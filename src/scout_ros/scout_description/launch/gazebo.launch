<launch>
  <arg name="world_name" default="/home/a/scout_ws/src/scout_ros/scout_description/worlds/empty.world" />
  <include file="$(find scout_description)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)" />
  </include>
  <node
    name="tf_footprint_base"
    pkg="tf"
    type="static_transform_publisher"
    args="0 0 0 0 0 0 base_link base_footprint 40" />
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-file $(find scout_description)/urdf/scout_mini.urdf -urdf -model scout_description"
    output="screen" />
  <node
    name="fake_joint_calibration"
    pkg="rostopic"
    type="rostopic"
    args="pub /calibrated std_msgs/Bool true" />
</launch>
