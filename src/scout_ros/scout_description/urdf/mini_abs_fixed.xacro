<?xml version="1.0"?>
<robot name="scout_mini" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="robot_namespace" default="/" />
  <xacro:arg name="urdf_extras" default="empty.urdf" />

  <xacro:include filename="/data/a/official_scout_ws/src/scout_description/urdf/scout_mini_wheel_1_abs.xacro" />
  <xacro:include filename="/data/a/official_scout_ws/src/scout_description/urdf/scout_mini_wheel_2_abs.xacro" />
  <xacro:include filename="/data/a/official_scout_ws/src/scout_description/urdf/scout_mini_wheel_3_abs.xacro" />
  <xacro:include filename="/data/a/official_scout_ws/src/scout_description/urdf/scout_mini_wheel_4_abs.xacro" />

  <xacro:property name="M_PI" value="3.14159"/>
  <xacro:property name="base_x_size" value="0.6200000" />
  <xacro:property name="base_y_size" value="0.585000" />
  <xacro:property name="base_z_size" value="0.235000" />
  <xacro:property name="wheelbase" value="0.463951"/>
  <xacro:property name="track" value="0.416503"/>
  <xacro:property name="wheel_vertical_offset" value="-0.100998" />
  <xacro:property name="wheel_diameter" value="0.16" />
  <xacro:property name="wheel_width" value="0.084" />
  <xacro:property name="wheel_length" value="0.8e-01" />
  <xacro:property name="wheel_radius" value="1.600e-01" />

  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="10" />
      <inertia ixx="0.1354" ixy="0" ixz="0" iyy="0.1354" iyz="0" izz="0.2667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0" rpy="1.57 0 -1.57" />
      <geometry>
        <mesh filename="file:///data/a/official_scout_ws/src/scout_description/meshes/scout_mini_base_link2.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.4 0.4 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- box_link removed for 2D lidar visibility in simulation -->

  <link name="laser_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0088463" ixy="2.0356E-05" ixz="-0.00047464" iyy="0.0066478" iyz="-6.9288E-06" izz="0.01219" />
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.01" length="0.01"/>
      </geometry>
      <material name="red">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.31" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.23" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser_link" />
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0088463" ixy="2.0356E-05" ixz="-0.00047464" iyy="0.0066478" iyz="-6.9288E-06" izz="0.01219" />
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.31" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.2 0 0.16" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="camera_link" />
  </joint>

  <xacro:scout_mini_wheel_1 wheel_prefix="front_left" wheel_diameter="${wheel_diameter}" wheel_width="${wheel_width}">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="-1.57 0 0" />
  </xacro:scout_mini_wheel_1>
  <xacro:scout_mini_wheel_2 wheel_prefix="rear_left" wheel_diameter="${wheel_diameter}" wheel_width="${wheel_width}">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="-1.57 0 0" />
  </xacro:scout_mini_wheel_2>
  <!-- fix B re-applied 2026-05-19 for ab bisect: bisect step ab = A v2 + B
       (no C). Tests whether B alone helps over A v2 alone (+47% pose). -->
  <xacro:scout_mini_wheel_3 wheel_prefix="front_right" wheel_diameter="${wheel_diameter}" wheel_width="${wheel_width}">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="1.57 0 0" />
  </xacro:scout_mini_wheel_3>
  <xacro:scout_mini_wheel_4 wheel_prefix="rear_right" wheel_diameter="${wheel_diameter}" wheel_width="${wheel_width}">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="1.57 0 0" />
  </xacro:scout_mini_wheel_4>

  <xacro:include filename="$(arg urdf_extras)" />
  <xacro:include filename="/home/a/scout_ws/src/scout_ros/scout_description/urdf/scout_mini_fixed.gazebo" />
</robot>
