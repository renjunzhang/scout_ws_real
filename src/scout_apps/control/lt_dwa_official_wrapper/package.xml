<?xml version="1.0"?>
<package format="2">
  <name>lt_dwa_official_wrapper</name>
  <version>0.1.0</version>
  <description>Isolated wrapper skeleton for the official LT-DWA core. Phase 3A/3B only: converters, validators, and safe API contracts.</description>

  <maintainer email="noreply@example.com">Scout LT-DWA Wrapper</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>local_map_generation</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>obstacle_msgs</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>roslib</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>local_map_generation</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>obstacle_msgs</build_export_depend>
  <build_export_depend>pcl_ros</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>roslib</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>tf</build_export_depend>
  <build_export_depend>visualization_msgs</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>local_map_generation</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>obstacle_msgs</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>rostest</test_depend>

  <export>
  </export>
</package>
