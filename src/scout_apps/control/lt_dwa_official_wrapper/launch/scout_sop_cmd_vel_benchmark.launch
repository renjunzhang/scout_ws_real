<launch>
  <!-- Benchmark overlay is inert by default. Publishing /cmd_vel requires explicit arg overrides. -->
  <arg name="enable_actuated_output" default="false"/>
  <arg name="publish_cmd_vel" default="false"/>
  <arg name="publish_benchmark_raw" default="false"/>
  <arg name="start_local_map_service" default="true"/>
  <arg name="planner_rate_hz" default="5.0"/>
  <arg name="command_publish_rate_hz" default="30.0"/>
  <arg name="command_stale_timeout_sec" default="0.6"/>
  <arg name="worker_timeout_sec" default="1.0"/>
  <arg name="path_topic" default="/scout/global_path_fixed"/>
  <arg name="goal_topic" default="/scout/goal"/>
  <arg name="scout_ws_root" default="$(optenv SCOUT_WS_ROOT /home/geist/scout_ws)"/>
  <arg name="worker_executable" default="$(arg scout_ws_root)/devel/lib/lt_dwa_official_wrapper/lt_dwa_worker"/>
  <arg name="runtime_request_dir" default="/tmp"/>

  <include file="$(find lt_dwa_official_wrapper)/launch/scout_sop_shadow_integration.launch">
    <arg name="start_local_map_service" value="$(arg start_local_map_service)"/>
    <arg name="enable_actuated_output" value="$(arg enable_actuated_output)"/>
    <arg name="publish_cmd_vel" value="$(arg publish_cmd_vel)"/>
    <arg name="publish_benchmark_raw" value="$(arg publish_benchmark_raw)"/>
    <arg name="planner_rate_hz" value="$(arg planner_rate_hz)"/>
    <arg name="command_publish_rate_hz" value="$(arg command_publish_rate_hz)"/>
    <arg name="command_stale_timeout_sec" value="$(arg command_stale_timeout_sec)"/>
    <arg name="worker_timeout_sec" value="$(arg worker_timeout_sec)"/>
    <arg name="path_topic" value="$(arg path_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="scout_ws_root" value="$(arg scout_ws_root)"/>
    <arg name="worker_executable" value="$(arg worker_executable)"/>
    <arg name="runtime_request_dir" value="$(arg runtime_request_dir)"/>
  </include>
</launch>
