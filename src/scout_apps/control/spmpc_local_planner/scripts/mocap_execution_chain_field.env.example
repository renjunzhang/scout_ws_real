# Copy this file outside the repository, edit it once, then source it in every
# experiment terminal:
#   cp .../mocap_execution_chain_field.env.example /tmp/mocap_execution_chain.env
#   ${EDITOR:-vi} /tmp/mocap_execution_chain.env
#   source /tmp/mocap_execution_chain.env

export DATE="${DATE:-20260826}"

# NOKOV/XINGYING connection. The standard Noetic sample.launch uses port 3883.
export MOCAP_HOST="${MOCAP_HOST:-192.168.203.85}"
export MOCAP_PORT="${MOCAP_PORT:-3883}"
export MOCAP_TRACKER="${MOCAP_TRACKER:-Tracker0}"

# Frozen compact S path. Fill MAX_SPAN_* with the measured safe capture-area
# envelope before generating the path; zero disables that geometry gate.
export PATH_ROOT="${PATH_ROOT:-${HOME}/fixed_paths/real/${DATE}_spmpc_mocap_execution_chain}"
export PATH_FILE="${PATH_FILE:-${PATH_ROOT}/mocap_compact_s_path.json}"
export GOAL_TOPIC="${GOAL_TOPIC:-/scout/goal}"
export MAX_SPAN_X_M="${MAX_SPAN_X_M:-0}"
export MAX_SPAN_Y_M="${MAX_SPAN_Y_M:-0}"

# One controller configuration for the complete R01--R05 batch.
export VARIANT="${VARIANT:-B_slosh_matched5}"
export V_REF="${V_REF:-0.20}"
export W_SLOSH="${W_SLOSH:-5.0}"
export W_SMOOTH="${W_SMOOTH:-1.0}"
export W_ALPHA="${W_ALPHA:-1.0}"
export W_DU_A="${W_DU_A:-1.0}"
export W_DU_VS="${W_DU_VS:-1.0}"
export IMU_TOPIC="${IMU_TOPIC:-/imu/data}"

# Start-pose replay gate and recording window.
export START_POS_TOL="${START_POS_TOL:-0.08}"
export START_YAW_TOL="${START_YAW_TOL:-0.15}"
export START_HOLD_SEC="${START_HOLD_SEC:-0.5}"
export START_GATE_TIMEOUT_SEC="${START_GATE_TIMEOUT_SEC:-120}"
export RECORD_SEC="${RECORD_SEC:-70}"
export RUN_OUT_DIR="${RUN_OUT_DIR:-${HOME}/slosh_bags/real/${DATE}_spmpc_mocap_execution_chain/S_path}"

# Static smoke acceptance gates. Adjust only before the first recorded smoke,
# and preserve the values in the protocol metadata/notes.
export SMOKE_SEC="${SMOKE_SEC:-15}"
export MIN_MOCAP_RATE_HZ="${MIN_MOCAP_RATE_HZ:-60.0}"
export MAX_MOCAP_GAP_SEC="${MAX_MOCAP_GAP_SEC:-0.10}"
export MAX_STATIC_POSITION_P95_M="${MAX_STATIC_POSITION_P95_M:-0.01}"
export MAX_STATIC_YAW_P95_RAD="${MAX_STATIC_YAW_P95_RAD:-0.03}"

# Deliberately absent: TRIAL_ID and ARM_MOTION. Set TRIAL_ID for each run, and
# type ARM_MOTION=YES only after checking clearance and the physical E-stop.
