# Copy this file outside the repository, edit the field-specific values once,
# then source the copy. The real freeze still requires a separately typed
# ARM_MAP_FREEZE=YES; that variable is deliberately absent here.

export DATE="${DATE:-20260828}"

# A small-field asset must never reuse the large-field G3R3 map name.
export MAP_ID="${MAP_ID:-map_carto_20260828_mocap_exec_v1}"
export MAP_OUTPUT_ROOT="${MAP_OUTPUT_ROOT:-${HOME}/scout_maps/real/${DATE}_mocap_exec}"
export MAP_STEM="${MAP_STEM:-${MAP_OUTPUT_ROOT}/${MAP_ID}}"
export MAP_RESOLUTION="${MAP_RESOLUTION:-0.02}"
export TRAJECTORY_ID="${TRAJECTORY_ID:-0}"
export CARTOGRAPHER_SETUP="${CARTOGRAPHER_SETUP:-/home/geist/scout_ws/src/scout_apps/sensors/cartographer_ws/install_isolated/setup.bash}"

# Mapping/localization sensor topics.
export SCAN_TOPIC="${SCAN_TOPIC:-/scan_front}"
export ODOM_TOPIC="${ODOM_TOPIC:-/odom}"
export IMU_TOPIC="${IMU_TOPIC:-/imu/data}"
export MAP_TOPIC="${MAP_TOPIC:-/map}"
export LOCALIZATION_GLOBAL_FRAME="${LOCALIZATION_GLOBAL_FRAME:-map}"
export LOCALIZATION_BASE_FRAME="${LOCALIZATION_BASE_FRAME:-base_link}"
export LOCALIZATION_OCCUPANCY_GRID_RESOLUTION="${LOCALIZATION_OCCUPANCY_GRID_RESOLUTION:-${MAP_RESOLUTION}}"

# NOKOV is monitoring-only: do not remap it to /odom and do not publish
# map/odom/base_link TF from the mocap bridge.
export MOCAP_HOST="${MOCAP_HOST:-192.168.203.85}"
export MOCAP_PORT="${MOCAP_PORT:-3883}"
export MOCAP_TRACKER="${MOCAP_TRACKER:-Tracker0}"
export MOCAP_TOPIC="${MOCAP_TOPIC:-/vrpn_client_node/${MOCAP_TRACKER}/pose}"
export MOCAP_STATUS_TOPIC="${MOCAP_STATUS_TOPIC:-/mocap/status}"
export REQUIRE_MOCAP="${REQUIRE_MOCAP:-true}"

# After a successful freeze, source ${MAP_STEM}_freeze.env. It fills both of
# these with the immutable pbstream identity. Leaving the hash empty makes the
# explicit-map localization launcher fail closed.
export LOCALIZATION_MAP_FILE="${LOCALIZATION_MAP_FILE:-${MAP_STEM}.pbstream}"
export LOCALIZATION_MAP_EXPECTED_SHA256="${LOCALIZATION_MAP_EXPECTED_SHA256:-}"
export REQUIRE_LOCALIZATION_MAP_HASH="${REQUIRE_LOCALIZATION_MAP_HASH:-true}"
export WAIT_FOR_LOCALIZATION_MAP="${WAIT_FOR_LOCALIZATION_MAP:-true}"
export WAIT_FOR_LOCALIZATION_TF="${WAIT_FOR_LOCALIZATION_TF:-true}"
export LOCALIZATION_USE_RVIZ="${LOCALIZATION_USE_RVIZ:-true}"

# Small-field mapping/localization qualification does not need RGB. Keep IMU
# enabled because the later execution-chain smoke requires it.
export START_IMU="${START_IMU:-true}"
export START_REALSENSE="${START_REALSENSE:-false}"

# Static localization qualification thresholds (at least 10 s, default 15 s).
export LOCALIZATION_STATIC_SEC="${LOCALIZATION_STATIC_SEC:-15}"
export MIN_SCAN_RATE_HZ="${MIN_SCAN_RATE_HZ:-5.0}"
export MAX_SCAN_GAP_SEC="${MAX_SCAN_GAP_SEC:-0.50}"
export MIN_ODOM_RATE_HZ="${MIN_ODOM_RATE_HZ:-10.0}"
export MAX_ODOM_GAP_SEC="${MAX_ODOM_GAP_SEC:-0.30}"
export MIN_IMU_RATE_HZ="${MIN_IMU_RATE_HZ:-40.0}"
export MAX_IMU_GAP_SEC="${MAX_IMU_GAP_SEC:-0.15}"
export MIN_MOCAP_RATE_HZ="${MIN_MOCAP_RATE_HZ:-60.0}"
export MAX_MOCAP_GAP_SEC="${MAX_MOCAP_GAP_SEC:-0.10}"
export MAX_TF_POSITION_P95_M="${MAX_TF_POSITION_P95_M:-0.02}"
export MAX_TF_YAW_P95_RAD="${MAX_TF_YAW_P95_RAD:-0.05}"
export MAX_MOCAP_POSITION_P95_M="${MAX_MOCAP_POSITION_P95_M:-0.01}"
export MAX_MOCAP_YAW_P95_RAD="${MAX_MOCAP_YAW_P95_RAD:-0.03}"

export LOCALIZATION_REPORT_DIR="${LOCALIZATION_REPORT_DIR:-${HOME}/slosh_bags/real/${DATE}_spmpc_mocap_execution_chain/preflight}"
