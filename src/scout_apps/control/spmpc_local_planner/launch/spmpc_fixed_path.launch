<launch>
  <arg name="planner_variant" default="B0"/>
  <arg name="reference_path_topic" default="/scout/global_path_fixed"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="imu_shadow_enable" default="false"/>
  <arg name="imu_subscriber_queue_size" default="10"/>
  <arg name="observer_source" default="odom"/>
  <arg name="observer_fallback_policy" default="odom"/>
  <arg name="observer_latch_fallback" default="true"/>
  <arg name="observer_max_imu_state_age_sec" default="0.10"/>
  <arg name="observer_max_odom_state_age_sec" default="0.50"/>
  <arg name="observer_max_future_skew_sec" default="0.005"/>
  <arg name="costmap_topic" default="/map"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="publish_cmd_vel" default="true"/>
  <arg name="reference_target_frame" default="" doc="可选: 将收到的 reference path 转到该 frame 后再求解"/>
  <arg name="solver_backend" default="continuous_mpcc_acados" doc="continuous_mpcc_acados(mainline)|continuous_mpcc_direct_omega_legacy(RouteB diagnostic)|primitive(debug fallback)"/>
  <arg name="w_slosh" default="-1.0" doc="覆盖 w_slosh; 负值时用 variants.yaml 原值(sweep 用)"/>
  <arg name="v_ref" default="-1.0" doc="诊断/消融用: 覆盖 v_ref; 负值时用 variants.yaml 原值"/>
  <arg name="slosh_height_max" default="-1.0" doc="覆盖 slosh/slosh_height_max(m); 负值时用 container yaml"/>
  <arg name="w_smooth" default="-1.0"/>
  <arg name="w_alpha" default="-1.0"/>
  <arg name="w_du_a" default="-1.0"/>
  <arg name="w_du_vs" default="-1.0"/>
  <arg name="shared_linear_accel_limit_enable" default="true"/>
  <arg name="shared_linear_accel_max" default="-1.0"/>
  <arg name="shared_linear_accel_max_dt" default="-1.0"/>
  <arg name="shared_angular_limit_enable" default="false"/>
  <arg name="shared_angular_rate_max" default="-1.0"/>
  <arg name="shared_angular_accel_max" default="-1.0"/>
  <arg name="shared_angular_accel_max_dt" default="-1.0"/>
  <arg name="alpha_max" default="-1.0" doc="诊断/消融用: 覆盖 robot/alpha_max; 负值时用 platform yaml"/>
  <arg name="delay_phase_mode" default="off" doc="off|monitor|shadow|fixed_closed_loop; shadow 只发诊断, fixed_closed_loop 改 SolverInput"/>
  <arg name="delay_phase_linear_delay_sec" default="-1.0"/>
  <arg name="delay_phase_angular_delay_sec" default="-1.0"/>
  <include file="$(find spmpc_local_planner)/launch/spmpc_experiment.launch">
    <arg name="planner_variant" value="$(arg planner_variant)"/>
    <arg name="experiment_mode" value="fixed_path"/>
    <arg name="experiment_config" value="fixed_path"/>
    <arg name="reference_path_topic" value="$(arg reference_path_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="imu_shadow_enable" value="$(arg imu_shadow_enable)"/>
    <arg name="imu_subscriber_queue_size" value="$(arg imu_subscriber_queue_size)"/>
    <arg name="observer_source" value="$(arg observer_source)"/>
    <arg name="observer_fallback_policy" value="$(arg observer_fallback_policy)"/>
    <arg name="observer_latch_fallback" value="$(arg observer_latch_fallback)"/>
    <arg name="observer_max_imu_state_age_sec" value="$(arg observer_max_imu_state_age_sec)"/>
    <arg name="observer_max_odom_state_age_sec" value="$(arg observer_max_odom_state_age_sec)"/>
    <arg name="observer_max_future_skew_sec" value="$(arg observer_max_future_skew_sec)"/>
    <arg name="costmap_topic" value="$(arg costmap_topic)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="publish_cmd_vel" value="$(arg publish_cmd_vel)"/>
    <arg name="reference_target_frame" value="$(arg reference_target_frame)"/>
    <arg name="solver_backend" value="$(arg solver_backend)"/>
    <arg name="w_slosh" value="$(arg w_slosh)"/>
    <arg name="v_ref" value="$(arg v_ref)"/>
    <arg name="slosh_height_max" value="$(arg slosh_height_max)"/>
    <arg name="w_smooth" value="$(arg w_smooth)"/>
    <arg name="w_alpha" value="$(arg w_alpha)"/>
    <arg name="w_du_a" value="$(arg w_du_a)"/>
    <arg name="w_du_vs" value="$(arg w_du_vs)"/>
    <arg name="shared_linear_accel_limit_enable" value="$(arg shared_linear_accel_limit_enable)"/>
    <arg name="shared_linear_accel_max" value="$(arg shared_linear_accel_max)"/>
    <arg name="shared_linear_accel_max_dt" value="$(arg shared_linear_accel_max_dt)"/>
    <arg name="shared_angular_limit_enable" value="$(arg shared_angular_limit_enable)"/>
    <arg name="shared_angular_rate_max" value="$(arg shared_angular_rate_max)"/>
    <arg name="shared_angular_accel_max" value="$(arg shared_angular_accel_max)"/>
    <arg name="shared_angular_accel_max_dt" value="$(arg shared_angular_accel_max_dt)"/>
    <arg name="alpha_max" value="$(arg alpha_max)"/>
    <arg name="delay_phase_mode" value="$(arg delay_phase_mode)"/>
    <arg name="delay_phase_linear_delay_sec" value="$(arg delay_phase_linear_delay_sec)"/>
    <arg name="delay_phase_angular_delay_sec" value="$(arg delay_phase_angular_delay_sec)"/>
  </include>
</launch>
