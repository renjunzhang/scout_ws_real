<launch>
  <arg name="planner_variant" default="B0" doc="B0|B_accel|B_slosh|B_slosh_linear|B_slosh_anti|B_smooth|B_ours|B_ours_anti|B_slosh_matched0|B_slosh_matched5"/>
  <arg name="experiment_mode" default="fixed_path" doc="fixed_path|point_to_point"/>
  <arg name="reference_path_topic" default="/scout/global_path_fixed"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="imu_shadow_enable" default="false" doc="enable processed-IMU pipeline/parallel observer; forced true when observer_source=processed_imu"/>
  <arg name="imu_subscriber_queue_size" default="10" doc="processed-IMU private callback queue depth"/>
  <arg name="observer_source" default="odom" doc="odom|processed_imu; explicit nominal liquid-state source"/>
  <arg name="observer_fallback_policy" default="odom" doc="odom|fail_closed; only applies to nominal processed_imu after first READY"/>
  <arg name="observer_latch_fallback" default="true"/>
  <arg name="observer_max_imu_state_age_sec" default="0.10"/>
  <arg name="observer_max_odom_state_age_sec" default="0.50"/>
  <arg name="observer_max_future_skew_sec" default="0.005"/>
  <arg name="costmap_topic" default="/map"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="publish_cmd_vel" default="true"/>
  <arg name="reference_target_frame" default="" doc="可选: 将收到的 reference path 转到该 frame 后再求解"/>
  <arg name="solver_backend" default="continuous_mpcc_acados" doc="continuous_mpcc_acados(mainline)|delay_augmented_phase_acados(explicit development opt-in)|continuous_mpcc_direct_omega_legacy(RouteB diagnostic)|primitive(debug fallback)"/>
  <arg name="delay_augmented_phase_enabled" default="false" doc="must be explicitly true with delay_augmented_phase_acados"/>
  <arg name="delay_augmented_phase_expected_recovery_artifact_hash" default="" doc="loader-verified lowercase SHA-256 of the canonical V3 recovery payload; empty keeps NO-GO"/>
  <arg name="w_slosh" default="-1.0" doc="覆盖当前 variant 的 w_slosh; 负值时用 variants.yaml 原值(sweep 用)"/>
  <arg name="v_ref" default="-1.0" doc="诊断/消融用: 覆盖当前 variant 的 v_ref; 负值时用 variants.yaml 原值"/>
  <arg name="slosh_height_max" default="-1.0" doc="覆盖 slosh/slosh_height_max(m); 负值时用 container yaml"/>
  <arg name="w_smooth" default="-1.0" doc="覆盖当前 variant 的 w_smooth; 负值时用 variants.yaml 原值"/>
  <arg name="w_alpha" default="-1.0" doc="覆盖当前 variant 的 w_alpha; 负值时由 w_smooth fallback"/>
  <arg name="w_du_a" default="-1.0" doc="覆盖当前 variant 的 w_du_a; 负值时由 w_smooth fallback"/>
  <arg name="w_du_vs" default="-1.0" doc="覆盖当前 variant 的 w_du_vs; 负值时由 w_smooth fallback"/>
  <arg name="shared_linear_accel_limit_enable" default="true"/>
  <arg name="shared_linear_accel_max" default="-1.0" doc="覆盖 platform/shared_constraints/linear_accel_max; 负值时用 platform yaml"/>
  <arg name="shared_linear_accel_max_dt" default="-1.0" doc="覆盖 platform/shared_constraints/linear_accel_max_dt; 负值时用 platform yaml"/>
  <arg name="shared_angular_limit_enable" default="false"/>
  <arg name="shared_angular_rate_max" default="-1.0" doc="覆盖 platform/shared_constraints/angular_rate_max; 负值时用 platform yaml/robot omega_max"/>
  <arg name="shared_angular_accel_max" default="-1.0" doc="覆盖 platform/shared_constraints/angular_accel_max; 负值时用 platform yaml/robot alpha_max"/>
  <arg name="shared_angular_accel_max_dt" default="-1.0" doc="覆盖 platform/shared_constraints/angular_accel_max_dt; 负值时用 platform yaml"/>
  <arg name="alpha_max" default="-1.0" doc="诊断/消融用: 覆盖 robot/alpha_max; 负值时用 platform yaml"/>
  <arg name="delay_phase_mode" default="off" doc="off|monitor|shadow|fixed_closed_loop|fixed_robot_only; fixed_robot_only 仅替换 SolverInput.robot"/>
  <arg name="delay_phase_linear_delay_sec" default="-1.0" doc="覆盖 delay_phase/linear_delay_sec; 负值时用 common.yaml"/>
  <arg name="delay_phase_angular_delay_sec" default="-1.0" doc="覆盖 delay_phase/angular_delay_sec; 负值时用 common.yaml"/>
  <arg name="delay_phase_linear_time_constant_sec" default="-1.0" doc="覆盖线速度执行惯性时间常数; 负值时用 common.yaml"/>
  <arg name="delay_phase_angular_time_constant_sec" default="-1.0" doc="覆盖角速度执行惯性时间常数; 负值时用 common.yaml"/>
  <arg name="delay_phase_require_complete_history" default="false" doc="phase_rejoin=enforce 时必须显式为 true"/>
  <arg name="publish_timing_enabled" default="false" doc="explicit expected-publish epoch contract"/>
  <arg name="publish_timing_estimated_dc_sec" default="0.0"/>
  <arg name="phase_rejoin_mode" default="off" doc="off|monitor|enforce; 默认关闭"/>
  <arg name="phase_rejoin_artifact_path" default=""/>
  <arg name="phase_rejoin_publish_diagnostics" default="true"/>
  <arg name="phase_rejoin_liquid_horizon_steps" default="3"/>
  <arg name="phase_rejoin_max_residual_v" default="0.08"/>
  <arg name="phase_rejoin_max_residual_omega" default="0.20"/>
  <arg name="phase_rejoin_allow_development_artifact_in_enforce" default="false"/>
  <arg name="phase_rejoin_required_contract_id" default=""/>
  <arg name="phase_rejoin_required_frame_id" default=""/>
  <arg name="state_timing_require_common_epoch" default="true"/>
  <arg name="state_timing_max_raw_skew_sec" default="0.080"/>
  <arg name="state_timing_max_interpolation_gap_sec" default="0.050"/>
  <arg name="state_timing_max_robot_extrapolation_sec" default="0.010"/>
  <arg name="execution_contract_fail_closed_on_post_limit_change" default="false"/>
  <arg name="execution_contract_max_post_limit_delta_v" default="0.0001"/>
  <arg name="execution_contract_max_post_limit_delta_omega" default="0.0001"/>
  <arg name="platform_config" default="scout_mini"/>
  <arg name="container_config" default="tube_default"/>
  <arg name="experiment_config" default="fixed_path"/>

  <node pkg="spmpc_local_planner" type="spmpc_local_planner_node" name="spmpc_local_planner" output="screen">
    <rosparam file="$(find spmpc_local_planner)/config/planner/common.yaml" command="load"/>
    <rosparam file="$(find spmpc_local_planner)/config/planner/variants.yaml" command="load"/>
    <rosparam file="$(find spmpc_local_planner)/config/platforms/$(arg platform_config).yaml" command="load"/>
    <rosparam file="$(find spmpc_local_planner)/config/containers/$(arg container_config).yaml" command="load"/>
    <rosparam file="$(find spmpc_local_planner)/config/experiments/$(arg experiment_config).yaml" command="load"/>
    <param name="planner_variant" value="$(arg planner_variant)"/>
    <param name="experiment_mode" value="$(arg experiment_mode)"/>
    <param name="topics/reference_path" value="$(arg reference_path_topic)"/>
    <param name="topics/imu" value="$(arg imu_topic)"/>
    <param name="imu_shadow/enable" value="$(arg imu_shadow_enable)"/>
    <param name="imu_shadow/subscriber_queue_size" value="$(arg imu_subscriber_queue_size)"/>
    <param name="slosh_observer/source" value="$(arg observer_source)"/>
    <param name="slosh_observer/fallback_policy" value="$(arg observer_fallback_policy)"/>
    <param name="slosh_observer/latch_fallback" value="$(arg observer_latch_fallback)"/>
    <param name="slosh_observer/max_imu_state_age_sec" value="$(arg observer_max_imu_state_age_sec)"/>
    <param name="slosh_observer/max_odom_state_age_sec" value="$(arg observer_max_odom_state_age_sec)"/>
    <param name="slosh_observer/max_future_skew_sec" value="$(arg observer_max_future_skew_sec)"/>
    <param name="topics/costmap" value="$(arg costmap_topic)"/>
    <param name="topics/cmd_vel" value="$(arg cmd_vel_topic)"/>
    <param name="publish_cmd_vel" value="$(arg publish_cmd_vel)"/>
    <param name="frames/reference_target" value="$(arg reference_target_frame)"/>
    <param name="solver_backend" value="$(arg solver_backend)"/>
    <param name="delay_augmented_phase/enabled" value="$(arg delay_augmented_phase_enabled)"/>
    <param name="delay_augmented_phase/expected_recovery_artifact_hash" value="$(arg delay_augmented_phase_expected_recovery_artifact_hash)"/>
    <param name="slosh/slosh_height_max" value="$(arg slosh_height_max)"
           if="$(eval float(arg('slosh_height_max')) >= 0.0)"/>
    <param name="platform/shared_constraints/linear_accel_limit_enable" value="$(arg shared_linear_accel_limit_enable)"/>
    <param name="platform/shared_constraints/linear_accel_max" value="$(arg shared_linear_accel_max)"
           if="$(eval float(arg('shared_linear_accel_max')) >= 0.0)"/>
    <param name="platform/shared_constraints/linear_accel_max_dt" value="$(arg shared_linear_accel_max_dt)"
           if="$(eval float(arg('shared_linear_accel_max_dt')) >= 0.0)"/>
    <param name="platform/shared_constraints/angular_limit_enable" value="$(arg shared_angular_limit_enable)"/>
    <param name="platform/shared_constraints/angular_rate_max" value="$(arg shared_angular_rate_max)"
           if="$(eval float(arg('shared_angular_rate_max')) >= 0.0)"/>
    <param name="platform/shared_constraints/angular_accel_max" value="$(arg shared_angular_accel_max)"
           if="$(eval float(arg('shared_angular_accel_max')) >= 0.0)"/>
    <param name="platform/shared_constraints/angular_accel_max_dt" value="$(arg shared_angular_accel_max_dt)"
           if="$(eval float(arg('shared_angular_accel_max_dt')) >= 0.0)"/>
    <param name="robot/alpha_max" value="$(arg alpha_max)"
           if="$(eval float(arg('alpha_max')) >= 0.0)"/>
    <param name="delay_phase/mode" value="$(arg delay_phase_mode)"/>
    <param name="delay_phase/linear_delay_sec" value="$(arg delay_phase_linear_delay_sec)"
           if="$(eval float(arg('delay_phase_linear_delay_sec')) >= 0.0)"/>
    <param name="delay_phase/angular_delay_sec" value="$(arg delay_phase_angular_delay_sec)"
           if="$(eval float(arg('delay_phase_angular_delay_sec')) >= 0.0)"/>
    <param name="delay_phase/linear_time_constant_sec" value="$(arg delay_phase_linear_time_constant_sec)"
           if="$(eval float(arg('delay_phase_linear_time_constant_sec')) >= 0.0)"/>
    <param name="delay_phase/angular_time_constant_sec" value="$(arg delay_phase_angular_time_constant_sec)"
           if="$(eval float(arg('delay_phase_angular_time_constant_sec')) >= 0.0)"/>
    <param name="delay_phase/require_complete_history" value="$(arg delay_phase_require_complete_history)"/>
    <param name="publish_timing/enabled" value="$(arg publish_timing_enabled)"/>
    <param name="publish_timing/estimated_dc_sec" value="$(arg publish_timing_estimated_dc_sec)"/>
    <param name="phase_rejoin/mode" value="$(arg phase_rejoin_mode)"/>
    <param name="phase_rejoin/artifact_path" value="$(arg phase_rejoin_artifact_path)"/>
    <param name="phase_rejoin/publish_diagnostics" value="$(arg phase_rejoin_publish_diagnostics)"/>
    <param name="phase_rejoin/liquid_horizon_steps" value="$(arg phase_rejoin_liquid_horizon_steps)"/>
    <param name="phase_rejoin/max_residual_v" value="$(arg phase_rejoin_max_residual_v)"/>
    <param name="phase_rejoin/max_residual_omega" value="$(arg phase_rejoin_max_residual_omega)"/>
    <param name="phase_rejoin/allow_development_artifact_in_enforce" value="$(arg phase_rejoin_allow_development_artifact_in_enforce)"/>
    <param name="phase_rejoin/required_contract_id" value="$(arg phase_rejoin_required_contract_id)"/>
    <param name="phase_rejoin/required_frame_id" value="$(arg phase_rejoin_required_frame_id)"/>
    <param name="state_timing/require_common_epoch" value="$(arg state_timing_require_common_epoch)"/>
    <param name="state_timing/max_raw_skew_sec" value="$(arg state_timing_max_raw_skew_sec)"/>
    <param name="state_timing/max_interpolation_gap_sec" value="$(arg state_timing_max_interpolation_gap_sec)"/>
    <param name="state_timing/max_robot_extrapolation_sec" value="$(arg state_timing_max_robot_extrapolation_sec)"/>
    <param name="execution_contract/fail_closed_on_post_limit_change" value="$(arg execution_contract_fail_closed_on_post_limit_change)"/>
    <param name="execution_contract/max_post_limit_delta_v" value="$(arg execution_contract_max_post_limit_delta_v)"/>
    <param name="execution_contract/max_post_limit_delta_omega" value="$(arg execution_contract_max_post_limit_delta_omega)"/>
    <!-- sweep 时覆盖该 variant 的 w_slosh(在 variants.yaml 加载之后, 故生效); w_slosh<0 跳过 -->
    <param name="variants/$(arg planner_variant)/w_slosh" value="$(arg w_slosh)"
           if="$(eval float(arg('w_slosh')) >= 0.0)"/>
    <param name="variants/$(arg planner_variant)/w_smooth" value="$(arg w_smooth)"
           if="$(eval float(arg('w_smooth')) >= 0.0)"/>
    <!-- speed diagnostic 时覆盖该 variant 的 v_ref; v_ref<0 跳过，保持默认行为 -->
    <param name="variants/$(arg planner_variant)/v_ref" value="$(arg v_ref)"
           if="$(eval float(arg('v_ref')) >= 0.0)"/>
    <!-- smooth split sweep overrides; <0 时由 C++ 侧回退到 w_smooth -->
    <param name="variants/$(arg planner_variant)/w_alpha" value="$(arg w_alpha)"
           if="$(eval float(arg('w_alpha')) >= 0.0)"/>
    <param name="variants/$(arg planner_variant)/w_du_a" value="$(arg w_du_a)"
           if="$(eval float(arg('w_du_a')) >= 0.0)"/>
    <param name="variants/$(arg planner_variant)/w_du_vs" value="$(arg w_du_vs)"
           if="$(eval float(arg('w_du_vs')) >= 0.0)"/>
  </node>
</launch>
