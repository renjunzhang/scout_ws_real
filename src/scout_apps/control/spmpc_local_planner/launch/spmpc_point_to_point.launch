<launch>
  <arg name="planner_variant" default="B0"/>
  <arg name="reference_path_topic" default="/scout/global_path"/>
  <arg name="costmap_topic" default="/map"/>
  <arg name="solver_backend" default="continuous_mpcc_acados" doc="continuous_mpcc_acados(mainline)|continuous_mpcc_direct_omega_legacy(RouteB diagnostic)|primitive(debug fallback)"/>
  <arg name="w_slosh" default="-1.0" doc="覆盖 w_slosh; 负值时用 variants.yaml 原值(sweep 用)"/>
  <arg name="reference_target_frame" default="odom" doc="P2P 中将 global path 固化到该局部 frame; 空值则保持原 frame"/>
  <include file="$(find spmpc_local_planner)/launch/spmpc_experiment.launch">
    <arg name="planner_variant" value="$(arg planner_variant)"/>
    <arg name="experiment_mode" value="point_to_point"/>
    <arg name="experiment_config" value="point_to_point"/>
    <arg name="reference_path_topic" value="$(arg reference_path_topic)"/>
    <arg name="costmap_topic" value="$(arg costmap_topic)"/>
    <arg name="solver_backend" value="$(arg solver_backend)"/>
    <arg name="w_slosh" value="$(arg w_slosh)"/>
    <arg name="reference_target_frame" value="$(arg reference_target_frame)"/>
  </include>
</launch>
