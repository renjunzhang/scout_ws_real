<!-- Scout Mini 全向轮 MPC 局部规划器启动文件（实物） -->
<!-- 
  使用说明：
  1. 先启动底盘、雷达、定位
  2. 启动全局规划：roslaunch scout_global_planner move_base_global.launch
  3. 再启动本 launch 文件
-->
<launch>
  <!-- 参数 -->
  <arg name="verbose" default="false" doc="是否输出调试信息"/>
  
  <!-- ========== 全向轮 MPC 局部规划器（独立节点）========== -->
  <node pkg="scout_omni_local_planner" type="omni_local_planner_node" 
        name="scout_omni_local_planner" output="screen">
    <!-- 加载参数 -->
    <rosparam file="$(find scout_omni_local_planner)/config/mpc_params.yaml" 
              command="load"/>
    
    <!-- 覆盖 verbose 参数 -->
    <param name="verbose" value="$(arg verbose)"/>
    
    <!-- 话题 remap -->
    <remap from="global_path" to="/scout/global_path"/>
    <remap from="odom" to="/odom"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node>
        
</launch>
