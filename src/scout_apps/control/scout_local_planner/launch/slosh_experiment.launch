<!-- 液体晃动抑制消融实验 launch 文件 -->
<!--
  使用方式：
    # 基线 (无晃动抑制)
    roslaunch scout_local_planner slosh_experiment.launch Q_slosh:=0

    # 消融实验 (典型值: 5, 10, 20)
    roslaunch scout_local_planner slosh_experiment.launch Q_slosh:=10

  实验建议：
    1. 每组 Q_slosh 跑 3~5 次相同路径
    2. 同时运行 record_slosh_experiment.sh 录制 rosbag
    3. 实验路径应包含：直线加速、急弯、连续 S 弯
-->
<launch>
  <!-- ======== 实验参数 ======== -->
  <arg name="experiment_group" default="LEGACY" doc="正式对比实验组: LEGACY/C/D/E/F/RPP_STYLE/BIAGIOTTI/RUCKIG/TOPPRA；LEGACY 保持旧行为"/>
  <arg name="controller_variant" default="mpc" doc="兼容调试字段: mpc/rpp_speed_reg；正式实验由 experiment_group 派生"/>
  <arg name="external_profile_mode" default="none" doc="外部速度剖面模式: none/toppra/ruckig/biagiotti/custom_csv；正式实验由 experiment_group 派生"/>
  <arg name="Q_slosh" default="0.0"  doc="归一化晃动风险权重；第一轮建议扫 2/5/10"/>
  <arg name="slosh_height_ref" default="0.005" doc="归一化参考晃动高度 (m)，默认 5mm"/>
  <arg name="slosh_eta_dot_ratio" default="0.3" doc="eta_dot 等效位移项比例；非正数时使用手动 Q_slosh_eta_dot"/>
  <arg name="slosh_preview_factor" default="0.0" doc="one-step preview slosh 额外权重；0=关闭，1=对预测状态 x_1..x_N 额外加一份 slosh 权重"/>
  <arg name="Q_slosh_eta_dot" default="0.0" doc="旧手动 eta_dot QP 权重；仅 slosh_eta_dot_ratio 为非正数时生效"/>
  <arg name="mpc_Q_lag" default="0.5" doc="lag/纵向误差权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_Q_contour" default="32.0" doc="contour/横向误差权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_Q_etheta" default="15.0" doc="航向误差权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_Q_v" default="9.0" doc="速度跟踪权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_R_a" default="0.4" doc="加速度控制权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_R_omega" default="2.0" doc="角速度控制权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_R_da" default="0.5" doc="加速度变化权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="mpc_R_domega" default="4.0" doc="角速度变化权重覆盖，用于 slosh-priority MPC 消融"/>
  <arg name="terminal_factor_slosh_eta" default="0.0" doc="terminal η 代价放大系数，0=关闭；需 Q_slosh>0"/>
  <arg name="terminal_factor_slosh_eta_dot" default="0.0" doc="terminal η_dot 代价放大系数，0=关闭；需 eta_dot 权重生效"/>
  <arg name="verbose" default="false" doc="是否输出调试信息"/>
  <arg name="filter_alpha_v" default="1.0" doc="实验模式: 线速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_alpha_omega" default="1.0" doc="实验模式: 角速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_kappa_boost" default="0.0" doc="实验模式: 关闭曲率自适应 EMA 增益"/>
  <arg name="reached_debug_duration" default="5.0" doc="到达终点后继续输出 slosh debug 的时长（秒）"/>
  <arg name="terminal_slowdown_enable" default="true" doc="是否在终点捕获前提前平滑降低 v_des_cmd；作为 PathHandler 末端速度未验证干净前的保护层"/>
  <arg name="terminal_slowdown_distance" default="1.20" doc="终点前平滑减速起始距离 (m)"/>
  <arg name="terminal_slowdown_v_max" default="0.18" doc="terminal slowdown 外层包络最高速度"/>
  <arg name="terminal_slowdown_Q_v" default="40.0" doc="终点制动速度上限生效时临时速度跟踪权重"/>
  <arg name="terminal_slowdown_terminal_factor_v" default="5.0" doc="终点制动速度上限生效时临时 terminal 速度权重放大"/>
  <arg name="terminal_capture_stop_enable" default="true" doc="mpc_planner 风格外层终点捕获；阈值内进入限速 CAPTURE_BRAKE，不再硬发 cmd_vel=0"/>
  <arg name="terminal_capture_stop_distance" default="0.70" doc="终点捕获制动半径 (m)"/>
  <arg name="terminal_capture_v" default="0.18" doc="capture 入口和 capture 内的低速目标上限 (m/s)"/>
  <arg name="v_des_rate_limit_enable" default="true" doc="执行层参考速度变化率限制；用于治理纵向 ax 脉冲"/>
  <arg name="v_des_accel_limit" default="0.60" doc="v_des 上升变化率上限 (m/s^2)"/>
  <arg name="v_des_decel_limit" default="0.80" doc="v_des 下降变化率上限 (m/s^2)"/>
  <arg name="external_speed_profile_csv" default="" doc="TOPPRA/Ruckig/Biagiotti-style 外部 v_ref(s) CSV；external_profile_mode!=none 时必填"/>
  <arg name="external_profile_execution_cap_enable" default="false" doc="兼容字段；external_profile_mode!=none 时 C++ 内部会强制启用执行层 cap"/>
  <arg name="external_profile_execution_accel_limit" default="0.0" doc="外部 profile 执行层加速度上限；0 表示使用 path/vehicle 默认"/>
  <arg name="external_profile_execution_decel_limit" default="0.0" doc="外部 profile 执行层减速度上限；0 表示使用 path/vehicle 默认"/>
  <arg name="external_profile_execution_jerk_limit" default="0.0" doc="外部 profile 执行层 jerk 上限；0 表示不限制 jerk"/>
  <arg name="rpp_regulated_min_radius" default="0.50" doc="RPP-style 曲率限速触发半径 (m)"/>
  <arg name="rpp_approach_dist" default="0.70" doc="RPP-style 终点 approach 速度缩放距离 (m)"/>
  <arg name="rpp_min_approach_v" default="0.05" doc="RPP-style approach 最低线速度 (m/s)"/>
  <arg name="rpp_replace_base_curvature_cap" default="true" doc="RPP-style 是否替代 PathHandler method 曲率限速层"/>
  <arg name="max_lat_accel_safety" default="2.5" doc="所有方法共用的最终横向加速度安全 cap；0 表示关闭"/>
  <arg name="slosh_use_imu_lateral_accel" default="false" doc="是否使用 IMU 横向加速度替代 v*omega"/>
  <arg name="slosh_use_imu_yaw_rate" default="true" doc="当前默认安全配置：使用 IMU 角速度 z 替代 odom omega"/>
  <arg name="slosh_use_imu_alpha_z" default="false" doc="是否使用 IMU 角速度差分替代 alpha_z"/>
  <arg name="slosh_imu_topic" default="/imu/data" doc="IMU 话题"/>
  <arg name="slosh_imu_filter_alpha" default="0.3" doc="IMU 数据 EMA 滤波系数"/>
  <arg name="slosh_imu_ay_bias_compensation_enable" default="true" doc="是否对 IMU ay 做静止零偏扣除"/>
  <arg name="slosh_imu_ay_bias_init_duration" default="3.0" doc="估计 IMU ay 零偏所需的连续静止时长"/>
  <arg name="slosh_imu_ay_scale" default="1.0" doc="IMU ay 离线标定比例系数（由 imu_ay_tool.py calibrate 输出）"/>
  <arg name="cmd_vel_topic" default="/cmd_vel" doc="planner 输出的 cmd_vel 话题；阶段 3 可改到调试话题避免与底盘直控冲突"/>
  <arg name="global_path_topic" default="/scout/global_path" doc="local planner 订阅的全局路径话题；固定路径重放实验时可改到 /scout/global_path_fixed"/>

  <!-- ========== MPC 局部规划器 ========== -->
  <node pkg="scout_local_planner" type="local_planner_node"
        name="scout_local_planner" output="screen">

    <!-- 加载基础参数 -->
    <rosparam file="$(find scout_local_planner)/config/mpc_params.yaml"
              command="load"/>

    <!-- 实验参数覆盖 (YAML 之后、节点 init 之前) -->
    <param name="experiment_group" value="$(arg experiment_group)"/>
    <param name="controller_variant" value="$(arg controller_variant)"/>
    <param name="external_profile_mode" value="$(arg external_profile_mode)"/>
    <param name="verbose" value="$(arg verbose)"/>
    <param name="mpc/Q_slosh" value="$(arg Q_slosh)"/>
    <param name="mpc/slosh_height_ref" value="$(arg slosh_height_ref)"/>
    <param name="mpc/slosh_eta_dot_ratio" value="$(arg slosh_eta_dot_ratio)"/>
    <param name="mpc/slosh_preview_factor" value="$(arg slosh_preview_factor)"/>
    <param name="mpc/Q_slosh_eta_dot" value="$(arg Q_slosh_eta_dot)"/>
    <param name="mpc/Q_lag" value="$(arg mpc_Q_lag)"/>
    <param name="mpc/Q_contour" value="$(arg mpc_Q_contour)"/>
    <param name="mpc/Q_etheta" value="$(arg mpc_Q_etheta)"/>
    <param name="mpc/Q_v" value="$(arg mpc_Q_v)"/>
    <param name="mpc/R_a" value="$(arg mpc_R_a)"/>
    <param name="mpc/R_omega" value="$(arg mpc_R_omega)"/>
    <param name="mpc/R_da" value="$(arg mpc_R_da)"/>
    <param name="mpc/R_domega" value="$(arg mpc_R_domega)"/>
    <param name="mpc/terminal_factor_slosh_eta" value="$(arg terminal_factor_slosh_eta)"/>
    <param name="mpc/terminal_factor_slosh_eta_dot" value="$(arg terminal_factor_slosh_eta_dot)"/>
    <param name="filter/alpha_v" value="$(arg filter_alpha_v)"/>
    <param name="filter/alpha_omega" value="$(arg filter_alpha_omega)"/>
    <param name="filter/kappa_boost" value="$(arg filter_kappa_boost)"/>
    <param name="experiment/reached_debug_duration" value="$(arg reached_debug_duration)"/>
    <param name="terminal_slowdown/enable" value="$(arg terminal_slowdown_enable)"/>
    <param name="terminal_slowdown/distance" value="$(arg terminal_slowdown_distance)"/>
    <param name="terminal_slowdown/v_max" value="$(arg terminal_slowdown_v_max)"/>
    <param name="terminal_slowdown/Q_v" value="$(arg terminal_slowdown_Q_v)"/>
    <param name="terminal_slowdown/terminal_factor_v" value="$(arg terminal_slowdown_terminal_factor_v)"/>
    <param name="terminal_capture_stop/enable" value="$(arg terminal_capture_stop_enable)"/>
    <param name="terminal_capture_stop/distance" value="$(arg terminal_capture_stop_distance)"/>
    <param name="terminal_capture_stop/v_cap" value="$(arg terminal_capture_v)"/>
    <param name="v_des_rate_limit/enable" value="$(arg v_des_rate_limit_enable)"/>
    <param name="v_des_rate_limit/accel_limit" value="$(arg v_des_accel_limit)"/>
    <param name="v_des_rate_limit/decel_limit" value="$(arg v_des_decel_limit)"/>
    <param name="path_handler/external_speed_profile_csv" value="$(arg external_speed_profile_csv)"/>
    <param name="external_profile_execution_cap/enable" value="$(arg external_profile_execution_cap_enable)"/>
    <param name="external_profile_execution_cap/accel_limit" value="$(arg external_profile_execution_accel_limit)"/>
    <param name="external_profile_execution_cap/decel_limit" value="$(arg external_profile_execution_decel_limit)"/>
    <param name="external_profile_execution_cap/jerk_limit" value="$(arg external_profile_execution_jerk_limit)"/>
    <param name="rpp_speed_reg/regulated_min_radius" value="$(arg rpp_regulated_min_radius)"/>
    <param name="rpp_speed_reg/approach_dist" value="$(arg rpp_approach_dist)"/>
    <param name="rpp_speed_reg/min_approach_v" value="$(arg rpp_min_approach_v)"/>
    <param name="rpp_speed_reg/replace_base_curvature_cap" value="$(arg rpp_replace_base_curvature_cap)"/>
    <param name="path_handler/max_lat_accel_safety" value="$(arg max_lat_accel_safety)"/>
    <param name="slosh_estimator/use_imu_lateral_accel" value="$(arg slosh_use_imu_lateral_accel)"/>
    <param name="slosh_estimator/use_imu_yaw_rate" value="$(arg slosh_use_imu_yaw_rate)"/>
    <param name="slosh_estimator/use_imu_alpha_z" value="$(arg slosh_use_imu_alpha_z)"/>
    <param name="slosh_estimator/imu_topic" value="$(arg slosh_imu_topic)"/>
    <param name="slosh_estimator/imu_filter_alpha" value="$(arg slosh_imu_filter_alpha)"/>
    <param name="slosh_estimator/imu_ay_bias_compensation_enable" value="$(arg slosh_imu_ay_bias_compensation_enable)"/>
    <param name="slosh_estimator/imu_ay_bias_init_duration" value="$(arg slosh_imu_ay_bias_init_duration)"/>
    <param name="slosh_estimator/imu_ay_scale"             value="$(arg slosh_imu_ay_scale)"/>
    <!-- 话题 remap -->
    <remap from="global_path" to="$(arg global_path_topic)"/>
    <remap from="odom"        to="/odom"/>
    <remap from="cmd_vel"     to="$(arg cmd_vel_topic)"/>
  </node>

</launch>
