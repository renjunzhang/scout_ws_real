<!-- 液体晃动抑制消融实验 launch 文件（仿真专用） -->
<!--
  使用方式：
    # 仿真基线 (无晃动抑制)
    roslaunch scout_local_planner slosh_experiment_sim.launch Q_slosh:=0

    # 仿真消融实验 (典型值: 5, 10, 20)
    roslaunch scout_local_planner slosh_experiment_sim.launch Q_slosh:=10

  实验建议：
    1. 每组 Q_slosh 跑 3~5 次相同路径
    2. 同时运行 record_slosh_experiment.sh 录制 rosbag
    3. 实验路径应包含：直线加速、急弯、连续 S 弯
-->
<launch>
  <!-- ======== 实验参数 ======== -->
  <arg name="Q_slosh" default="0.0"  doc="晃动抑制权重 (消融变量: 0/5/10/20)"/>
  <arg name="Q_slosh_eta_dot" default="0.0" doc="P1: eta_dot 速度惩罚权重，默认关闭；建议从 0.01~0.1 开始调"/>
  <arg name="mpc_Q_v" default="8.0" doc="速度跟踪权重覆盖，用于 reference execution 消融"/>
  <arg name="mpc_R_a" default="0.4" doc="加速度控制权重覆盖，用于 reference execution 消融"/>
  <arg name="mpc_R_da" default="0.5" doc="加速度变化权重覆盖，用于 reference execution 消融"/>
  <arg name="mpc_cmd_vel_lead_time" default="0.15" doc="cmd_vel 输出前瞻时间覆盖；仿真默认 0.15"/>
  <arg name="terminal_factor_slosh_eta" default="0.0" doc="P2: terminal η 代价放大系数，0=关闭；首轮建议 5~10；需 Q_slosh>0"/>
  <arg name="terminal_factor_slosh_eta_dot" default="0.0" doc="P2: terminal η̇ 代价放大系数，0=关闭；首轮建议 5~10；需 Q_slosh_eta_dot>0"/>
  <arg name="enable_slosh_box_constraint" default="false" doc="是否启用第一版液面峰值盒约束代理"/>
  <arg name="verbose" default="false" doc="是否输出调试信息"/>
  <arg name="filter_alpha_v" default="1.0" doc="实验模式: 线速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_alpha_omega" default="1.0" doc="实验模式: 角速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_kappa_boost" default="0.0" doc="实验模式: 关闭曲率自适应 EMA 增益"/>
  <arg name="reached_debug_duration" default="5.0" doc="到达终点后继续输出 slosh debug 的时长（秒）"/>
  <arg name="slosh_speed_governor_enable" default="false" doc="是否启用残余晃动感知的速度治理"/>
  <arg name="slosh_speed_governor_k_eta" default="2.5" doc="速度治理液面高度比例缩放系数"/>
  <arg name="slosh_speed_governor_ay_max_base" default="0.0" doc="速度治理横向加速度预算"/>
  <arg name="slosh_speed_governor_v_des_min" default="0.0" doc="速度治理后的最低参考速度"/>
  <arg name="slosh_speed_governor_eta_deadband" default="0.3" doc="速度治理液面比例死区"/>
  <arg name="slosh_speed_governor_eta_exit_ratio" default="0.2" doc="速度治理退出阈值（滞回）"/>
  <arg name="slosh_speed_governor_preview_distance" default="1.0" doc="速度治理前方曲率预览长度"/>
  <arg name="slosh_speed_governor_min_active_steps" default="10" doc="速度治理最少保持周期数"/>
  <arg name="energy_profile_enable" default="false" doc="是否启用 PROFILE_ENERGY Step1 几何低激励速度剖面"/>
  <arg name="energy_profile_lat_accel" default="1.2" doc="PROFILE_ENERGY_GEO 横向加速度预算"/>
  <arg name="energy_profile_omega_max" default="1.1" doc="PROFILE_ENERGY_GEO 角速度预算"/>
  <arg name="energy_profile_alpha_max" default="3.0" doc="PROFILE_ENERGY_GEO 角加速度预算，含 ax*kappa"/>
  <arg name="energy_profile_ax_max" default="1.2" doc="PROFILE_ENERGY_GEO 切向加速度预算"/>
  <arg name="energy_profile_decel_max" default="1.2" doc="PROFILE_ENERGY_GEO 切向减速度预算"/>
  <arg name="energy_profile_min_v" default="0.35" doc="PROFILE_ENERGY_GEO 最低参考速度"/>
  <arg name="slosh_use_imu_lateral_accel" default="false" doc="是否使用 IMU 横向加速度替代 v*omega"/>
  <arg name="slosh_use_imu_yaw_rate" default="true" doc="当前默认安全配置：使用 IMU 角速度 z 替代 odom omega"/>
  <arg name="slosh_use_imu_alpha_z" default="false" doc="是否使用 IMU 角速度差分替代 alpha_z"/>
  <arg name="slosh_imu_topic" default="/imu/data" doc="IMU 话题"/>
  <arg name="slosh_imu_filter_alpha" default="0.3" doc="IMU 数据 EMA 滤波系数"/>
  <arg name="slosh_imu_ay_bias_compensation_enable" default="true" doc="是否对 IMU ay 做静止零偏扣除"/>
  <arg name="slosh_imu_ay_bias_init_duration" default="3.0" doc="估计 IMU ay 零偏所需的连续静止时长"/>
  <arg name="risk_scheduler_enable" default="false" doc="是否启用 rho_k 风险自适应调度器"/>
  <arg name="risk_scheduler_gamma" default="5.0" doc="rho_k sigmoid 斜率"/>
  <arg name="risk_scheduler_rho_0" default="0.3" doc="rho_k sigmoid 中点"/>
  <arg name="risk_scheduler_rate_limit_per_step" default="0.05" doc="Q_eta / eta_bar / v_eff 每步变化率限制"/>
  <arg name="risk_scheduler_beta" default="0.3" doc="高风险时 v_ref 最大折扣比例"/>
  <arg name="risk_scheduler_Q_eta_min" default="0.0" doc="低风险 Q_eta 下限"/>
  <arg name="risk_scheduler_Q_eta_max" default="10.0" doc="高风险 Q_eta 上限"/>
  <arg name="settling_eta_tol" default="0.0015" doc="SETTLING |eta| 收敛阈值 (m)"/>
  <arg name="settling_eta_dot_tol" default="0.03" doc="SETTLING |eta_dot| 收敛阈值 (m/s)"/>
  <arg name="settling_timeout_s" default="3.0" doc="SETTLING 最长停留时间 (s)"/>
  <arg name="input_shaping_enable" default="false" doc="是否启用 ISR/ZV input shaping baseline"/>
  <arg name="input_shaping_type" default="zv" doc="input shaping 类型，当前仅支持 zv"/>
  <arg name="input_shaping_use_model_params" default="true" doc="是否使用当前 slosh 模态参数生成 shaper"/>
  <arg name="input_shaping_omega0_override" default="0.0" doc="input shaping 频率覆盖值，非正时使用模型参数"/>
  <arg name="input_shaping_zeta_override" default="0.0" doc="input shaping 阻尼比覆盖值，非正时使用模型参数"/>
  <arg name="vehicle_v_max" default="3.0" doc="覆盖 vehicle/v_max；anti-slosh path candidate 可用 1.75 使 v_nominal=1.40"/>
  <arg name="cmd_vel_topic" default="/cmd_vel" doc="planner 输出的 cmd_vel 话题；阶段 3 可改到调试话题避免与底盘直控冲突"/>
  <arg name="global_path_topic" default="/scout/global_path" doc="local planner 订阅的全局路径话题；固定路径重放实验时可改到 /scout/global_path_fixed"/>

  <!-- ========== MPC 局部规划器 ========== -->
  <node pkg="scout_local_planner" type="local_planner_node"
        name="scout_local_planner" output="screen">

    <!-- 加载仿真基础参数 -->
    <rosparam file="$(find scout_local_planner)/config/mpc_params_sim.yaml"
              command="load"/>

    <!-- 实验参数覆盖 (YAML 之后、节点 init 之前) -->
    <param name="verbose" value="$(arg verbose)"/>
    <param name="mpc/Q_slosh" value="$(arg Q_slosh)"/>
    <param name="mpc/Q_slosh_eta_dot" value="$(arg Q_slosh_eta_dot)"/>
    <param name="mpc/Q_v" value="$(arg mpc_Q_v)"/>
    <param name="mpc/R_a" value="$(arg mpc_R_a)"/>
    <param name="mpc/R_da" value="$(arg mpc_R_da)"/>
    <param name="mpc/cmd_vel_lead_time" value="$(arg mpc_cmd_vel_lead_time)"/>
    <param name="mpc/terminal_factor_slosh_eta" value="$(arg terminal_factor_slosh_eta)"/>
    <param name="mpc/terminal_factor_slosh_eta_dot" value="$(arg terminal_factor_slosh_eta_dot)"/>
    <param name="mpc/enable_slosh_box_constraint" value="$(arg enable_slosh_box_constraint)"/>
    <param name="filter/alpha_v" value="$(arg filter_alpha_v)"/>
    <param name="filter/alpha_omega" value="$(arg filter_alpha_omega)"/>
    <param name="filter/kappa_boost" value="$(arg filter_kappa_boost)"/>
    <param name="experiment/reached_debug_duration" value="$(arg reached_debug_duration)"/>
    <param name="slosh_speed_governor/enable" value="$(arg slosh_speed_governor_enable)"/>
    <param name="slosh_speed_governor/k_eta" value="$(arg slosh_speed_governor_k_eta)"/>
    <param name="slosh_speed_governor/ay_max_base" value="$(arg slosh_speed_governor_ay_max_base)"/>
    <param name="slosh_speed_governor/v_des_min" value="$(arg slosh_speed_governor_v_des_min)"/>
    <param name="slosh_speed_governor/eta_deadband" value="$(arg slosh_speed_governor_eta_deadband)"/>
    <param name="slosh_speed_governor/eta_exit_ratio" value="$(arg slosh_speed_governor_eta_exit_ratio)"/>
    <param name="slosh_speed_governor/preview_distance" value="$(arg slosh_speed_governor_preview_distance)"/>
    <param name="slosh_speed_governor/min_active_steps" value="$(arg slosh_speed_governor_min_active_steps)"/>
    <param name="path_handler/energy_profile_enable" value="$(arg energy_profile_enable)"/>
    <param name="path_handler/energy_profile_lat_accel" value="$(arg energy_profile_lat_accel)"/>
    <param name="path_handler/energy_profile_omega_max" value="$(arg energy_profile_omega_max)"/>
    <param name="path_handler/energy_profile_alpha_max" value="$(arg energy_profile_alpha_max)"/>
    <param name="path_handler/energy_profile_ax_max" value="$(arg energy_profile_ax_max)"/>
    <param name="path_handler/energy_profile_decel_max" value="$(arg energy_profile_decel_max)"/>
    <param name="path_handler/energy_profile_min_v" value="$(arg energy_profile_min_v)"/>
    <param name="slosh_estimator/use_imu_lateral_accel" value="$(arg slosh_use_imu_lateral_accel)"/>
    <param name="slosh_estimator/use_imu_yaw_rate" value="$(arg slosh_use_imu_yaw_rate)"/>
    <param name="slosh_estimator/use_imu_alpha_z" value="$(arg slosh_use_imu_alpha_z)"/>
    <param name="slosh_estimator/imu_topic" value="$(arg slosh_imu_topic)"/>
    <param name="slosh_estimator/imu_filter_alpha" value="$(arg slosh_imu_filter_alpha)"/>
    <param name="slosh_estimator/imu_ay_bias_compensation_enable" value="$(arg slosh_imu_ay_bias_compensation_enable)"/>
    <param name="slosh_estimator/imu_ay_bias_init_duration" value="$(arg slosh_imu_ay_bias_init_duration)"/>
    <param name="risk_scheduler/enable" value="$(arg risk_scheduler_enable)"/>
    <param name="risk_scheduler/gamma" value="$(arg risk_scheduler_gamma)"/>
    <param name="risk_scheduler/rho_0" value="$(arg risk_scheduler_rho_0)"/>
    <param name="risk_scheduler/rate_limit_per_step" value="$(arg risk_scheduler_rate_limit_per_step)"/>
    <param name="risk_scheduler/beta" value="$(arg risk_scheduler_beta)"/>
    <param name="risk_scheduler/Q_eta_min" value="$(arg risk_scheduler_Q_eta_min)"/>
    <param name="risk_scheduler/Q_eta_max" value="$(arg risk_scheduler_Q_eta_max)"/>
    <param name="settling/eta_tol" value="$(arg settling_eta_tol)"/>
    <param name="settling/eta_dot_tol" value="$(arg settling_eta_dot_tol)"/>
    <param name="settling/timeout_s" value="$(arg settling_timeout_s)"/>
    <param name="input_shaping/enable" value="$(arg input_shaping_enable)"/>
    <param name="input_shaping/type" value="$(arg input_shaping_type)"/>
    <param name="input_shaping/use_model_params" value="$(arg input_shaping_use_model_params)"/>
    <param name="input_shaping/omega0_override" value="$(arg input_shaping_omega0_override)"/>
    <param name="input_shaping/zeta_override" value="$(arg input_shaping_zeta_override)"/>
    <param name="vehicle/v_max" value="$(arg vehicle_v_max)"/>

    <!-- 话题 remap -->
    <remap from="global_path" to="$(arg global_path_topic)"/>
    <remap from="odom"        to="/odom"/>
    <remap from="cmd_vel"     to="$(arg cmd_vel_topic)"/>
  </node>

</launch>
