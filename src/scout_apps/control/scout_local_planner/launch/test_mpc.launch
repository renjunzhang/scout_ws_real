<!-- Scout Mini MPC 局部规划器启动文件 -->
<!-- 
  使用说明：
  1. 先启动底盘、雷达、定位
  2. 启动全局规划：roslaunch scout_global_planner move_base_global.launch
  3. 再启动本 launch 文件
-->
<launch>
  <!-- 参数 -->
  <arg name="verbose" default="false" doc="是否输出调试信息"/>
  <arg name="Q_slosh" default="0.0" doc="晃动抑制权重 (0=关闭, 建议实验值: 5/10/20)"/>
  <arg name="filter_alpha_v" default="1.0" doc="实验口径: 线速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_alpha_omega" default="1.0" doc="实验口径: 角速度 EMA 系数，1.0 表示关闭额外低通"/>
  <arg name="filter_kappa_boost" default="0.0" doc="实验口径: 关闭曲率自适应 EMA 增益"/>
  
  <!-- ========== MPC 局部规划器（独立节点）========== -->
  <node pkg="scout_local_planner" type="local_planner_node" 
        name="scout_local_planner" output="screen">
    <!-- 加载参数 -->
    <rosparam file="$(find scout_local_planner)/config/mpc_params.yaml" 
              command="load"/>
    
    <!-- 覆盖 verbose 参数 -->
    <param name="verbose" value="$(arg verbose)"/>
    
    <!-- 实验参数覆盖：Q_slosh 在 YAML 加载后覆盖，确保在节点 init 前生效 -->
    <param name="mpc/Q_slosh" value="$(arg Q_slosh)"/>
    <param name="filter/alpha_v" value="$(arg filter_alpha_v)"/>
    <param name="filter/alpha_omega" value="$(arg filter_alpha_omega)"/>
    <param name="filter/kappa_boost" value="$(arg filter_kappa_boost)"/>
    
    <!-- 话题 remap -->
    <remap from="global_path" to="/scout/global_path"/>
    <remap from="odom" to="/odom"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node>
        
</launch>
