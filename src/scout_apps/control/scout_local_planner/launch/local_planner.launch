<launch>
  <!-- Scout 局部规划器 (MPC + 液体晃动抑制) -->

  <arg name="config_file" default="$(find scout_local_planner)/config/local_planner.yaml"/>

  <node name="scout_local_planner" pkg="scout_local_planner" type="scout_local_planner_node" output="screen">
    <rosparam file="$(arg config_file)" command="load"/>

    <!-- 话题重映射 -->
    <remap from="odom" to="/odom"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
    <remap from="global_path" to="/move_base/NavfnROS/plan"/>
  </node>

</launch>
