<?xml version="1.0"?>
<package format="2">
  <name>spmpc_experiments</name>
  <version>0.0.1</version>
  <description>Experiment launch and recording utilities for SPMPC and external local-planner baselines.</description>

  <maintainer email="geist@example.com">geist</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>scout_global_planner</exec_depend>
  <exec_depend>scout_local_planner</exec_depend>
  <exec_depend>spmpc_local_planner</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
</package>
