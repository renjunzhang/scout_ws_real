<launch>
  <arg name="global_path_topic" default="/scout/global_path_fixed"/>
  <arg name="goal_topic" default="/scout/goal"/>
  <arg name="cmd_vel_topic" default="/benchmark/cmd_vel_raw"/>
  <arg name="publish_cmd_vel" default="false"/>
  <arg name="enable_actuated_output" default="false"/>
  <arg name="publish_benchmark_raw" default="false"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="map_topic" default="/map"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="plan_target_frame" default="map"/>
  <arg name="planning_frequency" default="5.0"/>
  <arg name="command_publish_frequency" default="30.0"/>
  <arg name="command_stale_timeout_sec" default="0.6"/>
  <arg name="worker_timeout_sec" default="1.0"/>
  <arg name="max_v" default="0.8"/>
  <arg name="min_v" default="0.0"/>
  <arg name="max_w" default="1.2"/>
  <arg name="max_acc" default="0.6"/>
  <arg name="max_angular_acc" default="1.2"/>
  <arg name="robot_radius" default="0.3"/>
  <arg name="time_step" default="0.2"/>
  <arg name="path_resample_spacing" default="0.10"/>
  <arg name="enable_path_tracking_guard" default="true"/>
  <arg name="path_tracking_lookahead_m" default="0.75"/>
  <arg name="path_tracking_min_v" default="0.18"/>
  <arg name="scout_ws_root" default="$(optenv SCOUT_WS_ROOT /home/a/scout_ws)"/>
  <arg name="runtime_request_dir" default="/tmp"/>

  <include file="$(find lt_dwa_official_wrapper)/launch/scout_sop_cmd_vel_benchmark.launch">
    <arg name="input_odom_topic" value="$(arg odom_topic)"/>
    <arg name="map_topic" value="$(arg map_topic)"/>
    <arg name="map_frame_odom_topic" value="/baseline/lt_dwa/odom_map"/>
    <arg name="path_topic" value="$(arg global_path_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="shadow_cmd_topic" value="/baseline/lt_dwa/shadow_cmd_vel"/>
    <arg name="status_topic" value="/baseline/lt_dwa/status"/>
    <arg name="diagnostics_topic" value="/baseline/lt_dwa/diagnostics"/>
    <arg name="global_plan_topic" value="/baseline/lt_dwa/global_plan"/>
    <arg name="local_plan_topic" value="/baseline/lt_dwa/local_plan"/>
    <arg name="worker_result_topic" value="/baseline/lt_dwa/worker_result"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="benchmark_raw_topic" value="/benchmark/cmd_vel_raw"/>
    <arg name="enable_actuated_output" value="$(arg enable_actuated_output)"/>
    <arg name="publish_cmd_vel" value="$(arg publish_cmd_vel)"/>
    <arg name="publish_benchmark_raw" value="$(arg publish_benchmark_raw)"/>
    <arg name="planner_rate_hz" value="$(arg planning_frequency)"/>
    <arg name="command_publish_rate_hz" value="$(arg command_publish_frequency)"/>
    <arg name="command_stale_timeout_sec" value="$(arg command_stale_timeout_sec)"/>
    <arg name="worker_timeout_sec" value="$(arg worker_timeout_sec)"/>
    <arg name="max_v" value="$(arg max_v)"/>
    <arg name="min_v" value="$(arg min_v)"/>
    <arg name="max_w" value="$(arg max_w)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="max_angular_acc" value="$(arg max_angular_acc)"/>
    <arg name="robot_radius" value="$(arg robot_radius)"/>
    <arg name="time_step" value="$(arg time_step)"/>
    <arg name="path_resample_spacing" value="$(arg path_resample_spacing)"/>
    <arg name="enable_path_tracking_guard" value="$(arg enable_path_tracking_guard)"/>
    <arg name="path_tracking_lookahead_m" value="$(arg path_tracking_lookahead_m)"/>
    <arg name="path_tracking_min_v" value="$(arg path_tracking_min_v)"/>
    <arg name="scout_ws_root" value="$(arg scout_ws_root)"/>
    <arg name="runtime_request_dir" value="$(arg runtime_request_dir)"/>
  </include>
</launch>
