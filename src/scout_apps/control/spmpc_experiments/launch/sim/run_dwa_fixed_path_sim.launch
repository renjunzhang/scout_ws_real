<launch>
  <arg name="global_path_topic" default="/scout/global_path_fixed"/>
  <arg name="goal_topic" default="/scout/goal"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <include file="$(find baseline_local_planner_runner)/launch/nav_core_runner.launch">
    <arg name="plugin_type" value="dwa_local_planner/DWAPlannerROS"/>
    <arg name="plugin_name" value="DWAPlannerROS"/>
    <arg name="global_path_topic" value="$(arg global_path_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="status_topic" value="/baseline/dwa/status"/>
    <arg name="global_plan_topic" value="/baseline/dwa/global_plan"/>
    <arg name="plan_target_frame" value="odom"/>
    <arg name="force_straight_plan_on_goal" value="false"/>
    <arg name="use_wrapper_goal_check" value="true"/>
    <arg name="latch_goal_reached" value="true"/>
    <arg name="planner_config" value="$(find spmpc_experiments)/config/baselines/dwa_local_planner_standalone_sim.yaml"/>
  </include>
</launch>
