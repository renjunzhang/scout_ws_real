<launch>
  <arg name="global_path_topic" default="/scout/global_path_fixed"/>
  <arg name="goal_topic" default="/scout/goal"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="controller_frequency" default="10.0"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="plan_target_frame" default="odom"/>
  <arg name="max_cmd_vel_x" default="0.8"/>
  <arg name="max_cmd_vel_theta" default="1.2"/>
  <arg name="xy_goal_tolerance" default="0.20"/>
  <arg name="yaw_goal_tolerance" default="0.30"/>
  <arg name="planner_config" default="$(find spmpc_experiments)/config/baselines/mpc_local_planner_fixed_path_tuned_sim.yaml"/>
  <arg name="costmap_config" default="$(find baseline_local_planner_runner)/config/local_costmap_sim.yaml"/>

  <include file="$(find baseline_local_planner_runner)/launch/nav_core_runner.launch">
    <arg name="plugin_type" value="mpc_local_planner/MpcLocalPlannerROS"/>
    <arg name="plugin_name" value="MpcLocalPlannerROS"/>
    <arg name="global_path_topic" value="$(arg global_path_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="status_topic" value="/baseline/mpc_local_planner/status"/>
    <arg name="global_plan_topic" value="/baseline/mpc_local_planner/global_plan"/>
    <arg name="controller_frequency" value="$(arg controller_frequency)"/>
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="plan_target_frame" value="$(arg plan_target_frame)"/>
    <arg name="max_cmd_vel_x" value="$(arg max_cmd_vel_x)"/>
    <arg name="max_cmd_vel_theta" value="$(arg max_cmd_vel_theta)"/>
    <arg name="xy_goal_tolerance" value="$(arg xy_goal_tolerance)"/>
    <arg name="yaw_goal_tolerance" value="$(arg yaw_goal_tolerance)"/>
    <arg name="force_straight_plan_on_goal" value="false"/>
    <arg name="use_wrapper_goal_check" value="true"/>
    <arg name="latch_goal_reached" value="true"/>
    <arg name="planner_config" value="$(arg planner_config)"/>
    <arg name="costmap_config" value="$(arg costmap_config)"/>
  </include>
</launch>
