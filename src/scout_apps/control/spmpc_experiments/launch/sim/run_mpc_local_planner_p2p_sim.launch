<launch>
  <arg name="global_path_topic" default="/scout/global_path_fixed"/>
  <arg name="goal_topic" default="/scout/goal"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <include file="$(find baseline_local_planner_runner)/launch/nav_core_runner.launch">
    <arg name="plugin_type" value="mpc_local_planner/MpcLocalPlannerROS"/>
    <arg name="plugin_name" value="MpcLocalPlannerROS"/>
    <arg name="global_path_topic" value="$(arg global_path_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <arg name="status_topic" value="/baseline/mpc_local_planner/status"/>
    <arg name="global_plan_topic" value="/baseline/mpc_local_planner/global_plan"/>
    <arg name="planner_config" value="$(find spmpc_experiments)/config/baselines/mpc_local_planner_standalone_sim.yaml"/>
  </include>
</launch>
