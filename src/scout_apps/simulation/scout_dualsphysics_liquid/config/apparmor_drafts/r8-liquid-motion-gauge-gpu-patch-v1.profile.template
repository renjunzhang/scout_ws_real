# Static create-new template.  NOT LOADABLE AS-IS.
abi <abi/4.0>,
include <tunables/global>

profile @@PROFILE_NAME@@ flags=(attach_disconnected,mediate_deleted) {
  userns create,
  /usr/bin/bwrap rix,
  /usr/bin/env rix,
  /usr/bin/prlimit rix,
  /usr/bin/python3 rix,
  /usr/bin/python3.12 rix,
  @@PATCH_HELPER@@ rix,

  /usr/ r,
  /usr/lib/** mr,
  /usr/lib64/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/ld.so.cache r,
  @@SOURCE_ROOT@@/ r,
  @@SOURCE_ROOT@@/** r,
  @@SOURCE_ROOT@@/JDsGaugeItem.cpp rw,
  @@SOURCE_ROOT@@/JDsGaugeItem.h rw,
  @@SOURCE_ROOT@@/JDsGaugeSystem.cpp rw,
  @@SOURCE_ROOT@@/JDsGaugeSystem.h rw,
  @@SOURCE_ROOT@@/JSph.cpp rw,
  @@SOURCE_ROOT@@/JSph.h rw,

  owner /proc/** r,
  owner /proc/*/uid_map w,
  owner /proc/*/gid_map w,
  owner /proc/*/setgroups w,
  /proc/filesystems r,
  /proc/sys/kernel/overflowuid r,
  /proc/sys/kernel/overflowgid r,
  /dev/null rw,
  /dev/zero r,
  /dev/urandom r,

  mount options=(rw, silent, rslave) -> /,
  mount fstype=tmpfs options=(rw, nosuid, nodev) -> /tmp/,
  mount options=(rw, rbind) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  umount /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /,
  mount options=(rw, rbind) /oldroot/usr/ -> /newroot/usr/,
  remount options=(ro, nosuid, nodev, bind, silent, relatime) /newroot/usr/,
  mount fstype=tmpfs options=(rw, nosuid, nodev) -> /newroot/work/,
  mount options=(rw, rbind) /oldroot@@SOURCE_ROOT@@/ -> /newroot/work/source/,
  remount options=(rw, nosuid, nodev, bind, silent, relatime) /newroot/work/source/,
  /tmp/newroot/ rw,
  /tmp/newroot/** rw,
  /tmp/oldroot/ rw,
  /tmp/oldroot/** rw,
  /newroot/usr/ rw,
  /newroot/lib wl,
  /newroot/lib64 wl,
  /newroot/work/ rw,
  /newroot/work/source/ rw,
  /work/source/ r,
  /work/source/** r,
  /work/source/JDsGaugeItem.cpp rw,
  /work/source/JDsGaugeItem.h rw,
  /work/source/JDsGaugeSystem.cpp rw,
  /work/source/JDsGaugeSystem.h rw,
  /work/source/JSph.cpp rw,
  /work/source/JSph.h rw,
  capability sys_admin,
  capability sys_ptrace,
  capability sys_resource,
  capability setpcap,
  signal (send, receive) peer=@@PROFILE_NAME@@,
  ptrace (read, readby) peer=@@PROFILE_NAME@@,
  network unix dgram,
  network netlink raw,

  # The six explicit files are the only host source paths with write permission.
  # No compiler, candidate, GPU device, inet/inet6, or sealed-source access.
}
