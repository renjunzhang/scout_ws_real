{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_u3_gpu_stage4_run_policy_v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "run_id", "purpose", "status", "claim_ceiling", "parents", "tools", "gpu", "inputs", "restart", "solver", "sandbox", "run", "expected_output", "limits", "single_delta"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-u3-gpu-stage4-run-policy-v3"},
    "document_type": {"const": "SMPCC_R8_LIQUID_U3_GPU_STAGE4_RUN_POLICY_V3"},
    "run_id": {"type": "string", "pattern": "^u3_[a-z0-9_]{8,96}_v[0-9]+$"},
    "purpose": {"enum": ["remediation_probe", "cold_a", "cold_b", "restart_equivalence", "cpu_gpu_parity_gpu", "synthetic_zero", "synthetic_translation", "synthetic_yaw", "synthetic_free_decay", "cfl_sensitivity"]},
    "status": {"const": "FROZEN_PENDING_EXACTLY_ONE_GPU_RUN"},
    "claim_ceiling": {"const": "DEVELOPMENT_ONLY_SOFTWARE_NUMERICAL_NOT_PHYSICAL_FIDELITY"},
    "parents": {"$ref": "#/$defs/parents"},
    "tools": {"$ref": "#/$defs/tools"},
    "gpu": {"$ref": "#/$defs/gpu"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "restart": {"$ref": "#/$defs/restart"},
    "solver": {"$ref": "#/$defs/solver"},
    "sandbox": {"$ref": "#/$defs/sandbox"},
    "run": {"$ref": "#/$defs/run"},
    "expected_output": {"$ref": "#/$defs/expectedOutput"},
    "limits": {"$ref": "#/$defs/limits"},
    "single_delta": {"$ref": "#/$defs/singleDelta"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "parentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "mode", "inode", "nlink"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "inode": {"type": "integer", "minimum": 1},
        "nlink": {"const": 1}
      }
    },
    "parents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "build_receipt", "static_audit_receipt", "stage3_postvalidation", "numerical_contract", "prior_gpu_final", "prior_gpu_qc", "runner", "schema"],
      "properties": {
        "plan": {"$ref": "#/$defs/parentIdentity"},
        "build_receipt": {"$ref": "#/$defs/parentIdentity"},
        "static_audit_receipt": {"$ref": "#/$defs/parentIdentity"},
        "stage3_postvalidation": {"$ref": "#/$defs/parentIdentity"},
        "numerical_contract": {"$ref": "#/$defs/parentIdentity"},
        "prior_gpu_final": {"$ref": "#/$defs/parentIdentity"},
        "prior_gpu_qc": {"$ref": "#/$defs/parentIdentity"},
        "runner": {"$ref": "#/$defs/parentIdentity"},
        "schema": {"$ref": "#/$defs/parentIdentity"}
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bwrap", "nvidia_smi", "python", "sudo"],
      "properties": {
        "bwrap": {"$ref": "#/$defs/toolIdentity"},
        "nvidia_smi": {"$ref": "#/$defs/toolIdentity"},
        "python": {"$ref": "#/$defs/toolIdentity"},
        "sudo": {"$ref": "#/$defs/toolIdentity"}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "uuid", "pci_bus_id", "name", "driver_version", "device_paths"],
      "properties": {
        "index": {"const": 0},
        "uuid": {"const": "GPU-d29cd22d-8b25-8f4e-9dcf-f2fc4bb113fb"},
        "pci_bus_id": {"const": "00000000:01:00.0"},
        "name": {"const": "NVIDIA GeForce RTX 5080 Laptop GPU"},
        "driver_version": {"const": "580.173.02"},
        "device_paths": {
          "type": "array",
          "prefixItems": [
            {"const": "/dev/nvidia0"},
            {"const": "/dev/nvidiactl"},
            {"const": "/dev/nvidia-uvm"},
            {"const": "/dev/nvidia-uvm-tools"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "dsph_config", "case_bi4", "case_xml", "restart_part", "restart_head"],
      "properties": {
        "candidate": {"$ref": "#/$defs/fileIdentity"},
        "dsph_config": {"$ref": "#/$defs/fileIdentity"},
        "case_bi4": {"$ref": "#/$defs/fileIdentity"},
        "case_xml": {"$ref": "#/$defs/fileIdentity"},
        "restart_part": {"oneOf": [{"$ref": "#/$defs/fileIdentity"}, {"type": "null"}]},
        "restart_head": {"oneOf": [{"$ref": "#/$defs/fileIdentity"}, {"type": "null"}]}
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "part_index", "part_first", "guest_dir"],
      "properties": {
        "enabled": {"type": "boolean"},
        "part_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "part_first": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "guest_dir": {"enum": ["/restart", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"properties": {"part_index": {"type": "integer"}, "part_first": {"type": "integer"}, "guest_dir": {"const": "/restart"}}},
          "else": {"properties": {"part_index": {"type": "null"}, "part_first": {"type": "null"}, "guest_dir": {"type": "null"}}}
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "PATH", "LC_ALL", "LANG", "TZ", "TMPDIR", "OMP_NUM_THREADS", "OMP_DYNAMIC", "CUDA_VISIBLE_DEVICES"],
      "properties": {
        "HOME": {"const": "/nonexistent"},
        "PATH": {"const": "/usr/bin"},
        "LC_ALL": {"const": "C"},
        "LANG": {"const": "C"},
        "TZ": {"const": "UTC0"},
        "TMPDIR": {"const": "/tmp"},
        "OMP_NUM_THREADS": {"const": "1"},
        "OMP_DYNAMIC": {"const": "FALSE"},
        "CUDA_VISIBLE_DEVICES": {"const": "0"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment", "expected_particles", "expected_moving", "expected_fluid"],
      "properties": {
        "argv": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "minItems": 18,
          "maxItems": 32
        },
        "environment": {"$ref": "#/$defs/environment"},
        "expected_particles": {"const": 9078},
        "expected_moving": {"const": 2669},
        "expected_fluid": {"const": 6409}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "stage_root", "network", "guest_uid", "guest_gid", "guest_groups", "guest_cap_eff", "host_write_bind_count", "project_workspace_write_bind_count", "apparmor_profile_used", "preserve_stage"],
      "properties": {
        "model": {"const": "ROOT_ONLY_VAR_TMP_TRANSPORT_TO_UID1000_CAP0_BWRAP_NETNS_TO_O_EXCL_LAB_EXPORT"},
        "stage_root": {"type": "string", "pattern": "^/var/tmp/r8-liquid-u3-stage4-u3-[a-z0-9-]+-v[0-9]+$"},
        "network": {"const": false},
        "guest_uid": {"const": 1000},
        "guest_gid": {"const": 1000},
        "guest_groups": {"type": "array", "prefixItems": [{"const": 1000}], "items": false, "minItems": 1, "maxItems": 1},
        "guest_cap_eff": {"const": "0000000000000000"},
        "host_write_bind_count": {"const": 1},
        "project_workspace_write_bind_count": {"const": 0},
        "apparmor_profile_used": {"const": false},
        "preserve_stage": {"const": true}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_root", "output_root", "start_receipt", "final_receipt", "failure_receipt", "stdout_log", "stderr_log", "resource_log"],
      "properties": {
        "attempt_root": {"$ref": "#/$defs/absolutePath"},
        "output_root": {"$ref": "#/$defs/absolutePath"},
        "start_receipt": {"$ref": "#/$defs/absolutePath"},
        "final_receipt": {"$ref": "#/$defs/absolutePath"},
        "failure_receipt": {"$ref": "#/$defs/absolutePath"},
        "stdout_log": {"$ref": "#/$defs/absolutePath"},
        "stderr_log": {"$ref": "#/$defs/absolutePath"},
        "resource_log": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_time_s", "end_time_s", "output_period_s", "part_first", "part_last", "part_count", "maximum_output_bytes"],
      "properties": {
        "start_time_s": {"type": "number", "minimum": 0, "maximum": 120},
        "end_time_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "output_period_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "part_first": {"type": "integer", "minimum": 0, "maximum": 9999},
        "part_last": {"type": "integer", "minimum": 0, "maximum": 9999},
        "part_count": {"type": "integer", "minimum": 2, "maximum": 2401},
        "maximum_output_bytes": {"type": "integer", "minimum": 1048576, "maximum": 536870912}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_timeout_seconds", "kill_after_seconds", "monitor_interval_seconds", "minimum_mem_available_bytes", "maximum_output_bytes"],
      "properties": {
        "wall_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "kill_after_seconds": {"type": "integer", "minimum": 5, "maximum": 30},
        "monitor_interval_seconds": {"type": "integer", "minimum": 10, "maximum": 30},
        "minimum_mem_available_bytes": {"type": "integer", "minimum": 4294967296},
        "maximum_output_bytes": {"type": "integer", "minimum": 1048576, "maximum": 536870912}
      }
    },
    "singleDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "baseline", "candidate", "other_numerical_parameters_changed"],
      "properties": {
        "parameter": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "baseline": {"type": "string", "minLength": 1, "maxLength": 256},
        "candidate": {"type": "string", "minLength": 1, "maxLength": 256},
        "other_numerical_parameters_changed": {"const": false}
      }
    }
  }
}
