{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_motion_gauge_gpu_build_authorization_token_v11.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "created_at", "authorization_reference", "authorization_reference_sha256", "policy", "gate", "supervisor", "supervisor_receipt_schema", "token_producer", "profiles", "user_authorized"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-motion-gauge-gpu-build-authorization-token-v11"},
    "campaign_id": {"const": "motion_gauge_gpu_build_sm120_20260812T073037Z_v11"},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 64},
    "authorization_reference": {"type": "string", "minLength": 16, "maxLength": 4096},
    "authorization_reference_sha256": {"$ref": "#/$defs/hash"},
    "policy": {"$ref": "#/$defs/file_identity"}, "gate": {"$ref": "#/$defs/file_identity"},
    "supervisor": {"$ref": "#/$defs/file_identity"}, "supervisor_receipt_schema": {"$ref": "#/$defs/file_identity"},
    "token_producer": {"$ref": "#/$defs/file_identity"},
    "profiles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/profile_identity"}},
    "user_authorized": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "mode_octal", "size_bytes", "sha256"],
      "properties": {"path": {"type": "string"}, "mode_octal": {"pattern": "^[0-7]{4}$"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "profile_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "name", "path", "mode_octal", "size_bytes", "sha256"],
      "properties": {"role": {"enum": ["SOURCE_COPY", "PATCH", "BUILD", "STATIC_AUDIT"]}, "name": {"type": "string"}, "path": {"type": "string"}, "mode_octal": {"const": "0644"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}
    }
  }
}
