{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_primary_comparison_result_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "attempt_id", "planned_denominator", "parents", "profile", "surface_metrics", "model_comparisons", "alignment", "visualization", "delivery", "evidence_index", "secondary_ledger", "claims"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-primary-comparison-result-v1"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_PRIMARY_COMPARISON_RESULT_V1"},
    "status": {"const": "S6_PRIMARY_SYNTHETIC_STATIC_COMPARISON_VALIDATED_NOT_FINAL"},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"},
    "planned_denominator": {"const": 1},
    "parents": {"type": "object", "additionalProperties": false, "required": ["selected_signals", "finalized_replay"], "properties": {"selected_signals": {"$ref": "#/$defs/syntheticParent"}, "finalized_replay": {"$ref": "#/$defs/syntheticParent"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["row_count", "missing_values", "time_min_s", "time_max_s", "strict_time"], "properties": {"row_count": {"type": "integer", "minimum": 4}, "missing_values": {"const": 0}, "time_min_s": {"type": "number"}, "time_max_s": {"type": "number"}, "strict_time": {"const": true}}},
    "surface_metrics": {"type": "object", "additionalProperties": false, "required": ["H_crest", "H_abs", "H_peak_to_peak"], "properties": {"H_crest": {"$ref": "#/$defs/seriesMetrics"}, "H_abs": {"$ref": "#/$defs/seriesMetrics"}, "H_peak_to_peak": {"$ref": "#/$defs/seriesMetrics"}}},
    "model_comparisons": {"type": "object", "additionalProperties": false, "required": ["H_proxy", "H_modal"], "properties": {"H_proxy": {"$ref": "#/$defs/comparisonMetrics"}, "H_modal": {"$ref": "#/$defs/comparisonMetrics"}}},
    "alignment": {"type": "object", "additionalProperties": false, "required": ["x_axis", "grid_source", "interpolation", "extrapolation", "smoothing", "sample_count"], "properties": {"x_axis": {"const": "time_since_odom_header_origin_s"}, "grid_source": {"const": "FINALIZED_REPLAY_OUTPUT_SLOTS"}, "interpolation": {"const": "LINEAR_WITHIN_OVERLAP_ONLY"}, "extrapolation": {"const": false}, "smoothing": {"const": false}, "sample_count": {"type": "integer", "minimum": 4}}},
    "visualization": {"type": "object", "additionalProperties": false, "required": ["layout", "shared_x", "axes_count", "dual_y_axes", "palette", "redundant_line_styles", "rainbow_colormap", "grayscale_review", "layout_audit", "final_figure_generated"], "properties": {"layout": {"const": "THREE_VERTICAL_SHARED_X_PANELS"}, "shared_x": {"const": true}, "axes_count": {"const": 3}, "dual_y_axes": {"const": false}, "palette": {"const": "OKABE_ITO_COLORBLIND_SAFE"}, "redundant_line_styles": {"const": true}, "rainbow_colormap": {"const": false}, "grayscale_review": {"const": true}, "layout_audit": {"const": "REQUIRED_BEFORE_MATERIALIZATION"}, "final_figure_generated": {"const": false}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["write_semantics", "artifacts_materialized", "planned_inventory", "animation_interface"], "properties": {"write_semantics": {"const": "CREATE_NEW_ONLY"}, "artifacts_materialized": {"const": false}, "planned_inventory": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}}, "animation_interface": {"type": "object", "additionalProperties": false, "required": ["source", "mp4", "gif", "keyframes", "encoder_executed"], "properties": {"source": {"const": "FINALIZED_SOLVER_FRAMES_ONLY"}, "mp4": {"const": "animation/primary.mp4"}, "gif": {"const": "animation/primary_preview.gif"}, "keyframes": {"const": ["keyframes/primary_t000.png"]}, "encoder_executed": {"const": false}}}}},
    "evidence_index": {"type": "object", "additionalProperties": false, "required": ["status", "entries", "checksums_path"], "properties": {"status": {"const": "PLANNED_NOT_MATERIALIZED"}, "entries": {"const": []}, "checksums_path": {"const": "checksums.sha256"}}},
    "secondary_ledger": {"type": "object", "additionalProperties": false, "required": ["status", "path", "append_performed"], "properties": {"status": {"const": "PLANNED_NOT_APPENDED"}, "path": {"const": "secondary_ledger_entry.json"}, "append_performed": {"const": false}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["stage6_pass", "paired_ranking", "cpu_selected_trajectory_comparison", "physical_reference_pending", "physical_fidelity_validated", "formal", "production"], "properties": {"stage6_pass": {"const": false}, "paired_ranking": {"const": false}, "cpu_selected_trajectory_comparison": {"const": false}, "physical_reference_pending": {"const": true}, "physical_fidelity_validated": {"const": false}, "formal": {"const": false}, "production": {"const": false}}}
  },
  "$defs": {
    "syntheticParent": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "real_parent_materialized"], "properties": {"kind": {"type": "string", "pattern": "^SYNTHETIC_"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "real_parent_materialized": {"const": false}}},
    "seriesMetrics": {"type": "object", "additionalProperties": false, "required": ["amplitude_peak_mm", "dominant_frequency_hz", "damping_rate_per_s", "phase_rad"], "properties": {"amplitude_peak_mm": {"type": "number", "minimum": 0}, "dominant_frequency_hz": {"type": "number", "minimum": 0}, "damping_rate_per_s": {"type": "number"}, "phase_rad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}}},
    "comparisonMetrics": {"type": "object", "additionalProperties": false, "required": ["sample_count", "amplitude_error_mm", "frequency_error_hz", "damping_error_per_s", "phase_error_rad", "rmse_mm", "correlation"], "properties": {"sample_count": {"type": "integer", "minimum": 4}, "amplitude_error_mm": {"type": "number"}, "frequency_error_hz": {"type": "number"}, "damping_error_per_s": {"type": "number"}, "phase_error_rad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}, "rmse_mm": {"type": "number", "minimum": 0}, "correlation": {"type": "number", "minimum": -1, "maximum": 1}}}
  }
}
