{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_u3_extended_settling_qc_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "captured_at_utc", "inputs", "contract", "run", "verdict"],
