    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "settled_state", "failed_metrics", "numerical_rebound_detected", "next", "development_only", "formal", "physical_primary_eligible", "solver_executed_by_this_tool", "inputs_modified"],
      "properties": {
        "status": {"enum": ["PASS_U3_EXTENDED_SETTLING", "FAIL_U3_EXTENDED_SETTLING_NUMERICAL_STABILITY"]},
        "settled_state": {"type": "boolean"},
        "failed_metrics": {"type": "array", "items": {"$ref": "#/$defs/metricName"}, "uniqueItems": true, "maxItems": 17},
        "numerical_rebound_detected": {"type": "boolean"},
        "next": {"enum": ["S4C_REPEATABILITY", "CFL_0P1_SENSITIVITY_OR_STOP"]},
        "development_only": {"const": true},
        "formal": {"const": false},
        "physical_primary_eligible": {"const": false},
        "solver_executed_by_this_tool": {"const": false},
        "inputs_modified": {"const": false}
      }
