    "ledger": {"type": "object", "additionalProperties": false, "required": ["append_performed", "entry_sha256", "previous_entry_sha256"], "properties": {"append_performed": {"type": "boolean"}, "entry_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "previous_entry_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["exact_parent", "primary_bag_read", "sixteen_gauge_csv", "finalized_bi4_frames", "analysis_complete", "figure_complete", "media_complete_decode", "inventory_complete", "optional_unread"], "properties": {"exact_parent": {"type": "boolean"}, "primary_bag_read": {"type": "boolean"}, "sixteen_gauge_csv": {"type": "boolean"}, "finalized_bi4_frames": {"type": "boolean"}, "analysis_complete": {"type": "boolean"}, "figure_complete": {"type": "boolean"}, "media_complete_decode": {"type": "boolean"}, "inventory_complete": {"type": "boolean"}, "optional_unread": {"const": true}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["stage6_pass", "development_only", "physical_reference_pending", "physical_fidelity_validated", "paired_ranking", "cross_method_ranking", "selected_trajectory_cpu_comparison", "formal", "production", "physical_primary"], "properties": {"stage6_pass": {"type": "boolean"}, "development_only": {"const": true}, "physical_reference_pending": {"const": true}, "physical_fidelity_validated": {"const": false}, "paired_ranking": {"const": false}, "cross_method_ranking": {"const": false}, "selected_trajectory_cpu_comparison": {"const": false}, "formal": {"const": false}, "production": {"const": false}, "physical_primary": {"const": false}}}
