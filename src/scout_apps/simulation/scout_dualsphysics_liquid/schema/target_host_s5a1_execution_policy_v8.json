{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s5a1_execution_policy_v8.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "execution_id", "transfer_id",
    "parent_v7", "base_v6_policy", "extractor_v4", "extractor_v4_tests",
    "package_v4", "v8_contract", "preserved_v6", "sandbox", "safety"
  ],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s5a1-execution-policy-v8"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S5A1_EXECUTION_POLICY_V8"},
    "execution_id": {"const": "s5a1_primary_bsmooth_b01_20260811T221159Z_v8"},
    "transfer_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01_r8_liquid_handoff_v3_v4"},
    "parent_v7": {"$ref": "#/$defs/parentV7"},
    "base_v6_policy": {"$ref": "#/$defs/file"},
    "extractor_v4": {"$ref": "#/$defs/file"},
    "extractor_v4_tests": {"$ref": "#/$defs/file"},
    "package_v4": {"$ref": "#/$defs/packageRevision"},
    "v8_contract": {"$ref": "#/$defs/v8Contract"},
    "preserved_v6": {"$ref": "#/$defs/preservedV6"},
    "sandbox": {"$ref": "#/$defs/sandbox"},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "mode", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "parentV7": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "policy_schema", "receipt_schema", "supervisor", "tests"],
      "properties": {
        "policy": {"$ref": "#/$defs/file"}, "policy_schema": {"$ref": "#/$defs/file"},
        "receipt_schema": {"$ref": "#/$defs/file"}, "supervisor": {"$ref": "#/$defs/file"},
        "tests": {"$ref": "#/$defs/file"}
      }
    },
    "packageRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "schema", "gate", "tests"],
      "properties": {
        "policy": {"$ref": "#/$defs/file"}, "schema": {"$ref": "#/$defs/file"},
        "gate": {"$ref": "#/$defs/file"}, "tests": {"$ref": "#/$defs/file"}
      }
    },
    "v8Contract": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_schema", "receipt_schema", "supervisor", "tests"],
      "properties": {
        "policy_schema": {"$ref": "#/$defs/file"}, "receipt_schema": {"$ref": "#/$defs/file"},
        "supervisor": {"$ref": "#/$defs/file"}, "tests": {"$ref": "#/$defs/file"}
      }
    },
    "dirIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "inode", "mode", "size_bytes", "nlink", "entry_count", "inventory_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "inode": {"type": "integer", "minimum": 1},
        "mode": {"const": "0700"}, "size_bytes": {"type": "integer", "minimum": 1},
        "nlink": {"const": 2}, "entry_count": {"const": 0},
        "inventory_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
      }
    },
    "preservedV6": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_receipt", "partial_root"],
      "properties": {"failure_receipt": {"$ref": "#/$defs/file"}, "partial_root": {"$ref": "#/$defs/dirIdentity"}}
    },
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_argv_sha256", "canonical_token_count", "fd_placeholders", "child_environment", "host_environment", "uid", "gid", "mapped_groups", "writable_bind"],
      "properties": {
        "canonical_argv_sha256": {"$ref": "#/$defs/sha"},
        "canonical_token_count": {"type": "integer", "minimum": 1},
        "fd_placeholders": {"const": ["@S5A0_RECEIPT_FD@", "@SOURCE_BAG_FD@"]},
        "child_environment": {"$ref": "#/$defs/environment"},
        "host_environment": {"$ref": "#/$defs/environment"},
        "uid": {"const": 1000}, "gid": {"const": 1000},
        "mapped_groups": {"const": [65534,65534,65534,65534,65534,65534,65534,65534,1000]},
        "writable_bind": {"const": "/home/zrj/scout_liquid_lab/incoming/SIM-S1_CORE_H1_C1_Bsmooth_b01_r01_r8_liquid_handoff_v3_v4.partial"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["PATH", "HOME", "PYTHONDONTWRITEBYTECODE"],
      "properties": {"PATH": {"const": "/usr/bin"}, "HOME": {"const": "/nonexistent"}, "PYTHONDONTWRITEBYTECODE": {"const": "1"}}
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["optional_bag_read", "gpu_exposed", "solver_executed", "network_used", "sudo_used", "v6_evidence_preserved"],
      "properties": {
        "optional_bag_read": {"const": false}, "gpu_exposed": {"const": false},
        "solver_executed": {"const": false}, "network_used": {"const": false},
        "sudo_used": {"const": false}, "v6_evidence_preserved": {"const": true}
      }
    }
  }
}
