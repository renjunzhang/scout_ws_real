  "required": ["schema_version", "document_type", "policy_id", "status", "selection", "parent_contract", "gauge", "analysis", "visual", "delivery", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-real-runtime-delivery-policy-v6"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_REAL_RUNTIME_DELIVERY_POLICY_V6"},
