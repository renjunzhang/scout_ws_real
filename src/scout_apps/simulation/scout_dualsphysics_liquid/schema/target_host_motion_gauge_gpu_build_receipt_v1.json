    "document_type": {"const": "SMPCC_R8_LIQUID_MOTION_GAUGE_GPU_BUILD_RECEIPT_V1"},
    "campaign_id": {"const": "motion_gauge_gpu_build_sm120_20260812T034446Z_v1"},
    "build_id": {"const": "motion_gauge_gpu_build_sm120_20260812T034446Z_v1_a"},
    "phase": {"enum": ["SOURCE_COPY", "PATCH", "BUILD", "STATIC_AUDIT"]},
    "kind": {"enum": ["START", "FINAL", "FAILURE", "LIFECYCLE"]},
