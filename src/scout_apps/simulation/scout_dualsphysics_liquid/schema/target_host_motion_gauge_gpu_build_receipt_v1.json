    "safety": {"$ref": "#/$defs/safety"},
    "next_allowed_stage": {"enum": ["STOP_PARENT_HASH_REQUIRED", "NEXT_PHASE_REQUIRES_SEPARATE_AUTHORIZATION", "SEPARATE_RUNTIME_ADMISSION_REQUIRED", "STOP_PRESERVE_EVIDENCE"]}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory": {"type": ["object", "null"], "additionalProperties": false, "required": ["label", "entry_count", "canonical_sha256"], "properties": {"label": {"type": "string"}, "entry_count": {"type": "integer", "minimum": 0}, "canonical_sha256": {"$ref": "#/$defs/sha"}}},
    "patch": {"type": ["object", "null"], "additionalProperties": false, "required": ["changed_count", "unchanged_count", "before_sha256", "after_sha256", "full_inventory_pass"], "properties": {"changed_count": {"const": 6}, "unchanged_count": {"const": 346}, "before_sha256": {"$ref": "#/$defs/sha"}, "after_sha256": {"$ref": "#/$defs/sha"}, "full_inventory_pass": {"type": "boolean"}}},
