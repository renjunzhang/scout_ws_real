    "audit": {"type": ["object", "null"], "additionalProperties": false, "required": ["command_count", "candidate_identity_unchanged", "objects_identity_unchanged", "sm120_pass"], "properties": {"command_count": {"type": "integer", "minimum": 0, "maximum": 142}, "candidate_identity_unchanged": {"type": "boolean"}, "objects_identity_unchanged": {"type": "boolean"}, "sm120_pass": {"type": "boolean"}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["create_new_only", "sealed_source_unchanged", "candidate_executed", "gpu_exposed", "optional_bag_read", "network_used", "sudo_used", "apparmor_loaded"], "properties": {"create_new_only": {"const": true}, "sealed_source_unchanged": {"type": "boolean"}, "candidate_executed": {"const": false}, "gpu_exposed": {"const": false}, "optional_bag_read": {"const": false}, "network_used": {"const": false}, "sudo_used": {"type": "boolean"}, "apparmor_loaded": {"type": "boolean"}}}
  }
}
