{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_readonly_delivery_plan_v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "attempt_id", "planned_denominator", "analysis_parent", "visualization", "delivery", "evidence", "claims"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-readonly-delivery-plan-v3"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_READONLY_DELIVERY_PLAN_V3"},
    "status": {"const": "S6_SYNTHETIC_READONLY_DELIVERY_CONTRACT_VALIDATED_NOT_MATERIALIZED"},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"},
    "planned_denominator": {"const": 1},
    "analysis_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "status", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "SYNTHETIC_S6_PRIMARY_ANALYSIS_RESULT_V2"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "S6_PRIMARY_SYNTHETIC_PURE_ANALYSIS_VALIDATED_NOT_FINAL"},
        "real_parent_materialized": {"const": false}
      }
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "shared_x", "axes_count", "dual_y_axes", "panels", "palette", "line_styles", "rainbow_colormap", "grayscale_qa", "layout_qa"],
      "properties": {
        "layout": {"const": "THREE_VERTICAL_SHARED_X_PANELS"},
        "shared_x": {"const": true},
        "axes_count": {"const": 3},
        "dual_y_axes": {"const": false},
        "panels": {
          "const": [
            {"panel_id": "a", "series": ["H_crest", "H_abs", "H_peak_to_peak"], "unit": "mm"},
            {"panel_id": "b", "series": ["H_proxy", "H_modal"], "unit": "mm"},
            {"panel_id": "c", "series": ["H_crest_minus_H_proxy", "H_crest_minus_H_modal"], "unit": "mm"}
          ]
        },
        "palette": {
          "const": {
            "name": "OKABE_ITO_COLORBLIND_SAFE",
            "H_crest": "#0072B2",
            "H_abs": "#E69F00",
            "H_peak_to_peak": "#009E73",
            "H_proxy": "#0072B2",
            "H_modal": "#CC79A7",
            "H_crest_minus_H_proxy": "#000000",
            "H_crest_minus_H_modal": "#E69F00"
          }
        },
        "line_styles": {
          "const": {
            "H_crest": "-",
            "H_abs": "--",
            "H_peak_to_peak": ":",
            "H_proxy": "-",
            "H_modal": "--",
            "H_crest_minus_H_proxy": "-",
            "H_crest_minus_H_modal": "--"
          }
        },
        "rainbow_colormap": {"const": false},
        "grayscale_qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "path", "status", "executed", "pass_claimed"],
          "properties": {
            "required": {"const": true},
            "path": {"const": "figures/primary_shared_x_timeseries_grayscale.png"},
            "status": {"const": "REQUIRED_BEFORE_MATERIALIZATION"},
            "executed": {"const": false},
            "pass_claimed": {"const": false}
          }
        },
        "layout_qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks", "status", "executed", "pass_claimed"],
          "properties": {
            "checks": {"const": ["missing_glyphs", "text_clipping", "tick_overlap", "legend_occlusion", "panel_alignment"]},
            "status": {"const": "REQUIRED_BEFORE_MATERIALIZATION"},
            "executed": {"const": false},
            "pass_claimed": {"const": false}
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_analysis", "write_semantics", "artifacts_materialized", "final_artifacts_allowed", "planned_inventory", "animation", "checksums"],
      "properties": {
        "read_only_analysis": {"const": true},
        "write_semantics": {"const": "CREATE_NEW_ONLY_IF_SEPARATELY_ADMITTED"},
        "artifacts_materialized": {"const": false},
        "final_artifacts_allowed": {"const": false},
        "planned_inventory": {
          "const": [
            "comparison_manifest.json",
            "data/derived_surface_metrics.csv",
            "data/aligned_primary_comparison.csv",
            "reports/primary_summary.json",
            "figures/primary_shared_x_timeseries.png",
            "figures/primary_shared_x_timeseries_grayscale.png",
            "animation/primary.mp4",
            "animation/primary_preview.gif",
            "keyframes/primary_t000.png",
            "evidence_index.json",
            "secondary_ledger_entry.json",
            "checksums.sha256"
          ]
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact_source", "mp4", "gif", "keyframes", "keyframe_overlay", "encoder_executed"],
          "properties": {
            "fact_source": {"const": "FINALIZED_SOLVER_FRAMES_ONLY"},
            "mp4": {"const": "animation/primary.mp4"},
            "gif": {"const": "animation/primary_preview.gif"},
            "keyframes": {"const": ["keyframes/primary_t000.png"]},
            "keyframe_overlay": {"const": ["container_coordinates", "time", "particle_classes", "liquid_surface_probes"]},
            "encoder_executed": {"const": false}
          }
        },
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "path", "coverage", "status", "entries"],
          "properties": {
            "algorithm": {"const": "SHA-256"},
            "path": {"const": "checksums.sha256"},
            "coverage": {"const": "ALL_MATERIALIZED_ARTIFACTS_EXCEPT_SELF"},
            "status": {"const": "PLANNED_NOT_MATERIALIZED"},
            "entries": {"const": []}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_manifest", "evidence_index", "secondary_ledger"],
      "properties": {
        "comparison_manifest": {"$ref": "#/$defs/plannedEvidence"},
        "evidence_index": {"$ref": "#/$defs/plannedEvidence"},
        "secondary_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "status", "append_performed"],
          "properties": {
            "path": {"const": "secondary_ledger_entry.json"},
            "status": {"const": "PLANNED_NOT_APPENDED"},
            "append_performed": {"const": false}
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage6_pass", "paired_ranking", "cpu_selected_trajectory_comparison", "physical_reference_pending", "physical_fidelity_validated", "formal", "production", "physical_primary"],
      "properties": {
        "stage6_pass": {"const": false},
        "paired_ranking": {"const": false},
        "cpu_selected_trajectory_comparison": {"const": false},
        "physical_reference_pending": {"const": true},
        "physical_fidelity_validated": {"const": false},
        "formal": {"const": false},
        "production": {"const": false},
        "physical_primary": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plannedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "entries"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"const": "PLANNED_NOT_MATERIALIZED"},
        "entries": {"const": []}
      }
    }
  }
}
