        "frame_schema_deep_closed": {"const": true},
        "external_inventory_receipt_bound": {"const": true},
        "expected_inventory_bound": {"const": true},
        "frame_inventory_exact": {"const": true},
        "frame_indices_contiguous": {"const": true},
        "frame_times_match_external_grid": {"const": true},
        "particle_count_stable": {"const": true},
        "particle_id_set_canonical": {"const": true},
        "particle_array_order_normalized": {"const": true},
        "particle_classes_stable": {"const": true},
        "nout_zero": {"const": true},
        "all_numeric_values_finite": {"const": true},
        "gauge_names_exact_and_ordered": {"const": true},
        "gauge_coordinates_exact": {"const": true},
        "gauge_attachment_exact": {"const": true},
        "gauge_csv_hashes_and_sizes_exact": {"const": true},
        "gauge_time_grids_identical": {"const": true},
        "frame_and_gauge_time_grid_identical": {"const": true}
      }
