        "frame_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "start_index": {"type": "integer", "minimum": 0},
        "frame_count": {"type": "integer", "minimum": 1},
        "time_grid_sha256": {"$ref": "#/$defs/sha256"},
        "particle_count": {"const": 9078},
        "canonical_ids_sha256": {"const": "dbce99d36546067ed3a903e5892383885b6bb9b94feb1f4171411743fec9bdcf"},
        "class_counts": {"$ref": "#/$defs/particleClasses"}
      }
    },
    "native_gauges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "fact_source", "attachment_frame",
        "probe_count", "probe_radius_m", "angular_spacing_deg", "probe_grid",
        "probe_grid_sha256", "time_grid_sha256", "slot_count",
        "minimum_valid_probes_per_slot", "maximum_invalid_ratio",
        "manifest_sha256", "actual_csv_inventory_sha256", "files"
      ],
      "properties": {
        "schema_version": {"const": "smpcc-r8-liquid-s5b0-native-gauge-manifest-v1"},
        "status": {"const": "PASS_S5B0_NATIVE_GAUGE_MANIFEST_V1"},
        "fact_source": {"const": "SIXTEEN_RAW_NATIVE_JGAUGESWL_CSV"},
        "attachment_frame": {"const": "MOVING_CONTAINER_REFERENCE_REF_0"},
        "probe_count": {"const": 16},
        "probe_radius_m": {"const": 0.0145},
        "angular_spacing_deg": {"const": 22.5},
        "probe_grid": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/probe"}
