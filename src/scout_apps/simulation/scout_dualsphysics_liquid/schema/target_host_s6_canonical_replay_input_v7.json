    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optional_not_read", "PHYSICAL_REFERENCE_PENDING", "stage6_pass",
        "development_only", "physical_fidelity_validated", "paired_ranking",
        "cross_method_ranking", "selected_trajectory_cpu_comparison",
        "candidate_or_solver_executed", "gpu_exposed", "sudo_used",
        "network_used", "external_persistent_write"
      ],
      "properties": {
        "optional_not_read": {"const": true},
        "PHYSICAL_REFERENCE_PENDING": {"const": true},
        "stage6_pass": {"const": false},
        "development_only": {"const": true},
        "physical_fidelity_validated": {"const": false},
        "paired_ranking": {"const": false},
        "cross_method_ranking": {"const": false},
        "selected_trajectory_cpu_comparison": {"const": false},
        "candidate_or_solver_executed": {"const": false},
        "gpu_exposed": {"const": false},
        "sudo_used": {"const": false},
        "network_used": {"const": false},
        "external_persistent_write": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "finalizedFrameReader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "scripts/r8_liquid_s5b0_finalized_frame_reader_v2.py"},
        "sha256": {"const": "aecd5125625ce4da91b9782f6a28eed017ff5e163056fc648b414aca96e2af4c"}
      }
    },
    "finalizedFrameSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "schema/target_host_s5b0_finalized_solver_frames_manifest_v2.json"},
        "sha256": {"const": "4f75694305cd8530ebc0b3c744ec8f3e9d880a0c63d7160cb9a7fb6b6b92853a"}
      }
    },
    "bi4Reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "scripts/r8_liquid_bi4_reader_v1.py"},
        "sha256": {"const": "104d271b750eed15985bf29f743a59678d66c50b9dfae9d1a3fd1663510dbc14"}
      }
    },
    "particleClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_boundary", "moving_boundary", "floating", "fluid"],
      "properties": {
        "fixed_boundary": {"const": 0},
        "moving_boundary": {"const": 2669},
        "floating": {"const": 0},
        "fluid": {"const": 6409}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "name", "angle_deg", "x_m", "y_m"],
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 15},
        "name": {"type": "string", "pattern": "^s5b0_p(?:0[0-9]|1[0-5])$"},
        "angle_deg": {"type": "number"},
        "x_m": {"type": "number"},
        "y_m": {"type": "number"}
      }
    },
    "gaugeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "probe_name", "relative_path", "sha256", "size_bytes", "time_grid_sha256", "row_count", "valid_count", "missing_count", "invalid_count"],
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 15},
        "probe_name": {"type": "string", "pattern": "^s5b0_p(?:0[0-9]|1[0-5])$"},
        "relative_path": {"type": "string", "pattern": "^GaugesSwl_s5b0_p(?:0[0-9]|1[0-5])\\.csv$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "time_grid_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "valid_count": {"type": "integer", "minimum": 1},
        "missing_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
