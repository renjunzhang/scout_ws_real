    "document_type": {"const": "SMPCC_R8_LIQUID_S6_CANONICAL_REPLAY_INPUT_V7"},
    "status": {"const": "PASS_S6_CANONICAL_REPLAY_INPUT_ADMISSION_V7"},
    "mode": {"enum": ["FIXTURE_SELF_CHECK", "EXPLICIT_READ_ONLY_BYTES"]},
