        "minimum_valid_probes_per_slot": {"const": 16},
        "maximum_invalid_ratio": {"const": 0.001},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "actual_csv_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/gaugeFile"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencies_byte_pinned", "frame_schema_deep_closed",
        "external_inventory_receipt_bound", "expected_inventory_bound",
        "frame_inventory_exact", "frame_indices_contiguous",
        "frame_times_match_external_grid", "particle_count_stable",
        "particle_id_set_canonical", "particle_array_order_normalized",
        "particle_classes_stable", "nout_zero",
        "all_numeric_values_finite", "gauge_names_exact_and_ordered",
