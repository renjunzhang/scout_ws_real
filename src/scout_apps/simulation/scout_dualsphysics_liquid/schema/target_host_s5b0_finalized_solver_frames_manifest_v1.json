{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s5b0_finalized_solver_frames_manifest_v1.json",
  "title": "S5B0 finalized solver frames manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "status", "root", "contract",
    "inventory", "bindings", "frames", "integrity", "claims"
  ],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s5b0-finalized-solver-frames-manifest-v1"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S5B0_FINALIZED_SOLVER_FRAMES_MANIFEST_V1"},
    "status": {"const": "PASS_S5B0_FINALIZED_SOLVER_FRAMES_MANIFEST_V1"},
    "root": {"type": "string", "pattern": "^/"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_root", "expected_inventory_sha256", "expected_start_index",
        "expected_frame_count", "expected_times_sha256", "expected_particle_count",
        "expected_ids_sha256", "time_tolerance_s"
      ],
      "properties": {
        "expected_root": {"type": "string", "pattern": "^/"},
        "expected_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "expected_start_index": {"type": "integer", "minimum": 0},
        "expected_frame_count": {"type": "integer", "minimum": 1},
        "expected_times_sha256": {"$ref": "#/$defs/sha256"},
        "expected_particle_count": {"type": "integer", "minimum": 1},
        "expected_ids_sha256": {"$ref": "#/$defs/sha256"},
        "time_tolerance_s": {"const": 1e-09}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "directory_count", "canonical_sha256", "files"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 7},
        "directory_count": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 7,
          "items": {"$ref": "#/$defs/fileIdentity"}
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_files", "part_head", "part_info", "part_motion_ref", "part_out"],
      "properties": {
        "run_files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/fileIdentity"}
        },
        "part_head": {"$ref": "#/$defs/fileIdentity"},
        "part_info": {"$ref": "#/$defs/fileIdentity"},
        "part_motion_ref": {"$ref": "#/$defs/fileIdentity"},
        "part_out": {"$ref": "#/$defs/fileIdentity"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_root", "exact_inventory", "no_symlinks", "no_hardlinks",
        "no_special_files", "no_toctou", "frame_indices_contiguous",
        "frame_times_match_external_grid", "particle_count_stable",
        "particle_ids_stable", "nout_zero", "finite", "frame_manifest_sha256"
      ],
      "properties": {
        "exact_root": {"const": true},
        "exact_inventory": {"const": true},
        "no_symlinks": {"const": true},
        "no_hardlinks": {"const": true},
        "no_special_files": {"const": true},
        "no_toctou": {"const": true},
        "frame_indices_contiguous": {"const": true},
        "frame_times_match_external_grid": {"const": true},
        "particle_count_stable": {"const": true},
        "particle_ids_stable": {"const": true},
        "nout_zero": {"const": true},
        "finite": {"const": true},
        "frame_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_executed_by_reader", "solver_executed_by_reader", "gpu_exposed",
        "network_used", "sudo_used", "apparmor_loaded", "real_bag_read"
      ],
      "properties": {
        "candidate_executed_by_reader": {"const": false},
        "solver_executed_by_reader": {"const": false},
        "gpu_exposed": {"const": false},
        "network_used": {"const": false},
        "sudo_used": {"const": false},
        "apparmor_loaded": {"const": false},
        "real_bag_read": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path", "type", "mode", "size_bytes", "device", "inode",
        "nlink", "sha256"
      ],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "type": {"const": "regular"},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "nlink": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "classCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_boundary", "moving_boundary", "floating", "fluid"],
      "properties": {
        "fixed_boundary": {"type": "integer", "minimum": 0},
        "moving_boundary": {"type": "integer", "minimum": 0},
        "floating": {"type": "integer", "minimum": 0},
        "fluid": {"type": "integer", "minimum": 0}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "time_s", "identity", "particle_count", "nout",
        "ids_sha256", "finite", "class_counts"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "time_s": {"type": "number"},
        "identity": {"$ref": "#/$defs/fileIdentity"},
        "particle_count": {"type": "integer", "minimum": 1},
        "nout": {"const": 0},
        "ids_sha256": {"$ref": "#/$defs/sha256"},
        "finite": {"const": true},
        "class_counts": {"$ref": "#/$defs/classCounts"}
      }
    }
  }
}
