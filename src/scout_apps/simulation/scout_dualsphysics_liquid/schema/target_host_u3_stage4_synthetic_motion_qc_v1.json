        "initial_window_start_s": { "$ref": "#/$defs/finiteNumber" },
        "initial_window_end_s": { "$ref": "#/$defs/finiteNumber" },
        "final_window_start_s": { "$ref": "#/$defs/finiteNumber" },
        "final_window_end_s": { "$ref": "#/$defs/finiteNumber" },
        "initial_peak_specific_ke_lab_j_kg": { "$ref": "#/$defs/nonnegativeNumber" },
        "final_mean_specific_ke_lab_j_kg": { "$ref": "#/$defs/nonnegativeNumber" },
        "final_to_initial_peak_ratio": { "$ref": "#/$defs/nonnegativeNumber" },
        "pass": { "type": "boolean" }
      }
    },
    "freeDecay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "yaw", "pass"],
      "properties": {
        "translation": { "$ref": "#/$defs/decayResult" },
        "yaw": { "$ref": "#/$defs/decayResult" },
        "pass": { "type": "boolean" }
      }
    },
    "inputReconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "yaw", "pass"],
      "properties": {
        "translation": { "$ref": "#/$defs/frequencyFit" },
        "yaw": { "$ref": "#/$defs/frequencyFit" },
        "pass": { "type": "boolean" }
      }
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_stability",
        "translation_response",
        "yaw_response",
        "free_decay",
        "input_reconstruction"
      ],
      "properties": {
        "zero_stability": { "$ref": "#/$defs/zeroStability" },
        "translation_response": { "$ref": "#/$defs/dynamicResponse" },
        "yaw_response": { "$ref": "#/$defs/dynamicResponse" },
        "free_decay": { "$ref": "#/$defs/freeDecay" },
        "input_reconstruction": { "$ref": "#/$defs/inputReconstruction" }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stage4_liquid_only_validation_complete",
        "development_only",
        "formal",
        "physical_fidelity_validated",
        "production_eligible",
        "stage5_admitted",
        "all_frozen_thresholds_pass",
        "candidate_source_executed",
        "solver_executed_by_this_tool",
        "gpu_exposed_by_this_tool",
        "network_used_by_this_tool",
        "inputs_modified",
        "next"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS_U3_STAGE4_LIQUID_ONLY_DEVELOPMENT_VALIDATION",
            "FAIL_U3_STAGE4_SYNTHETIC_MOTION_QC"
          ]
        },
        "stage4_liquid_only_validation_complete": { "type": "boolean" },
        "development_only": { "const": true },
        "formal": { "const": false },
        "physical_fidelity_validated": { "const": false },
        "production_eligible": { "const": false },
        "stage5_admitted": { "const": false },
        "all_frozen_thresholds_pass": { "type": "boolean" },
        "candidate_source_executed": { "const": false },
        "solver_executed_by_this_tool": { "const": false },
        "gpu_exposed_by_this_tool": { "const": false },
        "network_used_by_this_tool": { "const": false },
        "inputs_modified": { "const": false },
        "next": {
          "enum": [
            "STAGE5_REQUIRES_SEPARATE_USER_AUTHORIZATION_AND_PHYSICAL_INPUTS",
            "STOP_REVIEW_STAGE4_QC_FAILURE"
          ]
        }
      }
    }
  }
}
