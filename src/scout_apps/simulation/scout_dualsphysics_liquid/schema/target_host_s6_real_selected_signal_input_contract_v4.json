{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_real_selected_signal_input_contract_v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "mode", "real_input_admitted", "attempt_id", "planned_denominator", "parents", "provenance", "time_alignment", "series", "claims"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-real-selected-signal-input-contract-v4"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_REAL_SELECTED_SIGNAL_INPUT_CONTRACT_V4"},
    "status": {"const": "S6_REAL_SELECTED_SIGNAL_SHAPE_FIXTURE_VALIDATED_NOT_ADMITTED"},
    "mode": {"const": "STATIC_FIXTURE_FOR_REAL_INPUT_CONTRACT"},
    "real_input_admitted": {"const": false},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"},
    "planned_denominator": {"const": 1},
    "parents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s5a0_selected_bag_receipt", "s5a1_transfer_manifest", "source_bag"],
      "properties": {
        "s5a0_selected_bag_receipt": {"$ref": "#/$defs/s5a0Identity"},
        "s5a1_transfer_manifest": {"$ref": "#/$defs/s5a1Identity"},
        "source_bag": {"$ref": "#/$defs/sourceIdentity"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_s5a0_status", "target_s5a1_status", "source_outcome", "original_root_zero_write_required", "real_files_read", "motion_exporter_consumed_selected_signals", "solver_forcing_consumed_selected_signals", "comparison_only"],
      "properties": {
        "target_s5a0_status": {"const": "S5A0_PRIMARY_SELECTED_BAG_ACCEPTED"},
        "target_s5a1_status": {"const": "S5A1_PRIMARY_R7_MOTION_TRANSFER_VERIFIED_ACCEPTED"},
        "source_outcome": {"const": "SPMPC_NON_FIXED"},
        "original_root_zero_write_required": {"const": true},
        "real_files_read": {"const": false},
        "motion_exporter_consumed_selected_signals": {"const": false},
        "solver_forcing_consumed_selected_signals": {"const": false},
        "comparison_only": {"const": true}
      }
    },
    "time_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_axis", "sample_time_source", "odom_header_origin_ns", "record_to_odom_offset_ns", "overlap_start_s", "overlap_end_s", "output_grid_sha256", "interpolation", "extrapolation", "smoothing"],
      "properties": {
        "x_axis": {"const": "time_since_odom_header_origin_s"},
        "sample_time_source": {"const": "ROS1_BAG_RECORD_TIME_NS"},
        "odom_header_origin_ns": {"type": "integer", "minimum": 0},
        "record_to_odom_offset_ns": {"type": "integer"},
        "overlap_start_s": {"type": "number"},
        "overlap_end_s": {"type": "number"},
        "output_grid_sha256": {"$ref": "#/$defs/sha256"},
        "interpolation": {"const": "LINEAR_WITHIN_OVERLAP_ONLY"},
        "extrapolation": {"const": false},
        "smoothing": {"const": false}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["H_proxy", "H_modal"],
      "properties": {
        "H_proxy": {"$ref": "#/$defs/hProxy"},
        "H_modal": {"$ref": "#/$defs/hModal"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage6_pass", "single_row", "paired_ranking", "cpu_selected_trajectory_comparison", "physical_reference_pending", "physical_fidelity_validated", "formal", "production"],
      "properties": {
        "stage6_pass": {"const": false},
        "single_row": {"const": true},
        "paired_ranking": {"const": false},
        "cpu_selected_trajectory_comparison": {"const": false},
        "physical_reference_pending": {"const": true},
        "physical_fidelity_validated": {"const": false},
        "formal": {"const": false},
        "production": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "s5a0Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "FINALIZED_S5A0_RECEIPT_IDENTITY_FIXTURE"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "real_parent_materialized": {"const": false}
      }
    },
    "s5a1Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "FINALIZED_S5A1_TRANSFER_IDENTITY_FIXTURE"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "real_parent_materialized": {"const": false}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "size_bytes", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "SOURCE_ROS1_BAG_IDENTITY_FIXTURE"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "real_parent_materialized": {"const": false}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bag_record_t_ns", "value_native"],
      "properties": {
        "bag_record_t_ns": {"type": "integer", "minimum": 0},
        "value_native": {"type": "number"}
      }
    },
    "hProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison", "offset_to_comparison", "samples"],
      "properties": {
        "topic": {"const": "/slosh/height"},
        "message_type": {"const": "std_msgs/Float32"},
        "native_unit": {"const": "m"},
        "comparison_unit": {"const": "mm"},
        "scale_to_comparison": {"const": 1000.0},
        "offset_to_comparison": {"const": 0.0},
        "samples": {"type": "array", "minItems": 16, "maxItems": 100000, "items": {"$ref": "#/$defs/sample"}}
      }
    },
    "hModal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison", "offset_to_comparison", "samples"],
      "properties": {
        "topic": {"const": "/spmpc/slosh_height"},
        "message_type": {"const": "std_msgs/Float32"},
        "native_unit": {"const": "mm"},
        "comparison_unit": {"const": "mm"},
        "scale_to_comparison": {"const": 1.0},
        "offset_to_comparison": {"const": 0.0},
        "samples": {"type": "array", "minItems": 16, "maxItems": 100000, "items": {"$ref": "#/$defs/sample"}}
      }
    }
  }
}
