{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_selected_signals_provenance_v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "status",
    "synthetic_fixture",
    "attempt_id",
    "planned_denominator",
    "parents",
    "source",
    "time_alignment",
    "series",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-selected-signals-provenance-v2"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_SELECTED_SIGNALS_PROVENANCE_V2"},
    "status": {"const": "S6_SELECTED_SIGNALS_SYNTHETIC_PROVENANCE_FROZEN_NOT_FINAL"},
    "synthetic_fixture": {"const": true},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"},
    "planned_denominator": {"const": 1},
    "parents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s5a0_selected_bag_receipt", "s5a1_transfer_manifest"],
      "properties": {
        "s5a0_selected_bag_receipt": {"$ref": "#/$defs/s5a0Identity"},
        "s5a1_transfer_manifest": {"$ref": "#/$defs/s5a1Identity"}
      }
    },
    "source": {"$ref": "#/$defs/sourceIdentity"},
    "time_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_axis",
        "sample_time_source",
        "odom_header_origin_ns",
        "record_to_odom_offset_ns",
        "overlap_start_s",
        "overlap_end_s",
        "output_grid_sha256",
        "interpolation",
        "extrapolation",
        "smoothing"
      ],
      "properties": {
        "x_axis": {"const": "time_since_odom_header_origin_s"},
        "sample_time_source": {"const": "ROS1_BAG_RECORD_TIME_NS"},
        "odom_header_origin_ns": {"type": "integer", "minimum": 0},
        "record_to_odom_offset_ns": {"type": "integer"},
        "overlap_start_s": {"type": "number"},
        "overlap_end_s": {"type": "number"},
        "output_grid_sha256": {"$ref": "#/$defs/sha256"},
        "interpolation": {"const": "LINEAR_WITHIN_OVERLAP_ONLY"},
        "extrapolation": {"const": false},
        "smoothing": {"const": false}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["H_proxy", "H_modal"],
      "properties": {
        "H_proxy": {"$ref": "#/$defs/hProxy"},
        "H_modal": {"$ref": "#/$defs/hModal"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_bag_read",
        "stage6_pass",
        "paired_ranking",
        "cpu_selected_trajectory_comparison",
        "physical_reference_pending",
        "physical_fidelity_validated",
        "final_materialization_admitted"
      ],
      "properties": {
        "real_bag_read": {"const": false},
        "stage6_pass": {"const": false},
        "paired_ranking": {"const": false},
        "cpu_selected_trajectory_comparison": {"const": false},
        "physical_reference_pending": {"const": true},
        "physical_fidelity_validated": {"const": false},
        "final_materialization_admitted": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "s5a0Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "SYNTHETIC_S5A0_SELECTED_BAG_RECEIPT"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "real_parent_materialized": {"const": false}
      }
    },
    "s5a1Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "SYNTHETIC_S5A1_TRANSFER_MANIFEST"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "real_parent_materialized": {"const": false}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "size_bytes", "real_parent_materialized"],
      "properties": {
        "kind": {"const": "SYNTHETIC_ROS1_BAG_V2_BYTES"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "real_parent_materialized": {"const": false}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bag_record_t_ns", "value_native"],
      "properties": {
        "bag_record_t_ns": {"type": "integer", "minimum": 0},
        "value_native": {"type": "number"}
      }
    },
    "hProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison", "offset_to_comparison", "samples"],
      "properties": {
        "topic": {"const": "/slosh/height"},
        "message_type": {"const": "std_msgs/Float32"},
        "native_unit": {"const": "m"},
        "comparison_unit": {"const": "mm"},
        "scale_to_comparison": {"const": 1000.0},
        "offset_to_comparison": {"const": 0.0},
        "samples": {"type": "array", "minItems": 4, "maxItems": 100000, "items": {"$ref": "#/$defs/sample"}}
      }
    },
    "hModal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison", "offset_to_comparison", "samples"],
      "properties": {
        "topic": {"const": "/spmpc/slosh_height"},
        "message_type": {"const": "std_msgs/Float32"},
        "native_unit": {"const": "mm"},
        "comparison_unit": {"const": "mm"},
        "scale_to_comparison": {"const": 1.0},
        "offset_to_comparison": {"const": 0.0},
        "samples": {"type": "array", "minItems": 4, "maxItems": 100000, "items": {"$ref": "#/$defs/sample"}}
      }
    }
  }
}
