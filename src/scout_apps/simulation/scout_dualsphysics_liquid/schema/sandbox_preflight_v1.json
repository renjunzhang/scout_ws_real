{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIM-R8 liquid VM and build sandbox preflight",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "created_utc",
    "development_only",
    "formal",
    "physical_primary_eligible",
    "approved_root",
    "mode",
    "policies",
    "host_safety",
    "runtime",
    "resources",
    "source_dependency",
    "layout",
    "upstream_code_executed",
    "status",
    "errors",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-sandbox-preflight-v1"},
    "document_type": {"const": "SMPCC_R8_LIQUID_SANDBOX_PREFLIGHT"},
    "created_utc": {"type": "string"},
    "development_only": {"const": true},
    "formal": {"const": false},
    "physical_primary_eligible": {"const": false},
    "approved_root": {"const": "/data/a/scout_sim_replacement/r8_liquid"},
    "mode": {"enum": ["vm-host", "cpu-build", "gencase"]},
    "policies": {"type": "object"},
    "host_safety": {"type": "object"},
    "runtime": {"type": "object"},
    "resources": {"type": "object"},
    "source_dependency": {"type": "object"},
    "layout": {"type": "object"},
    "upstream_code_executed": {"const": false},
    "status": {"enum": ["PASS", "NO_GO"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
