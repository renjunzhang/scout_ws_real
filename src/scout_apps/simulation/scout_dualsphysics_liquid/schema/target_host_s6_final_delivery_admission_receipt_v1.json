{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_final_delivery_admission_receipt_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "attempt_id", "planned_denominator", "policy", "s5b0_package", "required_checks", "side_effects", "claims"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-final-delivery-admission-receipt-v1"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_FINAL_DELIVERY_ADMISSION_RECEIPT_V1"},
    "status": {"enum": ["NOT_ADMITTED_FINALIZED_S5B0_REPLAY_REQUIRED", "ADMITTED_FINALIZED_S5B0_PRIMARY_PACKAGE_V1"]},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"},
    "planned_denominator": {"const": 1},
    "policy": {"$ref": "#/$defs/identity"},
    "s5b0_package": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "execution_receipt", "result_qc", "frame_manifest", "gauge_zsurf", "checksums"],
      "properties": {
        "root": {"type": ["string", "null"], "pattern": "^/"},
        "execution_receipt": {"$ref": "#/$defs/nullableIdentity"},
        "result_qc": {"$ref": "#/$defs/nullableIdentity"},
        "frame_manifest": {"$ref": "#/$defs/nullableIdentity"},
        "gauge_zsurf": {"$ref": "#/$defs/nullableIdentity"},
        "checksums": {"$ref": "#/$defs/nullableIdentity"}
      }
    },
    "required_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_root", "no_symlink_components", "execution_finalized", "execution_status_exact", "result_qc_pass", "frame_manifest_status_exact", "frame_manifest_integrity_pass", "checksums_complete", "gauge_bound_by_checksums", "attempt_exact", "optional_unread"],
      "properties": {
        "exact_root": {"type": "boolean"}, "no_symlink_components": {"type": "boolean"},
        "execution_finalized": {"type": "boolean"}, "execution_status_exact": {"type": "boolean"},
        "result_qc_pass": {"type": "boolean"}, "frame_manifest_status_exact": {"type": "boolean"},
        "frame_manifest_integrity_pass": {"type": "boolean"}, "checksums_complete": {"type": "boolean"},
        "gauge_bound_by_checksums": {"type": "boolean"}, "attempt_exact": {"type": "boolean"},
        "optional_unread": {"const": true}
      }
    },
    "side_effects": {
      "type": "object", "additionalProperties": false,
      "required": ["bag_read", "optional_bag_read", "solver_executed", "gpu_exposed", "network_used", "sudo_used", "external_write_performed"],
      "properties": {
        "bag_read": {"const": false}, "optional_bag_read": {"const": false}, "solver_executed": {"const": false},
        "gpu_exposed": {"const": false}, "network_used": {"const": false}, "sudo_used": {"const": false},
        "external_write_performed": {"const": false}
      }
    },
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
    },
    "nullableIdentity": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size_bytes"], "properties": {
          "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}
        }}
      ]
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["stage6_pass", "single_row", "paired_ranking", "cross_method_ranking", "cpu_selected_trajectory_comparison", "physical_reference_pending", "physical_fidelity_validated", "formal", "production", "physical_primary"],
      "properties": {
        "stage6_pass": {"const": false}, "single_row": {"const": true}, "paired_ranking": {"const": false}, "cross_method_ranking": {"const": false},
        "cpu_selected_trajectory_comparison": {"const": false}, "physical_reference_pending": {"const": true},
        "physical_fidelity_validated": {"const": false}, "formal": {"const": false}, "production": {"const": false},
        "physical_primary": {"const": false}
      }
    }
  }
}
