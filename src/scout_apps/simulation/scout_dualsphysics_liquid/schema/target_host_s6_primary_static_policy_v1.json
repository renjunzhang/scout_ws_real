{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_primary_static_policy_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "policy_id", "status", "selection", "parents", "selected_signals", "replay", "alignment", "comparison", "visualization", "delivery", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-primary-static-policy-v1"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_PRIMARY_STATIC_ANALYSIS_POLICY_V1"},
    "policy_id": {"const": "liquid_zrj_msi_u2404_s6_primary_static_analysis_v1"},
    "status": {"const": "S6_PRIMARY_STATIC_CONTRACT_FROZEN_NOT_ADMITTED"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "role", "planned_denominator", "optional_pair_admitted", "paired_ranking_allowed"], "properties": {"attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"}, "role": {"const": "PRIMARY_BASELINE"}, "planned_denominator": {"const": 1}, "optional_pair_admitted": {"const": false}, "paired_ranking_allowed": {"const": false}}},
    "parents": {"type": "object", "additionalProperties": false, "required": ["s5a0_selected_bag_receipt", "s5a1_transfer_manifest", "s5b0_finalized_replay_manifest"], "properties": {"s5a0_selected_bag_receipt": {"$ref": "#/$defs/notMaterialized"}, "s5a1_transfer_manifest": {"$ref": "#/$defs/notMaterialized"}, "s5b0_finalized_replay_manifest": {"$ref": "#/$defs/notMaterialized"}}},
    "selected_signals": {"type": "object", "additionalProperties": false, "required": ["maximum_source_bytes", "maximum_messages_per_topic", "minimum_messages_per_topic", "time_source", "strictly_increasing_time", "signals"], "properties": {"maximum_source_bytes": {"const": 67108864}, "maximum_messages_per_topic": {"const": 100000}, "minimum_messages_per_topic": {"const": 2}, "time_source": {"const": "ROS1_BAG_RECORD_TIME_NS"}, "strictly_increasing_time": {"const": true}, "signals": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/hProxy"}, {"$ref": "#/$defs/hModal"}], "items": false}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["finalized_required", "required_status", "required_surface_metrics", "required_numeric_sources", "synthetic_fixture_allowed_for_static_tests"], "properties": {"finalized_required": {"const": true}, "required_status": {"const": "S5B0_PRIMARY_R7_EXECUTED_MOTION_REPLAY_PASS_DEVELOPMENT_ONLY"}, "required_surface_metrics": {"const": ["H_crest", "H_abs", "H_peak_to_peak"]}, "required_numeric_sources": {"const": ["finalized_bi4", "gauge_zsurf_csv", "slosh_height_csv"]}, "synthetic_fixture_allowed_for_static_tests": {"const": true}}},
    "alignment": {"type": "object", "additionalProperties": false, "required": ["x_axis", "grid_source", "interpolation", "extrapolation", "smoothing", "result_driven_window", "result_driven_filter"], "properties": {"x_axis": {"const": "time_since_odom_header_origin_s"}, "grid_source": {"const": "FINALIZED_REPLAY_OUTPUT_SLOTS"}, "interpolation": {"const": "LINEAR_WITHIN_OVERLAP_ONLY"}, "extrapolation": {"const": false}, "smoothing": {"const": false}, "result_driven_window": {"const": false}, "result_driven_filter": {"const": false}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["comparison_unit", "dimensions", "single_row_only", "cpu_selected_trajectory_claim_allowed", "physical_reference_pending", "physical_fidelity_validated"], "properties": {"comparison_unit": {"const": "mm"}, "dimensions": {"const": ["amplitude", "frequency", "damping", "phase"]}, "single_row_only": {"const": true}, "cpu_selected_trajectory_claim_allowed": {"const": false}, "physical_reference_pending": {"const": true}, "physical_fidelity_validated": {"const": false}}},
    "visualization": {"type": "object", "additionalProperties": false, "required": ["layout", "shared_x", "dual_y_axes", "panel_y_axis_count", "panels", "palette", "redundant_line_styles", "rainbow_colormap_allowed", "grayscale_review_required"], "properties": {"layout": {"const": "THREE_VERTICAL_SHARED_X_PANELS"}, "shared_x": {"const": true}, "dual_y_axes": {"const": false}, "panel_y_axis_count": {"const": 1}, "panels": {"const": [{"panel_id": "a", "series": ["H_crest", "H_abs", "H_peak_to_peak"], "unit": "mm"}, {"panel_id": "b", "series": ["H_proxy", "H_modal"], "unit": "mm"}, {"panel_id": "c", "series": ["H_crest_minus_H_proxy", "H_crest_minus_H_modal"], "unit": "mm"}]}, "palette": {"const": "OKABE_ITO_COLORBLIND_SAFE"}, "redundant_line_styles": {"const": true}, "rainbow_colormap_allowed": {"const": false}, "grayscale_review_required": {"const": true}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["write_semantics", "final_outputs_allowed", "planned_inventory"], "properties": {"write_semantics": {"const": "CREATE_NEW_ONLY"}, "final_outputs_allowed": {"const": false}, "planned_inventory": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "claim_ceiling": {"type": "object", "additionalProperties": false, "required": ["development_only", "stage6_pass", "formal", "production", "physical_primary", "physical_reference_pending", "admission"], "properties": {"development_only": {"const": true}, "stage6_pass": {"const": false}, "formal": {"const": false}, "production": {"const": false}, "physical_primary": {"const": false}, "physical_reference_pending": {"const": true}, "admission": {"const": "NOT_ADMITTED_FINALIZED_S5B0_REPLAY_REQUIRED"}}}
  },
  "$defs": {
    "notMaterialized": {"type": "object", "additionalProperties": false, "required": ["state", "path", "sha256"], "properties": {"state": {"const": "NOT_MATERIALIZED"}, "path": {"type": "null"}, "sha256": {"type": "null"}}},
    "hProxy": {"type": "object", "additionalProperties": false, "required": ["name", "topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison"], "properties": {"name": {"const": "H_proxy"}, "topic": {"const": "/slosh/height"}, "message_type": {"const": "std_msgs/Float32"}, "native_unit": {"const": "m"}, "comparison_unit": {"const": "mm"}, "scale_to_comparison": {"const": 1000.0}}},
    "hModal": {"type": "object", "additionalProperties": false, "required": ["name", "topic", "message_type", "native_unit", "comparison_unit", "scale_to_comparison"], "properties": {"name": {"const": "H_modal"}, "topic": {"const": "/spmpc/slosh_height"}, "message_type": {"const": "std_msgs/Float32"}, "native_unit": {"const": "mm"}, "comparison_unit": {"const": "mm"}, "scale_to_comparison": {"const": 1.0}}}
  }
}
