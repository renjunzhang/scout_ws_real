      "properties": {
        "motion_replacement_locations": {"type": "array", "prefixItems": [{"const": "/case/casedef/motion"}, {"const": "/case/execution/motion"}], "items": false},
        "motion_replacement_count": {"const": 2}, "motion_element": {"const": "mvpathfile"}, "solver_path_name": {"const": "solver_path.csv"},
        "field_indices": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1}, {"const": 2}, {"const": 3}, {"const": 4}, {"const": 5}, {"const": 6}], "items": false},
        "anglesunits": {"const": "degrees"}, "axes": {"const": "ZYX"}, "intrinsic": {"const": true}, "movecenter": {"const": true},
        "solver_tail_s": {"const": 1.0}, "solver_path_last_t_already_includes_tail": {"const": true},
