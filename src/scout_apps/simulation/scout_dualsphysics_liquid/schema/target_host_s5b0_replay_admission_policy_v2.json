      "type": "object", "additionalProperties": false,
      "required": ["estimate_label", "fixed_gpu_bytes", "bytes_per_cell", "bytes_per_particle", "minimum_dynamic_free_bytes", "minimum_dynamic_headroom_bytes", "dynamic_free_and_headroom_required", "monitor_interval_seconds", "monitor_interval_max_seconds", "wall_timeout_seconds", "pgid_kill_required", "xid_reset_zero_required"],
      "properties": {
        "estimate_label": {"const": "PREFLIGHT_ESTIMATE_NOT_OBSERVED_USAGE"}, "fixed_gpu_bytes": {"type": "integer", "minimum": 1},
        "bytes_per_cell": {"type": "integer", "minimum": 1}, "bytes_per_particle": {"type": "integer", "minimum": 1},
        "minimum_dynamic_free_bytes": {"type": "integer", "minimum": 1}, "minimum_dynamic_headroom_bytes": {"type": "integer", "minimum": 1},
        "dynamic_free_and_headroom_required": {"const": true}, "monitor_interval_seconds": {"type": "integer", "minimum": 10, "maximum": 30},
        "monitor_interval_max_seconds": {"const": 30}, "wall_timeout_seconds": {"type": "integer", "minimum": 1},
        "pgid_kill_required": {"const": true}, "xid_reset_zero_required": {"const": true}
