      "properties": {
        "replay_id": {"type": "null"}, "partial_root": {"type": "null"}, "final_root": {"type": "null"},
        "start_receipt": {"type": "null"}, "final_receipt": {"type": "null"}, "failure_receipt": {"type": "null"},
        "fresh_create_new_required": {"const": true}, "failure_preserves_partial": {"const": true},
        "atomic_noreplace_publish": {"const": true}, "zero_residue_required": {"const": true}
