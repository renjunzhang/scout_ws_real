        "settled_head_sha256": {"$ref": "#/$defs/sha256"}, "settled_part_index": {"const": 901},
        "settled_time_s": {"const": 45.05001991890928}, "particle_count": {"const": 9078},
        "moving_boundary_count": {"const": 2669}, "fluid_count": {"const": 6409}
      }
    },
