  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "numeric_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["interval_subdivisions", "include_solver_output_grid", "maximum_axis_span_m", "container_radius_m", "container_height_m", "margin_m", "cell_size_m", "maximum_cells", "cumulative_path_length_is_not_axis_span"],
      "properties": {
        "interval_subdivisions": {"const": 4}, "include_solver_output_grid": {"const": true}, "maximum_axis_span_m": {"const": 8.0},
        "container_radius_m": {"const": 0.0185}, "container_height_m": {"const": 0.066}, "margin_m": {"const": 0.012},
        "cell_size_m": {"const": 0.004}, "maximum_cells": {"const": 50000000}, "cumulative_path_length_is_not_axis_span": {"const": true}
      }
