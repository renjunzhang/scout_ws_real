  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "selection", "parent_transfer", "c1_parents", "case_contract", "solver_contract", "moving_envelope", "resource_contract", "profile_contract", "result_contract", "lifecycle", "authorization", "next"],
  "properties": {
