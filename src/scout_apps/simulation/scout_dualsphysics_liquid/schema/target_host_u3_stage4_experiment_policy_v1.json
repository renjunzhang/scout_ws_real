{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_u3_stage4_experiment_policy_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "run_id",
    "purpose",
    "parents",
    "tools",
    "backend",
    "gpu",
    "inputs",
    "restart",
    "solver",
    "sandbox",
    "run",
    "expected_output",
    "limits",
    "experiment"
  ],
  "properties": {
    "schema_version": { "const": "r8-liquid-u3-stage4-experiment-policy-v1" },
    "document_type": { "const": "SMPCC_R8_LIQUID_U3_STAGE4_EXPERIMENT_POLICY_V1" },
    "run_id": {
      "type": "string",
      "pattern": "^u3_c1m_(cpu|gpu)_[A-Za-z0-9_]+_v[0-9]+$",
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 128
    },
    "parents": { "$ref": "#/$defs/parents" },
    "tools": { "$ref": "#/$defs/tools" },
    "backend": { "$ref": "#/$defs/backend" },
    "gpu": {
      "oneOf": [
        { "$ref": "#/$defs/gpu" },
        { "type": "null" }
      ]
    },
    "inputs": { "$ref": "#/$defs/inputs" },
    "restart": { "$ref": "#/$defs/restart" },
    "solver": { "$ref": "#/$defs/solver" },
    "sandbox": { "$ref": "#/$defs/sandbox" },
    "run": { "$ref": "#/$defs/run" },
    "expected_output": { "$ref": "#/$defs/expectedOutput" },
    "limits": { "$ref": "#/$defs/limits" },
    "experiment": { "$ref": "#/$defs/experiment" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "parentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "mode", "inode", "nlink"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "inode": { "type": "integer", "minimum": 1 },
        "nlink": { "const": 1 }
      }
    },
    "parents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "numerical_contract",
        "settled_qc",
        "candidate_evidence",
        "runner",
        "schema",
        "tests"
      ],
      "properties": {
        "plan": { "$ref": "#/$defs/parentIdentity" },
        "numerical_contract": { "$ref": "#/$defs/parentIdentity" },
        "settled_qc": { "$ref": "#/$defs/parentIdentity" },
        "candidate_evidence": { "$ref": "#/$defs/parentIdentity" },
        "runner": { "$ref": "#/$defs/parentIdentity" },
        "schema": { "$ref": "#/$defs/parentIdentity" },
        "tests": { "$ref": "#/$defs/parentIdentity" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bwrap", "nvidia_smi", "python"],
      "properties": {
        "bwrap": { "$ref": "#/$defs/parentIdentity" },
        "nvidia_smi": { "$ref": "#/$defs/parentIdentity" },
        "python": { "$ref": "#/$defs/parentIdentity" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "parallel_jobs"],
      "properties": {
        "kind": { "enum": ["CPU", "GPU"] },
        "index": { "enum": [null, 0] },
        "parallel_jobs": { "const": 1 }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "uuid", "pci_bus_id", "name", "driver_version", "device_paths"],
      "properties": {
        "index": { "const": 0 },
        "uuid": { "const": "GPU-d29cd22d-8b25-8f4e-9dcf-f2fc4bb113fb" },
        "pci_bus_id": { "const": "00000000:01:00.0" },
        "name": { "const": "NVIDIA GeForce RTX 5080 Laptop GPU" },
        "driver_version": { "const": "580.173.02" },
        "device_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "/dev/nvidia0" },
            { "const": "/dev/nvidiactl" },
            { "const": "/dev/nvidia-uvm" },
            { "const": "/dev/nvidia-uvm-tools" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "dsph_config", "case_bi4", "case_xml", "restart_part", "restart_head"],
      "properties": {
        "candidate": { "$ref": "#/$defs/fileIdentity" },
        "dsph_config": { "$ref": "#/$defs/fileIdentity" },
        "case_bi4": { "$ref": "#/$defs/fileIdentity" },
        "case_xml": { "$ref": "#/$defs/fileIdentity" },
        "restart_part": {
          "oneOf": [
            { "$ref": "#/$defs/fileIdentity" },
            { "type": "null" }
          ]
        },
        "restart_head": {
          "oneOf": [
            { "$ref": "#/$defs/fileIdentity" },
            { "type": "null" }
          ]
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "part_index", "part_first", "guest_dir"],
      "properties": {
        "enabled": { "type": "boolean" },
        "part_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
        "part_first": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
        "guest_dir": { "enum": ["/restart", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "part_index": { "const": 901 },
              "part_first": { "const": 901 },
              "guest_dir": { "const": "/restart" }
            }
          },
          "else": {
            "properties": {
              "part_index": { "type": "null" },
              "part_first": { "type": "null" },
              "guest_dir": { "type": "null" }
            }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "PATH", "LC_ALL", "LANG", "TZ", "TMPDIR", "OMP_NUM_THREADS", "OMP_DYNAMIC", "CUDA_VISIBLE_DEVICES"],
      "properties": {
        "HOME": { "const": "/nonexistent" },
        "PATH": { "const": "/usr/bin" },
        "LC_ALL": { "const": "C" },
        "LANG": { "const": "C" },
        "TZ": { "const": "UTC0" },
        "TMPDIR": { "const": "/tmp" },
        "OMP_NUM_THREADS": { "const": "1" },
        "OMP_DYNAMIC": { "const": "FALSE" },
        "CUDA_VISIBLE_DEVICES": { "enum": ["", "0"] }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment", "expected_particles", "expected_moving", "expected_fluid"],
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "minItems": 20,
          "maxItems": 32
        },
        "environment": { "$ref": "#/$defs/environment" },
        "expected_particles": { "const": 9078 },
        "expected_moving": { "const": 2669 },
        "expected_fluid": { "const": 6409 }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "network",
        "guest_uid",
        "guest_gid",
        "guest_cap_eff",
        "host_write_bind_count",
        "project_workspace_write_bind_count",
        "sudo_used",
        "apparmor_profile_used",
        "preserve_stage"
      ],
      "properties": {
        "model": { "const": "ROOTLESS_UID1000_CAP0_BWRAP_NETNS_ONE_FRESH_LAB_OUTPUT_BIND" },
        "network": { "const": false },
        "guest_uid": { "const": 1000 },
        "guest_gid": { "const": 1000 },
        "guest_cap_eff": { "const": "0000000000000000" },
        "host_write_bind_count": { "const": 1 },
        "project_workspace_write_bind_count": { "const": 0 },
        "sudo_used": { "const": false },
        "apparmor_profile_used": { "const": false },
        "preserve_stage": { "const": true }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_root",
        "output_root",
        "stage_root",
        "guest_output_root",
        "start_receipt",
        "final_receipt",
        "failure_receipt",
        "stdout_log",
        "stderr_log",
        "resource_log"
      ],
      "properties": {
        "attempt_root": { "$ref": "#/$defs/absolutePath" },
        "output_root": { "$ref": "#/$defs/absolutePath" },
        "stage_root": { "$ref": "#/$defs/absolutePath" },
        "guest_output_root": { "$ref": "#/$defs/absolutePath" },
        "start_receipt": { "$ref": "#/$defs/absolutePath" },
        "final_receipt": { "$ref": "#/$defs/absolutePath" },
        "failure_receipt": { "$ref": "#/$defs/absolutePath" },
        "stdout_log": { "$ref": "#/$defs/absolutePath" },
        "stderr_log": { "$ref": "#/$defs/absolutePath" },
        "resource_log": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_time_s", "end_time_s", "output_period_s", "part_first", "part_last", "part_count", "maximum_output_bytes"],
      "properties": {
        "start_time_s": { "type": "number", "minimum": 0, "maximum": 120 },
        "end_time_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "output_period_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
        "part_first": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "part_last": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "part_count": { "type": "integer", "minimum": 2, "maximum": 401 },
        "maximum_output_bytes": { "type": "integer", "minimum": 8388608, "maximum": 268435456 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_timeout_seconds", "kill_after_seconds", "monitor_interval_seconds", "minimum_mem_available_bytes", "maximum_output_bytes"],
      "properties": {
        "wall_timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 1800 },
        "kill_after_seconds": { "type": "integer", "minimum": 5, "maximum": 30 },
        "monitor_interval_seconds": { "type": "integer", "minimum": 10, "maximum": 30 },
        "minimum_mem_available_bytes": { "type": "integer", "minimum": 4294967296 },
        "maximum_output_bytes": { "type": "integer", "minimum": 8388608, "maximum": 268435456 }
      }
    },
    "motionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "translation_axis",
        "translation_amplitude_m",
        "yaw_amplitude_deg",
        "frequency_hz",
        "phase_rad",
        "active_duration_s",
        "tail_duration_s"
      ],
      "properties": {
        "coordinate_frame": { "const": "CASE_XYZ_Z_UP_CONTAINER_BODY" },
        "translation_axis": { "enum": ["NONE", "X"] },
        "translation_amplitude_m": { "type": "number", "minimum": 0, "maximum": 0.01 },
        "yaw_amplitude_deg": { "type": "number", "minimum": 0, "maximum": 5 },
        "frequency_hz": { "type": "number", "minimum": 0, "maximum": 5 },
        "phase_rad": { "type": "number", "minimum": 0, "maximum": 6.283185307179586 },
        "active_duration_s": { "type": "number", "minimum": 0, "maximum": 5 },
        "tail_duration_s": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "comparison_group", "repeat_index", "motion_kind", "motion_contract"],
      "properties": {
        "family": {
          "enum": [
            "BACKEND_PARITY_SHORT",
            "SETTLED_REPLAY_ZERO",
            "SYNTHETIC_TRANSLATION",
            "SYNTHETIC_YAW",
            "FREE_DECAY",
            "SYNTHETIC_COMBINED"
          ]
        },
        "comparison_group": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 96
        },
        "repeat_index": { "type": "integer", "minimum": 1, "maximum": 3 },
        "motion_kind": { "enum": ["ZERO", "TRANSLATION", "YAW", "DECAY", "COMBINED"] },
        "motion_contract": { "$ref": "#/$defs/motionContract" }
      }
    }
  }
}
