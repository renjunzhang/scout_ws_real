{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schema/target_host_s6_final_delivery_analysis_v3.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_type", "status", "attempt_id", "planned_denominator", "provenance", "grids", "windows", "probe_qc", "solver_rows", "comparison_rows", "window_statistics", "series_metrics", "comparisons", "figure_model", "claims"],
  "properties": {
    "schema_version": {"const": "smpcc-r8-liquid-s6-final-delivery-analysis-v3"},
    "document_type": {"const": "SMPCC_R8_LIQUID_S6_FINAL_DELIVERY_ANALYSIS_V3"},
    "status": {"const": "S6_REAL_ENGINE_ANALYSIS_COMPLETE_NOT_PUBLISHED_NOT_ACCEPTED"},
    "attempt_id": {"const": "SIM-S1_CORE_H1_C1_Bsmooth_b01_r01"}, "planned_denominator": {"const": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["gauge_sha256", "selected_sha256", "gauge_contract_sha256", "source_schema", "source_outcome", "optional_unread"], "properties": {"gauge_sha256": {"$ref": "#/$defs/sha"}, "selected_sha256": {"$ref": "#/$defs/sha"}, "gauge_contract_sha256": {"$ref": "#/$defs/sha"}, "source_schema": {"const": "SPMPC_NON_FIXED"}, "source_outcome": {"enum": ["UNKNOWN", "AUTHORITATIVE_SIDECAR"]}, "optional_unread": {"const": true}}},
    "grids": {"type": "object", "additionalProperties": false, "required": ["solver", "comparison", "overlap", "outside_overlap_encoding", "interpolation", "extrapolation", "smoothing"], "properties": {"solver": {"$ref": "#/$defs/grid"}, "comparison": {"$ref": "#/$defs/grid"}, "overlap": {"$ref": "#/$defs/range"}, "outside_overlap_encoding": {"const": "EXPLICIT_NULL_NA"}, "interpolation": {"const": "LINEAR_WITHIN_REGISTERED_OVERLAP_ONLY"}, "extrapolation": {"const": false}, "smoothing": {"const": false}}},
    "windows": {"type": "object", "additionalProperties": false, "required": ["first15", "full_motion", "recorded_tail", "solver_tail"], "properties": {"first15": {"$ref": "#/$defs/range"}, "full_motion": {"$ref": "#/$defs/range"}, "recorded_tail": {"$ref": "#/$defs/range"}, "solver_tail": {"$ref": "#/$defs/range"}}},
    "probe_qc": {"type": "object", "additionalProperties": false, "required": ["registered_probe_count", "row_count", "per_probe"], "properties": {"registered_probe_count": {"const": 16}, "row_count": {"type": "integer", "minimum": 2}, "per_probe": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/probeQc"}}}},
    "solver_rows": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/solverRow"}},
    "comparison_rows": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/comparisonRow"}},
    "window_statistics": {"type": "object", "additionalProperties": false, "required": ["first15", "full_motion", "recorded_tail", "solver_tail"], "properties": {"first15": {"$ref": "#/$defs/windowStats"}, "full_motion": {"$ref": "#/$defs/windowStats"}, "recorded_tail": {"$ref": "#/$defs/windowStats"}, "solver_tail": {"$ref": "#/$defs/windowStats"}}},
    "series_metrics": {"type": "object", "additionalProperties": false, "required": ["H_crest", "H_abs", "H_peak_to_peak", "H_proxy", "H_modal"], "properties": {"H_crest": {"$ref": "#/$defs/metric"}, "H_abs": {"$ref": "#/$defs/metric"}, "H_peak_to_peak": {"$ref": "#/$defs/metric"}, "H_proxy": {"$ref": "#/$defs/metric"}, "H_modal": {"$ref": "#/$defs/metric"}}},
    "comparisons": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/comparison"}},
    "figure_model": {"type": "object", "additionalProperties": false, "required": ["layout", "shared_x", "dual_y_axes", "palette", "panels", "physical_reference_label"], "properties": {"layout": {"const": "THREE_VERTICAL_PANELS"}, "shared_x": {"const": true}, "dual_y_axes": {"const": false}, "palette": {"const": "OKABE_ITO_WITH_REDUNDANT_LINE_STYLE"}, "panels": {"const": ["SURFACES", "SECONDARIES", "HCREST_RESIDUALS"]}, "physical_reference_label": {"const": "PENDING"}}},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "range": {"type": "object", "additionalProperties": false, "required": ["start_s", "end_s"], "properties": {"start_s": {"type": "number"}, "end_s": {"type": "number"}}},
    "grid": {"type": "object", "additionalProperties": false, "required": ["count", "start_s", "end_s", "sha256"], "properties": {"count": {"type": "integer", "minimum": 2}, "start_s": {"type": "number"}, "end_s": {"type": "number"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "probeQc": {"type": "object", "additionalProperties": false, "required": ["name", "valid", "missing", "invalid", "missing_ratio", "invalid_ratio", "pass"], "properties": {"name": {"pattern": "^s5b0_p(?:0[0-9]|1[0-5])$"}, "valid": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0}, "missing_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "invalid_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "pass": {"const": true}}},
    "solverRow": {"type": "object", "additionalProperties": false, "required": ["time_s", "H_crest_m", "H_abs_m", "H_peak_to_peak_m", "H_proxy_m", "H_modal_m", "H_proxy_coverage", "H_modal_coverage", "valid_probe_count"], "properties": {"time_s": {"type": "number"}, "H_crest_m": {"type": "number"}, "H_abs_m": {"type": "number"}, "H_peak_to_peak_m": {"type": "number"}, "H_proxy_m": {"type": ["number", "null"]}, "H_modal_m": {"type": ["number", "null"]}, "H_proxy_coverage": {"enum": ["IN_REGISTERED_OVERLAP", "NA_OUTSIDE_REGISTERED_OVERLAP"]}, "H_modal_coverage": {"enum": ["IN_REGISTERED_OVERLAP", "NA_OUTSIDE_REGISTERED_OVERLAP"]}, "valid_probe_count": {"type": "integer", "minimum": 15, "maximum": 16}}},
    "comparisonRow": {"type": "object", "additionalProperties": false, "required": ["time_s", "H_crest_m", "H_abs_m", "H_peak_to_peak_m", "H_proxy_m", "H_modal_m"], "properties": {"time_s": {"type": "number"}, "H_crest_m": {"type": "number"}, "H_abs_m": {"type": "number"}, "H_peak_to_peak_m": {"type": "number"}, "H_proxy_m": {"type": "number"}, "H_modal_m": {"type": "number"}}},
    "stat": {"type": "object", "additionalProperties": false, "required": ["peak", "p95", "rms", "peak_time_s"], "properties": {"peak": {"type": "number"}, "p95": {"type": "number"}, "rms": {"type": "number"}, "peak_time_s": {"type": "number"}}},
    "windowStats": {"type": "object", "additionalProperties": false, "required": ["H_crest", "H_abs", "H_peak_to_peak"], "properties": {"H_crest": {"$ref": "#/$defs/stat"}, "H_abs": {"$ref": "#/$defs/stat"}, "H_peak_to_peak": {"$ref": "#/$defs/stat"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["amplitude", "frequency_hz", "damping_per_s", "phase_rad"], "properties": {"amplitude": {"type": "number"}, "frequency_hz": {"type": "number", "minimum": 0}, "damping_per_s": {"type": "number"}, "phase_rad": {"type": "number"}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["surface", "secondary", "amplitude_error", "frequency_error_hz", "damping_error_per_s", "phase_error_rad", "correlation", "rmse", "ranking_claimed"], "properties": {"surface": {"enum": ["H_crest", "H_abs", "H_peak_to_peak"]}, "secondary": {"enum": ["H_proxy", "H_modal"]}, "amplitude_error": {"type": "number"}, "frequency_error_hz": {"type": "number"}, "damping_error_per_s": {"type": "number"}, "phase_error_rad": {"type": "number"}, "correlation": {"type": "number", "minimum": -1, "maximum": 1}, "rmse": {"type": "number", "minimum": 0}, "ranking_claimed": {"const": false}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["stage6_pass", "development_only", "single_row", "optional_unread", "paired_ranking", "cross_method_ranking", "selected_trajectory_cpu_comparison", "physical_reference_pending", "physical_fidelity_validated", "formal", "production", "physical_primary"], "properties": {"stage6_pass": {"const": false}, "development_only": {"const": true}, "single_row": {"const": true}, "optional_unread": {"const": true}, "paired_ranking": {"const": false}, "cross_method_ranking": {"const": false}, "selected_trajectory_cpu_comparison": {"const": false}, "physical_reference_pending": {"const": true}, "physical_fidelity_validated": {"const": false}, "formal": {"const": false}, "production": {"const": false}, "physical_primary": {"const": false}}}
  }
}
