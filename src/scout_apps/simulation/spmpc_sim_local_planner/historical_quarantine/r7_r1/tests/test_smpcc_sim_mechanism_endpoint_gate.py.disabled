#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


import importlib.util
import sys
import unittest
from pathlib import Path


MODULE = Path(__file__).resolve().parents[1] / "smpcc_sim_mechanism_endpoint_gate.py"
SPEC = importlib.util.spec_from_file_location("smpcc_endpoint_gate_tested", MODULE)
assert SPEC is not None and SPEC.loader is not None
gate = importlib.util.module_from_spec(SPEC)
sys.modules[SPEC.name] = gate
SPEC.loader.exec_module(gate)


class FrozenEndpointGateTest(unittest.TestCase):
    def make_gate(self):
        return gate.FrozenEndpointGate(
            start_x=-4.0, start_y=0.0, goal_x=5.0, goal_y=0.0)

    @staticmethod
    def odom(target, index, x, v=0.0, w=0.0):
        target.observe_odom(
            x=x, y=0.0, linear_x_mps=v, angular_z_radps=w,
            monotonic_sec=float(index), utc=f"t{index}",
            ros_time_sec=100.0 + float(index))

    def test_initial_pose_must_match_frozen_start(self):
        good = self.make_gate()
        self.odom(good, 0, -4.0)
        self.assertTrue(good.state["initial_pose_gate"]["pass"])
        bad = self.make_gate()
        self.odom(bad, 0, 0.0)
        self.assertFalse(bad.state["initial_pose_gate"]["pass"])

    def test_early_controller_status_never_creates_goal(self):
        target = self.make_gate()
        self.odom(target, 0, -4.0)
        self.odom(target, 1, -3.9, v=0.2)
        target.observe_status(
            "GOAL_REACHED", monotonic_sec=2.0, utc="t2",
            ros_time_sec=102.0)
        for index in range(3, 12):
            self.odom(target, index, 0.84)
        self.assertIn("controller_goal_status_seen", target.state)
        self.assertNotIn("goal_reached", target.state)
        self.assertGreater(target.state["latest_odometry"]["goal_distance_m"], 4.0)

    def test_status_and_five_low_speed_endpoint_samples_are_required(self):
        target = self.make_gate()
        self.odom(target, 0, -4.0)
        self.odom(target, 1, -3.9, v=0.2)
        target.observe_status(
            "GOAL_REACHED", monotonic_sec=2.0, utc="t2",
            ros_time_sec=102.0)
        for index in range(3, 7):
            self.odom(target, index, 4.85, v=0.0)
        self.assertNotIn("goal_reached", target.state)
        self.odom(target, 7, 4.85, v=0.0)
        result = target.state["goal_reached"]
        self.assertTrue(result["controller_status_gate_pass"])
        self.assertTrue(result["geometric_gate_pass"])
        self.assertLessEqual(result["goal_distance_m"], 0.20)
        self.assertEqual(5, result["stable_samples"])

    def test_geometry_without_controller_status_is_not_success(self):
        target = self.make_gate()
        self.odom(target, 0, -4.0)
        self.odom(target, 1, -3.9, v=0.2)
        for index in range(2, 9):
            self.odom(target, index, 4.85)
        self.assertTrue(target.state["geometric_goal_gate"]["pass"])
        self.assertNotIn("goal_reached", target.state)

    def test_nonfinite_yaw_and_timestamps_are_rejected(self):
        with self.assertRaisesRegex(ValueError, "start yaw"):
            gate.FrozenEndpointGate(
                start_x=-4.0, start_y=0.0, start_yaw_rad=float("nan"),
                goal_x=5.0, goal_y=0.0)
        target = gate.FrozenEndpointGate(
            start_x=-4.0, start_y=0.0, start_yaw_rad=0.0,
            goal_x=5.0, goal_y=0.0)
        target.observe_odom(
            x=-4.0, y=0.0, yaw_rad=float("nan"), linear_x_mps=0.0,
            angular_z_radps=0.0, monotonic_sec=0.0, utc="t0",
            ros_time_sec=100.0)
        self.assertTrue(target.state["invalid_odometry_seen"])
        with self.assertRaisesRegex(ValueError, "timestamp"):
            target.observe_status(
                "GOAL_REACHED", monotonic_sec=float("nan"), utc="bad",
                ros_time_sec=101.0)


if __name__ == "__main__":
    unittest.main()
