    def test_public_cli_has_one_release_only_execution_entry(self):
        parser = self.runner.build_parser()
        subparsers = next(action for action in parser._actions if action.dest == "command")
        choices = set(subparsers.choices)
        self.assertEqual({"run-campaign"}, choices)
        run = subparsers.choices["run-campaign"]
        options = {option for action in run._actions for option in action.option_strings}
        self.assertIn("--release", options)
        self.assertNotIn("--seed", options)
        self.assertNotIn("--planned-row-id", options)
        self.assertNotIn("--freeze", options)
        self.assertNotIn("--master", options)

    def test_internal_helpers_reject_direct_unlocked_invocation(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            lock = self.runner.CAMPAIGN_LOCK
            lock.parent.mkdir(parents=True)
            lock.write_text(json.dumps({
                "runner_id": self.runner.RUNNER_ID,
                "pid": os.getppid(),
                "utc": "2026-08-03T00:00:00Z",
            }) + "\n", encoding="utf-8")
            with self.assertRaisesRegex(self.runner.RunnerError, "unlocked campaign"):
                self.runner._require_internal_parent_lock()
            self.assertFalse((paths["result"] / "path_replay_receipt.json").exists())

    def test_release_admission_rejects_test_root_and_all_predecessors_before_reading(self):
        for path in (
            Path("/data/a/scout_sim_replacement/test-root/mechanism_release.json"),
            Path("/data/a/scout_sim_replacement/SMPCC-SIM-MECHANISM-40-64-88-R1/release/mechanism_release.json"),
            Path("/data/a/scout_sim_replacement/SMPCC-SIM-MECHANISM-40-64-88-R2/release/mechanism_release.json"),
            Path("/data/a/scout_sim_replacement/SMPCC-SIM-MECHANISM-40-64-88-R3/release/mechanism_release.json"),
            Path("/data/a/scout_sim_replacement/SMPCC-SIM-MECHANISM-40-64-88-R4/release/mechanism_release.json"),
        ):
            with self.subTest(path=path), self.assertRaises(self.runner.RunnerError):
                self.runner.admit(path)

    def test_release_admission_accepts_only_fully_bound_r7_contract(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            go_path = paths["namespace"] / "go_gate" / "go_gate_receipt.json"
            self._write_json(go_path, {"go_receipt_hash": "d" * 64})
            go = {"path": str(go_path), "sha256": self.runner.sha256_file(go_path)}
            runner_source = Path(self.runner.__file__).resolve()
            runner_descriptor = {"path": str(runner_source), "sha256": self.runner.sha256_file(runner_source)}
            candidate_path = paths["freeze"].parent / "mechanism_freeze_candidate.json"
            self._write_json(candidate_path, {"fixture": True})
            candidate_descriptor = {
                "path": str(candidate_path),
                "sha256": self.runner.sha256_file(candidate_path),
            }
            contract_path = paths["freeze"].parent / "crn_runtime_consumer_contract.json"
            self._write_json(contract_path, {"fixture": True})
            contract_descriptor = {
                "path": str(contract_path),
                "sha256": self.runner.sha256_file(contract_path),
            }
            contract_hash = "1" * 64
            freeze = {
                "protocol_id": self.runner.PROTOCOL_ID,
                "release_id": self.runner.RELEASE_ID,
                "physical_alignment": False,
                "physical_primary_eligible": False,
                "freeze_hash": "e" * 64,
                "runtime_bindings_hash": "f" * 64,
                "go_gate_evidence": go,
                "runtime_bindings": {"mechanism_runner": runner_descriptor},
                "freeze_candidate": candidate_descriptor,
                "crn_runtime_consumer_contract": contract_descriptor,
            }
            self._write_json(paths["freeze"], freeze)
            master = self._schedule_master()
            master.update({
                "freeze": {"path": str(paths["freeze"]), "sha256": self.runner.sha256_file(paths["freeze"])},
                "freeze_hash": freeze["freeze_hash"],
            })
            self._write_json(paths["master"], master)
            initial_core = {
                "result_root_state": "ABSENT",
                "bag_root_state": "ABSENT",
                "dataset_index_absent": True,
                "attempts_dir_absent": True,
                "N_attempt": 0,
                "predecessor_attempts_migrated": 0,
            }
            release_core = {
                "schema_version": self.runner.RELEASE_SCHEMA_VERSION,
                "document_type": self.runner.RELEASE_DOCUMENT_TYPE,
                "protocol_id": self.runner.PROTOCOL_ID,
                "release_id": self.runner.RELEASE_ID,
                "namespace": self.runner.NAMESPACE,
                "formal": True,
                "formal_scope": self.runner.FORMAL_SCOPE,
                "physical_alignment": False,
                "physical_primary_eligible": False,
                "physical_primary": None,
                "evidence_class": self.runner.RELEASE_EVIDENCE_CLASS,
                "freeze": {"path": str(paths["freeze"]), "sha256": self.runner.sha256_file(paths["freeze"])},
                "freeze_hash": freeze["freeze_hash"],
                "master": {"path": str(paths["master"]), "sha256": self.runner.sha256_file(paths["master"])},
                "master_hash": master["master_hash"],
                "go_gate_evidence": go,
                "go_gate_receipt_hash": "d" * 64,
                "runtime_bindings_hash": freeze["runtime_bindings_hash"],
                "crn_runtime_consumer_contract": contract_descriptor,
                "crn_runtime_consumer_contract_hash": contract_hash,
                "crn_runtime_ack_schema_hash":
                    self.runner.crn_runtime.RUNTIME_ACK_SCHEMA_HASH,
                "result_policy": master["result_policy"],
                "predecessor_exclusion": self.runner._expected_predecessor_exclusion(),
                "initial_state": dict(initial_core, initial_state_hash=self.runner.canonical_hash(initial_core)),
                "canonical_runner": runner_descriptor,
                "created_utc": "2026-08-03T00:00:00Z",
            }
            release = dict(release_core, release_hash=self.runner.canonical_hash(release_core))
            self._write_json(paths["release"], release)
            crn_report = {
                "status": "PASS",
                "contract_hash": contract_hash,
                "runtime_ack_schema_hash":
                    self.runner.crn_runtime.RUNTIME_ACK_SCHEMA_HASH,
            }
            with mock.patch.object(self.runner.release_tool, "validate_release", return_value={"status": "PASS", "errors": []}), mock.patch.object(
                self.runner.freeze_tool, "validate_freeze", return_value={"status": "PASS", "errors": [], "freeze_hash": freeze["freeze_hash"]},
            ), mock.patch.object(
                self.runner.matrix_tool, "validate_master", return_value={"status": "PASS", "errors": [], "master_hash": master["master_hash"]},
            ), mock.patch.object(
                self.runner.freeze_tool,
                "validate_crn_runtime_consumer_contract",
                return_value=crn_report,
            ) as validate_crn:
                admission = self.runner.admit(paths["release"])
                validate_crn.assert_called_once_with(
                    contract_descriptor, {"fixture": True}, candidate_path)
                for field, bad_value, message in (
                    ("crn_runtime_consumer_contract",
                     dict(contract_descriptor, sha256="0" * 64),
                     "differs from freeze"),
                    ("crn_runtime_consumer_contract_hash", "0" * 64,
                     "contract hash mismatch"),
                    ("crn_runtime_ack_schema_hash", "0" * 64,
                     "ACK schema hash mismatch"),
                ):
                    bad_core = dict(release_core, **{field: bad_value})
                    bad_release = dict(
                        bad_core,
                        release_hash=self.runner.canonical_hash(bad_core),
                    )
                    paths["release"].chmod(0o644)
                    self._write_json(paths["release"], bad_release)
                    with self.subTest(field=field), self.assertRaisesRegex(
                            self.runner.RunnerError, message):
                        self.runner.admit(paths["release"])
            self.assertEqual(self.runner.RELEASE_ID, admission.release["release_id"])
            self.assertEqual(paths["master"], admission.master_path)

    def test_frozen_seed_has_no_operator_override(self):
        master = self._schedule_master()
        row = master["planned_rows"][0]
        unit = master["seed_bundles"][f"{row['stage']}:{row['block_id']}"]["traces"]["simulator_rng"]["samples"][0]["unit_uniform"]
        expected = int(math.floor(unit * 2147483647.0))
        self.assertEqual(expected, self.runner.frozen_simulator_seed(master, row))
        policy = self.runner.validate_crn_stream_application_registry()
        self.assertEqual("ACTIVE", policy["simulator_rng"]["application_mode"])
        self.assertEqual(
            "INACTIVE_ZERO_AMPLITUDE",
            policy["sensor_noise"]["application_mode"],
        )
        trace_hashes = {
            stream: self.runner.canonical_hash({"stream": stream})
            for stream in self.runner.crn_runtime.SEED_STREAMS
        }

        class Consumer:
            stream_trace_hashes = trace_hashes
            initial_yaw_offset_rad = 0.01

        units = {stream: 0.25 for stream in trace_hashes}
        units["initial_robot_pose"] = 0.75
        units["simulator_rng"] = unit
        consumptions = {
            stream: {
                "stream": stream,
                "trace_hash": trace_hashes[stream],
                "consumption_phase":
                    self.runner.crn_runtime.CONSUMPTION_PHASES[stream],
                "time_domain": self.runner.crn_runtime.TIME_DOMAIN,
                "time_origin_event": self.runner.crn_runtime.TIME_ORIGIN_EVENT,
                "time_index_ms": 0.0,
                "interpolation": self.runner.crn_runtime.INTERPOLATION,
                "unit_uniform": units[stream],
            }
            for stream in trace_hashes
        }
        resolved = self.runner.resolve_crn_stream_applications(
            consumptions, consumer=Consumer(),
            frozen_path_initial_yaw_rad=0.0, simulator_seed=expected,
        )
        self.assertEqual(0.0, resolved["sensor_noise"]["applied_value"])
        receipt = self.runner.build_crn_application_receipt(
            case_manifest_hash="f" * 64, row=row,
            stream_application=resolved,
        )
        self.assertFalse(receipt["nonzero_unfrozen_noise_invented"])
        self.assertEqual(
            self.runner.canonical_hash({
                key: value for key, value in receipt.items()
                if key != "receipt_hash"
            }),
            receipt["receipt_hash"],
        )

    def test_fixed_profile_command_consumes_release_and_frozen_descriptor_identity(self):
        with tempfile.TemporaryDirectory() as temporary:
            profile = Path(temporary) / "H1_C1.csv"
            profile.write_text("fixture\n", encoding="utf-8")
            profile_hash = self.runner.sha256_file(profile)
            row = {"path_id": "H1", "container_id": "C1"}
            freeze = {
                "fixed_profiles": {
                    "H1_C1": {"profile": {"path": str(profile), "sha256": profile_hash}},
                },
            }
            admission = self.runner.CampaignAdmission(
                Path("/fixture/release.json"), {"release_hash": "c" * 64},
                Path("/fixture/freeze.json"), freeze,
                Path("/fixture/master.json"), {},
            )
            command = " ".join(self.runner._profile_command(admission, row, profile))
            self.assertIn("spmpc_sim_local_planner", command)
            self.assertNotIn("spmpc_experiments", command)
            self.assertIn("smpcc_sim_mechanism_fixed_profile.launch", command)
            self.assertIn(f"frozen_profile_sha256:={profile_hash}", command)
            self.assertIn("mechanism_release_hash:=" + "c" * 64, command)
            self.assertIn("fixed_profile_id:=H1_C1", command)
            self.assertIn("frozen_path_id:=H1", command)
            recorded, fixed_required = self.runner._bag_topic_contract(
                "FixedProfile")
            _recorded, online_required = self.runner._bag_topic_contract("Bslosh")
            self.assertIn("/sim_mechanism/fixed_profile/identity", fixed_required)
            self.assertIn("/sim_spmpc/status", fixed_required)
            self.assertIn("/sim_spmpc/status", online_required)
            self.assertNotIn(
                "/sim_mechanism/fixed_profile/identity", online_required)
            self.assertTrue(set(fixed_required).issubset(recorded))
            self.assertTrue(set(online_required).issubset(recorded))

    def test_shared_source_r7_execution_is_quarantined_before_release_io(self):
        with self.assertRaisesRegex(self.runner.RunnerError, "source-separated R8"):
            self.runner.run_campaign(
                Path("/definitely/not/a/release.json"), None, 1,
                11700, 11900, True,
            )

    def test_ledger_accepts_current_release_and_rejects_old_master(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            self._bound_files(paths, master, release)
            record = self._record(paths, master, release, master["planned_rows"][0])
            paths["index"].write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8")
            loaded = self.runner.load_ledger(paths["index"], master, release)
            self.assertEqual(1, len(loaded))
            bad = dict(record, master_hash="d" * 64)
            core = dict(bad); core.pop("entry_hash")
            bad["entry_hash"] = self.runner.canonical_hash(core)
            paths["index"].write_text(json.dumps(bad, sort_keys=True) + "\n", encoding="utf-8")
            with self.assertRaisesRegex(self.runner.RunnerError, "another master"):
                self.runner.load_ledger(paths["index"], master, release)

            # Even a fully re-hashed ledger/manifest/postflight chain cannot
            # turn a failed geometric endpoint gate into method success.
            manifest_path = Path(str(record["attempt_manifest_path"]))
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            event_path = Path(str(manifest["events_path"]))
            event = json.loads(event_path.read_text(encoding="utf-8"))
            event["goal_reached"]["geometric_gate_pass"] = False
            event_path.chmod(0o644)
            self._write_json(event_path, event)
            endpoint = {
                key: event.get(key) for key in (
                    "initial_pose_gate", "controller_goal_status_seen",
                    "geometric_goal_gate", "goal_reached",
                    "latest_odometry")
            }
            postflight_path = Path(str(manifest["postflight_path"]))
            postflight = json.loads(
                postflight_path.read_text(encoding="utf-8"))
            postflight["endpoint_evidence"] = endpoint
            postflight_path.chmod(0o644)
            self._write_json(postflight_path, postflight)
            manifest["endpoint_evidence"] = endpoint
            manifest["events_hash"] = self.runner.sha256_file(event_path)
            manifest["postflight_hash"] = self.runner.sha256_file(
                postflight_path)
            manifest_path.chmod(0o644)
            self._write_json(manifest_path, manifest)
            tampered = dict(record, master_hash=master["master_hash"],
                            attempt_manifest_hash=
                            self.runner.sha256_file(manifest_path))
            tampered_core = dict(tampered)
            tampered_core.pop("entry_hash")
            tampered["entry_hash"] = self.runner.canonical_hash(tampered_core)
            paths["index"].write_text(
                json.dumps(tampered, sort_keys=True) + "\n",
                encoding="utf-8")
            with self.assertRaisesRegex(self.runner.RunnerError, "endpoint"):
                self.runner.load_ledger(paths["index"], master, release)

    def test_ledger_rejects_cross_release_manifest_and_orphan_old_attempt(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            self._bound_files(paths, master, release)
            record = self._record(paths, master, release, master["planned_rows"][0])
            record["attempt_manifest_path"] = str(Path(temporary) / "R2" / "attempt_manifest.json")
            core = dict(record); core.pop("entry_hash")
            record["entry_hash"] = self.runner.canonical_hash(core)
            paths["index"].write_text(json.dumps(record, sort_keys=True) + "\n", encoding="utf-8")
            with self.assertRaisesRegex(self.runner.RunnerError, "must be exactly"):
                self.runner.load_ledger(paths["index"], master, release)

        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            (paths["result"] / "attempts" / "COPIED_FROM_R2").mkdir(parents=True)
            with self.assertRaisesRegex(self.runner.RunnerError, "inventory"):
                self.runner.load_ledger(paths["index"], master, release)

    def test_append_reloads_head_under_lock_and_preserves_chain(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            self._bound_files(paths, master, release)
            record = self._record(paths, master, release, master["planned_rows"][0])
            core = dict(record); core.pop("entry_hash"); core.pop("previous_entry_hash")
            entry = self.runner.append_ledger(paths["index"], core, master, release)
            self.assertEqual("0" * 64, entry["previous_entry_hash"])
            self.assertEqual([entry], self.runner.load_ledger(paths["index"], master, release))
            with self.assertRaisesRegex(self.runner.RunnerError, "attempt"):
                self.runner.append_ledger(paths["index"], core, master, release)

    def test_campaign_lock_is_nonblocking_and_dry_refusal_has_no_side_effect(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            with self.runner.campaign_lock():
                with self.assertRaisesRegex(self.runner.RunnerError, "another canonical runner"):
                    with self.runner.campaign_lock():
                        self.fail("second lock unexpectedly acquired")
            lock = paths["namespace"] / "locks" / "r7_campaign.lock"
            lock.unlink()
            lock.parent.rmdir()
            with self.assertRaisesRegex(self.runner.RunnerError, "explicit --execute"):
                self.runner.run_campaign(paths["release"], None, 1, 11700, 11900, False)
            self.assertFalse(lock.exists())

    def test_s1_cannot_auto_advance_into_s2a_without_authorization(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            admission = self.runner.CampaignAdmission(
                paths["release"], release, paths["freeze"], {},
                paths["master"], master,
            )
            terminal_prefix = [
                {
                    "planned_row_id": row["planned_row_id"],
                    "method_success": True,
                    "method_failure": False,
                    "entry_hash": f"{index:064x}",
                }
                for index, row in enumerate(master["planned_rows"][:40], 1)
            ]
            first_s2a = master["planned_rows"][40]
            attempt_id = str(first_s2a["planned_row_id"]) + "_r01"
            with mock.patch.object(self.runner, "load_ledger", return_value=terminal_prefix), self.assertRaisesRegex(
                self.runner.RunnerError, "immutable stage authorization",
            ):
                self.runner._validate_next_row(admission, first_s2a, attempt_id, None)

    def test_summary_reports_n_pair_only_per_registered_contrast(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master()
            release = {"release_hash": "c" * 64}
            admission = self.runner.CampaignAdmission(
                paths["release"], release, paths["freeze"], {},
                paths["master"], master,
            )
            picked = [
                row for row in master["planned_rows"]
                if row["stage"] == "SIM-S1_CORE" and
                row["block_id"] == "b01" and
                row["condition_id"] in {"B0", "Bsmooth"}
            ]
            records = [{
                "planned_row_id": row["planned_row_id"],
                "stage": row["stage"],
                "condition_id": row["condition_id"],
                "method_success": True,
                "method_failure": False,
                "continuous_eligible": True,
            } for row in picked]
            with mock.patch.object(self.runner, "load_ledger", return_value=records):
                summary = self.runner.summarize(admission)
            contrast = "SIM-S1_CORE:B0-vs-Bsmooth"
            self.assertNotIn("N_pair", summary)
            self.assertIsNone(summary["N_pair_cross_contrast_aggregate"])
            self.assertEqual(1, summary["N_pair_by_contrast"][contrast]["N_pair"])
            self.assertEqual(["b01"], summary["N_pair_by_contrast"][contrast]["eligible_blocks"])

    def test_symlink_dataset_index_is_rejected(self):
        with tempfile.TemporaryDirectory() as temporary, self._paths(Path(temporary)) as paths:
            master = self._schedule_master(); release = {"release_hash": "c" * 64}
            paths["result"].mkdir(parents=True)
            target = Path(temporary) / "outside.jsonl"; target.write_text("", encoding="utf-8")
            paths["index"].symlink_to(target)
            with self.assertRaisesRegex(self.runner.RunnerError, "symlink"):
                self.runner.load_ledger(paths["index"], master, release)

    def test_event_race_is_post_motion_protocol_and_method_failure_is_preserved(self):
        source = SCRIPT.read_text(encoding="utf-8")
        self.assertIn("state_lock = threading.RLock()", source)
        self.assertGreaterEqual(source.count("with state_lock:"), 3)
        self.assertLess(
            source.index('children.start("event_monitor"'),
            source.index('time.sleep(30.0)'),
        )
        self.assertEqual(30.0, self.runner.INITIAL_POSE_ACQUISITION_TIMEOUT_SEC)
        self.assertEqual(45.0, self.runner.MOTION_ACQUISITION_TIMEOUT_SEC)
        self.assertEqual(5, self.runner.ZERO_COMMAND_MAX_ATTEMPTS)
        self.assertEqual(2, self.runner.ZERO_COMMAND_REQUIRED_SUCCESSES)
        zero_lifecycle = []
        with mock.patch.object(
                self.runner.sim_only, "publish_zero",
                side_effect=[False, True, True]) as publish:
            self.runner._publish_frozen_zero_suffix({}, zero_lifecycle)
        self.assertEqual(3, publish.call_count)
        self.assertEqual("redundant_zero_suffix_published",
                         zero_lifecycle[-1]["event"])
        self.assertEqual(2, sum(
            item["published"] for item in
            zero_lifecycle[-1]["attempts"]))
        self.assertIn(
            '"campaign_action": classification["campaign_action"]', source)
        self.assertIn(
            '"protocol_qc_pass": classification["protocol_qc_pass"]', source)
        internal_case_source = source[
            source.index("def _admit_internal_case"):
            source.index("def command_path_replay")]
        self.assertNotIn("admit(DEFAULT_RELEASE)", internal_case_source)
        self.assertIn("internal canonical runner binding mismatch",
                      internal_case_source)
        self.assertEqual(
            "PROTOCOL_FAILURE_AFTER_MOTION",
            self.runner._classify("cannot read event state: Extra data", True),
        )
        classified = self.runner.runtime_qc.classify_outcome(
            motion_started=True, primary_method_outcome="METHOD_FAILURE",
            qc_failure=True,
        )
        self.assertTrue(classified["method_failure"])
        self.assertFalse(classified["method_success"])
        self.assertEqual("METHOD_FAILURE", classified["failure_class"])
        self.assertEqual(
            "STOP_CAMPAIGN_REVIEW_WITH_TERMINAL_METHOD_FAILURE",
            classified["campaign_action"],
        )
        with tempfile.TemporaryDirectory() as temporary, self._paths(
                Path(temporary)) as paths:
            master = self._schedule_master()
            release = {"release_hash": "c" * 64}
            row = master["planned_rows"][0]
            attempt_id = str(row["planned_row_id"]) + "_r01"
            (paths["result"] / "attempts" / attempt_id).mkdir(parents=True)
            (paths["bags"] / attempt_id).mkdir(parents=True)
            core = {
                "schema_version": self.runner.SCHEMA_VERSION,
                "record_type": "SMPCC_SIM_MECHANISM_DATASET_INDEX_ENTRY",
                "protocol_id": self.runner.PROTOCOL_ID,
                "release_id": self.runner.RELEASE_ID,
                "formal": True, "formal_scope": self.runner.FORMAL_SCOPE,
                "physical_primary_eligible": False,
                "release_hash": release["release_hash"],
                "master_hash": master["master_hash"],
                "planned_row_id": row["planned_row_id"],
                "attempt_id": attempt_id, "stage": row["stage"],
                "condition_id": row["condition_id"],
                "method_success": False, "method_failure": True,
                "continuous_eligible": False, "motion_started": True,
                "assignment_consumed": True,
                "failure_class": classified["failure_class"],
                "campaign_action": classified["campaign_action"],
                "protocol_qc_pass": classified["protocol_qc_pass"],
                "outcome_qc_hash": classified["outcome_qc_hash"],
                "attempt_manifest_path": str(
                    paths["result"] / "attempts" / attempt_id /
                    "attempt_manifest.json"),
                "attempt_manifest_hash": "d" * 64,
                "created_utc": "2026-08-03T00:00:00Z",
                "previous_entry_hash": "0" * 64,
            }
            entry = dict(core, entry_hash=self.runner.canonical_hash(core))
            with mock.patch.object(self.runner, "_validate_attempt_binding"):
                self.runner._validate_ledger_records(
                    [entry], master, release)
            admission = self.runner.CampaignAdmission(
                paths["release"], release, paths["freeze"], {},
                paths["master"], master,
            )
            with mock.patch.object(
                    self.runner, "load_ledger", return_value=[entry]):
                _row, next_attempt, _authorization, reason = (
                    self.runner._next_dispatch(admission))
            self.assertIsNone(next_attempt)
            self.assertEqual(
                "PROTOCOL_OR_QC_FAILURE_REQUIRES_CAMPAIGN_REVIEW", reason)


if __name__ == "__main__":
    unittest.main()
