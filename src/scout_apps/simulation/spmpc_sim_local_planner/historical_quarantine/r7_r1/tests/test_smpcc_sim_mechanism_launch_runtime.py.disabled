#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.
"""Pre-exec runtime-admission tests for the separate simulation target.

Each rejection is evaluated before the gate reaches ``os.execvp``.  Therefore
none can create the separately linked controller process or its /cmd_vel
publisher.  Full Gazebo execution remains a release-controlled operation.
"""

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


import importlib.util
from pathlib import Path
import unittest


WORKSPACE = Path(__file__).resolve().parents[6]
GATE_PATH = (
    WORKSPACE / "src/scout_apps/simulation/spmpc_sim_local_planner/scripts/"
    "smpcc_sim_controller_gate.py"
)
SPEC = importlib.util.spec_from_file_location("sim_gate_runtime", GATE_PATH)
assert SPEC is not None and SPEC.loader is not None
gate = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(gate)


def valid(condition="SIM_Bsmooth_R1", container="C1"):
    return {
        "ros_master_uri": "http://127.0.0.1:11328",
        "use_sim_time": True,
        "condition_id": condition,
        "container_condition": container,
        "parameters": gate.required_parameter_paths(condition, container),
    }


class SimMechanismLaunchRuntimeTest(unittest.TestCase):
    def test_every_manual_boundary_refuses_before_exec(self):
        cases = []
        for condition in tuple(gate.CONDITIONS):
            for container in tuple(gate.CONTAINERS):
                value = valid(condition, container)
                value["use_sim_time"] = False
                cases.append(value)
        for key, bad in (
            ("sim_adapter/release_ack", False),
            ("sim_adapter/launch_marker", False),
            ("solver_backend", "primitive"),
            ("frames/use_tf_pose", True),
            ("slosh_observer/source", "processed_imu"),
            ("imu_shadow/enable", True),
            ("delay_phase/mode", "monitor"),
            ("control_frequency", 20.0),
            ("horizon_steps", 8),
            ("slosh/container_radius", 0.02),
        ):
            value = valid()
            value["parameters"][key] = bad
            cases.append(value)
        value = valid(); value["ros_master_uri"] = "http://localhost:11328"; cases.append(value)
        value = valid(); value["condition_id"] = "SIM_typo"; cases.append(value)
        value = valid(); value["container_condition"] = "C3"; cases.append(value)
        self.assertEqual(23, len(cases))
        for value in cases:
            with self.assertRaises(gate.GateError):
                gate.validate_snapshot(value)
        source = GATE_PATH.read_text(encoding="utf-8")
        self.assertLess(source.index("validate_snapshot(_read_live_snapshot())"),
                        source.index("os.execvp("))
        print("RUNTIME_REJECTION_CASES=23")

    def test_positive_fixture_is_admitted_only_to_sim_target(self):
        receipt = gate.validate_snapshot(valid("SIM_Bslosh_R1", "C2"))
        self.assertEqual("SMPCC_SIM_LOCAL_PLANNER_TARGET_R8", receipt["target_id"])
        self.assertEqual("SIM_Bslosh_R1", receipt["condition_id"])
        self.assertEqual("C2", receipt["container_condition"])
        source = GATE_PATH.read_text(encoding="utf-8")
        self.assertIn('"spmpc_sim_local_planner"', source)
        self.assertNotIn('"spmpc_local_planner", "spmpc_local_planner_node"', source)
        print("RUNTIME_POSITIVE_FIXTURE_CASES=1")


if __name__ == "__main__":
    unittest.main()
