#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.
"""Fail-closed release tooling for the isolated SIM-ONLY Bslosh R1 condition.

``SIM_Bslosh_R1`` is a frozen controller identity for simulation-only work.  It
is deliberately *not* an input to ``SMPCC-SIM-40-64-88-v0.1``: it does not
align to a physical freeze, does not have physical-primary eligibility, and
never creates original 40/64/88 planned rows, randomisation tables, or a
formal dataset ledger.

This module is intentionally offline.  It starts neither ROS nor Gazebo and
does not write bags/results.  Its only write operation is a one-time,
read-only controller release manifest and the matching effective-config
contract beneath the SIM-ONLY release namespace.  The original matrix formal
gate is probed explicitly and must reject this release with a non-zero exit
and a protocol-mismatch error.
"""

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


import argparse
import copy
import hashlib
import json
import math
import os
import re
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, Iterable, Mapping, Optional, Sequence

try:
    import yaml
except ImportError:  # pragma: no cover - CI/runtime dependency failure is explicit
    yaml = None  # type: ignore[assignment]


