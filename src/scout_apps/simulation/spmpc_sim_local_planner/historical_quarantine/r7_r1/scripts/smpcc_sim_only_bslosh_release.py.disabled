EFFECTIVE_CONFIG_DOCUMENT_TYPE = "SMPCC_SIM_ONLY_BSLOSH_EFFECTIVE_CONFIG"
PROTOCOL_ID = "SMPCC-SIM-ONLY-BSLOSH-R1-v1"
ORIGINAL_FORMAL_PROTOCOL_ID = "SMPCC-SIM-40-64-88-v0.1"
CONDITION_ID = "SIM_Bslosh_R1"
RELEASE_ID = "SIM-ONLY-BSLOSH-R1"

DEFAULT_SIM_ROOT = Path("/data/a/scout_sim_replacement")
SIM_ONLY_NAMESPACE = "SMPCC-SIM-ONLY-BSLOSH-R1"
SIM_ONLY_ROOT = DEFAULT_SIM_ROOT / SIM_ONLY_NAMESPACE
CANONICAL_RELEASE_ROOT = SIM_ONLY_ROOT / "releases" / RELEASE_ID
CANONICAL_RESULTS_ROOT = SIM_ONLY_ROOT / "results" / RELEASE_ID
CANONICAL_BAGS_ROOT = SIM_ONLY_ROOT / "bags" / RELEASE_ID

SCRIPT_PATH = Path(__file__).resolve()
WORKSPACE_ROOT = SCRIPT_PATH.parents[5]
SIM_CONTROLLER_ROOT = WORKSPACE_ROOT / "src/scout_apps/simulation/spmpc_sim_local_planner"
ORIGINAL_TOOLCHAIN_PATH = SCRIPT_PATH.with_name("smpcc_sim_toolchain.py")


class SimOnlyReleaseError(RuntimeError):
    """A release-contract failure that must keep the release NO-GO."""


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SimOnlyReleaseError(message)


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def canonical_hash(value: Any) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def is_sha256(value: Any) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def _as_mapping(value: Any, label: str) -> Mapping[str, Any]:
    require(isinstance(value, Mapping), f"{label} must be an object")
    return value


def _absolute_existing_file(value: Any, label: str) -> Path:
    require(isinstance(value, str) and value.strip(), f"{label} path must be a non-empty string")
    path = Path(value)
    require(path.is_absolute(), f"{label} path must be absolute: {path}")
    require(path.is_file(), f"{label} file is missing: {path}")
    resolved = path.resolve()
    require(str(path) == str(resolved), f"{label} path must not traverse a symlink: {path}")
    return resolved


def _require_below(path: Path, root: Path, label: str) -> Path:
    resolved = path.resolve()
    try:
        resolved.relative_to(root.resolve())
    except ValueError as exc:
        raise SimOnlyReleaseError(f"{label} must be below {root.resolve()}: {resolved}") from exc
    return resolved


def _readonly(path: Path, label: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    require(mode & (stat.S_IWUSR | stat.S_IWGRP | stat.S_IWOTH) == 0, f"{label} must be read-only: {path}")


def _write_json_new_readonly(path: Path, value: Mapping[str, Any], label: str) -> None:
    """Create one immutable JSON artifact; an existing file is never reused."""

    payload = (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")
    try:
        with path.open("xb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(path, 0o444)
    except FileExistsError as exc:
        raise SimOnlyReleaseError(f"{label} already exists: {path}") from exc
    except OSError as exc:
        raise SimOnlyReleaseError(f"cannot write {label} {path}: {exc}") from exc


def _read_json(path: Path, label: str) -> Mapping[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as stream:
            return _as_mapping(json.load(stream), label)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SimOnlyReleaseError(f"cannot read {label} {path}: {exc}") from exc


