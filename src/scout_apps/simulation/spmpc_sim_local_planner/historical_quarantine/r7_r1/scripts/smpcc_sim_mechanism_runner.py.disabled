#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.
"""Canonical serial campaign executor for the R7 simulation-mechanism matrix.

The sole public execution selector is the immutable R7
``mechanism_release.json``.  Freeze, master, row, attempt ID and seed are all
derived from that release; an operator cannot select or override them.  The
runner has no code path to the physical-alignment protocol, and every case
manifest permanently sets ``physical_primary=null``.  Neither a broad kill
command nor a case-local profile generator exists in this program.
"""

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


