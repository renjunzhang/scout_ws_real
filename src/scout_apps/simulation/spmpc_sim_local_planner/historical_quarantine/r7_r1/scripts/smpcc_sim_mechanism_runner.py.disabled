        "protocol_ids": ["SMPCC-SIM-MECHANISM-40-64-88-v1", "SMPCC-SIM-MECHANISM-40-64-88-v2"],
        "namespaces": ["SMPCC-SIM-MECHANISM-40-64-88-R1", "SMPCC-SIM-MECHANISM-40-64-88-R2", "SMPCC-SIM-MECHANISM-40-64-88-R3", "SMPCC-SIM-MECHANISM-40-64-88-R4", "SMPCC-SIM-MECHANISM-40-64-88-R5", "SMPCC-SIM-MECHANISM-40-64-88-R6"],
        "attempt_import_allowed": False,
        "attempts_imported": 0,
        "r3_invalidation_receipt": {
