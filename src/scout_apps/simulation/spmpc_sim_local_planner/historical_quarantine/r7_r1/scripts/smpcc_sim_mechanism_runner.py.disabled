class RunnerError(RuntimeError):
    pass


def require(value: bool, message: str) -> None:
    if not value:
        raise RunnerError(message)


@dataclass(frozen=True)
class CampaignAdmission:
    release_path: Path
    release: Mapping[str, Any]
    freeze_path: Path
    freeze: Mapping[str, Any]
    master_path: Path
    master: Mapping[str, Any]


def _load(filename: str):
    path = SCRIPT_DIR / filename
    spec = importlib.util.spec_from_file_location(f"smpcc_sim_mechanism_{path.stem}", path)
    if spec is None or spec.loader is None:
        raise RunnerError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


freeze_tool = _load("smpcc_sim_mechanism_freeze.py")
matrix_tool = _load("smpcc_sim_mechanism_matrix.py")
release_tool = _load("smpcc_sim_mechanism_release.py")
sim_only = _load("smpcc_sim_only_bslosh_r1_runner.py")
endpoint_gate = _load("smpcc_sim_mechanism_endpoint_gate.py")
crn_runtime = _load("smpcc_sim_mechanism_crn_runtime.py")
runtime_qc = _load("smpcc_sim_mechanism_runtime_qc.py")


def sha256_file(path: Path) -> str: return str(sim_only.sha256_file(path))
def canonical_hash(value: Any) -> str: return str(sim_only.canonical_hash(value))
def utc_now() -> str: return str(sim_only.utc_now())
def read_json(path: Path, label: str) -> Mapping[str, Any]: return sim_only.read_json(path, label)
def write_json_new(path: Path, value: Mapping[str, Any]) -> None: sim_only.write_json_new(path, value)


def lexical_absolute(path: Path) -> Path:
    return Path(os.path.abspath(os.fspath(path)))


def reject_symlink_chain(path: Path, label: str) -> Path:
    path = lexical_absolute(path)
    for component in (path, *path.parents):
        if component.is_symlink():
            raise RunnerError(f"{label} may not contain a symlink: {component}")
    return path


def require_exact_path(path: Path, expected: Path, label: str) -> Path:
    path = reject_symlink_chain(path, label)
    expected = reject_symlink_chain(expected, f"canonical {label}")
    require(path == expected, f"{label} must be exactly {expected}, got {path}")
    return path


def _readonly_path(value: Any, label: str) -> Path:
    require(isinstance(value, Mapping) and set(value) == {"path", "sha256"}, f"{label} must be a path/hash descriptor")
    path = reject_symlink_chain(Path(str(value["path"])), label)
    require(path.is_absolute() and path.is_file(), f"{label} is missing: {path}")
    require(stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0, f"{label} must be read-only")
    require(value.get("sha256") == sha256_file(path), f"{label} hash mismatch")
    return path


def _readonly_bound(value: Any, label: str) -> tuple[Path, Mapping[str, Any]]:
    path = _readonly_path(value, label)
    return path, read_json(path, label)


def _ensure_below(path: Path, root: Path, label: str) -> Path:
    path = reject_symlink_chain(path, label)
    root = reject_symlink_chain(root, f"{label} root")
    try: path.relative_to(root)
    except ValueError as exc: raise RunnerError(f"{label} must be below {root}: {path}") from exc
    return path


def _descriptor_exact(value: Any, expected: Path, label: str) -> tuple[Path, Mapping[str, Any]]:
    path = _readonly_path(value, label)
    require_exact_path(path, expected, label)
    return path, read_json(path, label)


