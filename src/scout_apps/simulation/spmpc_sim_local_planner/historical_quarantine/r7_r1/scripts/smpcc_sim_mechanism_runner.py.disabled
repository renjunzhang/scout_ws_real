        },
    }


def _validate_initial_state(value: Any) -> None:
    require(isinstance(value, Mapping), "release initial_state is missing")
    core = dict(value)
    declared = core.pop("initial_state_hash", None)
    require(
        set(core) == {
            "result_root_state", "bag_root_state", "dataset_index_absent",
            "attempts_dir_absent", "N_attempt", "predecessor_attempts_migrated",
        },
        "release initial_state fields are not exact",
    )
    require(core["result_root_state"] in {"ABSENT", "EMPTY"}, "release result root was not initially absent/empty")
    require(core["bag_root_state"] in {"ABSENT", "EMPTY"}, "release bag root was not initially absent/empty")
    require(
        core["dataset_index_absent"] is True
        and core["attempts_dir_absent"] is True
        and core["N_attempt"] == 0
        and core["predecessor_attempts_migrated"] == 0,
        "release initial_state does not prove a zero-attempt R7 campaign",
    )
    require(declared == canonical_hash(core), "release initial_state_hash mismatch")


def admit(release_path: Path) -> CampaignAdmission:
    """Admit only the one immutable canonical R7 release."""

    release_path = require_exact_path(release_path, DEFAULT_RELEASE, "mechanism release")
    require(
        release_path.is_file()
        and stat.S_IMODE(release_path.stat().st_mode) & WRITE_BITS == 0,
        "mechanism release must be an immutable file",
    )
    release = read_json(release_path, "mechanism release")
    release_fields = {
        "schema_version", "document_type", "protocol_id", "release_id",
        "namespace", "formal", "formal_scope", "physical_alignment",
        "physical_primary_eligible", "physical_primary", "evidence_class",
        "freeze", "freeze_hash", "master", "master_hash", "go_gate_evidence",
        "go_gate_receipt_hash", "runtime_bindings_hash", "result_policy",
        "crn_runtime_consumer_contract",
        "crn_runtime_consumer_contract_hash",
        "crn_runtime_ack_schema_hash",
        "predecessor_exclusion", "initial_state", "canonical_runner",
        "created_utc", "release_hash",
    }
    require(set(release) == release_fields, "mechanism release fields are not the exact R7 schema")
    require(isinstance(release.get("created_utc"), str) and release.get("created_utc"), "mechanism release lacks created_utc")
    expected = {
        "schema_version": RELEASE_SCHEMA_VERSION,
        "document_type": RELEASE_DOCUMENT_TYPE,
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "namespace": NAMESPACE,
        "formal": True,
        "formal_scope": FORMAL_SCOPE,
        "physical_alignment": False,
        "physical_primary_eligible": False,
        "physical_primary": None,
        "evidence_class": RELEASE_EVIDENCE_CLASS,
    }
    for key, wanted in expected.items():
        require(release.get(key) == wanted, f"mechanism release {key} must equal {wanted!r}")
    release_core = dict(release)
    release_hash = release_core.pop("release_hash", None)
    require(release_hash == canonical_hash(release_core), "mechanism release_hash mismatch")
    release_report = release_tool.validate_release(
        release, manifest_path=release_path,
        require_canonical_paths=True, require_empty=False,
    )
    require(release_report.get("status") == "PASS", "mechanism release gate is not PASS: " + "; ".join(release_report.get("errors", [])))
    require(release.get("predecessor_exclusion") == _expected_predecessor_exclusion(), "R7 release predecessor exclusion is not exact")
    _validate_initial_state(release.get("initial_state"))

    freeze_path, freeze = _descriptor_exact(release.get("freeze"), DEFAULT_FREEZE, "release freeze")
    report = freeze_tool.validate_freeze(freeze)
    require(report.get("status") == "PASS", "mechanism freeze gate is not PASS: " + "; ".join(report.get("errors", [])))
    require(
        freeze.get("protocol_id") == PROTOCOL_ID
        and freeze.get("release_id") == RELEASE_ID
        and freeze.get("physical_alignment") is False
        and freeze.get("physical_primary_eligible") is False,
        "wrong mechanism freeze release/scope",
    )
    require(release.get("freeze_hash") == freeze.get("freeze_hash") == report.get("freeze_hash"), "release freeze_hash mismatch")
    require(release.get("runtime_bindings_hash") == freeze.get("runtime_bindings_hash"), "release runtime binding hash mismatch")

    candidate_path, candidate = _descriptor_exact(
        freeze.get("freeze_candidate"),
        DEFAULT_FREEZE.parent / "mechanism_freeze_candidate.json",
        "release-bound CRN freeze candidate",
    )
    contract_path = _readonly_path(
        freeze.get("crn_runtime_consumer_contract"),
        "release-bound CRN runtime consumer contract",
    )
    require_exact_path(
        contract_path,
        DEFAULT_FREEZE.parent / "crn_runtime_consumer_contract.json",
        "release-bound CRN runtime consumer contract",
    )
    crn_report = freeze_tool.validate_crn_runtime_consumer_contract(
        freeze.get("crn_runtime_consumer_contract"), candidate, candidate_path)
    require(
        release.get("crn_runtime_consumer_contract") ==
        freeze.get("crn_runtime_consumer_contract"),
        "release CRN runtime consumer contract differs from freeze",
    )
    require(
        release.get("crn_runtime_consumer_contract_hash") ==
        crn_report.get("contract_hash"),
        "release CRN runtime consumer contract hash mismatch",
    )
    require(
        release.get("crn_runtime_ack_schema_hash") ==
        crn_report.get("runtime_ack_schema_hash") ==
        crn_runtime.RUNTIME_ACK_SCHEMA_HASH,
        "release CRN runtime ACK schema hash mismatch",
    )

    master_path, master = _descriptor_exact(release.get("master"), DEFAULT_MASTER, "release master")
    master_report = matrix_tool.validate_master(master)
    require(master_report.get("status") == "PASS", "mechanism master gate is not PASS: " + "; ".join(master_report.get("errors", [])))
    require(master.get("freeze") == {"path": str(freeze_path), "sha256": sha256_file(freeze_path)}, "master is not bound to the supplied final freeze")
    require(release.get("master_hash") == master.get("master_hash") == master_report.get("master_hash"), "release master_hash mismatch")
    require(release.get("result_policy") == master.get("result_policy") == matrix_tool.result_policy_for(freeze_path, enforce_canonical_paths=True), "release/master result policy mismatch")
    go_gate = release.get("go_gate_evidence")
    go_path = _readonly_path(go_gate, "release GO gate evidence")
    go_document = read_json(go_path, "release GO gate evidence")
    require(release.get("go_gate_receipt_hash") == go_document.get("go_receipt_hash"), "release GO gate receipt hash mismatch")
    require(freeze.get("go_gate_evidence") == go_gate, "release/freeze GO gate evidence mismatch")
    runner_descriptor = {"path": str(Path(__file__).resolve()), "sha256": sha256_file(Path(__file__).resolve())}
    require(release.get("canonical_runner") == runner_descriptor == freeze.get("runtime_bindings", {}).get("mechanism_runner"), "release canonical runner binding mismatch")
    return CampaignAdmission(release_path, release, freeze_path, freeze, master_path, master)


def schedule(master: Mapping[str, Any]) -> list[Mapping[str, Any]]:
    rows = master.get("planned_rows")
    require(isinstance(rows, list) and len(rows) == 88, "master has no 88-row schedule")
    # The rows were created from each frozen table in order; reproduce the
    # same order explicitly so a changed master list cannot reorder execution.
    ordered: list[Mapping[str, Any]] = []
    by_id = {str(row.get("planned_row_id")): row for row in rows if isinstance(row, Mapping)}
    tables = master.get("randomization_tables")
    require(isinstance(tables, Mapping), "master randomization tables are missing")
    for stage in ("SIM-S1_CORE", "SIM-S2A_SELECTIVITY", "SIM-S2B_TRANSFER"):
        table = tables.get(stage); require(isinstance(table, Mapping) and isinstance(table.get("rows"), list), f"{stage} frozen table missing")
        for assignment in table["rows"]:
            row_id = f"{stage}_{assignment['path_id']}_{assignment['container_id']}_{assignment['condition_id']}_{assignment['block_id']}"
            row = by_id.get(row_id); require(isinstance(row, Mapping), f"frozen schedule row is absent: {row_id}")
            ordered.append(row)
    require(len(ordered) == 88 and len({item["planned_row_id"] for item in ordered}) == 88, "frozen schedule is malformed")
    return ordered


def ledger_path(master: Mapping[str, Any]) -> Path:
    policy = master.get("result_policy")
    require(isinstance(policy, Mapping), "master result policy missing")
    require(policy == matrix_tool.result_policy_for(DEFAULT_FREEZE, enforce_canonical_paths=True), "master result policy is not canonical R7")
    root = require_exact_path(Path(str(policy["result_root"])), CANONICAL_RESULT_ROOT, "matrix result root")
    require_exact_path(Path(str(policy["bag_root"])), CANONICAL_BAG_ROOT, "matrix bag root")
    return require_exact_path(Path(str(policy["dataset_index_path"])), CANONICAL_DATASET_INDEX, "dataset index")


def _attempt_dirs(root: Path, label: str) -> set[str]:
    root = reject_symlink_chain(root, label)
    if not root.exists():
        return set()
    require(root.is_dir(), f"{label} must be a directory")
    names: set[str] = set()
    for child in root.iterdir():
        reject_symlink_chain(child, f"{label} child")
        require(child.is_dir(), f"{label} contains a non-directory artifact: {child}")
        names.add(child.name)
    return names


def _validate_receipt_descriptor(
        descriptor: Any, *, expected_path: Path, hash_field: str,
        record_type: str, label: str) -> Mapping[str, Any]:
    require(isinstance(descriptor, Mapping) and
            set(descriptor) == {"path", "sha256", hash_field},
            f"{label} descriptor fields are not exact")
    path = require_exact_path(Path(str(descriptor["path"])), expected_path,
                              label)
    require(path.is_file() and
            stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0,
            f"{label} must be an immutable file")
    require(descriptor.get("sha256") == sha256_file(path),
            f"{label} file hash mismatch")
    receipt = read_json(path, label)
    core = dict(receipt)
    declared = core.pop(hash_field, None)
    require(receipt.get("record_type") == record_type and
            receipt.get("status") == "PASS" and
            declared == canonical_hash(core) and
            descriptor.get(hash_field) == declared,
            f"{label} semantic hash/status mismatch")
    return receipt


def _validate_plain_descriptor(descriptor: Any, *, expected_path: Path,
                               label: str) -> Mapping[str, Any]:
    require(isinstance(descriptor, Mapping) and
            set(descriptor) == {"path", "sha256"},
            f"{label} descriptor fields are not exact")
    path = require_exact_path(Path(str(descriptor["path"])), expected_path,
                              label)
    require(path.is_file() and
            stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0 and
            descriptor.get("sha256") == sha256_file(path),
            f"{label} file/hash/immutability mismatch")
    return read_json(path, label)


@functools.lru_cache(maxsize=256)
def _reaudit_closed_bag_cached(
        bag_path: str, active_paths: tuple[str, ...],
        required_topics: tuple[str, ...], motion_start_ros_time_sec: float,
        terminal_ros_time_sec: float, terminal_kind: str, attempt_id: str,
        case_manifest_hash: str, expected_bag_hash: str) -> Mapping[str, Any]:
    """Reopen each immutable bag once per runner process and rebuild its QC."""

    path = Path(bag_path)
    require(path.is_file() and sha256_file(path) == expected_bag_hash,
            f"attempt {attempt_id} bag changed before recursive audit")
    return runtime_qc.audit_closed_rosbag(
        path, active_artifact_paths=tuple(Path(item) for item in active_paths),
        required_topics=required_topics,
        motion_start_ros_time_sec=motion_start_ros_time_sec,
        terminal_ros_time_sec=terminal_ros_time_sec,
        terminal_kind=terminal_kind, attempt_id=attempt_id,
        case_manifest_hash=case_manifest_hash, protocol_id=PROTOCOL_ID,
        release_id=RELEASE_ID, formal=True, tail_sec=5.0)


def _validate_attempt_binding(record: Mapping[str, Any], row: Mapping[str, Any], master: Mapping[str, Any], release: Mapping[str, Any]) -> None:
    attempt_id = str(record.get("attempt_id", ""))
    row_id = str(row["planned_row_id"])
    _attempt_number(attempt_id, row_id)
    attempt_root = CANONICAL_RESULT_ROOT / "attempts" / attempt_id
    expected_manifest = attempt_root / "attempt_manifest.json"
    manifest_path = require_exact_path(Path(str(record.get("attempt_manifest_path", ""))), expected_manifest, "attempt manifest")
    require(manifest_path.is_file() and stat.S_IMODE(manifest_path.stat().st_mode) & WRITE_BITS == 0, "attempt manifest must be immutable")
    require(record.get("attempt_manifest_hash") == sha256_file(manifest_path), "attempt manifest hash mismatch")
    manifest = read_json(manifest_path, "attempt manifest")
    for key in (
        "protocol_id", "release_id", "formal", "formal_scope",
        "physical_primary_eligible", "attempt_id", "planned_row_id", "stage",
        "condition_id", "method_success", "method_failure", "motion_started",
        "assignment_consumed", "failure_class", "continuous_eligible",
    ):
        require(manifest.get(key) == record.get(key), f"ledger/attempt manifest {key} mismatch for {attempt_id}")
    require(manifest.get("master_hash") == master.get("master_hash"), f"attempt {attempt_id} belongs to another master")
    require(manifest.get("release_hash") == release.get("release_hash"), f"attempt {attempt_id} belongs to another release")
    require(manifest.get("physical_alignment") is False and manifest.get("physical_primary") is None, f"attempt {attempt_id} promotes physical alignment/primary")
    require(manifest.get("method_backend") == row.get("method_backend") and manifest.get("block_id") == row.get("block_id"), f"attempt {attempt_id} backend/block mismatch")
    case_path = require_exact_path(Path(str(manifest.get("case_manifest_path", ""))), attempt_root / "case_manifest.json", "case manifest")
    require(case_path.is_file() and stat.S_IMODE(case_path.stat().st_mode) & WRITE_BITS == 0, "case manifest must be immutable")
    require(manifest.get("case_manifest_hash") == sha256_file(case_path), "case manifest hash mismatch")
    case = read_json(case_path, "case manifest")
    planned = case.get("planned_row")
    require(isinstance(planned, Mapping) and case.get("attempt_id") == attempt_id and planned.get("planned_row_id") == row_id, "case manifest row/attempt mismatch")
    require(case.get("protocol_id") == PROTOCOL_ID and case.get("release_id") == RELEASE_ID and case.get("formal") is True and case.get("formal_scope") == FORMAL_SCOPE and case.get("physical_alignment") is False and case.get("physical_primary_eligible") is False and case.get("physical_primary") is None, "case manifest release/scope/primary mismatch")
    case_master = case.get("master"); case_release = case.get("release")
    require(isinstance(case_master, Mapping) and case_master.get("master_hash") == master.get("master_hash"), "case manifest master mismatch")
    require(isinstance(case_release, Mapping) and case_release.get("release_hash") == release.get("release_hash"), "case manifest release mismatch")
    require(case.get("release") == {"path": str(DEFAULT_RELEASE), "sha256": sha256_file(DEFAULT_RELEASE), "release_hash": release.get("release_hash")}, "case manifest release descriptor mismatch")
    require(case.get("master") == {"path": str(DEFAULT_MASTER), "sha256": sha256_file(DEFAULT_MASTER), "master_hash": master.get("master_hash")}, "case manifest master descriptor mismatch")
    require(DEFAULT_FREEZE.is_file() and
            stat.S_IMODE(DEFAULT_FREEZE.stat().st_mode) & WRITE_BITS == 0,
            "canonical freeze disappeared or became writable")
    freeze = read_json(DEFAULT_FREEZE, "attempt canonical freeze")
    require(case.get("freeze") == {
                "path": str(DEFAULT_FREEZE),
                "sha256": sha256_file(DEFAULT_FREEZE),
            }, f"attempt {attempt_id} freeze descriptor mismatch")
    simulator_assets = freeze.get("simulator_assets")
    require(isinstance(simulator_assets, Mapping) and
            case.get("simulator_assets") == simulator_assets and
            set(simulator_assets) == {
                "map", "world", "world_geometry", "robot_model"},
            f"attempt {attempt_id} simulator asset registry mismatch")
    for asset_name, asset_descriptor in simulator_assets.items():
        require(isinstance(asset_descriptor, Mapping) and
                set(asset_descriptor) == {"path", "sha256"},
                f"attempt simulator {asset_name} descriptor is malformed")
        asset_path = reject_symlink_chain(
            Path(str(asset_descriptor["path"])),
            f"attempt simulator {asset_name} asset")
        require(asset_path.is_absolute() and asset_path.is_file() and
                asset_descriptor.get("sha256") == sha256_file(asset_path),
                f"attempt simulator {asset_name} asset hash mismatch")
    path_descriptor = freeze.get("paths", {}).get(
        row.get("path_id"), {}).get("sim_path")
    container_descriptor = freeze.get("containers", {}).get(
        row.get("container_id"))
    require(isinstance(path_descriptor, Mapping) and
            set(path_descriptor) == {"path", "sha256"} and
            case.get("path") == dict(path_descriptor),
            f"attempt {attempt_id} frozen path descriptor mismatch")
    require(isinstance(container_descriptor, Mapping) and
            set(container_descriptor) == {"path", "sha256"} and
            case.get("container") == dict(container_descriptor),
            f"attempt {attempt_id} frozen container descriptor mismatch")
    path_file = _readonly_path(path_descriptor, "attempt frozen path")
    _readonly_path(container_descriptor, "attempt frozen container")
    path_document = read_json(path_file, "attempt frozen path")
    points = path_document.get("points")
    require(isinstance(points, list) and points and
            isinstance(points[0], Mapping),
            f"attempt {attempt_id} frozen path has no start")
    yaw_offset = row.get("crn_initial_yaw_offset_rad")
    require(isinstance(yaw_offset, (int, float)) and
            not isinstance(yaw_offset, bool) and
            math.isfinite(float(yaw_offset)),
            f"attempt {attempt_id} row yaw realization is invalid")
    frozen_path_yaw = float(points[0].get("yaw", 0.0))
    expected_spawn_yaw = frozen_path_yaw + float(yaw_offset)
    require(case.get("pose_contract") == {
                "authoritative_pose_topic": "/odom",
                "authoritative_pose_semantic": "gazebo_odometry_message",
                "frozen_path_coordinate_contract":
                    "gazebo_odometry_numeric_world",
                "online_planner_use_tf_pose": False,
                "controller_status_is_sufficient_for_success": False,
                "initial_yaw_offset_rad": float(yaw_offset),
                "expected_spawn_yaw_rad": expected_spawn_yaw,
            }, f"attempt {attempt_id} pose/CRN contract drifted")
    expected_profile = None
    if row.get("condition_id") == "FixedProfile":
        profile_entry = freeze.get("fixed_profiles", {}).get(
            f"{row['path_id']}_{row['container_id']}")
        require(isinstance(profile_entry, Mapping) and
                isinstance(profile_entry.get("profile"), Mapping),
                f"attempt {attempt_id} frozen FixedProfile entry is missing")
        expected_profile = dict(profile_entry["profile"])
        _readonly_path(expected_profile, "attempt frozen FixedProfile")
    require(case.get("profile") == expected_profile,
            f"attempt {attempt_id} FixedProfile descriptor mismatch")
    if row.get("condition_id") in ONLINE_CONDITIONS:
        expected_execution_config = {
            "kind": "ONLINE_EFFECTIVE_CONFIG",
            "descriptor": dict(freeze["effective_configs"][
                row["condition_id"]]),
        }
    else:
        expected_execution_config = {
            "kind": "FIXEDPROFILE_TRACKER_CONFIG",
            "descriptor": dict(freeze["fixed_profiles"][
                f"{row['path_id']}_{row['container_id']}"]["tracker_config"]),
        }
    require(case.get("execution_config") == expected_execution_config,
            f"attempt {attempt_id} execution config descriptor mismatch")
    _readonly_path(expected_execution_config["descriptor"],
                   "attempt execution config")
    bundle = freeze.get("seed_bundles", {}).get(
        f"{row['stage']}:{row['block_id']}")
    require(isinstance(bundle, Mapping) and
            case.get("seed_bundle") == bundle and
            case.get("seed") == frozen_simulator_seed(freeze, row) and
            case.get("timing") == freeze.get("recording_policy"),
            f"attempt {attempt_id} seed/timing freeze binding mismatch")
    require(case.get("measurements") == {
                "H_proxy": {
                    "topic": H_PROXY,
                    "semantic": "sim_modal_proxy_mechanism_only",
                    "physical_primary_eligible": False,
                },
                "H_modal": {
                    "topic": H_MODAL,
                    "semantic": "controller_internal_modal_only",
                    "physical_primary_eligible": False,
                },
                "physical_primary": None,
            }, f"attempt {attempt_id} measurement semantics drifted")
    seed_realization = case.get("seed_realization")
    require(isinstance(seed_realization, Mapping) and
            seed_realization.get("seed_bundle_id") ==
            row.get("seed_bundle_id") and
            seed_realization.get("seed_bundle_hash") ==
            row.get("seed_bundle_hash") and
            seed_realization.get("trace_asset") ==
            row.get("crn_trace_asset") and
            seed_realization.get("trace_asset_hash") ==
            row.get("crn_trace_asset_hash") and
            seed_realization.get("stream_trace_hashes") ==
            row.get("crn_stream_trace_hashes") and
            seed_realization.get("frozen_simulator_seed") ==
            case.get("seed") and
            seed_realization.get("operator_seed_override_allowed") is False and
            seed_realization.get("runtime_consumer_id") ==
            crn_runtime.CONSUMER_ID and
            seed_realization.get("runtime_ack_schema_hash") ==
            crn_runtime.RUNTIME_ACK_SCHEMA_HASH and
            seed_realization.get("stream_application_contract") ==
            validate_crn_stream_application_registry() and
            seed_realization.get("nonzero_unfrozen_noise_invented") is False,
            f"attempt {attempt_id} seed realization/CRN contract drifted")
    recorder_topics, required_bag_topics = _bag_topic_contract(
        str(row["condition_id"]))
    require(case.get("recording_contract") == {
                "recorder_topics": list(recorder_topics),
                "required_nonempty_topics": list(required_bag_topics),
                "pre_motion_publisher_gate_topics": (
                    list(DEFERRED_ONLINE_MESSAGE_TOPICS)
                    if row["condition_id"] in ONLINE_CONDITIONS else []),
                "condition_specific_nonempty_gate": True,
                "optional_superset_topics_may_be_empty": True,
            }, f"attempt {attempt_id} recording contract drifted")
    bag_path = manifest.get("bag_path")
    if bag_path is not None:
        bag = require_exact_path(Path(str(bag_path)), CANONICAL_BAG_ROOT / attempt_id / "capture.bag", "attempt bag")
        require(bag.is_file() and stat.S_IMODE(bag.stat().st_mode) & WRITE_BITS == 0 and manifest.get("bag_hash") == sha256_file(bag), "attempt bag hash/immutability mismatch")
    partial_bags = manifest.get("partial_bag_artifacts")
    require(isinstance(partial_bags, list),
            f"attempt {attempt_id} partial-bag inventory is not a list")
    allowed_partial_paths = {
        CANONICAL_BAG_ROOT / attempt_id / "capture.active.bag",
        CANONICAL_BAG_ROOT / attempt_id / "capture.active.bag.active",
    }
    seen_partial_paths: set[Path] = set()
    for descriptor in partial_bags:
        require(isinstance(descriptor, Mapping) and
                set(descriptor) == {"path", "sha256", "finalized"} and
                descriptor.get("finalized") is False,
                f"attempt {attempt_id} partial-bag descriptor is malformed")
        partial_path = reject_symlink_chain(Path(str(descriptor["path"])),
                                            "attempt partial bag")
        require(partial_path in allowed_partial_paths and
                partial_path not in seen_partial_paths and
                partial_path.is_file() and
                stat.S_IMODE(partial_path.stat().st_mode) & WRITE_BITS == 0 and
                descriptor.get("sha256") == sha256_file(partial_path),
                f"attempt {attempt_id} partial-bag path/hash/immutability mismatch")
        seen_partial_paths.add(partial_path)

    postflight_path = require_exact_path(
        Path(str(manifest.get("postflight_path", ""))),
        attempt_root / "postflight.json", "attempt postflight")
    require(postflight_path.is_file() and
            stat.S_IMODE(postflight_path.stat().st_mode) & WRITE_BITS == 0 and
            manifest.get("postflight_hash") == sha256_file(postflight_path),
            f"attempt {attempt_id} postflight file/hash mismatch")
    postflight = read_json(postflight_path, "attempt postflight")
    require(postflight.get("schema_version") == SCHEMA_VERSION and
            postflight.get("record_type") == "SMPCC_SIM_MECHANISM_POSTFLIGHT" and
            postflight.get("formal") is True and
            postflight.get("formal_scope") == FORMAL_SCOPE and
            postflight.get("physical_primary_eligible") is False and
            postflight.get("attempt_id") == attempt_id and
            postflight.get("owned_pid_cleanup_only") is True,
            f"attempt {attempt_id} postflight identity/scope mismatch")

    event_document: Optional[Mapping[str, Any]] = None
    event_path_value = manifest.get("events_path")
    if event_path_value is None:
        require(manifest.get("events_hash") is None and
                manifest.get("motion_started") is False,
                f"attempt {attempt_id} lacks immutable event evidence")
    else:
        event_path = require_exact_path(
            Path(str(event_path_value)),
            attempt_root / "motion_goal_events.live.json",
            "attempt endpoint event evidence")
        require(event_path.is_file() and
                stat.S_IMODE(event_path.stat().st_mode) & WRITE_BITS == 0 and
                manifest.get("events_hash") == sha256_file(event_path),
                f"attempt {attempt_id} endpoint event file/hash mismatch")
        event_document = read_json(event_path, "attempt endpoint event evidence")
        require(event_document.get("schema_version") == SCHEMA_VERSION and
                event_document.get("record_type") ==
                "SMPCC_SIM_MECHANISM_MOTION_GOAL_EVENTS" and
                event_document.get("formal") is True and
                event_document.get("formal_scope") == FORMAL_SCOPE and
                event_document.get("physical_primary_eligible") is False and
                event_document.get("case_manifest_hash") ==
                manifest.get("case_manifest_hash") and
                event_document.get("success_contract") ==
                "controller_GOAL_REACHED_AND_frozen_endpoint_geometry",
                f"attempt {attempt_id} endpoint event identity/contract mismatch")
        expected_endpoint = {
            key: event_document.get(key) for key in (
                "initial_pose_gate", "controller_goal_status_seen",
                "geometric_goal_gate", "goal_reached", "latest_odometry")
        }
        require(manifest.get("endpoint_evidence") == expected_endpoint and
                postflight.get("endpoint_evidence") == expected_endpoint,
                f"attempt {attempt_id} endpoint summary is not raw-event bound")
        observed_motion = isinstance(
            event_document.get("first_executed_motion"), Mapping)
        require(observed_motion == (manifest.get("motion_started") is True),
                f"attempt {attempt_id} motion flag differs from raw event")

    classification = _validate_receipt_descriptor(
        manifest.get("outcome_classification"),
        expected_path=attempt_root / "outcome_classification.json",
        hash_field="outcome_qc_hash",
        record_type="SMPCC_SIM_MECHANISM_OUTCOME_CLASSIFICATION",
        label="attempt outcome classification")
    secondary = classification.get("secondary_failures")
    require(isinstance(secondary, Mapping),
            f"attempt {attempt_id} outcome secondary-failure set is missing")
    rebuilt_classification = runtime_qc.classify_outcome(
        motion_started=classification.get("motion_started"),
        primary_method_outcome=classification.get("primary_method_outcome"),
        infrastructure_failure=secondary.get("infrastructure_failure"),
        qc_failure=secondary.get("qc_failure"),
        protocol_failure=secondary.get("protocol_failure"))
    require(classification == rebuilt_classification,
            f"attempt {attempt_id} outcome classification is noncanonical")
    for key in ("method_success", "method_failure", "motion_started",
                "assignment_consumed", "failure_class", "campaign_action",
                "protocol_qc_pass"):
        expected = record.get(key) if key in record else manifest.get(key)
        require(classification.get(key) == expected and
                manifest.get(key) == classification.get(key),
                f"attempt {attempt_id} outcome {key} binding mismatch")
    require(record.get("outcome_qc_hash") ==
            classification.get("outcome_qc_hash"),
            f"attempt {attempt_id} ledger outcome hash mismatch")

    stop_results = None
    if manifest.get("process_stop_results") is not None:
        stop_results = _validate_plain_descriptor(
            manifest["process_stop_results"],
            expected_path=attempt_root / "process_stop_results.json",
            label="attempt owned-process stop results")
        require(stop_results.get("record_type") ==
                "SMPCC_SIM_MECHANISM_OWNED_PROCESS_STOP_RESULTS" and
                stop_results.get("formal") is True and
                stop_results.get("formal_scope") == FORMAL_SCOPE and
                stop_results.get("physical_primary_eligible") is False and
                stop_results.get("attempt_id") == attempt_id,
                f"attempt {attempt_id} raw process-stop identity mismatch")
    stop_qc = None
    if manifest.get("process_stop_qc") is not None:
        stop_qc = _validate_receipt_descriptor(
            manifest["process_stop_qc"],
            expected_path=attempt_root / "process_stop_qc.json",
            hash_field="stop_bundle_qc_hash",
            record_type="SMPCC_SIM_MECHANISM_PROCESS_STOP_BUNDLE_QC",
            label="attempt process-stop QC")
        require(isinstance(stop_results, Mapping) and
                isinstance(stop_results.get("results"), Mapping),
                f"attempt {attempt_id} stop QC lacks raw stop evidence")
        rebuilt_stop = runtime_qc.validate_owned_stop_bundle(
            stop_results["results"],
            motion_component=str(stop_results.get("motion_component", "")))
        require(stop_qc == rebuilt_stop,
                f"attempt {attempt_id} stop QC does not rebuild from raw results")

    closed_bag_qc = None
    if manifest.get("closed_bag_qc") is not None:
        closed_bag_qc = _validate_receipt_descriptor(
            manifest["closed_bag_qc"],
            expected_path=attempt_root / "closed_bag_qc.json",
            hash_field="bag_qc_hash",
            record_type="SMPCC_SIM_MECHANISM_CLOSED_ROSBAG_QC",
            label="attempt closed-bag QC")
        bag_evidence = closed_bag_qc.get("bag")
        require(isinstance(bag_evidence, Mapping) and bag_path is not None and
                bag_evidence.get("path") == str(bag) and
                bag_evidence.get("sha256") == manifest.get("bag_hash") and
                bag_evidence.get("opened_read_only") is True and
                bag_evidence.get("index_readable") is True and
                bag_evidence.get("unchanged_during_audit") is True and
                closed_bag_qc.get("formal") is True and
                closed_bag_qc.get("attempt_id") == attempt_id and
                closed_bag_qc.get("case_manifest_hash") ==
                manifest.get("case_manifest_hash") and
                closed_bag_qc.get("protocol_id") == PROTOCOL_ID and
                closed_bag_qc.get("release_id") == RELEASE_ID and
                set(closed_bag_qc.get(
                    "required_topic_message_counts", {})) ==
                set(required_bag_topics) and
                all(isinstance(value, int) and value > 0 for value in
                    closed_bag_qc.get(
                        "required_topic_message_counts", {}).values()) and
                closed_bag_qc.get("zero_command_tail", {}).get("pass") is True,
                f"attempt {attempt_id} closed-bag QC binding mismatch")
        active_paths = bag_evidence.get("active_artifacts_absent")
        require(isinstance(active_paths, list) and active_paths and
                all(not os.path.lexists(Path(str(item))) for item in active_paths),
                f"attempt {attempt_id} retains an active recorder artifact")
        motion_qc = closed_bag_qc.get("motion_start")
        terminal_qc = closed_bag_qc.get("terminal")
        require(isinstance(motion_qc, Mapping) and
                isinstance(terminal_qc, Mapping) and
                isinstance(motion_qc.get("ros_time_sec"), (int, float)) and
                isinstance(terminal_qc.get("ros_time_sec"), (int, float)) and
                terminal_qc.get("kind") in {"GOAL_REACHED", "GOAL_TIMEOUT"},
                f"attempt {attempt_id} bag motion/terminal QC is malformed")
        rebuilt_bag_qc = _reaudit_closed_bag_cached(
            str(bag), tuple(str(item) for item in active_paths),
            tuple(required_bag_topics),
            float(motion_qc["ros_time_sec"]),
            float(terminal_qc["ros_time_sec"]),
            str(terminal_qc["kind"]), attempt_id,
            str(manifest.get("case_manifest_hash")),
            str(manifest.get("bag_hash")))
        require(closed_bag_qc == rebuilt_bag_qc,
                f"attempt {attempt_id} persisted bag QC differs from raw bag")

    completion_receipt = None
    if manifest.get("completion_time_qc") is not None:
        completion_receipt = _validate_receipt_descriptor(
            manifest["completion_time_qc"],
            expected_path=attempt_root / "completion_time_qc.json",
            hash_field="completion_qc_hash",
            record_type="SMPCC_SIM_MECHANISM_COMPLETION_TIME_QC",
            label="attempt completion-time QC")
        require(completion_receipt == runtime_qc.validate_completion_time(
                    completion_receipt.get("completion_time_sec"),
                    max_completion_sec=completion_receipt.get("max_completion_sec")),
                f"attempt {attempt_id} completion receipt is noncanonical")
    timeout_receipt = None
    if manifest.get("timeout_terminal_qc") is not None:
        timeout_receipt = _validate_receipt_descriptor(
            manifest["timeout_terminal_qc"],
            expected_path=attempt_root / "timeout_terminal_qc.json",
            hash_field="timeout_qc_hash",
            record_type="SMPCC_SIM_MECHANISM_TIMEOUT_TERMINAL_QC",
            label="attempt timeout-terminal QC")
        require(timeout_receipt == runtime_qc.validate_timeout_terminal(
                    timeout_receipt.get("elapsed_sec"),
                    timeout_receipt.get("min_timeout_sec"),
                    terminal_kind=str(timeout_receipt.get("terminal_kind", ""))),
                f"attempt {attempt_id} timeout receipt is noncanonical")

    runtime_report = None
    if manifest.get("runtime_qc_report") is not None:
        runtime_report = _validate_receipt_descriptor(
            manifest["runtime_qc_report"],
            expected_path=attempt_root / "runtime_qc_report.json",
            hash_field="runtime_qc_hash",
            record_type="SMPCC_SIM_MECHANISM_RUNTIME_QC_REPORT",
            label="attempt runtime QC report")
        terminal_timing = runtime_report.get("terminal_timing_qc")
        require(isinstance(terminal_timing, Mapping),
                f"attempt {attempt_id} runtime report lacks terminal timing")
        reported_completion = (terminal_timing.get("receipt")
                               if terminal_timing.get("kind") ==
                               "GOAL_REACHED_COMPLETION" else None)
        reported_timeout = (terminal_timing.get("receipt")
                            if terminal_timing.get("kind") ==
                            "GOAL_TIMEOUT" else None)
        rebuilt_runtime = runtime_qc.build_runtime_qc_report(
            protocol_id=PROTOCOL_ID, release_id=RELEASE_ID,
            attempt_id=attempt_id,
            case_manifest_hash=str(manifest.get("case_manifest_hash")),
            formal=True, stop_bundle=runtime_report.get("stop_bundle"),
            bag_qc=runtime_report.get("bag_qc"),
            outcome_classification=runtime_report.get("outcome_classification"),
            completion_qc=reported_completion,
            timeout_qc=reported_timeout)
        require(runtime_report == rebuilt_runtime and
                runtime_report.get("stop_bundle") == stop_qc and
                runtime_report.get("bag_qc") == closed_bag_qc and
                runtime_report.get("outcome_classification") == classification and
                reported_completion == completion_receipt and
                reported_timeout == timeout_receipt,
                f"attempt {attempt_id} runtime QC report binding mismatch")

    for descriptor_key in (
            "process_stop_results", "process_stop_qc", "closed_bag_qc",
            "completion_time_qc", "timeout_terminal_qc",
            "outcome_classification", "runtime_qc_report",
            "effective_config_readback", "fixed_profile_identity_readback"):
        require(postflight.get(descriptor_key) == manifest.get(descriptor_key),
                f"attempt {attempt_id} postflight/{descriptor_key} mismatch")
    require(postflight.get("tail_complete") == manifest.get("tail_complete") and
            postflight.get("fresh_ros_gazebo") ==
            manifest.get("fresh_ros_gazebo") and
            postflight.get("endpoint_evidence") ==
            manifest.get("endpoint_evidence") and
            postflight.get("crn_runtime_ack") ==
            manifest.get("crn_runtime_ack") and
            postflight.get("crn_runtime_application_receipt") ==
            manifest.get("crn_runtime_application_receipt") and
            postflight.get("partial_bag_artifacts") ==
            manifest.get("partial_bag_artifacts"),
            f"attempt {attempt_id} postflight outcome evidence mismatch")
    effective_readback = None
    fixed_identity_readback = None
    if row.get("condition_id") in ONLINE_CONDITIONS:
        require(manifest.get("fixed_profile_identity_readback") is None,
                f"online attempt {attempt_id} carries FixedProfile identity")
        if manifest.get("effective_config_readback") is not None:
            effective_readback = _validate_plain_descriptor(
                manifest["effective_config_readback"],
                expected_path=attempt_root / "effective_config_readback.json",
                label="attempt effective-config readback")
            expected_config = read_json(
                Path(str(expected_execution_config["descriptor"]["path"])),
                "attempt expected effective config")
            observer = expected_config.get("observer")
            delay = expected_config.get("delay")
            require(isinstance(observer, Mapping) and
                    isinstance(delay, Mapping),
                    f"attempt {attempt_id} frozen observer/delay config missing")
            expected_runtime_parameters = {
                "/sim_spmpc_local_planner/slosh_observer/source":
                    str(observer["source"]).casefold(),
                "/sim_spmpc_local_planner/slosh_observer/fallback_policy":
                    str(observer["fallback_policy"]).casefold(),
                "/sim_spmpc_local_planner/imu_shadow/enable":
                    str(observer["imu_shadow_enable"]).casefold(),
                "/sim_spmpc_local_planner/delay_phase/mode":
                    str(delay["mode"]).casefold(),
                "/sim_spmpc_local_planner/frames/use_tf_pose": "false",
            }
            actual_abi = effective_readback.get("actual_float32_abi")
            readback_pass = (
                effective_readback.get("status") == "PASS" and
                effective_readback.get("differences") == {} and
                effective_readback.get("runtime_parameter_readback") ==
                expected_runtime_parameters)
            readback_fail = (
                effective_readback.get("status") == "FAIL" and
                isinstance(effective_readback.get("differences"), Mapping) and
                bool(effective_readback["differences"]) and
                str(classification.get("campaign_action", "")).startswith(
                    "STOP_CAMPAIGN_REVIEW"))
            require(effective_readback.get("schema_version") == SCHEMA_VERSION and
                    effective_readback.get("record_type") ==
                    "SMPCC_SIM_MECHANISM_EFFECTIVE_CONFIG_READBACK" and
                    effective_readback.get("formal") is True and
                    effective_readback.get("formal_scope") == FORMAL_SCOPE and
                    effective_readback.get("physical_primary_eligible") is False and
                    effective_readback.get("expected_config_hash") ==
                    expected_config.get("effective_config_hash") and
                    (readback_pass or readback_fail) and
                    effective_readback.get("pose_contract") == {
                        "authoritative_pose_topic": "/odom",
                        "planner_use_tf_pose": False,
                        "frozen_path_coordinate_contract":
                            "gazebo_odometry_numeric_world",
                    } and
                    isinstance(actual_abi, Mapping) and
                    set(actual_abi) == set(CONFIG_FIELDS) and
                    all(isinstance(value, (int, float)) and
                        math.isfinite(float(value))
                        for value in actual_abi.values()),
                    f"attempt {attempt_id} effective config/observer/delay readback failed")
    else:
        require(manifest.get("effective_config_readback") is None,
                f"FixedProfile attempt {attempt_id} carries online config readback")
        if manifest.get("fixed_profile_identity_readback") is not None:
            fixed_identity_readback = _validate_plain_descriptor(
                manifest["fixed_profile_identity_readback"],
                expected_path=attempt_root /
                "fixed_profile_identity_readback.json",
                label="attempt FixedProfile identity readback")
            identity_pass = (
                fixed_identity_readback.get("status") == "PASS" and
                fixed_identity_readback.get("missing_bindings") == {} and
                fixed_identity_readback.get("actual") ==
                fixed_identity_readback.get("expected"))
            identity_fail = (
                fixed_identity_readback.get("status") == "FAIL" and
                isinstance(fixed_identity_readback.get("missing_bindings"),
                           Mapping) and
                bool(fixed_identity_readback["missing_bindings"]) and
                str(classification.get("campaign_action", "")).startswith(
                    "STOP_CAMPAIGN_REVIEW"))
            require(fixed_identity_readback.get("schema_version") ==
                    SCHEMA_VERSION and
                    fixed_identity_readback.get("record_type") ==
                    "SMPCC_SIM_MECHANISM_FIXED_PROFILE_IDENTITY_READBACK" and
                    fixed_identity_readback.get("protocol_id") == PROTOCOL_ID and
                    fixed_identity_readback.get("release_id") == RELEASE_ID and
                    fixed_identity_readback.get("formal") is True and
                    fixed_identity_readback.get("formal_scope") == FORMAL_SCOPE and
                    fixed_identity_readback.get("physical_primary_eligible") is False and
                    (identity_pass or identity_fail),
                    f"attempt {attempt_id} FixedProfile identity readback failed")
    primary_terminal = (record.get("method_success") is True or
                        record.get("method_failure") is True)
    if primary_terminal:
        require((effective_readback is not None) ==
                    (row.get("condition_id") in ONLINE_CONDITIONS) and
                (fixed_identity_readback is not None) ==
                    (row.get("condition_id") == "FixedProfile"),
                f"primary attempt {attempt_id} lacks execution config identity")
        require((effective_readback is None or
                 effective_readback.get("status") == "PASS") and
                (fixed_identity_readback is None or
                 fixed_identity_readback.get("status") == "PASS"),
                f"primary attempt {attempt_id} execution config identity failed")
        require(isinstance(event_document, Mapping),
                f"primary terminal attempt {attempt_id} lacks raw events")
        initial = event_document.get("initial_pose_gate")
        first_motion = event_document.get("first_executed_motion")
        pose_contract = case.get("pose_contract")
        require(isinstance(initial, Mapping) and initial.get("pass") is True and
                event_document.get("invalid_odometry_seen") is not True and
                initial.get("pose_source") == "gazebo_odometry_message" and
                isinstance(pose_contract, Mapping) and
                pose_contract.get("authoritative_pose_topic") == "/odom" and
                pose_contract.get("authoritative_pose_semantic") ==
                "gazebo_odometry_message" and
                pose_contract.get("online_planner_use_tf_pose") is False and
                isinstance(pose_contract.get("expected_spawn_yaw_rad"),
                           (int, float)) and
                math.isfinite(float(
                    pose_contract["expected_spawn_yaw_rad"])) and
                isinstance(initial.get("yaw_rad"), (int, float)) and
                math.isfinite(float(initial["yaw_rad"])) and
                math.isclose(float(initial["yaw_rad"]),
                             float(pose_contract.get(
                                 "expected_spawn_yaw_rad")),
                             rel_tol=0.0,
                             abs_tol=endpoint_gate.START_YAW_TOLERANCE_RAD) and
                isinstance(first_motion, Mapping) and
                all(isinstance(first_motion.get(key), (int, float)) and
                    math.isfinite(float(first_motion[key]))
                    for key in ("monotonic_sec", "ros_time_sec")),
                f"attempt {attempt_id} initial-pose/motion event is invalid")
        if classification.get("protocol_qc_pass") is True:
            lifecycle = manifest.get("lifecycle")
            require(isinstance(lifecycle, list) and
                    all(isinstance(item, Mapping) and
                        isinstance(item.get("event"), str)
                        for item in lifecycle),
                    f"attempt {attempt_id} lifecycle is malformed")
            names = [str(item["event"]) for item in lifecycle]
            terminal_event = ("goal_reached" if
                              record.get("method_success") is True else
                              "goal_timeout")
            required_order = [
                "preflight", "settle", "recorder_admitted",
                "recorder_before_motion", "first_executed_motion",
                terminal_event, "tail_sim_interval_complete",
                "tail_recorded", "owned_pid_cleanup",
            ]
            require(all(names.count(name) == 1 for name in required_order) and
                    [names.index(name) for name in required_order] == sorted(
                        names.index(name) for name in required_order),
                    f"attempt {attempt_id} fresh/recorder/motion/tail lifecycle order failed")
            if row.get("condition_id") in ONLINE_CONDITIONS:
                deferred_event = "deferred_diagnostic_publishers_admitted"
                require(names.count(deferred_event) == 1 and
                        names.index("preflight") < names.index(deferred_event) <
                        names.index("settle") and
                        set(lifecycle[names.index(deferred_event)].get(
                            "topics", {})) ==
                        set(DEFERRED_ONLINE_MESSAGE_TOPICS),
                        f"attempt {attempt_id} deferred publisher gate failed")
            preflight_event = lifecycle[names.index("preflight")]
            tail_event = lifecycle[names.index("tail_sim_interval_complete")]
            require(preflight_event.get("ros") is False and
                    preflight_event.get("gazebo") is False and
                    isinstance(tail_event.get("observed_guard_sec"),
                               (int, float)) and
                    float(tail_event.get("observed_guard_sec")) >= 5.5 and
                    postflight.get("pre") == {"ros": False, "gazebo": False} and
                    postflight.get("post") == {"ros": False, "gazebo": False},
                    f"attempt {attempt_id} fresh master/tail evidence failed")
        if row.get("condition_id") == "FixedProfile":
            handshake = manifest.get("fixed_profile_handshake")
            require(isinstance(handshake, Mapping) and
                    set(handshake) == {
                        "zero_hold_ready", "dynamic_admission",
                        "release_receipt"},
                    f"attempt {attempt_id} FixedProfile handshake is incomplete")
            admission = CampaignAdmission(
                DEFAULT_RELEASE, release, DEFAULT_FREEZE, freeze,
                DEFAULT_MASTER, master)
            profile_path = Path(str(expected_profile["path"]))
            _validate_fixed_handshake(
                handshake["zero_hold_ready"],
                record_type=
                "SMPCC_SIM_MECHANISM_FIXEDPROFILE_ZERO_HOLD_READY",
                admission=admission, row=row, profile=profile_path)
            _validate_fixed_handshake(
                handshake["dynamic_admission"],
                record_type=
                "SMPCC_SIM_MECHANISM_FIXEDPROFILE_DYNAMIC_ADMISSION",
                admission=admission, row=row, profile=profile_path)
            _validate_fixed_handshake(
                handshake["release_receipt"],
                record_type=
                "SMPCC_SIM_MECHANISM_FIXEDPROFILE_RELEASE_RECEIPT",
                admission=admission, row=row, profile=profile_path)
        else:
            require(manifest.get("fixed_profile_handshake") is None,
                    f"online attempt {attempt_id} carries FixedProfile handshake")
    if record.get("method_success") is True:
        endpoint = manifest.get("endpoint_evidence")
        goal = endpoint.get("goal_reached") if isinstance(endpoint, Mapping) else None
        controller = (endpoint.get("controller_goal_status_seen")
                      if isinstance(endpoint, Mapping) else None)
        geometric = (endpoint.get("geometric_goal_gate")
                     if isinstance(endpoint, Mapping) else None)
        event_duration = (
            float(goal["monotonic_sec"]) -
            float(first_motion["monotonic_sec"])
            if isinstance(goal, Mapping) and
            isinstance(goal.get("monotonic_sec"), (int, float)) else None)
        require(bag_path is not None and manifest.get("runtime_error") is None and
                manifest.get("goal_reached") is True and
                manifest.get("terminal_kind") == "GOAL_REACHED" and
                isinstance(completion_receipt, Mapping) and
                manifest.get("completion_time_sec") ==
                completion_receipt.get("completion_time_sec") and
                timeout_receipt is None and stop_qc is not None and
                closed_bag_qc is not None and runtime_report is not None and
                postflight.get("owned_pid_cleanup_pass") is True and
                manifest.get("tail_complete") is True and
                manifest.get("fresh_ros_gazebo") is True and
                manifest.get("continuous_eligible") is True and
                isinstance(goal, Mapping) and
                isinstance(controller, Mapping) and
                isinstance(geometric, Mapping) and
                all(isinstance(goal.get(key), (int, float)) and
                    math.isfinite(float(goal[key])) for key in
                    ("goal_distance_m", "linear_x_mps",
                     "angular_z_radps")) and
                isinstance(geometric.get("stable_samples"), int) and
                event_duration is not None and
                math.isfinite(event_duration) and event_duration > 0.0 and
                event_duration <= 60.0 and
                math.isclose(event_duration,
                             float(completion_receipt.get(
                                 "completion_time_sec")),
                             rel_tol=0.0, abs_tol=1e-9) and
                goal.get("controller_status") == "GOAL_REACHED" and
                goal.get("controller_status_gate_pass") is True and
                goal.get("geometric_gate_pass") is True and
                controller.get("geometry_already_stable") in {True, False} and
                geometric.get("pass") is True and
                geometric.get("stable_samples", 0) >=
                endpoint_gate.GOAL_STABLE_SAMPLES and
                float(goal.get("goal_distance_m")) <=
                endpoint_gate.GOAL_TOLERANCE_M and
                abs(float(goal.get("linear_x_mps"))) <=
                endpoint_gate.GOAL_MAX_LINEAR_MPS and
                abs(float(goal.get("angular_z_radps"))) <=
                endpoint_gate.GOAL_MAX_ANGULAR_RADPS,
                f"successful attempt {attempt_id} lacks complete endpoint/runtime QC")

    if primary_terminal:
        ack_descriptor = manifest.get("crn_runtime_ack")
        require(isinstance(ack_descriptor, Mapping) and set(ack_descriptor) == {"path", "sha256", "ack_hash"}, f"primary terminal attempt {attempt_id} lacks CRN runtime ACK descriptor")
        ack_path = require_exact_path(Path(str(ack_descriptor["path"])), attempt_root / "crn_runtime_ack.json", "attempt CRN runtime ACK")
        require(ack_path.is_file() and stat.S_IMODE(ack_path.stat().st_mode) & WRITE_BITS == 0 and ack_descriptor.get("sha256") == sha256_file(ack_path), f"attempt {attempt_id} CRN runtime ACK file/hash mismatch")
        ack = read_json(ack_path, "attempt CRN runtime ACK")
        ack_core = dict(ack); declared_ack_hash = ack_core.pop("ack_hash", None)
        consumed = ack.get("consumed_streams")
        require(set(ack) == crn_runtime.ACK_FIELDS and declared_ack_hash == canonical_hash(ack_core) and ack_descriptor.get("ack_hash") == declared_ack_hash and ack.get("schema_hash") == crn_runtime.RUNTIME_ACK_SCHEMA_HASH and ack.get("formal") is True and ack.get("status") == "PASS" and ack.get("stage") == row.get("stage") and ack.get("block_id") == row.get("block_id") and ack.get("seed_bundle_id") == row.get("seed_bundle_id") and ack.get("seed_bundle_hash") == row.get("seed_bundle_hash") and ack.get("trace_asset_path") == row.get("crn_trace_asset", {}).get("path") and ack.get("trace_asset_file_sha256") == row.get("crn_trace_asset", {}).get("sha256") and ack.get("trace_asset_hash") == row.get("crn_trace_asset_hash") and ack.get("stream_trace_hashes") == row.get("crn_stream_trace_hashes") and ack.get("condition_selector_used") is False and ack.get("callback_count_rng_used") is False and ack.get("initial_yaw_offset_rad_applied") is True and ack.get("applied") is True and isinstance(ack.get("observed_initial_yaw_rad"), (int, float)) and math.isclose(float(ack["observed_initial_yaw_rad"]), float(initial["yaw_rad"]), rel_tol=0.0, abs_tol=endpoint_gate.START_YAW_TOLERANCE_RAD) and isinstance(consumed, Mapping) and set(consumed) == set(crn_runtime.SEED_STREAMS), f"attempt {attempt_id} CRN runtime ACK semantic binding mismatch")
        for stream in crn_runtime.SEED_STREAMS:
            item = consumed[stream]
            require(isinstance(item, Mapping) and item.get("trace_hash") == row["crn_stream_trace_hashes"][stream] and item.get("consumption_phase") == crn_runtime.CONSUMPTION_PHASES[stream] and isinstance(item.get("time_indices_ms"), list) and item["time_indices_ms"], f"attempt {attempt_id} CRN consumed stream {stream} is incomplete")
        application_descriptor = manifest.get("crn_runtime_application_receipt")
        require(isinstance(application_descriptor, Mapping) and
                set(application_descriptor) == {"path", "sha256", "receipt_hash"},
                f"primary terminal attempt {attempt_id} lacks CRN application receipt")
        application_path = require_exact_path(
            Path(str(application_descriptor["path"])),
            attempt_root / "crn_runtime_application_receipt.json",
            "attempt CRN application receipt")
        require(application_path.is_file() and
                stat.S_IMODE(application_path.stat().st_mode) & WRITE_BITS == 0 and
                application_descriptor.get("sha256") == sha256_file(application_path),
                f"attempt {attempt_id} CRN application file/hash mismatch")
        application = read_json(application_path, "attempt CRN application receipt")
        application_core = dict(application)
        declared_application_hash = application_core.pop("receipt_hash", None)
        stream_application = application.get("stream_application")
        require(declared_application_hash == canonical_hash(application_core) and
                application_descriptor.get("receipt_hash") ==
                declared_application_hash and
                application.get("record_type") ==
                "SMPCC_SIM_MECHANISM_CRN_APPLICATION_RECEIPT" and
                application.get("protocol_id") == PROTOCOL_ID and
                application.get("release_id") == RELEASE_ID and
                application.get("formal") is True and
                application.get("physical_primary_eligible") is False and
                application.get("status") == "PASS" and
                application.get("case_manifest_hash") ==
                manifest.get("case_manifest_hash") and
                application.get("stage") == row.get("stage") and
                application.get("block_id") == row.get("block_id") and
                application.get("seed_bundle_id") == row.get("seed_bundle_id") and
                application.get("seed_bundle_hash") == row.get("seed_bundle_hash") and
                application.get("trace_asset_hash") ==
                row.get("crn_trace_asset_hash") and
                application.get("nonzero_unfrozen_noise_invented") is False and
                isinstance(stream_application, Mapping) and
                set(stream_application) == set(crn_runtime.SEED_STREAMS),
                f"attempt {attempt_id} CRN application semantic binding mismatch")
        policy = validate_crn_stream_application_registry()
        for stream in crn_runtime.SEED_STREAMS:
            applied = stream_application[stream]
            require(isinstance(applied, Mapping) and
                    applied.get("trace_hash") ==
                    row["crn_stream_trace_hashes"][stream] and
                    applied.get("application_mode") ==
                    policy[stream]["application_mode"] and
                    applied.get("mapping_hash") ==
                    policy[stream]["mapping_hash"] and
                    applied.get("mapping_enforced") is True,
                    f"attempt {attempt_id} CRN application {stream} drifted")
    if record.get("method_failure") is True:
        late_goal = (event_document.get("goal_reached")
                     if isinstance(event_document, Mapping) else None)
        late_goal_duration = (
            float(late_goal["monotonic_sec"]) -
            float(event_document["first_executed_motion"]["monotonic_sec"])
            if isinstance(late_goal, Mapping) and
            isinstance(late_goal.get("monotonic_sec"), (int, float)) else None)
        require(manifest.get("goal_reached") is False and
                manifest.get("terminal_kind") == "GOAL_TIMEOUT" and
                completion_receipt is None and timeout_receipt is not None and
                isinstance(manifest.get("terminal_elapsed_sec"), (int, float)) and
                math.isclose(float(manifest.get("terminal_elapsed_sec")),
                             float(timeout_receipt.get("elapsed_sec")),
                             rel_tol=0.0, abs_tol=1e-9) and
                (late_goal_duration is None or
                 (math.isfinite(late_goal_duration) and
                  late_goal_duration > 60.0)),
                f"timeout method failure {attempt_id} lacks strict timeout evidence")
        if classification.get("protocol_qc_pass") is True:
            require(manifest.get("runtime_error") is None and
                    manifest.get("tail_complete") is True and
                    manifest.get("fresh_ros_gazebo") is True and
                    postflight.get("owned_pid_cleanup_pass") is True and
                    bag_path is not None and stop_qc is not None and
                    closed_bag_qc is not None and runtime_report is not None,
                    f"clean timeout method failure {attempt_id} lacks frozen tail/runtime QC")
        else:
            require(str(classification.get("campaign_action", "")).startswith(
                        "STOP_CAMPAIGN_REVIEW"),
                    f"QC-failed method failure {attempt_id} did not stop campaign")
    attempt_number = _attempt_number(attempt_id, row_id)
    if attempt_number == 1:
        require(manifest.get("retry_authorization_path") is None and manifest.get("retry_authorization_hash") is None, "r01 may not carry retry authorization")
    else:
        auth_path = require_exact_path(Path(str(manifest.get("retry_authorization_path", ""))), CANONICAL_RESULT_ROOT / "retry_authorizations" / f"{attempt_id}.json", "attempt retry authorization")
        require(auth_path.is_file() and manifest.get("retry_authorization_hash") == sha256_file(auth_path), "attempt retry authorization hash mismatch")


def _validate_ledger_records(records: Sequence[Mapping[str, Any]], master: Mapping[str, Any], release: Mapping[str, Any], *, pending_attempt_id: Optional[str] = None) -> None:
    ordered = schedule(master)
    cursor = 0
    next_attempt_number = 1
    previous = "0" * 64
    seen_attempt_ids: set[str] = set()
    for number, item in enumerate(records, 1):
        require(isinstance(item, Mapping), f"ledger line {number} is not an object")
        core = dict(item)
        declared = core.pop("entry_hash", None)
        require(core.get("previous_entry_hash") == previous, f"append-only ledger chain is broken at line {number}")
        require(declared == canonical_hash(core), f"append-only ledger entry hash mismatch at line {number}")
        previous = str(declared)
        expected_fields = {
            "schema_version", "record_type", "protocol_id", "release_id",
            "formal", "formal_scope", "physical_primary_eligible", "release_hash",
        "master_hash", "planned_row_id", "attempt_id", "stage", "condition_id",
            "method_success", "method_failure", "continuous_eligible",
            "motion_started", "assignment_consumed", "failure_class",
            "campaign_action", "protocol_qc_pass", "outcome_qc_hash",
            "attempt_manifest_path", "attempt_manifest_hash", "created_utc",
            "previous_entry_hash", "entry_hash",
        }
        require(set(item) == expected_fields, f"ledger line {number} fields are not exact R7 schema")
        require(
            item.get("schema_version") == SCHEMA_VERSION
            and item.get("record_type") == "SMPCC_SIM_MECHANISM_DATASET_INDEX_ENTRY"
            and item.get("protocol_id") == PROTOCOL_ID
            and item.get("release_id") == RELEASE_ID
            and item.get("formal") is True
            and item.get("formal_scope") == FORMAL_SCOPE
            and item.get("physical_primary_eligible") is False,
            f"ledger line {number} protocol/release/scope mismatch",
        )
        require(item.get("release_hash") == release.get("release_hash"), f"ledger line {number} mixes another release")
        require(item.get("master_hash") == master.get("master_hash"), f"ledger line {number} mixes another master")
        require(cursor < len(ordered), "ledger contains attempts beyond the frozen 88 rows")
        row = ordered[cursor]
        row_id = str(row["planned_row_id"])
        attempt_id = str(item.get("attempt_id", ""))
        require(attempt_id not in seen_attempt_ids, f"ledger repeats attempt {attempt_id}")
        seen_attempt_ids.add(attempt_id)
        require(item.get("planned_row_id") == row_id, f"ledger is out of frozen order at line {number}; expected {row_id}")
        require(item.get("stage") == row.get("stage") and item.get("condition_id") == row.get("condition_id"), f"ledger row identity drift at {attempt_id}")
        attempt_number = _attempt_number(attempt_id, row_id)
        require(attempt_number == next_attempt_number, f"non-contiguous attempt sequence for {row_id}")
        success = item.get("method_success") is True
        method_failure = item.get("method_failure") is True
        motion = item.get("motion_started") is True
        consumed = item.get("assignment_consumed") is True
        failure = item.get("failure_class")
        action = item.get("campaign_action")
        protocol_qc_pass = item.get("protocol_qc_pass") is True
        require(not (success and method_failure), f"attempt {attempt_id} claims both success and failure")
        if success:
            require(motion and consumed and failure == "NONE" and
                    protocol_qc_pass and
                    action == "ADVANCE_WITH_METHOD_SUCCESS" and
                    item.get("continuous_eligible") is True,
                    f"successful attempt {attempt_id} has inconsistent outcome/eligibility")
        elif method_failure:
            require(motion and consumed and failure == "METHOD_FAILURE" and
                    item.get("continuous_eligible") is False,
                    f"method failure {attempt_id} has inconsistent outcome/eligibility")
            if protocol_qc_pass:
                require(action == "ADVANCE_WITH_TERMINAL_METHOD_FAILURE",
                        f"clean method failure {attempt_id} has the wrong campaign action")
            else:
                require(action == "STOP_CAMPAIGN_REVIEW_WITH_TERMINAL_METHOD_FAILURE",
                        f"QC-failed method failure {attempt_id} did not stop the campaign")
                require(number == len(records),
                        "ledger continued after method-failure protocol/QC loss")
        elif failure == "INFRASTRUCTURE_ACQUISITION":
            require(not motion and not consumed and not protocol_qc_pass and
                    action == "REQUIRE_IMMUTABLE_RETRY_AUTHORIZATION" and
                    item.get("continuous_eligible") is False,
                    f"retryable acquisition {attempt_id} started motion or claimed eligibility")
        elif failure == "PROTOCOL_FAILURE":
            require(not motion and not consumed and not protocol_qc_pass and
                    action == "STOP_CAMPAIGN_REVIEW" and
                    item.get("continuous_eligible") is False,
                    f"protocol failure {attempt_id} started motion or claimed eligibility")
            require(number == len(records), "ledger continued after a protocol failure")
        elif failure == "PROTOCOL_FAILURE_AFTER_MOTION":
            require(motion and consumed and not protocol_qc_pass and
                    not success and not method_failure and
                    action == "STOP_CAMPAIGN_REVIEW" and
                    item.get("continuous_eligible") is False,
                    f"post-motion protocol failure {attempt_id} is inconsistent")
            require(number == len(records), "ledger continued after a protocol failure")
        else:
            raise RunnerError(f"attempt {attempt_id} has an invalid nonterminal outcome")
        _validate_attempt_binding(item, row, master, release)
        if success or method_failure:
            cursor += 1
            next_attempt_number = 1
        elif failure == "INFRASTRUCTURE_ACQUISITION":
            next_attempt_number += 1

    expected_attempts = {str(item["attempt_id"]) for item in records}
    if pending_attempt_id is not None:
        require(pending_attempt_id not in expected_attempts, "pending attempt already exists in the ledger")
        expected_attempts.add(pending_attempt_id)
    require(_attempt_dirs(CANONICAL_RESULT_ROOT / "attempts", "R7 attempt root") == expected_attempts, "attempt directory inventory differs from the R7 ledger")
    require(_attempt_dirs(CANONICAL_BAG_ROOT, "R7 bag root") == expected_attempts, "bag directory inventory differs from the R7 ledger")


def load_ledger(path: Path, master: Mapping[str, Any], release: Mapping[str, Any]) -> list[Mapping[str, Any]]:
    path = require_exact_path(path, CANONICAL_DATASET_INDEX, "dataset index")
    if not path.exists():
        _validate_ledger_records([], master, release)
        return []
    output: list[Mapping[str, Any]] = []
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        require(raw.strip(), f"ledger line {number} is blank")
        try: item = json.loads(raw)
        except json.JSONDecodeError as exc: raise RunnerError(f"ledger line {number} is invalid JSON: {exc}") from exc
        output.append(item)
    _validate_ledger_records(output, master, release)
    return output


def append_ledger(path: Path, record: Mapping[str, Any], master: Mapping[str, Any], release: Mapping[str, Any]) -> Dict[str, Any]:
    path = require_exact_path(path, CANONICAL_DATASET_INDEX, "dataset index")
    reject_symlink_chain(path.parent, "dataset index parent").mkdir(parents=True, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT | os.O_APPEND
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o664)
    with os.fdopen(descriptor, "a+", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        try:
            # Check the chain head and append while holding the same lock.
            stream.seek(0)
            existing: list[Mapping[str, Any]] = []
            for number, raw in enumerate(stream, 1):
                require(raw.strip(), f"ledger line {number} is blank")
                try: item = json.loads(raw)
                except json.JSONDecodeError as exc: raise RunnerError(f"ledger line {number} is invalid JSON: {exc}") from exc
                existing.append(item)
            pending_attempt_id = str(record.get("attempt_id", ""))
            require(pending_attempt_id, "dataset index record has no attempt ID")
            _validate_ledger_records(existing, master, release, pending_attempt_id=pending_attempt_id)
            require(record.get("attempt_id") not in {item.get("attempt_id") for item in existing}, "dataset index repeats an attempt ID")
            prior = str(existing[-1]["entry_hash"]) if existing else "0" * 64
            core = dict(record, previous_entry_hash=prior)
            entry = dict(core, entry_hash=canonical_hash(core))
            _validate_ledger_records([*existing, entry], master, release)
            stream.seek(0, os.SEEK_END)
            stream.write(json.dumps(entry, ensure_ascii=False, sort_keys=True) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
            return entry
        finally:
            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def _attempt_number(attempt_id: str, row_id: str) -> int:
    require(attempt_id.startswith(row_id + "_r"), "attempt ID must derive from frozen planned row")
    suffix = attempt_id[len(row_id) + 2:]
    require(len(suffix) == 2 and suffix.isdigit() and int(suffix) >= 1, "attempt ID needs a canonical positive _rNN suffix")
    return int(suffix)


def _row_history(records: Sequence[Mapping[str, Any]], row_id: str) -> list[Mapping[str, Any]]:
    return [record for record in records if record.get("planned_row_id") == row_id]


def _stage_authorization_path(stage: str) -> Path:
    require(stage in {"SIM-S2A_SELECTIVITY", "SIM-S2B_TRANSFER"}, "stage does not require an extension authorization")
    return CANONICAL_RESULT_ROOT / "stage_authorizations" / f"{stage}.json"


def _validate_stage_authorization(admission: CampaignAdmission, stage: str, records: Sequence[Mapping[str, Any]]) -> None:
    required_prefix = 40 if stage == "SIM-S2A_SELECTIVITY" else 64
    evidence_names = {"s1_closure", "extension_decision"} if stage == "SIM-S2A_SELECTIVITY" else {"s2a_closure", "selectivity_trigger"}
    path = require_exact_path(_stage_authorization_path(stage), _stage_authorization_path(stage), f"{stage} authorization")
    require(path.is_file() and stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0, f"{stage} requires an immutable stage authorization")
    authorization = read_json(path, f"{stage} authorization")
    core = dict(authorization); declared = core.pop("authorization_hash", None)
    require(declared == canonical_hash(core), f"{stage} authorization_hash mismatch")
    require(
        authorization.get("protocol_id") == PROTOCOL_ID
        and authorization.get("release_id") == RELEASE_ID
        and authorization.get("release_hash") == admission.release.get("release_hash")
        and authorization.get("master_hash") == admission.master.get("master_hash")
        and authorization.get("stage") == stage
        and authorization.get("decision") == "OPEN"
        and authorization.get("required_terminal_prefix_rows") == required_prefix
        and authorization.get("physical_primary_eligible") is False,
        f"{stage} authorization is not bound to this R7 release/master",
    )
    require(authorization.get("dataset_index_path") == str(CANONICAL_DATASET_INDEX), f"{stage} authorization dataset path mismatch")
    prefix_rows = schedule(admission.master)[:required_prefix]
    require(len(prefix_rows) == required_prefix, f"{stage} frozen prefix length mismatch")
    for row in prefix_rows:
        history = _row_history(records, str(row["planned_row_id"]))
        require(history and (history[-1].get("method_success") is True or history[-1].get("method_failure") is True), f"{stage} authorization precedes terminal closure of {row['planned_row_id']}")
    terminal_history = _row_history(records, str(prefix_rows[-1]["planned_row_id"]))
    head = str(terminal_history[-1]["entry_hash"])
    require(authorization.get("dataset_index_head_hash") == head, f"{stage} authorization is not bound to the frozen terminal-prefix head")
    evidence = authorization.get("evidence")
    require(isinstance(evidence, Mapping) and set(evidence) == evidence_names, f"{stage} authorization evidence set is incomplete")
    for name, descriptor in evidence.items():
        evidence_path = _readonly_path(descriptor, f"{stage} {name} evidence")
        document = read_json(evidence_path, f"{stage} {name} evidence")
        require(
            document.get("protocol_id") == PROTOCOL_ID
            and document.get("release_id") == RELEASE_ID
            and document.get("release_hash") == admission.release.get("release_hash")
            and document.get("master_hash") == admission.master.get("master_hash")
            and document.get("physical_primary_eligible") is False,
            f"{stage} {name} evidence belongs to another release/master",
        )
        require(document.get("status") == "PASS" or document.get("decision") in {"OPEN", "TRIGGERED"}, f"{stage} {name} evidence is not affirmative")


def _validate_next_row(admission: CampaignAdmission, row: Mapping[str, Any], attempt_id: str, retry_authorization: Optional[Path]) -> None:
    master = admission.master
    records = load_ledger(ledger_path(master), master, admission.release); ordered = schedule(master)
    if records and str(records[-1].get("campaign_action", "")).startswith("STOP_CAMPAIGN_REVIEW"):
        raise RunnerError("campaign is stopped by the immutable last-attempt outcome")
    current: Optional[Mapping[str, Any]] = None
    for item in ordered:
        history = _row_history(records, str(item["planned_row_id"]))
        if not history:
            current = item; break
        last = history[-1]
        if last.get("method_success") is True or last.get("method_failure") is True:
            continue
        # A pre-motion acquisition loss is unresolved until an explicit retry;
        # the same row remains current.
        current = item; break
    require(current is not None and current.get("planned_row_id") == row.get("planned_row_id"), "row is not the sole next frozen serial assignment")
    if row.get("stage") in {"SIM-S2A_SELECTIVITY", "SIM-S2B_TRANSFER"}:
        _validate_stage_authorization(admission, str(row["stage"]), records)
    number = _attempt_number(attempt_id, str(row["planned_row_id"]))
    history = _row_history(records, str(row["planned_row_id"]))
    if number == 1:
        require(not history and retry_authorization is None, "r01 must be the first unattempted row")
        return
    require(len(history) == number - 1 and retry_authorization is not None, "retry number/history mismatch")
    previous = history[-1]
    require(previous.get("method_failure") is False and previous.get("method_success") is False, "method result is terminal and cannot be retried")
    require(previous.get("failure_class") == "INFRASTRUCTURE_ACQUISITION", "only infrastructure acquisition may be retried")
    require(previous.get("motion_started") is False, "post-motion loss cannot be retried")
    require_exact_path(retry_authorization, CANONICAL_RESULT_ROOT / "retry_authorizations" / f"{attempt_id}.json", "retry authorization")
    require(retry_authorization.is_file() and stat.S_IMODE(retry_authorization.stat().st_mode) & WRITE_BITS == 0, "retry authorization must be an immutable file")
    auth = read_json(retry_authorization, "retry authorization")
    require(auth.get("protocol_id") == PROTOCOL_ID and auth.get("release_id") == RELEASE_ID and auth.get("release_hash") == admission.release.get("release_hash") and auth.get("master_hash") == master.get("master_hash") and auth.get("next_attempt_id") == attempt_id, "retry authorization identity mismatch")
    require(auth.get("previous_attempt_id") == previous.get("attempt_id") and auth.get("previous_attempt_manifest_hash") == previous.get("attempt_manifest_hash"), "retry authorization does not bind previous acquisition attempt")
    require(auth.get("method_failure") is False and auth.get("motion_started") is False and auth.get("failure_class") == "INFRASTRUCTURE_ACQUISITION", "retry authorization is not acquisition-only")


def _path_container_config(freeze: Mapping[str, Any], row: Mapping[str, Any]) -> tuple[Path, Mapping[str, Any], Mapping[str, Any], Optional[Path]]:
    path, path_doc = _readonly_bound(freeze["paths"][row["path_id"]]["sim_path"], "frozen simulation path")
    container_path, container = _readonly_bound(freeze["containers"][row["container_id"]], "frozen simulation container")
    require(path_doc.get("path_id") == row.get("path_id") and container.get("container_id") == row.get("container_id"), "row path/container identity drift")
    profile_path = None
    if row["condition_id"] == "FixedProfile":
        entry = freeze["fixed_profiles"][f"{row['path_id']}_{row['container_id']}"]
        profile_path = _readonly_path(entry["profile"], "read-only FixedProfile CSV")
        _readonly_bound(entry["generation_report"], "FixedProfile generation report")
        tracker_path, tracker = _readonly_bound(entry["tracker_config"], "FixedProfile tracker config")
        require(tracker.get("runtime_profile_regeneration") is False and tracker.get("online_liquid_feedback") is False, "FixedProfile tracker may not regenerate or use liquid feedback")
        require(profile_path.is_file() and tracker_path.is_file(), "FixedProfile immutable assets disappeared")
    return path, path_doc, container, profile_path


def _online_command(freeze: Mapping[str, Any], row: Mapping[str, Any]) -> list[str]:
    config_path, config = _readonly_bound(freeze["effective_configs"][row["condition_id"]], "online effective config")
    require(config.get("condition_id") == row.get("condition_id") and config.get("physical_primary_eligible") is False, "online config identity/primary drift")
    # No weight/observer/delay CLI selectors appear here: the compiled R1
    # variant gate owns them.  The config JSON is a readback expectation, not
    # a mutable launch input.
    return sim_only.sourced_command((
        "roslaunch", "spmpc_sim_local_planner", "smpcc_sim_mechanism_r8.launch",
        "sim_release_ack:=true", f"sim_controller_variant:={config['planner_variant']}",
        f"sim_container_condition:={row['container_id']}",
        "reference_path_topic:=/scout/global_path_fixed", "costmap_topic:=/map",
        "cmd_vel_topic:=/cmd_vel", "publish_cmd_vel:=true",
    ))


def _profile_command(admission: CampaignAdmission, row: Mapping[str, Any], profile: Path) -> list[str]:
    profile_id = f"{row['path_id']}_{row['container_id']}"
    descriptor = admission.freeze["fixed_profiles"][profile_id]["profile"]
    require(descriptor.get("path") == str(profile) and descriptor.get("sha256") == sha256_file(profile), "FixedProfile descriptor drift before launch")
    return sim_only.sourced_command((
        "roslaunch", "spmpc_sim_local_planner", "smpcc_sim_mechanism_fixed_profile.launch",
        "sim_only_release_ack:=true", f"sim_only_container_condition:={row['container_id']}",
        f"frozen_profile_csv:={profile}", f"frozen_profile_sha256:={descriptor['sha256']}",
        f"mechanism_release_hash:={admission.release['release_hash']}",
        f"fixed_profile_id:={profile_id}", f"frozen_path_id:={row['path_id']}",
    ))


def _hproxy_command(container: Mapping[str, Any]) -> list[str]:
    values = container.get("parameters"); require(isinstance(values, Mapping), "container parameters missing")
    return sim_only.sourced_command((
        "roslaunch", "spmpc_sim_local_planner", "smpcc_sim_h_proxy_monitor.launch", "odom_topic:=/odom",
        "subscribe_cmd_vel_debug:=false", "output_namespace:=/slosh",
        f"container_radius:={float(values['container_radius']):.10g}", f"liquid_height:={float(values['liquid_height']):.10g}",
        f"liquid_density:={float(values['liquid_density']):.10g}", f"mode_index:={int(values['mode_index'])}",
        f"damping_ratio:={float(values['damping_ratio']):.10g}", "model_dt:=0.02", "use_linear_model:=true", "use_parabola_term:=false",
    ))


def _child(command: str, *args: str) -> list[str]:
    return sim_only.sourced_command((sys.executable, str(Path(__file__).resolve()), command, *args))


def _event_path(case_dir: Path) -> Path: return case_dir / "motion_goal_events.live.json"


def _read_event(case_dir: Path, case_hash: str) -> Mapping[str, Any]:
    path = _event_path(case_dir); require(path.is_file(), "event monitor state is missing")
    item = read_json(path, "event monitor state"); require(item.get("case_manifest_hash") == case_hash, "event monitor binding mismatch")
    return item


def _read_online_effective(environment: Mapping[str, str], expected: Mapping[str, Any], case_dir: Path) -> Dict[str, Any]:
    result = sim_only.run_checked(sim_only.sourced_command(("rostopic", "echo", "-n", "1", "/sim_spmpc/debug/effective_config")), environment, 12.0, "effective config readback")
    require(result.returncode == 0, "effective config readback failed: " + result.stdout[-400:])
    text = result.stdout
    begin, end = text.find("data: ["), text.find("]", text.find("data: ["))
    require(begin >= 0 and end > begin, "effective config readback has no data array")
    values = [float(token.strip()) for token in text[begin + len("data: ["):end].split(",") if token.strip()]
    require(len(values) == len(CONFIG_FIELDS), "effective config ABI length drift")
    actual = dict(zip(CONFIG_FIELDS, values))
    controller = expected.get("controller"); require(isinstance(controller, Mapping), "expected controller config missing")
    required = ("w_control", "w_smooth", "w_alpha", "w_du_a", "w_du_vs", "w_slosh", "v_ref", "slosh_enable", "smooth_priority_enable")
    diff = {key: {"expected": controller[key], "actual": actual[key]} for key in required if not math.isclose(float(controller[key]), actual[key], rel_tol=1e-5, abs_tol=1e-5)}
    delay = expected.get("delay"); require(isinstance(delay, Mapping), "expected delay config missing")
    for name, expected_value in (("delay_linear_sec", delay["linear_sec"]), ("delay_angular_sec", delay["angular_sec"]), ("delay_cmd_timeout_sec", delay["cmd_timeout_sec"]), ("delay_odom_timeout_sec", delay["odom_timeout_sec"]), ("delay_history_window_sec", delay["history_window_sec"]), ("delay_require_complete_history", delay["require_complete_history"])):
        numeric_expected = 1.0 if expected_value is True else 0.0 if expected_value is False else float(expected_value)
        if not math.isclose(actual[name], numeric_expected, rel_tol=1e-5, abs_tol=1e-5): diff[name] = {"expected": numeric_expected, "actual": actual[name]}
    runtime_parameter_readback: Dict[str, str] = {}
    for parameter, expected_value in (("/sim_spmpc_local_planner/slosh_observer/source", expected["observer"]["source"]), ("/sim_spmpc_local_planner/slosh_observer/fallback_policy", expected["observer"]["fallback_policy"]), ("/sim_spmpc_local_planner/imu_shadow/enable", expected["observer"]["imu_shadow_enable"]), ("/sim_spmpc_local_planner/delay_phase/mode", delay["mode"]), ("/sim_spmpc_local_planner/frames/use_tf_pose", False)):
        check = sim_only.run_checked(sim_only.sourced_command(("rosparam", "get", parameter)), environment, 8.0, f"runtime param {parameter}")
        actual_text = check.stdout.strip().casefold().strip("'\"") if check.returncode == 0 else "<missing>"
        runtime_parameter_readback[parameter] = actual_text
        wanted = str(expected_value).casefold()
        if actual_text != wanted: diff[parameter] = {"expected": expected_value, "actual": actual_text}
    report = {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_EFFECTIVE_CONFIG_READBACK", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "expected_config_hash": expected["effective_config_hash"], "pose_contract": {"authoritative_pose_topic": "/odom", "planner_use_tf_pose": False, "frozen_path_coordinate_contract": "gazebo_odometry_numeric_world"}, "actual_float32_abi": actual, "runtime_parameter_readback": runtime_parameter_readback, "differences": diff, "status": "PASS" if not diff else "FAIL"}
    write_json_new(case_dir / "effective_config_readback.json", report)
    require(not diff, "runtime effective config differs from frozen config: " + json.dumps(diff, sort_keys=True))
    return report


def _read_fixed_identity(admission: CampaignAdmission, row: Mapping[str, Any], profile: Path, environment: Mapping[str, str], case_dir: Path) -> Dict[str, Any]:
    result = sim_only.run_checked(
        sim_only.sourced_command(("rostopic", "echo", "-n", "1", "/sim_mechanism/fixed_profile/identity")),
        environment, 12.0, "FixedProfile identity readback",
    )
    require(result.returncode == 0, "FixedProfile identity readback failed: " + result.stdout[-400:])
    profile_id = f"{row['path_id']}_{row['container_id']}"
    profile_entry = admission.freeze["fixed_profiles"][profile_id]
    profile_sha = profile_entry["profile"]["sha256"]
    generation = read_json(Path(str(profile_entry["generation_report"]["path"])), "FixedProfile generation report")
    expected = {
        "tracker_id": "SIM-MECHANISM-FIXEDPROFILE-TRACKER-R1",
        "release_id": RELEASE_ID,
        "release_hash": str(admission.release["release_hash"]),
        "formal_scope": FORMAL_SCOPE,
        "physical_primary_eligible": False,
        "fixed_profile_id": profile_id,
        "path_id": str(row["path_id"]),
        "container_config_id": {
            "C1": "SIM_ONLY_C1_D37_H58_LEGACY_UNVALIDATED",
            "C2": "SIM_ONLY_C2_D95_H58_UNVALIDATED",
        }[str(row["container_id"])],
        "profile_path": str(profile),
        "profile_sha256": str(profile_sha),
        "profile_method": "SIM_MECHANISM_HAMAGUCHI_STYLE",
        "profile_duration_sec": generation["duration_sec"],
        "execution_coordinate": "spatial_path_progress_closed_loop_v_of_s",
        "runtime_profile_regeneration": False,
        "online_liquid_feedback": False,
        "diagnostics_layout": [
            "nearest_index", "s_normalized", "s_m", "v_ref_m_s",
            "cmd_v_m_s", "cmd_omega_rad_s", "cross_track_error_m",
            "heading_error_rad", "goal_distance_m", "odom_v_m_s",
            "odom_omega_rad_s", "odom_age_sim_sec",
        ],
    }
    expected.update({
        "command_handshake_schema": FIXED_HANDSHAKE_SCHEMA,
        "zero_hold_ready_topic": FIXED_READY_TOPIC,
        "dynamic_admission_topic": FIXED_ADMISSION_TOPIC,
        "release_topic": FIXED_RELEASE_TOPIC,
        "release_receipt_topic": FIXED_RELEASE_RECEIPT_TOPIC,
        "release_request": _fixed_release_request(admission, row, profile),
    })
    try:
        import yaml  # type: ignore
        ros_message = yaml.safe_load(result.stdout.split("\n---", 1)[0])
        require(isinstance(ros_message, Mapping) and isinstance(ros_message.get("data"), str), "FixedProfile identity topic is not std_msgs/String")
        actual = json.loads(str(ros_message["data"]))
        require(isinstance(actual, Mapping), "FixedProfile identity payload is not an object")
    except Exception as exc:  # normalize malformed ROS/YAML/JSON to fail-closed admission
        raise RunnerError(f"cannot parse FixedProfile identity readback: {exc}") from exc
    missing = {key: value for key, value in expected.items() if actual.get(key) != value}
    report = {
        "schema_version": SCHEMA_VERSION,
        "record_type": "SMPCC_SIM_MECHANISM_FIXED_PROFILE_IDENTITY_READBACK",
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "formal": True,
        "formal_scope": FORMAL_SCOPE,
        "physical_primary_eligible": False,
        "expected": expected,
        "actual": dict(actual),
        "raw_identity_message": result.stdout,
        "missing_bindings": missing,
        "status": "PASS" if not missing else "FAIL",
    }
    write_json_new(case_dir / "fixed_profile_identity_readback.json", report)
    require(not missing, "FixedProfile runtime identity differs from frozen release: " + json.dumps(missing, sort_keys=True))
    return report


def _fixed_release_request(admission: CampaignAdmission, row: Mapping[str, Any],
                           profile: Path) -> Dict[str, Any]:
    descriptor = admission.freeze["fixed_profiles"][f"{row['path_id']}_{row['container_id']}"]["profile"]
    require(descriptor.get("path") == str(profile) and descriptor.get("sha256") == sha256_file(profile), "FixedProfile release request profile drift")
    return {
        "schema_version": FIXED_HANDSHAKE_SCHEMA,
        "command": "RELEASE_MOTION",
        "tracker_id": "SIM-MECHANISM-FIXEDPROFILE-TRACKER-R1",
        "release_id": RELEASE_ID,
        "release_hash": str(admission.release["release_hash"]),
        "formal_scope": FORMAL_SCOPE,
        "fixed_profile_id": f"{row['path_id']}_{row['container_id']}",
        "path_id": str(row["path_id"]),
        "container_config_id": {
            "C1": "SIM_ONLY_C1_D37_H58_LEGACY_UNVALIDATED",
            "C2": "SIM_ONLY_C2_D95_H58_UNVALIDATED",
        }[str(row["container_id"])],
        "profile_sha256": sha256_file(profile),
    }


def _read_string_json_topic(topic: str, environment: Mapping[str, str],
                            label: str) -> Mapping[str, Any]:
    result = sim_only.run_checked(
        sim_only.sourced_command(("rostopic", "echo", "-n", "1", topic)),
        environment, 12.0, label,
    )
    require(result.returncode == 0, f"{label} readback failed: {result.stdout[-400:]}")
    try:
        import yaml  # type: ignore
        message = yaml.safe_load(result.stdout.split("\n---", 1)[0])
        require(isinstance(message, Mapping) and isinstance(message.get("data"), str), f"{label} is not std_msgs/String")
        payload = json.loads(str(message["data"]))
        require(isinstance(payload, Mapping), f"{label} JSON payload is not an object")
        return payload
    except Exception as exc:
        raise RunnerError(f"cannot parse {label}: {exc}") from exc


def _wait_new_topic_subscribers(topic: str, *, ros_uri: str,
                                before: Mapping[str, Sequence[str]],
                                timeout_sec: float) -> list[str]:
    baseline = set(before.get(topic, ()))
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        current = sim_only.read_subscriber_graph(ros_uri)
        added = sorted(set(current.get(topic, ())) - baseline)
        if added:
            return added
        time.sleep(0.05)
    raise RunnerError(f"recorder did not add a subscriber to {topic} before motion release")


def _wait_required_publisher_registrations(
        ros_uri: str, topics: Sequence[str], timeout_sec: float = 10.0
        ) -> Dict[str, tuple[str, ...]]:
    """Prove deferred online diagnostics exist before reference release."""

    require(tuple(topics) == DEFERRED_ONLINE_MESSAGE_TOPICS,
            "deferred online publisher topics differ from frozen policy")
    deadline = time.monotonic() + float(timeout_sec)
    latest: Dict[str, tuple[str, ...]] = {}
    while time.monotonic() < deadline:
        latest = sim_only.read_publisher_graph(ros_uri)
        if all(latest.get(topic) for topic in topics):
            return {topic: tuple(latest[topic]) for topic in topics}
        time.sleep(0.05)
    missing = [topic for topic in topics if not latest.get(topic)]
    raise RunnerError(
        "required deferred diagnostic publishers are absent before motion: " +
        ", ".join(missing))


def _validate_fixed_handshake(payload: Mapping[str, Any], *,
                              record_type: str,
                              admission: CampaignAdmission,
                              row: Mapping[str, Any], profile: Path) -> None:
    request = _fixed_release_request(admission, row, profile)
    common = {
        "schema_version": FIXED_HANDSHAKE_SCHEMA,
        "record_type": record_type,
        "tracker_id": "SIM-MECHANISM-FIXEDPROFILE-TRACKER-R1",
        "release_id": RELEASE_ID,
        "release_hash": admission.release["release_hash"],
        "formal_scope": FORMAL_SCOPE,
        "physical_primary_eligible": False,
        "fixed_profile_id": request["fixed_profile_id"],
        "path_id": request["path_id"],
        "container_config_id": request["container_config_id"],
        "profile_sha256": request["profile_sha256"],
        "runtime_profile_regeneration": False,
        "online_liquid_feedback": False,
        "cmd_vel_topic": "/cmd_vel",
    }
    missing = {key: value for key, value in common.items() if payload.get(key) != value}
    require(not missing, "FixedProfile handshake common binding mismatch: " + json.dumps(missing, sort_keys=True))
    if record_type == "SMPCC_SIM_MECHANISM_FIXEDPROFILE_ZERO_HOLD_READY":
        require(payload.get("state") == "STATIC_ADMITTED_ZERO_HOLD" and payload.get("command_publisher_created") is True and payload.get("zero_hold_active") is True and payload.get("dynamic_path_admitted") is False and payload.get("motion_released") is False and int(payload.get("zero_command_count", 0)) >= 1 and payload.get("runner_must_verify_recorder_cmd_connection") is True and payload.get("release_request_sha256") == canonical_hash(request), "FixedProfile zero-hold ready evidence is incomplete")
    elif record_type == "SMPCC_SIM_MECHANISM_FIXEDPROFILE_DYNAMIC_ADMISSION":
        require(payload.get("state") == "DYNAMIC_ADMITTED_ZERO_HOLD" and payload.get("path_geometry_valid") is True and payload.get("start_pose_valid") is True and payload.get("start_stationary") is True and payload.get("motion_released") is False and payload.get("release_request") == request and payload.get("release_request_sha256") == canonical_hash(request) and payload.get("runner_must_verify_recorder_cmd_connection") is True, "FixedProfile dynamic admission evidence is incomplete")
    elif record_type == "SMPCC_SIM_MECHANISM_FIXEDPROFILE_RELEASE_RECEIPT":
        request_bytes = json.dumps(request, sort_keys=True, separators=(",", ":")).encode("utf-8")
        require(payload.get("state") == "MOTION_RELEASED" and payload.get("motion_released") is True and payload.get("release_request_sha256") == canonical_hash(request) and payload.get("accepted_request_sha256") == hashlib.sha256(request_bytes).hexdigest() and int(payload.get("zero_command_count_before_release", 0)) >= 1 and int(payload.get("cmd_publisher_connection_count", 0)) >= 1, "FixedProfile motion-release receipt is incomplete")


def _classify(error: str, motion_started: bool) -> str:
    """Classify only failures that occur before a primary method outcome.

    Executed motion is never made retryable from error-message text.  The
    shared runtime-QC classifier owns the final attempt outcome; this helper
    merely distinguishes a narrow, pre-motion acquisition loss from a frozen
    protocol violation.
    """

    if motion_started:
        return "PROTOCOL_FAILURE_AFTER_MOTION"
    text = error.casefold()
    if any(token in text for token in (
            "required topic", "wait topic", "recorder", "unreachable",
            "cannot read event state", "event state:",
            "communicate with master", "authoritative initial odometry was not acquired",
            "no executed base motion within acquisition deadline")):
        return "INFRASTRUCTURE_ACQUISITION"
    return "PROTOCOL_FAILURE"


def _bag_topic_contract(condition_id: str) -> tuple[tuple[str, ...], tuple[str, ...]]:
    """Return the recorded superset and condition-specific nonempty set."""

    common = (
        "/clock", "/odom", "/tf", "/tf_static",
        "/scout/global_path_fixed", "/scout/goal", "/sim_spmpc/status",
        H_PROXY, "/cmd_vel",
    )
    online = (
        "/sim_spmpc/terminal/debug", "/sim_spmpc/terminal/mode",
        "/sim_spmpc/debug/effective_config", H_MODAL,
    )
    fixed = (
        "/sim_mechanism/fixed_profile/identity",
        "/sim_mechanism/fixed_profile/diagnostics", FIXED_READY_TOPIC,
        FIXED_ADMISSION_TOPIC, FIXED_RELEASE_TOPIC,
        FIXED_RELEASE_RECEIPT_TOPIC,
    )
    require(condition_id in ONLINE_CONDITIONS or condition_id == "FixedProfile",
            f"unknown condition-specific recorder contract: {condition_id}")
    recorder = tuple(dict.fromkeys((*common, *online, *fixed)))
    required = tuple(dict.fromkeys(
        (*common, *(online if condition_id in ONLINE_CONDITIONS else fixed))))
    return recorder, required


def _cleanup_pass(results: Sequence[Mapping[str, Any]]) -> bool:
    """Reject any untracked escalation or incomplete owned-child cleanup."""

    return all(
        item.get("cleanup_error") in (None, "")
        and item.get("escalated_to") in (None, "")
        and (item.get("not_started") is True
             or isinstance(item.get("returncode"), int))
        for item in results
    )


def _publish_frozen_zero_suffix(
        environment: Mapping[str, str],
        lifecycle: list[Dict[str, Any]]) -> None:
    """Require a redundant, bounded all-zero suffix before tail timing.

    ``rostopic pub -1`` is an owned short-lived process and can transiently
    miss its five-second transport window under host load.  Repeating only
    the identical zero Twist is safe after command sources have stopped; this
    is tail acquisition, never a retry of the method outcome.
    """

    attempts: list[Dict[str, Any]] = []
    successes = 0
    for number in range(1, ZERO_COMMAND_MAX_ATTEMPTS + 1):
        published = bool(sim_only.publish_zero(environment))
        attempts.append({"attempt": number, "published": published})
        if published:
            successes += 1
            if successes >= ZERO_COMMAND_REQUIRED_SUCCESSES:
                lifecycle.append({
                    "event": "redundant_zero_suffix_published",
                    "utc": utc_now(),
                    "attempts": attempts,
                    "required_successes": ZERO_COMMAND_REQUIRED_SUCCESSES,
                })
                return
        time.sleep(0.10)
    lifecycle.append({
        "event": "redundant_zero_suffix_failed",
        "utc": utc_now(),
        "attempts": attempts,
        "required_successes": ZERO_COMMAND_REQUIRED_SUCCESSES,
    })
    raise RunnerError(
        "zero command suffix failed after bounded redundant publication")


def _receipt_descriptor(path: Path, receipt: Mapping[str, Any],
                        hash_field: str) -> Dict[str, Any]:
    require(path.is_file(), f"runtime QC receipt is missing: {path}")
    value = receipt.get(hash_field)
    require(isinstance(value, str) and len(value) == 64,
            f"runtime QC receipt lacks {hash_field}")
    return {"path": str(path), "sha256": sha256_file(path), hash_field: value}


def _case_roots(master: Mapping[str, Any], attempt_id: str) -> tuple[Path, Path]:
    policy = master["result_policy"]
    result_root = require_exact_path(Path(str(policy["result_root"])), CANONICAL_RESULT_ROOT, "matrix results")
    bag_root = require_exact_path(Path(str(policy["bag_root"])), CANONICAL_BAG_ROOT, "matrix bags")
    case = result_root / "attempts" / attempt_id; bag = bag_root / attempt_id
    reject_symlink_chain(case, "attempt result directory"); reject_symlink_chain(bag, "attempt bag directory")
    require(not case.exists() and not bag.exists(), "attempt output already exists")
    return case, bag


def validate_crn_stream_application_registry() -> Dict[str, Dict[str, Any]]:
    """Validate and hash the executable six-stream application policy."""

    expected_modes = {
        "initial_robot_pose": "ACTIVE",
        "initial_liquid_state": "INACTIVE_ZERO_AMPLITUDE",
        "actuator_disturbance": "INACTIVE_ZERO_AMPLITUDE",
        "sensor_noise": "INACTIVE_ZERO_AMPLITUDE",
        "environment_contact_noise": "INACTIVE_ZERO_AMPLITUDE",
        "simulator_rng": "ACTIVE",
    }
    require(set(CRN_STREAM_APPLICATIONS) == set(crn_runtime.SEED_STREAMS),
            "CRN application registry does not cover every frozen stream")
    output: Dict[str, Dict[str, Any]] = {}
    for stream in crn_runtime.SEED_STREAMS:
        item = CRN_STREAM_APPLICATIONS[stream]
        require(isinstance(item, Mapping) and
                set(item) == {"consumption_phase", "consumer_target", "mapping"},
                f"CRN application registry item {stream} is malformed")
        require(item.get("consumption_phase") ==
                crn_runtime.CONSUMPTION_PHASES[stream],
                f"CRN application registry phase mismatch for {stream}")
        require(isinstance(item.get("consumer_target"), str) and
                bool(item["consumer_target"]),
                f"CRN application registry target missing for {stream}")
        mapping = item.get("mapping")
        require(isinstance(mapping, Mapping) and set(mapping) == {
            "stream", "source_field", "time_index_field", "application_mode",
            "value_transform", "runtime_evidence",
        }, f"CRN application mapping {stream} fields are not exact")
        require(mapping.get("stream") == stream and
                mapping.get("source_field") == "unit_uniform" and
                mapping.get("time_index_field") == "time_index_ms" and
                mapping.get("application_mode") == expected_modes[stream] and
                isinstance(mapping.get("runtime_evidence"), str) and
                bool(mapping["runtime_evidence"]),
                f"CRN application mapping {stream} identity is invalid")
        if expected_modes[stream] == "INACTIVE_ZERO_AMPLITUDE":
            require(mapping.get("value_transform") == "unit_uniform_to_zero",
                    f"inactive CRN stream {stream} is not frozen to zero")
        output[stream] = {
            "consumption_phase": item["consumption_phase"],
            "consumer_target": item["consumer_target"],
            "application_mode": mapping["application_mode"],
            "mapping_hash": canonical_hash(mapping),
        }
    return output


def frozen_simulator_seed(freeze: Mapping[str, Any], row: Mapping[str, Any]) -> int:
    """Map the immutable simulator trace at t=0 to Gazebo's int31 seed."""

    bundle = freeze["seed_bundles"][f"{row['stage']}:{row['block_id']}"]
    require(bundle.get("seed_bundle_id") == row.get("seed_bundle_id") and bundle.get("seed_bundle_hash") == row.get("seed_bundle_hash"), "row seed bundle drift")
    traces = bundle.get("traces")
    trace = traces.get("simulator_rng") if isinstance(traces, Mapping) else None
    samples = trace.get("samples") if isinstance(trace, Mapping) else None
    first = samples[0] if isinstance(samples, list) and samples else None
    unit = first.get("unit_uniform") if isinstance(first, Mapping) else None
    require(isinstance(unit, (int, float)) and not isinstance(unit, bool) and
            math.isfinite(float(unit)) and 0.0 <= float(unit) < 1.0 and
            first.get("time_index_ms") == 0,
            "frozen simulator RNG trace t=0 sample is invalid")
    seed = int(math.floor(float(unit) * 2147483647.0))
    require(0 <= seed < 2147483647, "frozen simulator seed is invalid")
    return seed


def resolve_crn_stream_applications(
        consumptions: Mapping[str, Mapping[str, Any]], *,
        consumer: Any, frozen_path_initial_yaw_rad: float,
        simulator_seed: int) -> Dict[str, Dict[str, Any]]:
    """Resolve each admitted trace sample to its active or frozen-zero target."""

    contract = validate_crn_stream_application_registry()
    require(set(consumptions) == set(crn_runtime.SEED_STREAMS),
            "CRN application receipt requires every frozen stream")
    resolved: Dict[str, Dict[str, Any]] = {}
    for stream in crn_runtime.SEED_STREAMS:
        sample = consumptions[stream]
        require(isinstance(sample, Mapping) and sample.get("stream") == stream and
                sample.get("trace_hash") == consumer.stream_trace_hashes[stream] and
                sample.get("consumption_phase") ==
                crn_runtime.CONSUMPTION_PHASES[stream] and
                sample.get("time_domain") == crn_runtime.TIME_DOMAIN and
                sample.get("time_origin_event") == crn_runtime.TIME_ORIGIN_EVENT and
                sample.get("interpolation") == crn_runtime.INTERPOLATION,
                f"CRN application sample {stream} is not bound to the consumer")
        unit = sample.get("unit_uniform")
        index_ms = sample.get("time_index_ms")
        require(isinstance(unit, (int, float)) and not isinstance(unit, bool) and
                math.isfinite(float(unit)) and 0.0 <= float(unit) < 1.0 and
                isinstance(index_ms, (int, float)) and not isinstance(index_ms, bool) and
                math.isfinite(float(index_ms)),
                f"CRN application sample {stream} is invalid")
        mode = contract[stream]["application_mode"]
        if stream == "initial_robot_pose":
            expected_offset = (2.0 * float(unit) - 1.0) * 0.02
            require(math.isclose(expected_offset,
                                 float(consumer.initial_yaw_offset_rad),
                                 rel_tol=0.0, abs_tol=1e-12),
                    "initial robot pose trace does not map to frozen yaw offset")
            applied_value: Any = float(frozen_path_initial_yaw_rad) + expected_offset
            value_unit = "rad"
        elif stream == "simulator_rng":
            expected_seed = int(math.floor(float(unit) * 2147483647.0))
            require(expected_seed == simulator_seed,
                    "simulator RNG trace does not map to the launched Gazebo seed")
            applied_value = expected_seed
            value_unit = "int31_seed"
        else:
            require(mode == "INACTIVE_ZERO_AMPLITUDE",
                    f"unimplemented non-zero CRN channel: {stream}")
            applied_value = 0.0
            value_unit = "frozen_zero_amplitude"
        resolved[stream] = {
            **contract[stream],
            "trace_hash": sample["trace_hash"],
            "time_index_ms": float(index_ms),
            "unit_uniform": float(unit),
            "applied_value": applied_value,
            "applied_value_unit": value_unit,
            "mapping_enforced": True,
        }
    return resolved


def build_crn_application_receipt(
        *, case_manifest_hash: str, row: Mapping[str, Any],
        stream_application: Mapping[str, Mapping[str, Any]]) -> Dict[str, Any]:
    require(isinstance(case_manifest_hash, str) and len(case_manifest_hash) == 64,
            "CRN application receipt case manifest hash is invalid")
    require(set(stream_application) == set(crn_runtime.SEED_STREAMS) and
            all(item.get("mapping_enforced") is True
                for item in stream_application.values()),
            "CRN application receipt is incomplete")
    core = {
        "schema_version": "smpcc-sim-mechanism-crn-application-receipt-v1",
        "record_type": "SMPCC_SIM_MECHANISM_CRN_APPLICATION_RECEIPT",
        "consumer_id": crn_runtime.CONSUMER_ID,
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "formal": True,
        "formal_scope": FORMAL_SCOPE,
        "physical_primary_eligible": False,
        "status": "PASS",
        "case_manifest_hash": case_manifest_hash,
        "stage": row["stage"],
        "block_id": row["block_id"],
        "seed_bundle_id": row["seed_bundle_id"],
        "seed_bundle_hash": row["seed_bundle_hash"],
        "trace_asset_hash": row["crn_trace_asset_hash"],
        "stream_application": {
            stream: dict(stream_application[stream])
            for stream in crn_runtime.SEED_STREAMS
        },
        "active_streams": ["initial_robot_pose", "simulator_rng"],
        "inactive_zero_amplitude_streams": [
            "initial_liquid_state", "actuator_disturbance", "sensor_noise",
            "environment_contact_noise",
        ],
        "nonzero_unfrozen_noise_invented": False,
    }
    return dict(core, receipt_hash=canonical_hash(core))


def admit_crn_runtime(freeze: Mapping[str, Any], row: Mapping[str, Any]):
    """Admit the row-bound, condition-blind block asset before runtime start."""

    stage, block = str(row["stage"]), str(row["block_id"])
    bundle = freeze["seed_bundles"][f"{stage}:{block}"]
    trace = row.get("crn_trace_asset")
    require(isinstance(trace, Mapping) and set(trace) == {"path", "sha256"}, "row CRN trace descriptor is malformed")
    require(trace == bundle.get("trace_asset") and row.get("crn_trace_asset_hash") == bundle.get("trace_asset_hash") and row.get("seed_bundle_id") == bundle.get("seed_bundle_id") and row.get("seed_bundle_hash") == bundle.get("seed_bundle_hash"), "row CRN bundle/trace binding drift")
    trusted = {
        "SMPCC_CRN_TRACE_ASSET_PATH": str(trace["path"]),
        "SMPCC_CRN_TRACE_ASSET_SHA256": str(trace["sha256"]),
        "SMPCC_CRN_TRACE_ASSET_HASH": str(row["crn_trace_asset_hash"]),
        "SMPCC_CRN_SEED_BUNDLE_ID": str(row["seed_bundle_id"]),
        "SMPCC_CRN_SEED_BUNDLE_HASH": str(row["seed_bundle_hash"]),
    }
    computed = crn_runtime.required_environment(
        Path(str(trace["path"])), stage, block)
    require(computed == trusted, "row CRN trusted bindings differ from immutable asset")
    consumer = crn_runtime.CRNTraceConsumer.from_environment(
        dict(trusted), stage, block, expected_bindings=trusted)
    require(consumer.stream_trace_hashes == row.get("crn_stream_trace_hashes") and math.isclose(consumer.initial_yaw_offset_rad, float(row.get("crn_initial_yaw_offset_rad")), rel_tol=0.0, abs_tol=1e-12), "row CRN stream/yaw binding drift")
    # Reset/environment streams are consumed before any method publisher can
    # exist.  Motion-indexed streams are consumed at t=0 only after first
    # effective motion, so their ledger cannot be fabricated pre-motion.
    consumed: Dict[str, Mapping[str, Any]] = {}
    for stream in ("initial_robot_pose", "initial_liquid_state", "simulator_rng"):
        consumed[stream] = consumer.consume(
            stream, elapsed_sim_time_sec=0.0,
            consumption_phase=crn_runtime.CONSUMPTION_PHASES[stream])
    return consumer, trusted, bundle, consumed


def execute_one(admission: CampaignAdmission, row_id: str, attempt_id: str, ros_uri: str, gazebo_uri: str, retry_authorization: Optional[Path]) -> Dict[str, Any]:
    freeze_path, freeze = admission.freeze_path, admission.freeze
    master_path, master = admission.master_path, admission.master
    rows = {str(item["planned_row_id"]): item for item in master["planned_rows"]}
    row = rows.get(row_id); require(isinstance(row, Mapping), "unknown planned row ID")
    _validate_next_row(admission, row, attempt_id, retry_authorization)
    require(sim_only.canonical_uri(ros_uri, "ROS master URI") == ros_uri and sim_only.canonical_uri(gazebo_uri, "Gazebo master URI") == gazebo_uri and ros_uri != gazebo_uri, "masters must be distinct canonical loopback URIs")
    path, path_doc, container, profile = _path_container_config(freeze, row)
    first = path_doc["points"][0]
    crn_consumer, crn_environment, bundle, crn_consumptions = admit_crn_runtime(freeze, row)
    seed = frozen_simulator_seed(freeze, row)
    frozen_path_initial_yaw = float(first.get("yaw", 0.0))
    expected_spawn_yaw = crn_consumer.spawn_yaw(frozen_path_initial_yaw)
    require(admission.release.get("crn_runtime_ack_schema_hash") == crn_runtime.RUNTIME_ACK_SCHEMA_HASH, "release CRN runtime ACK schema differs from executable consumer")
    recorder_topics, required_bag_topics = _bag_topic_contract(
        str(row["condition_id"]))
    case_dir, bag_dir = _case_roots(master, attempt_id)
    case_dir.mkdir(parents=True, exist_ok=False); bag_dir.mkdir(parents=True, exist_ok=False)
    core = {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_CASE_MANIFEST", "runner_id": RUNNER_ID, "protocol_id": PROTOCOL_ID, "release_id": RELEASE_ID, "formal": True, "formal_scope": FORMAL_SCOPE, "physical_alignment": False, "physical_primary_eligible": False, "physical_primary": None, "evidence_class": "SIMULATION_MECHANISM_FORMAL_RUN", "attempt_id": attempt_id, "planned_row": dict(row), "release": {"path": str(admission.release_path), "sha256": sha256_file(admission.release_path), "release_hash": admission.release["release_hash"]}, "freeze": {"path": str(freeze_path), "sha256": sha256_file(freeze_path)}, "master": {"path": str(master_path), "sha256": sha256_file(master_path), "master_hash": master["master_hash"]}, "path": {"path": str(path), "sha256": sha256_file(path)}, "container": {"path": str(freeze["containers"][row["container_id"]]["path"]), "sha256": freeze["containers"][row["container_id"]]["sha256"]}, "profile": {"path": str(profile), "sha256": sha256_file(profile)} if profile else None, "seed": seed, "seed_bundle": bundle, "seed_realization": {"seed_bundle_id": bundle["seed_bundle_id"], "seed_bundle_hash": bundle["seed_bundle_hash"], "independent_sub_seeds": True, "time_indexed_traces": True, "frozen_simulator_seed": seed, "operator_seed_override_allowed": False, "runtime_stochastic_injection": "none; fresh proxy world has no enabled noise injector, so a deterministic reset is the common realization and no method-dependent RNG draw order exists"}, "ros_master_uri": ros_uri, "gazebo_master_uri": gazebo_uri, "timing": freeze["recording_policy"], "measurements": {"H_proxy": {"topic": H_PROXY, "semantic": "sim_modal_proxy_mechanism_only", "physical_primary_eligible": False}, "H_modal": {"topic": H_MODAL, "semantic": "controller_internal_modal_only", "physical_primary_eligible": False}, "physical_primary": None}}
    core["seed_realization"] = {
        "seed_bundle_id": bundle["seed_bundle_id"],
        "seed_bundle_hash": bundle["seed_bundle_hash"],
        "independent_sub_seeds": True,
        "time_indexed_traces": True,
        "trace_asset": dict(row["crn_trace_asset"]),
        "trace_asset_hash": row["crn_trace_asset_hash"],
        "stream_trace_hashes": dict(row["crn_stream_trace_hashes"]),
        "frozen_simulator_seed": seed,
        "operator_seed_override_allowed": False,
        "runtime_stochastic_injection": "active frozen initial yaw and Gazebo RNG seed; four unfrozen-magnitude channels are explicitly enforced at zero amplitude",
        "runtime_consumer_id": crn_runtime.CONSUMER_ID,
        "runtime_ack_schema_hash": crn_runtime.RUNTIME_ACK_SCHEMA_HASH,
        "stream_application_contract": validate_crn_stream_application_registry(),
        "active_streams": ["initial_robot_pose", "simulator_rng"],
        "inactive_zero_amplitude_streams": ["initial_liquid_state", "actuator_disturbance", "sensor_noise", "environment_contact_noise"],
        "nonzero_unfrozen_noise_invented": False,
    }
    core["pose_contract"] = {
        "authoritative_pose_topic": "/odom",
        "authoritative_pose_semantic": "gazebo_odometry_message",
        "frozen_path_coordinate_contract": "gazebo_odometry_numeric_world",
        "online_planner_use_tf_pose": False,
        "controller_status_is_sufficient_for_success": False,
        "initial_yaw_offset_rad": crn_consumer.initial_yaw_offset_rad,
        "expected_spawn_yaw_rad": expected_spawn_yaw,
    }
    core["recording_contract"] = {
        "recorder_topics": list(recorder_topics),
        "required_nonempty_topics": list(required_bag_topics),
        "pre_motion_publisher_gate_topics": (
            list(DEFERRED_ONLINE_MESSAGE_TOPICS)
            if row["condition_id"] in ONLINE_CONDITIONS else []),
        "condition_specific_nonempty_gate": True,
        "optional_superset_topics_may_be_empty": True,
    }
    core["simulator_assets"] = dict(freeze["simulator_assets"])
    if row["condition_id"] in ONLINE_CONDITIONS:
        core["execution_config"] = {
            "kind": "ONLINE_EFFECTIVE_CONFIG",
            "descriptor": dict(
                freeze["effective_configs"][row["condition_id"]]),
        }
    else:
        core["execution_config"] = {
            "kind": "FIXEDPROFILE_TRACKER_CONFIG",
            "descriptor": dict(freeze["fixed_profiles"][
                f"{row['path_id']}_{row['container_id']}"]["tracker_config"]),
        }
    manifest = dict(core, case_manifest_hash=canonical_hash(core)); manifest_path = case_dir / "case_manifest.json"; write_json_new(manifest_path, manifest); case_hash = sha256_file(manifest_path)
    runtime_start = dict(first); runtime_start["yaw"] = expected_spawn_yaw
    environment = sim_only.runtime_environment(ros_uri=ros_uri, gazebo_uri=gazebo_uri, case_dir=case_dir, path_info={"start": runtime_start})
    environment.update(crn_environment)
    environment["SMPCC_SIMULATOR_SEED"] = str(seed)
    children = sim_only.OwnedChildren()
    lifecycle: list[Dict[str, Any]] = []
    recorder = None
    events: Mapping[str, Any] = {}
    fixed_handshake: Dict[str, Any] = {}
    crn_ack: Optional[Mapping[str, Any]] = None
    crn_ack_valid = False
    crn_application_receipt: Optional[Mapping[str, Any]] = None
    crn_application_valid = False
    pre = {"ros": True, "gazebo": True}
    post = {"ros": True, "gazebo": True}
    motion_started = False
    motion_command_released = False
    motion_evidence_uncertain = False
    goal_reached = False
    tail_complete = False
    error: Optional[str] = None
    primary_method_outcome: Optional[str] = None
    terminal_kind: Optional[str] = None
    terminal_ros_time: Optional[float] = None
    terminal_elapsed_sec: Optional[float] = None
    completion_qc: Optional[Mapping[str, Any]] = None
    timeout_qc: Optional[Mapping[str, Any]] = None
    stop_bundle_qc: Optional[Mapping[str, Any]] = None
    bag_qc: Optional[Mapping[str, Any]] = None
    runtime_qc_report: Optional[Mapping[str, Any]] = None
    motion_stop: Optional[Mapping[str, Any]] = None
    path_stop: Optional[Mapping[str, Any]] = None
    recorder_stop: Optional[Mapping[str, Any]] = None
    cleanup: list[Mapping[str, Any]] = []
    cleanup_ok = False
    exception_infrastructure = False
    exception_protocol = False
    exception_qc = False
    final_event_read_ok = False
    motion_component = ("planner" if row["condition_id"] in ONLINE_CONDITIONS
                        else "profile_tracker")
    active = bag_dir / "capture.active.bag"
    recorder_native_active = Path(str(active) + ".active")
    final = bag_dir / "capture.bag"

    def stop_command_sources() -> None:
        nonlocal motion_stop, path_stop
        if motion_stop is None:
            motion_stop = children.stop(motion_component, signal.SIGTERM, 8.0)
        if path_stop is None:
            path_stop = children.stop("path_replay", signal.SIGTERM, 5.0)

    def record_frozen_tail_and_close() -> None:
        """Stop this attempt's command sources and close its recorder once."""

        nonlocal recorder_stop, stop_bundle_qc, bag_qc, tail_complete, events
        require(recorder is not None, "frozen tail has no owned recorder")
        stop_command_sources()
        _publish_frozen_zero_suffix(environment, lifecycle)
        # The evidence gate is in ROS simulation time, not wall time.  Wait for
        # a conservative 5.5 s /odom advance after the zero publication with a
        # bounded wall watchdog; this avoids an RTF<1 race at exactly 5.0 s.
        tail_start_ros_time: Optional[float] = None
        tail_deadline = time.monotonic() + 30.0
        while time.monotonic() < tail_deadline:
            require(recorder.poll() is None,
                    "recorder exited during frozen tail")
            if _event_path(case_dir).is_file():
                current_events = _read_event(case_dir, case_hash)
                latest = current_events.get("latest_odometry")
                stamp = (latest.get("ros_time_sec")
                         if isinstance(latest, Mapping) else None)
                if (isinstance(stamp, (int, float)) and
                        not isinstance(stamp, bool) and
                        math.isfinite(float(stamp))):
                    events = current_events
                    if tail_start_ros_time is None:
                        tail_start_ros_time = float(stamp)
                    elif float(stamp) - tail_start_ros_time >= 5.5:
                        break
            time.sleep(0.05)
        require(tail_start_ros_time is not None and
                isinstance(events.get("latest_odometry"), Mapping) and
                float(events["latest_odometry"]["ros_time_sec"]) -
                tail_start_ros_time >= 5.5,
                "frozen tail did not accumulate 5.5 s of ROS simulation time")
        require(recorder.poll() is None, "recorder exited during frozen tail")
        lifecycle.append({
            "event": "tail_sim_interval_complete", "utc": utc_now(),
            "required_sec": 5.0, "observed_guard_sec": 5.5,
            "start_ros_time_sec": tail_start_ros_time,
            "end_ros_time_sec": float(
                events["latest_odometry"]["ros_time_sec"]),
        })
        if recorder_stop is None:
            recorder_stop = children.stop("recorder", signal.SIGINT, 12.0)
        stop_bundle_qc = runtime_qc.validate_owned_stop_bundle(
            {motion_component: motion_stop, "path_replay": path_stop,
             "recorder": recorder_stop}, motion_component=motion_component)
        require(active.is_file(), "closed rosbag output is unavailable")
        require(not recorder_native_active.exists(),
                "rosbag native .active artifact remains after controlled close")
        require(not final.exists(), "final bag existed before controlled finalization")
        require(primary_method_outcome is not None and
                terminal_kind in {"GOAL_REACHED", "GOAL_TIMEOUT"} and
                terminal_ros_time is not None and
                isinstance(events.get("first_executed_motion"), Mapping),
                "cannot audit a bag without a frozen primary terminal event")
        os.replace(active, final)
        bag_qc = runtime_qc.audit_closed_rosbag(
            final, active_artifact_paths=(active, recorder_native_active),
            required_topics=required_bag_topics,
            motion_start_ros_time_sec=float(
                events["first_executed_motion"]["ros_time_sec"]),
            terminal_ros_time_sec=terminal_ros_time,
            terminal_kind=str(terminal_kind), attempt_id=attempt_id,
            case_manifest_hash=case_hash, protocol_id=PROTOCOL_ID,
            release_id=RELEASE_ID, formal=True, tail_sec=5.0)
        tail_complete = True
        lifecycle.append({
            "event": "tail_recorded", "utc": utc_now(), "sec": 5.0,
            "closed_bag_audited": True,
            "bag_qc_hash": bag_qc["bag_qc_hash"],
        })

    try:
        pre = sim_only.endpoints_reachable(ros_uri, gazebo_uri); require(pre == {"ros": False, "gazebo": False}, "fresh preflight requires both masters unreachable")
        lifecycle.append({"event": "preflight", "utc": utc_now(), **pre})
        children.start("environment", (str(sim_only.ENV_LAUNCH),), environment, stdout=case_dir / "environment.log")
        for topic in ("/odom", "/map"): sim_only.wait_topic(topic, environment, 60.0)
        sim_time = sim_only.run_checked(sim_only.sourced_command(("rosparam", "get", "/use_sim_time")), environment, 10.0, "simulation time")
        require(sim_time.returncode == 0 and sim_time.stdout.strip().casefold() == "true", "runner rejects a non-simulation ROS master")
        children.start("h_proxy", _hproxy_command(container), environment, stdout=case_dir / "h_proxy.log"); sim_only.wait_topic(H_PROXY, environment, 60.0)
        if row["condition_id"] in ONLINE_CONDITIONS:
            children.start("planner", _online_command(freeze, row), environment, stdout=case_dir / "planner.log")
            # H_modal is an internal controller signal.  It is recorded but
            # intentionally not a pre-motion admission requirement: on a
            # stationary fresh case this controller publishes it only after
            # entering its control loop.  Requiring it here would turn a
            # valid zero-motion setup into an acquisition false negative.
            for topic in ("/sim_spmpc/status", "/sim_spmpc/debug/effective_config"): sim_only.wait_topic(topic, environment, 60.0)
            _read_online_effective(environment, read_json(Path(str(freeze["effective_configs"][row["condition_id"]]["path"])), "frozen effective config"), case_dir)
            deferred_publishers = _wait_required_publisher_registrations(
                ros_uri, DEFERRED_ONLINE_MESSAGE_TOPICS, 10.0)
            lifecycle.append({
                "event": "deferred_diagnostic_publishers_admitted",
                "utc": utc_now(),
                "topics": {key: list(value) for key, value in
                           deferred_publishers.items()},
            })
            lifecycle.append({"event": "planner_admitted", "utc": utc_now(), "condition_id": row["condition_id"]})
        else:
            require(profile is not None, "FixedProfile profile is missing")
            children.start("profile_tracker", _profile_command(admission, row, profile), environment, stdout=case_dir / "profile_tracker.log")
            sim_only.wait_node("/sim_mechanism_fixed_profile_tracker", environment, 60.0)
            sim_only.wait_topic(FIXED_READY_TOPIC, environment, 15.0)
            fixed_ready = _read_string_json_topic(FIXED_READY_TOPIC, environment, "FixedProfile zero-hold ready")
            _validate_fixed_handshake(fixed_ready, record_type="SMPCC_SIM_MECHANISM_FIXEDPROFILE_ZERO_HOLD_READY", admission=admission, row=row, profile=profile)
            fixed_handshake["zero_hold_ready"] = dict(fixed_ready)
            lifecycle.append({"event": "profile_tracker_waiting_dynamic_admission", "utc": utc_now(), "condition_id": row["condition_id"]})
        # Internal helpers recursively re-admit the complete immutable release.
        # Start the event monitor before the frozen 30 s settle so admission
        # latency cannot consume the short post-recorder pose window.  This is
        # still recorder-before-motion: the monitor only observes odometry and
        # the path/profile release remains below the recorder gate.
        children.start("event_monitor", _child("__internal-event-monitor", "--case-dir", str(case_dir), "--case-manifest-hash", case_hash, "--start-x", str(first["x"]), "--start-y", str(first["y"]), "--start-yaw", str(core["pose_contract"]["expected_spawn_yaw_rad"]), "--goal-x", str(path_doc["points"][-1]["x"]), "--goal-y", str(path_doc["points"][-1]["y"]), "--status-topic", "/sim_spmpc/status"), environment, stdout=case_dir / "event_monitor.log")
        lifecycle.append({"event": "event_monitor_started_pre_settle", "utc": utc_now()})
        time.sleep(30.0); lifecycle.append({"event": "settle", "utc": utc_now(), "sec": 30.0})
        before = sim_only.read_subscriber_graph(ros_uri)
        sim_only.RECORDER_TOPICS = recorder_topics
        recorder = children.start("recorder", sim_only.sourced_command(("rosbag", "record", "--buffsize=16", "--chunksize=64", "-O", str(bag_dir / "capture.active"), *recorder_topics)), environment, stdout=case_dir / "recorder.log")
        _a, _b, source, nodes = sim_only.wait_for_recorder_artifact(active, ros_uri, before, recorder, 15.0)
        recorder_cmd_nodes = (_wait_new_topic_subscribers("/cmd_vel", ros_uri=ros_uri, before=before, timeout_sec=10.0) if row["condition_id"] == "FixedProfile" else nodes)
        lifecycle.append({"event": "recorder_admitted", "utc": utc_now(), "source": source, "nodes": nodes, "cmd_vel_recorder_nodes": recorder_cmd_nodes})
        initial_deadline = (time.monotonic() +
                            INITIAL_POSE_ACQUISITION_TIMEOUT_SEC)
        while time.monotonic() < initial_deadline:
            if _event_path(case_dir).is_file():
                events = _read_event(case_dir, case_hash)
                if isinstance(events.get("initial_pose_gate"), Mapping):
                    break
            time.sleep(0.05)
        initial_pose = events.get("initial_pose_gate")
        require(isinstance(initial_pose, Mapping), "authoritative initial odometry was not acquired before path release")
        require(initial_pose.get("pass") is True, "authoritative initial odometry does not match the frozen path start")
        lifecycle.append({"event": "initial_pose_gate", **dict(initial_pose)})
        children.start("path_replay", _child("__internal-path-replay", "--path", str(path), "--case-dir", str(case_dir), "--case-manifest-hash", case_hash), environment, stdout=case_dir / "path_replay.log")
        motion_command_released = True
        lifecycle.append({"event": "recorder_before_motion", "utc": utc_now()})
        if row["condition_id"] == "FixedProfile":
            sim_only.wait_topic("/sim_mechanism/fixed_profile/identity", environment, 15.0)
            sim_only.wait_topic(FIXED_ADMISSION_TOPIC, environment, 15.0)
            fixed_admission = _read_string_json_topic(FIXED_ADMISSION_TOPIC, environment, "FixedProfile dynamic admission")
            _validate_fixed_handshake(fixed_admission, record_type="SMPCC_SIM_MECHANISM_FIXEDPROFILE_DYNAMIC_ADMISSION", admission=admission, row=row, profile=profile)
            fixed_handshake["dynamic_admission"] = dict(fixed_admission)
            _read_fixed_identity(admission, row, profile, environment, case_dir)
            current_cmd_subscribers = set(sim_only.read_subscriber_graph(ros_uri).get("/cmd_vel", ()))
            require(bool(recorder_cmd_nodes) and set(recorder_cmd_nodes).issubset(current_cmd_subscribers), "recorder /cmd_vel subscription disappeared before FixedProfile release")
            children.start("profile_release", _child("__internal-fixed-release", "--case-dir", str(case_dir), "--case-manifest-hash", case_hash), environment, stdout=case_dir / "profile_release.log")
            sim_only.wait_topic(FIXED_RELEASE_RECEIPT_TOPIC, environment, 15.0)
            fixed_release = _read_string_json_topic(FIXED_RELEASE_RECEIPT_TOPIC, environment, "FixedProfile release receipt")
            _validate_fixed_handshake(fixed_release, record_type="SMPCC_SIM_MECHANISM_FIXEDPROFILE_RELEASE_RECEIPT", admission=admission, row=row, profile=profile)
            fixed_handshake["release_receipt"] = dict(fixed_release)
            lifecycle.append({"event": "profile_tracker_admitted_and_released", "utc": utc_now(), "condition_id": row["condition_id"], "recorder_cmd_vel_nodes": recorder_cmd_nodes})
        deadline = time.monotonic() + MOTION_ACQUISITION_TIMEOUT_SEC
        while time.monotonic() < deadline:
            if _event_path(case_dir).is_file():
                events = _read_event(case_dir, case_hash)
                if isinstance(events.get("first_executed_motion"), Mapping): break
            time.sleep(0.05)
        require(isinstance(events.get("first_executed_motion"), Mapping), "no executed base motion within acquisition deadline")
        motion_started = True; first_motion = events["first_executed_motion"]; lifecycle.append({"event": "first_executed_motion", **first_motion})
        for stream in ("actuator_disturbance", "sensor_noise", "environment_contact_noise"):
            crn_consumptions[stream] = crn_consumer.consume(
                stream, elapsed_sim_time_sec=0.0,
                consumption_phase=crn_runtime.CONSUMPTION_PHASES[stream])
        stream_application = resolve_crn_stream_applications(
            crn_consumptions, consumer=crn_consumer,
            frozen_path_initial_yaw_rad=frozen_path_initial_yaw,
            simulator_seed=seed,
        )
        crn_application_receipt = build_crn_application_receipt(
            case_manifest_hash=case_hash, row=row,
            stream_application=stream_application,
        )
        write_json_new(case_dir / "crn_runtime_application_receipt.json",
                       crn_application_receipt)
        crn_application_valid = True
        lifecycle.append({
            "event": "crn_runtime_application_receipt", "utc": utc_now(),
            "receipt_hash": crn_application_receipt["receipt_hash"],
            "active_streams": list(crn_application_receipt["active_streams"]),
            "inactive_zero_amplitude_streams": list(
                crn_application_receipt["inactive_zero_amplitude_streams"]),
        })
        observed_initial_yaw = initial_pose.get("yaw_rad")
        require(isinstance(observed_initial_yaw, (int, float)), "CRN runtime ACK lacks observed initial yaw")
        crn_ack = crn_consumer.build_runtime_ack(
            frozen_path_initial_yaw_rad=frozen_path_initial_yaw,
            observed_initial_yaw_rad=float(observed_initial_yaw),
            initial_yaw_offset_rad_applied=True,
            applied=True,
            formal=True,
        )
        crn_runtime.validate_runtime_ack(
            crn_ack, crn_consumer,
            expected_frozen_path_initial_yaw_rad=frozen_path_initial_yaw,
            expected_observed_initial_yaw_rad=float(observed_initial_yaw),
            expected_formal=True,
        )
        write_json_new(case_dir / "crn_runtime_ack.json", crn_ack)
        crn_ack_valid = True
        lifecycle.append({"event": "crn_runtime_ack", "utc": utc_now(), "ack_hash": crn_ack["ack_hash"], "trace_asset_hash": crn_ack["trace_asset_hash"]})
        deadline = float(first_motion["monotonic_sec"]) + 60.0
        while time.monotonic() < deadline:
            if _event_path(case_dir).is_file():
                events = _read_event(case_dir, case_hash)
                goal_item = events.get("goal_reached")
                if isinstance(goal_item, Mapping):
                    candidate_duration = (
                        float(goal_item["monotonic_sec"])
                        - float(first_motion["monotonic_sec"])
                    )
                    try:
                        completion_qc = runtime_qc.validate_completion_time(
                            candidate_duration, max_completion_sec=60.0)
                        goal_reached = True
                    except runtime_qc.RuntimeQCError:
                        goal_reached = False
                    break
            time.sleep(0.05)
        lifecycle.append({"event": "goal_reached" if goal_reached else "goal_timeout", "utc": utc_now(), "timeout_sec": 60.0, "success_requires": "controller_status_AND_frozen_endpoint_geometry"})
        terminal_elapsed_sec = max(
            0.0, time.monotonic() - float(first_motion["monotonic_sec"]))
        if goal_reached:
            primary_method_outcome = "METHOD_SUCCESS"
            terminal_kind = "GOAL_REACHED"
            terminal_ros_time = float(events["goal_reached"]["ros_time_sec"])
            terminal_elapsed_sec = float(completion_qc["completion_time_sec"])
        else:
            primary_method_outcome = "METHOD_FAILURE"
            terminal_kind = "GOAL_TIMEOUT"
            terminal_elapsed_sec = max(60.0, terminal_elapsed_sec)
            timeout_qc = runtime_qc.validate_timeout_terminal(
                terminal_elapsed_sec, min_timeout_sec=60.0)
            latest = events.get("latest_odometry")
            require(isinstance(latest, Mapping) and
                    isinstance(latest.get("ros_time_sec"), (int, float)) and
                    math.isfinite(float(latest["ros_time_sec"])),
                    "timeout lacks an authoritative finite terminal ROS time")
            terminal_ros_time = float(latest["ros_time_sec"])
        record_frozen_tail_and_close()
    except Exception as exc:  # noqa: BLE001
        error = str(exc)
        if isinstance(exc, runtime_qc.RuntimeQCError):
            exception_qc = True
            classified_error = ("PROTOCOL_FAILURE_AFTER_MOTION"
                                if motion_started else "PROTOCOL_FAILURE")
        else:
            classified_error = _classify(error, motion_started)
            exception_infrastructure = (
                classified_error == "INFRASTRUCTURE_ACQUISITION")
            exception_protocol = not exception_infrastructure
        lifecycle.append({"event": "failure", "utc": utc_now(),
                          "error": error,
                          "failure_class": classified_error})
    finally:
        if motion_started and not tail_complete and recorder is not None and recorder.poll() is None:
            try:
                record_frozen_tail_and_close()
                lifecycle.append({"event": "failure_tail_qc", "utc": utc_now(),
                                  "complete": tail_complete})
            except Exception as exc:  # noqa: BLE001
                error = error or str(exc)
                exception_qc = True
        if recorder is not None and recorder.poll() is None:
            try:
                recorder_close = children.stop("recorder", signal.SIGINT, 12.0)
                lifecycle.append({"event": "recorder_closed", "utc": utc_now(), "after_failure": error is not None, **recorder_close})
            except Exception as exc:  # pragma: no cover - process transport race
                error = error or str(exc); exception_qc = True
        cleanup = children.stop_all()
        cleanup_ok = _cleanup_pass(cleanup)
        lifecycle.append({"event": "owned_pid_cleanup", "utc": utc_now(),
                          "pass": cleanup_ok, "children": cleanup})
        if not cleanup_ok:
            error = error or "owned child cleanup QC failed"
            exception_qc = True
        if _event_path(case_dir).is_file():
            try:
                events = _read_event(case_dir, case_hash)
                final_event_read_ok = True
            except Exception as exc:  # noqa: BLE001
                error = error or f"cannot read final event state: {exc}"
                exception_protocol = True
        observed_motion = isinstance(events.get("first_executed_motion"), Mapping)
        if observed_motion:
            motion_started = True
        elif motion_command_released:
            monitor_stop = next(
                (item for item in cleanup
                 if item.get("label") == "event_monitor"), None)
            monitor_healthy_through_cleanup = bool(
                final_event_read_ok and isinstance(monitor_stop, Mapping)
                and monitor_stop.get("already_exited") is False
                and monitor_stop.get("escalated_to") in (None, "")
                and monitor_stop.get("cleanup_error") in (None, "")
                and monitor_stop.get("returncode") in (0, -int(signal.SIGTERM))
            )
            if not monitor_healthy_through_cleanup:
                # An unhealthy/missing final observer cannot prove that a
                # released command source never produced motion.
                motion_evidence_uncertain = True
                exception_protocol = True
                error = error or "final event snapshot cannot prove that released motion never executed"
        try:
            post = sim_only.wait_endpoints_down(ros_uri, gazebo_uri, 30.0)
            if post != {"ros": False, "gazebo": False}:
                exception_qc = True
                error = error or "fresh postflight requires both masters unreachable"
        except Exception as exc:  # noqa: BLE001
            error = error or str(exc)
            exception_qc = True
        for artifact in (final, active, recorder_native_active,
                         _event_path(case_dir)):
            if artifact.is_file():
                artifact.chmod(stat.S_IMODE(artifact.stat().st_mode) & ~WRITE_BITS)

    # A released command source with uncertain event evidence is terminal
    # protocol review, never an acquisition retry.  We do not invent a motion
    # observation; the explicit uncertainty flag and STOP action preserve the
    # ambiguity without falsely asserting either outcome.

    required_time_qc = (completion_qc if primary_method_outcome == "METHOD_SUCCESS"
                        else timeout_qc)
    qc_failure = bool(
        exception_qc or (motion_started and (
            not tail_complete or stop_bundle_qc is None or bag_qc is None
            or required_time_qc is None or not cleanup_ok
            or post != {"ros": False, "gazebo": False}
            or not crn_ack_valid or not crn_application_valid
        ))
    )
    classification = runtime_qc.classify_outcome(
        motion_started=motion_started,
        primary_method_outcome=primary_method_outcome,
        infrastructure_failure=exception_infrastructure,
        qc_failure=qc_failure,
        protocol_failure=exception_protocol,
    )
    method_success = bool(classification["method_success"])
    method_failure = bool(classification["method_failure"])
    failure_class = str(classification["failure_class"])
    duration = (float(completion_qc["completion_time_sec"])
                if completion_qc is not None else None)

    stop_results_path = case_dir / "process_stop_results.json"
    if motion_stop is not None or path_stop is not None or recorder_stop is not None:
        write_json_new(stop_results_path, {
            "schema_version": SCHEMA_VERSION,
            "record_type": "SMPCC_SIM_MECHANISM_OWNED_PROCESS_STOP_RESULTS",
            "formal": True, "formal_scope": FORMAL_SCOPE,
            "physical_primary_eligible": False, "attempt_id": attempt_id,
            "motion_component": motion_component,
            "results": {motion_component: motion_stop,
                        "path_replay": path_stop, "recorder": recorder_stop},
        })
    receipt_documents = (
        ("process_stop_qc.json", stop_bundle_qc),
        ("closed_bag_qc.json", bag_qc),
        ("completion_time_qc.json", completion_qc),
        ("timeout_terminal_qc.json", timeout_qc),
    )
    for name, receipt in receipt_documents:
        if receipt is not None:
            write_json_new(case_dir / name, receipt)
    outcome_classification_path = case_dir / "outcome_classification.json"
    write_json_new(outcome_classification_path, classification)

    if (primary_method_outcome in {"METHOD_SUCCESS", "METHOD_FAILURE"}
            and stop_bundle_qc is not None and bag_qc is not None
            and required_time_qc is not None
            and classification.get("protocol_qc_pass") is True):
        runtime_qc_report = runtime_qc.build_runtime_qc_report(
            protocol_id=PROTOCOL_ID, release_id=RELEASE_ID,
            attempt_id=attempt_id, case_manifest_hash=case_hash, formal=True,
            stop_bundle=stop_bundle_qc, bag_qc=bag_qc,
            completion_qc=completion_qc, timeout_qc=timeout_qc,
            outcome_classification=classification)
        write_json_new(case_dir / "runtime_qc_report.json", runtime_qc_report)

    endpoint_evidence = {key: events.get(key) for key in ("initial_pose_gate", "controller_goal_status_seen", "geometric_goal_gate", "goal_reached", "latest_odometry")}
    crn_ack_descriptor = ({"path": str(case_dir / "crn_runtime_ack.json"), "sha256": sha256_file(case_dir / "crn_runtime_ack.json"), "ack_hash": crn_ack.get("ack_hash")} if crn_ack_valid and (case_dir / "crn_runtime_ack.json").is_file() and isinstance(crn_ack, Mapping) else None)
    crn_application_descriptor = ({"path": str(case_dir / "crn_runtime_application_receipt.json"), "sha256": sha256_file(case_dir / "crn_runtime_application_receipt.json"), "receipt_hash": crn_application_receipt.get("receipt_hash")} if crn_application_valid and (case_dir / "crn_runtime_application_receipt.json").is_file() and isinstance(crn_application_receipt, Mapping) else None)
    effective_readback_path = case_dir / "effective_config_readback.json"
    effective_readback_descriptor = ({
        "path": str(effective_readback_path),
        "sha256": sha256_file(effective_readback_path),
    } if effective_readback_path.is_file() else None)
    fixed_identity_path = case_dir / "fixed_profile_identity_readback.json"
    fixed_identity_descriptor = ({
        "path": str(fixed_identity_path),
        "sha256": sha256_file(fixed_identity_path),
    } if fixed_identity_path.is_file() else None)
    stop_results_descriptor = ({"path": str(stop_results_path),
                                "sha256": sha256_file(stop_results_path)}
                               if stop_results_path.is_file() else None)
    stop_qc_descriptor = (_receipt_descriptor(
        case_dir / "process_stop_qc.json", stop_bundle_qc,
        "stop_bundle_qc_hash") if stop_bundle_qc is not None else None)
    bag_qc_descriptor = (_receipt_descriptor(
        case_dir / "closed_bag_qc.json", bag_qc, "bag_qc_hash")
                         if bag_qc is not None else None)
    completion_qc_descriptor = (_receipt_descriptor(
        case_dir / "completion_time_qc.json", completion_qc,
        "completion_qc_hash") if completion_qc is not None else None)
    timeout_qc_descriptor = (_receipt_descriptor(
        case_dir / "timeout_terminal_qc.json", timeout_qc,
        "timeout_qc_hash") if timeout_qc is not None else None)
    classification_descriptor = _receipt_descriptor(
        outcome_classification_path, classification, "outcome_qc_hash")
    runtime_qc_descriptor = (_receipt_descriptor(
        case_dir / "runtime_qc_report.json", runtime_qc_report,
        "runtime_qc_hash") if runtime_qc_report is not None else None)
    partial_bags = [
        {"path": str(artifact), "sha256": sha256_file(artifact),
         "finalized": False}
        for artifact in (active, recorder_native_active) if artifact.is_file()
    ]
    postflight = {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_POSTFLIGHT", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "attempt_id": attempt_id, "pre": pre, "post": post, "fresh_ros_gazebo": pre == {"ros": False, "gazebo": False} and post == {"ros": False, "gazebo": False}, "owned_pid_cleanup_only": True, "owned_pid_cleanup_pass": cleanup_ok, "owned_pid_cleanup": cleanup, "tail_complete": tail_complete, "motion_evidence_uncertain": motion_evidence_uncertain, "endpoint_evidence": endpoint_evidence, "crn_runtime_ack": crn_ack_descriptor, "crn_runtime_application_receipt": crn_application_descriptor, "effective_config_readback": effective_readback_descriptor, "fixed_profile_identity_readback": fixed_identity_descriptor, "process_stop_results": stop_results_descriptor, "process_stop_qc": stop_qc_descriptor, "closed_bag_qc": bag_qc_descriptor, "completion_time_qc": completion_qc_descriptor, "timeout_terminal_qc": timeout_qc_descriptor, "outcome_classification": classification_descriptor, "runtime_qc_report": runtime_qc_descriptor, "bag": {"path": str(final) if final.is_file() else None, "sha256": sha256_file(final) if final.is_file() else None}, "partial_bag_artifacts": partial_bags}
    write_json_new(case_dir / "postflight.json", postflight)
    continuous_eligible = bool(method_success and classification.get("protocol_qc_pass") is True and isinstance(endpoint_evidence.get("goal_reached"), Mapping) and endpoint_evidence["goal_reached"].get("controller_status_gate_pass") is True and endpoint_evidence["goal_reached"].get("geometric_gate_pass") is True)
    continuous_exclusion_reason = None if continuous_eligible else (failure_class if failure_class != "NONE" else "OUTCOME_QC_INELIGIBLE")
    outcome = {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_ATTEMPT_MANIFEST", "runner_id": RUNNER_ID, "protocol_id": PROTOCOL_ID, "release_id": RELEASE_ID, "release_hash": admission.release["release_hash"], "master_hash": master["master_hash"], "formal": True, "formal_scope": FORMAL_SCOPE, "physical_alignment": False, "physical_primary_eligible": False, "physical_primary": None, "attempt_id": attempt_id, "planned_row_id": row_id, "stage": row["stage"], "block_id": row["block_id"], "planned_block_segment_id": row["planned_block_segment_id"], "condition_id": row["condition_id"], "method_backend": row["method_backend"], "method_success": method_success, "method_failure": method_failure, "failure_class": failure_class, "campaign_action": classification["campaign_action"], "protocol_qc_pass": classification["protocol_qc_pass"], "motion_started": motion_started, "assignment_consumed": bool(classification["assignment_consumed"]), "goal_reached": goal_reached, "terminal_kind": terminal_kind, "terminal_elapsed_sec": terminal_elapsed_sec, "completion_time_sec": duration, "continuous_eligible": continuous_eligible, "continuous_exclusion_reason": continuous_exclusion_reason, "tail_complete": tail_complete, "fresh_ros_gazebo": postflight["fresh_ros_gazebo"], "endpoint_evidence": endpoint_evidence, "crn_runtime_ack": crn_ack_descriptor, "crn_runtime_application_receipt": crn_application_descriptor, "effective_config_readback": effective_readback_descriptor, "fixed_profile_identity_readback": fixed_identity_descriptor, "fixed_profile_handshake": fixed_handshake if row["condition_id"] == "FixedProfile" else None, "process_stop_results": stop_results_descriptor, "process_stop_qc": stop_qc_descriptor, "closed_bag_qc": bag_qc_descriptor, "completion_time_qc": completion_qc_descriptor, "timeout_terminal_qc": timeout_qc_descriptor, "outcome_classification": classification_descriptor, "runtime_qc_report": runtime_qc_descriptor, "case_manifest_path": str(manifest_path), "case_manifest_hash": case_hash, "postflight_path": str(case_dir / "postflight.json"), "postflight_hash": sha256_file(case_dir / "postflight.json"), "events_path": str(_event_path(case_dir)) if _event_path(case_dir).is_file() else None, "events_hash": sha256_file(_event_path(case_dir)) if _event_path(case_dir).is_file() else None, "bag_path": str(final) if final.is_file() else None, "bag_hash": sha256_file(final) if final.is_file() else None, "partial_bag_artifacts": partial_bags, "retry_authorization_path": str(retry_authorization) if retry_authorization else None, "retry_authorization_hash": sha256_file(retry_authorization) if retry_authorization else None, "runtime_error": error, "lifecycle": lifecycle, "created_utc": utc_now()}
    manifest_out = case_dir / "attempt_manifest.json"; write_json_new(manifest_out, outcome)
    record = {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_DATASET_INDEX_ENTRY", "protocol_id": PROTOCOL_ID, "release_id": RELEASE_ID, "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "release_hash": admission.release["release_hash"], "master_hash": master["master_hash"], "planned_row_id": row_id, "attempt_id": attempt_id, "stage": row["stage"], "condition_id": row["condition_id"], "method_success": method_success, "method_failure": method_failure, "continuous_eligible": continuous_eligible, "motion_started": motion_started, "assignment_consumed": bool(classification["assignment_consumed"]), "failure_class": failure_class, "campaign_action": classification["campaign_action"], "protocol_qc_pass": classification["protocol_qc_pass"], "outcome_qc_hash": classification["outcome_qc_hash"], "attempt_manifest_path": str(manifest_out), "attempt_manifest_hash": sha256_file(manifest_out), "created_utc": utc_now()}
    entry = append_ledger(ledger_path(master), record, master, admission.release)
    return {"status": "PASS" if method_success else "FAIL", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "attempt_manifest": str(manifest_out), "attempt_manifest_hash": sha256_file(manifest_out), "dataset_index_entry_hash": entry["entry_hash"], "completion_time_sec": duration}


def _require_internal_parent_lock() -> None:
    """Prove this helper was spawned by the currently locked canonical runner."""

    path = require_exact_path(CAMPAIGN_LOCK, CAMPAIGN_LOCK, "internal campaign lock")
    require(path.is_file() and not path.is_symlink(), "internal helper requires the active campaign lock")
    with path.open("r", encoding="utf-8") as stream:
        try:
            owner = json.loads(stream.readline())
        except (json.JSONDecodeError, OSError) as exc:
            raise RunnerError(f"cannot read active campaign lock owner: {exc}") from exc
        require(isinstance(owner, Mapping) and owner.get("runner_id") == RUNNER_ID and owner.get("pid") == os.getppid(), "internal helper parent is not the canonical campaign lock owner")
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        else:
            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
            raise RunnerError("internal helper refuses an unlocked campaign")


def _admit_internal_case(case_dir: Path, case_hash: str) -> tuple[CampaignAdmission, Mapping[str, Any], Mapping[str, Any]]:
    _require_internal_parent_lock()
    case_dir = reject_symlink_chain(case_dir, "internal case directory")
    require(case_dir.parent == CANONICAL_RESULT_ROOT / "attempts", "internal case directory is outside canonical R7 attempts")
    attempt_id = case_dir.name
    case_path = require_exact_path(case_dir / "case_manifest.json", case_dir / "case_manifest.json", "internal case manifest")
    require(case_path.is_file() and stat.S_IMODE(case_path.stat().st_mode) & WRITE_BITS == 0, "internal case manifest must be immutable")
    require(case_hash == sha256_file(case_path), "internal case manifest file hash mismatch")
    case = read_json(case_path, "internal case manifest")
    core = dict(case); declared = core.pop("case_manifest_hash", None)
    require(declared == canonical_hash(core), "internal case semantic hash mismatch")
    require(case.get("schema_version") == SCHEMA_VERSION and case.get("record_type") == "SMPCC_SIM_MECHANISM_CASE_MANIFEST" and case.get("runner_id") == RUNNER_ID and case.get("protocol_id") == PROTOCOL_ID and case.get("release_id") == RELEASE_ID and case.get("formal") is True and case.get("formal_scope") == FORMAL_SCOPE and case.get("physical_alignment") is False and case.get("physical_primary_eligible") is False and case.get("physical_primary") is None and case.get("attempt_id") == attempt_id, "internal case identity/scope mismatch")
    expected_ros_uri = str(case.get("ros_master_uri", ""))
    require(os.environ.get("ROS_MASTER_URI") == expected_ros_uri and sim_only.canonical_uri(expected_ros_uri, "internal ROS master URI") == expected_ros_uri, "internal helper ROS master differs from the admitted case")
    expected_gazebo_uri = str(case.get("gazebo_master_uri", ""))
    require(os.environ.get("GAZEBO_MASTER_URI") == expected_gazebo_uri and sim_only.canonical_uri(expected_gazebo_uri, "internal Gazebo master URI") == expected_gazebo_uri and expected_gazebo_uri != expected_ros_uri, "internal helper Gazebo master differs from the admitted case")

    # The parent already performed full release/freeze/master admission while
    # holding the campaign lock.  Reopening every prior bag in each short-lived
    # helper would be quadratic and can exceed the pre-motion watchdog.  The
    # helper instead authenticates the immutable, canonical documents and
    # their semantic hashes directly against the parent-created case manifest.
    release_descriptor = case.get("release")
    freeze_descriptor = case.get("freeze")
    master_descriptor = case.get("master")
    require(isinstance(release_descriptor, Mapping) and
            set(release_descriptor) == {"path", "sha256", "release_hash"},
            "internal case release descriptor is malformed")
    require(isinstance(freeze_descriptor, Mapping) and
            set(freeze_descriptor) == {"path", "sha256"},
            "internal case freeze descriptor is malformed")
    require(isinstance(master_descriptor, Mapping) and
            set(master_descriptor) == {"path", "sha256", "master_hash"},
            "internal case master descriptor is malformed")
    release_path = require_exact_path(
        Path(str(release_descriptor["path"])), DEFAULT_RELEASE,
        "internal release")
    freeze_path = require_exact_path(
        Path(str(freeze_descriptor["path"])), DEFAULT_FREEZE,
        "internal freeze")
    master_path = require_exact_path(
        Path(str(master_descriptor["path"])), DEFAULT_MASTER,
        "internal master")
    for path, descriptor, label in (
            (release_path, release_descriptor, "internal release"),
            (freeze_path, freeze_descriptor, "internal freeze"),
            (master_path, master_descriptor, "internal master")):
        require(path.is_file() and
                stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0 and
                descriptor.get("sha256") == sha256_file(path),
                f"{label} file/hash/immutability mismatch")
    release = read_json(release_path, "internal release")
    freeze = read_json(freeze_path, "internal freeze")
    master = read_json(master_path, "internal master")
    release_core = dict(release)
    release_hash = release_core.pop("release_hash", None)
    freeze_core = dict(freeze)
    freeze_hash = freeze_core.pop("freeze_hash", None)
    master_core = dict(master)
    master_hash = master_core.pop("master_hash", None)
    require(release_hash == canonical_hash(release_core) ==
            release_descriptor.get("release_hash"),
            "internal release semantic hash mismatch")
    require(freeze_hash == canonical_hash(freeze_core),
            "internal freeze semantic hash mismatch")
    require(master_hash == canonical_hash(master_core) ==
            master_descriptor.get("master_hash"),
            "internal master semantic hash mismatch")
    require(release.get("protocol_id") == PROTOCOL_ID and
            release.get("release_id") == RELEASE_ID and
            release.get("formal_scope") == FORMAL_SCOPE and
            release.get("physical_primary_eligible") is False and
            freeze.get("protocol_id") == PROTOCOL_ID and
            freeze.get("release_id") == RELEASE_ID and
            master.get("protocol_id") == PROTOCOL_ID and
            master.get("release_id") == RELEASE_ID,
            "internal release/freeze/master identity mismatch")
    require(release.get("freeze") == dict(freeze_descriptor) and
            release.get("freeze_hash") == freeze_hash and
            release.get("master") == {
                "path": str(master_path), "sha256": sha256_file(master_path)
            } and release.get("master_hash") == master_hash and
            master.get("freeze") == dict(freeze_descriptor),
            "internal release/freeze/master cross-binding mismatch")
    runner_descriptor = {
        "path": str(Path(__file__).resolve()),
        "sha256": sha256_file(Path(__file__).resolve()),
    }
    require(release.get("canonical_runner") == runner_descriptor and
            freeze.get("runtime_bindings", {}).get("mechanism_runner") ==
            runner_descriptor,
            "internal canonical runner binding mismatch")
    admission = CampaignAdmission(
        release_path, release, freeze_path, freeze, master_path, master)
    planned = case.get("planned_row")
    require(isinstance(planned, Mapping), "internal case planned row is missing")
    rows = {str(row["planned_row_id"]): row for row in admission.master["planned_rows"]}
    row = rows.get(str(planned.get("planned_row_id", "")))
    require(isinstance(row, Mapping) and dict(planned) == dict(row), "internal case planned row differs from frozen master")
    _attempt_number(attempt_id, str(row["planned_row_id"]))
    return admission, case, row


def command_path_replay(args: argparse.Namespace) -> int:
    path, case_dir, case_hash = lexical_absolute(Path(args.path)), lexical_absolute(Path(args.case_dir)), str(args.case_manifest_hash)
    admission, case, row = _admit_internal_case(case_dir, case_hash)
    expected_path = admission.freeze["paths"][row["path_id"]]["sim_path"]
    require(case.get("path") == expected_path and expected_path == {"path": str(path), "sha256": sha256_file(path)}, "internal path replay is not the case/freeze path")
    doc = read_json(path, "frozen path"); points = doc.get("points"); require(isinstance(points, list) and len(points) >= 2, "frozen path is malformed")
    import rospy  # type: ignore
    from geometry_msgs.msg import PoseStamped  # type: ignore
    from nav_msgs.msg import Path as RosPath  # type: ignore
    rospy.init_node("sim_mechanism_matrix_path_replay")
    require(rospy.get_param("/use_sim_time", False) is True, "internal path replay requires /use_sim_time=true")
    path_pub = rospy.Publisher("/scout/global_path_fixed", RosPath, queue_size=1, latch=True); goal_pub = rospy.Publisher("/scout/goal", PoseStamped, queue_size=1, latch=True)
    message = RosPath(); message.header.frame_id = "map"
    for item in points:
        pose = PoseStamped(); pose.header.frame_id = "map"; pose.pose.position.x = float(item["x"]); pose.pose.position.y = float(item["y"]); yaw = float(item.get("yaw", 0.0)); pose.pose.orientation.z = math.sin(yaw / 2.0); pose.pose.orientation.w = math.cos(yaw / 2.0); message.poses.append(pose)
    goal = PoseStamped(); goal.header.frame_id = "map"; goal.pose = message.poses[-1].pose
    write_json_new(case_dir / "path_replay_receipt.json", {"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_JSON_PATH_REPLAY", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "case_manifest_hash": case_hash, "path": str(path), "path_hash": sha256_file(path)})
    rate = rospy.Rate(10)
    try:
        while not rospy.is_shutdown():
            now = rospy.Time.now(); message.header.stamp = now; goal.header.stamp = now
            for pose in message.poses: pose.header.stamp = now
            path_pub.publish(message); goal_pub.publish(goal); rate.sleep()
    except rospy.ROSInterruptException:
        pass
    return 0


def command_fixed_release(args: argparse.Namespace) -> int:
    case_dir = lexical_absolute(Path(args.case_dir))
    case_hash = str(args.case_manifest_hash)
    admission, case, row = _admit_internal_case(case_dir, case_hash)
    require(row.get("condition_id") == "FixedProfile", "FixedProfile release helper rejects a non-FixedProfile row")
    profile_descriptor = admission.freeze["fixed_profiles"][f"{row['path_id']}_{row['container_id']}"]["profile"]
    profile = _readonly_path(profile_descriptor, "FixedProfile release profile")
    request = _fixed_release_request(admission, row, profile)
    import rospy  # type: ignore
    from std_msgs.msg import String  # type: ignore
    rospy.init_node("sim_mechanism_fixed_profile_release")
    require(rospy.get_param("/use_sim_time", False) is True, "FixedProfile release helper requires /use_sim_time=true")
    publisher = rospy.Publisher(FIXED_RELEASE_TOPIC, String, queue_size=1, latch=True)
    deadline = time.monotonic() + 5.0
    while publisher.get_num_connections() < 1 and time.monotonic() < deadline and not rospy.is_shutdown():
        rospy.sleep(0.05)
    require(publisher.get_num_connections() >= 1, "FixedProfile release topic has no tracker subscriber")
    raw_request = json.dumps(request, sort_keys=True, separators=(",", ":"))
    publisher.publish(String(data=raw_request))
    write_json_new(case_dir / "fixed_profile_release_command.json", {
        "schema_version": SCHEMA_VERSION,
        "record_type": "SMPCC_SIM_MECHANISM_FIXEDPROFILE_RELEASE_COMMAND",
        "formal": True,
        "formal_scope": FORMAL_SCOPE,
        "physical_primary_eligible": False,
        "case_manifest_hash": case_hash,
        "topic": FIXED_RELEASE_TOPIC,
        "request": request,
        "request_sha256": hashlib.sha256(raw_request.encode("utf-8")).hexdigest(),
        "tracker_subscriber_connections": int(publisher.get_num_connections()),
    })
    rospy.sleep(1.0)
    return 0


def command_event_monitor(args: argparse.Namespace) -> int:
    case_dir, case_hash = lexical_absolute(Path(args.case_dir)), str(args.case_manifest_hash)
    admission, case, row = _admit_internal_case(case_dir, case_hash)
    path_descriptor = admission.freeze["paths"][row["path_id"]]["sim_path"]
    path_document = read_json(Path(str(path_descriptor["path"])), "event-monitor frozen path")
    expected_start = path_document["points"][0]
    expected_goal = path_document["points"][-1]
    start_x, start_y = float(args.start_x), float(args.start_y)
    start_yaw = float(args.start_yaw)
    goal_x, goal_y = float(args.goal_x), float(args.goal_y)
    require(math.isclose(start_x, float(expected_start["x"]), abs_tol=1e-12) and math.isclose(start_y, float(expected_start["y"]), abs_tol=1e-12), "event monitor start differs from frozen path")
    require(isinstance(case.get("pose_contract"), Mapping) and math.isclose(start_yaw, float(case["pose_contract"]["expected_spawn_yaw_rad"]), abs_tol=1e-12), "event monitor start yaw differs from admitted pose/CRN contract")
    require(math.isclose(goal_x, float(expected_goal["x"]), abs_tol=1e-12) and math.isclose(goal_y, float(expected_goal["y"]), abs_tol=1e-12), "event monitor goal differs from frozen path")
    require(str(args.status_topic) == "/sim_spmpc/status", "event monitor status topic is not canonical")
    import rospy  # type: ignore
    from nav_msgs.msg import Odometry  # type: ignore
    from std_msgs.msg import String  # type: ignore
    status_topic = str(args.status_topic)
    rospy.init_node("sim_mechanism_matrix_event_monitor")
    require(rospy.get_param("/use_sim_time", False) is True, "internal event monitor requires /use_sim_time=true")
    gate = endpoint_gate.FrozenEndpointGate(
        start_x=start_x, start_y=start_y, start_yaw_rad=start_yaw,
        goal_x=goal_x, goal_y=goal_y,
        base_state={"schema_version": SCHEMA_VERSION, "record_type": "SMPCC_SIM_MECHANISM_MOTION_GOAL_EVENTS", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "case_manifest_hash": case_hash, "success_contract": "controller_GOAL_REACHED_AND_frozen_endpoint_geometry"},
    )
    state = gate.state
    output = _event_path(case_dir)
    state_lock = threading.RLock()
    def save() -> None:
        with state_lock:
            temporary = output.with_name(output.name + ".tmp." + str(os.getpid())); temporary.write_text(json.dumps(state, sort_keys=True, allow_nan=False) + "\n", encoding="utf-8"); os.replace(temporary, output)
    def odom(message: Any) -> None:
        x, y, v, w = float(message.pose.pose.position.x), float(message.pose.pose.position.y), float(message.twist.twist.linear.x), float(message.twist.twist.angular.z)
        orientation = message.pose.pose.orientation
        yaw = math.atan2(
            2.0 * (float(orientation.w) * float(orientation.z) + float(orientation.x) * float(orientation.y)),
            1.0 - 2.0 * (float(orientation.y) ** 2 + float(orientation.z) ** 2),
        )
        ros_stamp = float(message.header.stamp.to_sec()) if message.header.stamp else float(rospy.Time.now().to_sec())
        with state_lock:
            gate.observe_odom(x=x, y=y, linear_x_mps=v, angular_z_radps=w,
                              monotonic_sec=time.monotonic(), utc=utc_now(),
                              ros_time_sec=ros_stamp, yaw_rad=yaw)
            save()
    def status(message: Any) -> None:
        with state_lock:
            gate.observe_status(str(message.data), monotonic_sec=time.monotonic(),
                                utc=utc_now(),
                                ros_time_sec=float(rospy.Time.now().to_sec()))
            save()
    rospy.Subscriber("/odom", Odometry, odom, queue_size=10)
    if status_topic: rospy.Subscriber(status_topic, String, status, queue_size=10)
    save(); rospy.spin(); return 0


def summarize(admission: CampaignAdmission) -> Dict[str, Any]:
    master = admission.master
    records = load_ledger(ledger_path(master), master, admission.release)
    rows = master["planned_rows"]; latest = {str(item["planned_row_id"]): item for item in records}
    by_stage: Dict[str, Dict[str, Any]] = {}
    pair_by_contrast: Dict[str, Dict[str, Any]] = {}
    registry = master.get("contrast_denominator_registry")
    require(isinstance(registry, Mapping) and registry.get("cross_contrast_aggregation_forbidden") is True and registry.get("cross_stage_aggregation_forbidden") is True and isinstance(registry.get("contrasts"), list), "master lacks the per-contrast N_pair registry")
    for contrast in registry["contrasts"]:
        require(isinstance(contrast, Mapping), "contrast denominator entry is malformed")
        stage = str(contrast["stage"])
        left = str(contrast["left_condition_id"])
        right = str(contrast["right_condition_id"])
        pair_count = 0
        eligible_blocks: list[str] = []
        for block in (f"b{index:02d}" for index in range(1, 9)):
            selected = [row for row in rows if row.get("stage") == stage and row.get("block_id") == block and row.get("condition_id") in {left, right}]
            if len(selected) != 2:
                continue
            left_row = next(row for row in selected if row["condition_id"] == left)
            right_row = next(row for row in selected if row["condition_id"] == right)
            left_record = latest.get(str(left_row["planned_row_id"]))
            right_record = latest.get(str(right_row["planned_row_id"]))
            same_segment = left_row.get("planned_block_segment_id") == right_row.get("planned_block_segment_id")
            if (same_segment and isinstance(left_record, Mapping) and isinstance(right_record, Mapping) and
                    left_record.get("continuous_eligible") is True and right_record.get("continuous_eligible") is True and
                    left_record.get("method_success") is True and right_record.get("method_success") is True):
                pair_count += 1
                eligible_blocks.append(block)
        contrast_id = str(contrast["contrast_id"])
        pair_by_contrast[contrast_id] = {
            "stage": stage,
            "left_condition_id": left,
            "right_condition_id": right,
            "N_block_plan": int(contrast["N_block_plan"]),
            "N_pair": pair_count,
            "eligible_blocks": eligible_blocks,
            "scope": contrast["N_pair_scope"],
        }
    for stage in ("SIM-S1_CORE", "SIM-S2A_SELECTIVITY", "SIM-S2B_TRANSFER"):
        selected = [row for row in rows if row["stage"] == stage]; picked = [latest[str(row["planned_row_id"])] for row in selected if str(row["planned_row_id"]) in latest]
        by_stage[stage] = {"N_plan": len(selected), "N_attempt": sum(1 for item in records if item.get("stage") == stage), "N_method_success": sum(item.get("method_success") is True for item in picked), "N_method_failure": sum(item.get("method_failure") is True for item in picked), "N_continuous_eligible": sum(item.get("continuous_eligible") is True for item in picked), "N_pair_by_contrast": {key: value["N_pair"] for key, value in pair_by_contrast.items() if value["stage"] == stage}}
    return {"status": "PASS", "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False, "release_id": RELEASE_ID, "release_hash": admission.release["release_hash"], "master_hash": master["master_hash"], "N_plan": len(rows), "N_attempt": len(records), "N_method_success": sum(item.get("method_success") is True for item in latest.values()), "N_method_failure": sum(item.get("method_failure") is True for item in latest.values()), "N_continuous_eligible": sum(item.get("continuous_eligible") is True for item in latest.values()), "N_pair_by_contrast": pair_by_contrast, "N_pair_cross_contrast_aggregate": None, "by_stage": by_stage}


def require_pristine_first_start(admission: CampaignAdmission) -> None:
    index = ledger_path(admission.master)
    if index.exists():
        return
    for root, label in ((CANONICAL_RESULT_ROOT, "R7 result root"), (CANONICAL_BAG_ROOT, "R7 bag root")):
        root = reject_symlink_chain(root, label)
        if root.exists():
            require(root.is_dir() and not any(root.iterdir()), f"{label} must be absent or empty before the first R7 attempt")


@contextlib.contextmanager
def campaign_lock() -> Iterator[Path]:
    """Serialize admission, row selection, execution and ledger append."""

    lock_path = reject_symlink_chain(CAMPAIGN_LOCK, "R7 campaign lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(lock_path, flags, 0o664)
    stream = os.fdopen(descriptor, "a+", encoding="utf-8")
    try:
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EAGAIN):
                raise RunnerError("R7 campaign lock is held; another canonical runner is active") from exc
            raise
        stream.seek(0); stream.truncate()
        stream.write(json.dumps({"runner_id": RUNNER_ID, "pid": os.getpid(), "utc": utc_now()}) + "\n")
        stream.flush(); os.fsync(stream.fileno())
        yield lock_path
    finally:
        try: fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
        finally: stream.close()


def _next_dispatch(admission: CampaignAdmission) -> tuple[Optional[Mapping[str, Any]], Optional[str], Optional[Path], Optional[str]]:
    master = admission.master
    records = load_ledger(ledger_path(master), master, admission.release)
    if records and str(records[-1].get("campaign_action", "")).startswith("STOP_CAMPAIGN_REVIEW"):
        stopped_row_id = str(records[-1]["planned_row_id"])
        stopped_row = next(
            row for row in schedule(master)
            if str(row["planned_row_id"]) == stopped_row_id)
        return stopped_row, None, None, "PROTOCOL_OR_QC_FAILURE_REQUIRES_CAMPAIGN_REVIEW"
    for row in schedule(master):
        row_id = str(row["planned_row_id"])
        history = _row_history(records, row_id)
        if not history:
            return row, row_id + "_r01", None, None
        last = history[-1]
        if last.get("method_success") is True or last.get("method_failure") is True:
            continue
        if last.get("failure_class") in {"PROTOCOL_FAILURE", "PROTOCOL_FAILURE_AFTER_MOTION"}:
            return row, None, None, "PROTOCOL_FAILURE_REQUIRES_CAMPAIGN_REVIEW"
        require(last.get("failure_class") == "INFRASTRUCTURE_ACQUISITION", "campaign has an invalid unresolved attempt")
        attempt_id = f"{row_id}_r{len(history) + 1:02d}"
        authorization = CANONICAL_RESULT_ROOT / "retry_authorizations" / f"{attempt_id}.json"
        if not authorization.is_file():
            return row, None, None, "UNRESOLVED_ACQUISITION_REQUIRES_IMMUTABLE_RETRY_AUTHORIZATION"
        return row, attempt_id, authorization, None
    return None, None, None, None


def run_campaign(release_path: Path, through_stage: Optional[str], max_cases: Optional[int], ros_port_base: int, gazebo_port_base: int, execute: bool) -> Dict[str, Any]:
    """Execute a bounded canonical serial prefix selected only from R7 release."""

    require(execute, "canonical campaign execution requires explicit --execute")
    # R7 hashes bound the historical shared real-controller target.  Its
    # runner is retained only to inspect immutable history; allowing it to
    # create a new attempt after the source fork would silently mix release
    # identities.  A future source-separated R8 campaign must enter through
    # the formal adapter with a new R8 freeze/master/GO receipt instead.
    raise RunnerError(
        "R7 shared-source campaign is quarantined: no new matrix attempt may run; "
        "create and admit a source-separated R8 release"
    )
    require((through_stage is None) != (max_cases is None), "choose exactly one of --through-stage or --max-cases")
    if through_stage is not None:
        require(through_stage in STAGE_ORDER, "through-stage is not a frozen R7 stage")
        case_limit = {
            "SIM-S1_CORE": 40,
            "SIM-S2A_SELECTIVITY": 64,
            "SIM-S2B_TRANSFER": 88,
        }[through_stage]
    else:
        require(isinstance(max_cases, int) and 1 <= max_cases <= 88, "max-cases must be 1..88")
        case_limit = int(max_cases)
    require(1024 <= ros_port_base <= 65535 and 1024 <= gazebo_port_base <= 65535 and ros_port_base != gazebo_port_base, "invalid distinct loopback port bases")
    require(ros_port_base + case_limit - 1 <= 65535 and gazebo_port_base + case_limit - 1 <= 65535, "campaign port range exceeds 65535")

    initial = admit(release_path)
    require_pristine_first_start(initial)
    completed: list[Dict[str, Any]] = []
    with campaign_lock() as lock_path:
        # Re-admit after acquiring the lock so a stale preflight cannot select
        # the same row as another dispatcher.
        admission = admit(release_path)
        for index in range(case_limit):
            admission = admit(release_path)
            row, attempt_id, retry_authorization, pause_reason = _next_dispatch(admission)
            if row is None:
                return {"status": "PASS", "reason": "MATRIX_COMPLETE", "campaign_lock": str(lock_path), "completed_cases": completed, **summarize(admission)}
            if through_stage is not None and STAGE_ORDER.index(str(row["stage"])) > STAGE_ORDER.index(through_stage):
                return {"status": "PASS", "reason": "THROUGH_STAGE_COMPLETE", "through_stage": through_stage, "campaign_lock": str(lock_path), "completed_cases": completed, **summarize(admission)}
            if pause_reason is not None:
                return {"status": "PAUSED", "reason": pause_reason, "next_planned_row_id": row["planned_row_id"], "campaign_lock": str(lock_path), "completed_cases": completed, "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False}
            require(attempt_id is not None, "canonical dispatcher produced no attempt ID")
            if row.get("stage") in {"SIM-S2A_SELECTIVITY", "SIM-S2B_TRANSFER"} and not _stage_authorization_path(str(row["stage"])).is_file():
                return {"status": "PAUSED", "reason": f"{row['stage']}_AUTHORIZATION_REQUIRED", "next_planned_row_id": row["planned_row_id"], "campaign_lock": str(lock_path), "completed_cases": completed, "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False}
            report = execute_one(admission, str(row["planned_row_id"]), attempt_id, f"http://127.0.0.1:{ros_port_base + index}", f"http://127.0.0.1:{gazebo_port_base + index}", retry_authorization)
            manifest = read_json(Path(str(report["attempt_manifest"])), "campaign attempt manifest")
            completed.append({"planned_row_id": row["planned_row_id"], "attempt_id": attempt_id, "status": report["status"], "method_success": manifest.get("method_success"), "method_failure": manifest.get("method_failure"), "failure_class": manifest.get("failure_class")})
            classification_descriptor = manifest.get("outcome_classification")
            require(isinstance(classification_descriptor, Mapping),
                    "attempt manifest lacks outcome classification")
            classification = read_json(
                Path(str(classification_descriptor.get("path", ""))),
                "campaign outcome classification")
            if str(classification.get("campaign_action", "")).startswith(
                    "STOP_CAMPAIGN_REVIEW"):
                return {"status": "PAUSED",
                        "reason": "PROTOCOL_OR_QC_FAILURE_REQUIRES_CAMPAIGN_REVIEW",
                        "next_planned_row_id": row["planned_row_id"],
                        "campaign_lock": str(lock_path),
                        "completed_cases": completed, "formal": True,
                        "formal_scope": FORMAL_SCOPE,
                        "physical_primary_eligible": False}
            if manifest.get("method_success") is not True and manifest.get("method_failure") is not True:
                return {"status": "PAUSED", "reason": "UNRESOLVED_NONTERMINAL_ATTEMPT", "next_planned_row_id": row["planned_row_id"], "campaign_lock": str(lock_path), "completed_cases": completed, "formal": True, "formal_scope": FORMAL_SCOPE, "physical_primary_eligible": False}
        admission = admit(release_path)
        reason = "THROUGH_STAGE_COMPLETE" if through_stage is not None else "MAX_CASES_REACHED"
        return {"status": "PASS", "reason": reason, "through_stage": through_stage, "campaign_lock": str(lock_path), "completed_cases": completed, **summarize(admission)}


def _emit(value: Mapping[str, Any]) -> None: print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__); sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run-campaign", help="the sole public R7 execution entry")
    run.add_argument("--release", type=Path, required=True)
    limit = run.add_mutually_exclusive_group(required=True)
    limit.add_argument("--through-stage", choices=STAGE_ORDER)
    limit.add_argument("--max-cases", type=int)
    run.add_argument("--ros-port-base", type=int, default=11700)
    run.add_argument("--gazebo-port-base", type=int, default=11900)
    run.add_argument("--execute", action="store_true")
    run.set_defaults(func=lambda a: run_campaign(a.release, a.through_stage, a.max_cases, a.ros_port_base, a.gazebo_port_base, a.execute))
    return parser


def _parse_internal(arguments: Sequence[str]) -> argparse.Namespace:
    require(bool(arguments), "internal helper command is missing")
    command, remainder = arguments[0], list(arguments[1:])
    parser = argparse.ArgumentParser(add_help=False)
    if command == "__internal-path-replay":
        parser.add_argument("--path", required=True); parser.add_argument("--case-dir", required=True); parser.add_argument("--case-manifest-hash", required=True)
        parsed = parser.parse_args(remainder); parsed.func = command_path_replay; return parsed
    if command == "__internal-event-monitor":
        parser.add_argument("--case-dir", required=True); parser.add_argument("--case-manifest-hash", required=True); parser.add_argument("--start-x", required=True); parser.add_argument("--start-y", required=True); parser.add_argument("--start-yaw", required=True); parser.add_argument("--goal-x", required=True); parser.add_argument("--goal-y", required=True); parser.add_argument("--status-topic", required=True)
        parsed = parser.parse_args(remainder); parsed.func = command_event_monitor; return parsed
    if command == "__internal-fixed-release":
        parser.add_argument("--case-dir", required=True); parser.add_argument("--case-manifest-hash", required=True)
        parsed = parser.parse_args(remainder); parsed.func = command_fixed_release; return parsed
    raise RunnerError("unknown internal helper command")


def main(argv: Optional[Iterable[str]] = None) -> int:
    try:
        arguments = list(sys.argv[1:] if argv is None else argv)
        args = (_parse_internal(arguments) if arguments and arguments[0].startswith("__internal-")
                else build_parser().parse_args(arguments)); result = args.func(args)
        if isinstance(result, Mapping): _emit(result); return 0 if result.get("status") == "PASS" else 2
        return int(result)
    except (RunnerError, runtime_qc.RuntimeQCError,
            sim_only.SimOnlyRunnerError, freeze_tool.MechanismFreezeError,
            matrix_tool.MatrixError, release_tool.MechanismReleaseError,
            OSError, ValueError, KeyError, TypeError) as exc:
        _emit({"status": "NO_GO", "formal": False, "physical_primary_eligible": False, "errors": [str(exc)]}); return 2


if __name__ == "__main__": raise SystemExit(main())
