        str(SCRIPT_DIR / "tests/test_smpcc_sim_mechanism_campaign_control.py"),
    ],
}


class MechanismFreezeError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise MechanismFreezeError(message)


def is_sha256(value: Any) -> bool:
    return (
        isinstance(value, str)
        and len(value) == SHA256_LENGTH
        and all(character in "0123456789abcdef" for character in value)
    )


def _has_symlink_component(path: Path) -> bool:
    """Return true when an existing component redirects path resolution."""

    absolute = path.absolute()
    current = Path(absolute.anchor)
    for part in absolute.parts[1:]:
        current = current / part
        if current.is_symlink():
            return True
        if not current.exists():
            break
    return False


def require_exact_path(path: Path, expected: Path, label: str,
                       *, must_exist: bool = True) -> Path:
    absolute = Path(os.path.abspath(str(path)))
    expected_absolute = Path(os.path.abspath(str(expected)))
    require(absolute == expected_absolute, f"{label} must be exactly {expected_absolute}")
    require(not _has_symlink_component(absolute), f"{label} may not traverse a symlink")
    if must_exist:
        require(absolute.exists(), f"{label} is missing: {absolute}")
    return absolute


def canonical_hash(value: Any) -> str:
    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def read_json(path: Path, label: str) -> Mapping[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise MechanismFreezeError(f"cannot read {label}: {path}: {exc}") from exc
    require(isinstance(value, Mapping), f"{label} must be a JSON object")
    return value


def require_file(path: Path, label: str) -> Path:
    require(path.is_absolute() and path.is_file(), f"{label} is missing: {path}")
    return path.resolve()


def descriptor(path: Path, label: str) -> Dict[str, str]:
    path = require_file(path, label)
    return {"path": str(path), "sha256": sha256_file(path)}


def invalidation_receipt_descriptor(path: Path, expected_sha256: str,
                                    label: str) -> Dict[str, str]:
    """Bind a predecessor receipt to its canonical immutable bytes."""

    require(path.is_absolute() and not path.is_symlink() and
            not _has_symlink_component(path),
            f"{label} must be a canonical non-symlink path")
    path = require_file(path, label)
    require(stat.S_IMODE(path.stat().st_mode) & WRITE_BITS == 0,
            f"{label} must be read-only")
    actual_sha256 = sha256_file(path)
    require(actual_sha256 == expected_sha256,
            f"{label} hash mismatch")
    return {"path": str(path), "sha256": expected_sha256}


def runtime_bindings() -> Dict[str, Dict[str, str]]:
    return {
        name: descriptor(path, f"runtime binding {name}")
        for name, path in sorted(RUNTIME_BINDING_PATHS.items())
    }


def validate_runtime_bindings(value: Any) -> list[str]:
    errors: list[str] = []
    if not isinstance(value, Mapping) or set(value) != set(RUNTIME_BINDING_PATHS):
        return ["complete R7 runtime binding registry is missing"]
    for name, expected_path in RUNTIME_BINDING_PATHS.items():
        item = value.get(name)
        if not isinstance(item, Mapping) or set(item) != {"path", "sha256"}:
            errors.append(f"runtime binding {name} is malformed")
            continue
        path = Path(str(item.get("path", "")))
        if not path.is_absolute() or path.resolve() != expected_path.resolve():
            errors.append(f"runtime binding {name} path mismatch")
            continue
        if not path.is_file():
            errors.append(f"runtime binding {name} is missing: {path}")
            continue
        if item.get("sha256") != sha256_file(path):
            errors.append(f"runtime binding {name} hash mismatch")
    return errors


def validate_go_gate_receipt(value: Any, expected_bindings_hash: Any,
                             *, receipt_path: Optional[Path] = None,
                             require_canonical_path: bool = False) -> list[str]:
    """Validate semantic test evidence rather than trusting a PASS label."""

    errors: list[str] = []
    if not isinstance(value, Mapping):
        return ["R7 GO gate receipt is not an object"]
    expected_identity = {
        "schema_version": GO_GATE_SCHEMA_VERSION,
        "document_type": GO_GATE_DOCUMENT_TYPE,
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "namespace": NAMESPACE,
        "status": "PASS",
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "physical_alignment": False,
        "physical_primary_eligible": False,
        "physical_primary": None,
        "gazebo_started": False,
    }
    expected_fields = set(expected_identity) | {
        "runtime_bindings_hash",
        "runtime_bindings_count",
        "generator",
        "checks",
        "runtime_rejection_case_count",
        "positive_fixture_case_count",
        "cmd_vel_publisher_observed_in_rejection_cases",
        "positive_fixture_cmd_vel_publisher_observed",
        "created_utc",
        "go_receipt_hash",
    }
    if set(value) != expected_fields:
        errors.append("R7 GO gate receipt fields are not the exact schema")
    for key, expected in expected_identity.items():
        if value.get(key) != expected:
            errors.append(f"R7 GO gate {key} must equal {expected!r}")
    created_utc = value.get("created_utc")
    if not isinstance(created_utc, str) or not created_utc.endswith("Z"):
        errors.append("R7 GO gate created_utc is invalid")
    if value.get("runtime_bindings_hash") != expected_bindings_hash:
        errors.append("R7 GO gate evidence is not bound to runtime sources")
    bindings_count = value.get("runtime_bindings_count")
    if bindings_count != len(RUNTIME_BINDING_PATHS):
        errors.append("R7 GO gate runtime binding count mismatch")
    if receipt_path is not None:
        try:
            if require_canonical_path:
                require_exact_path(receipt_path, CANONICAL_GO_GATE_RECEIPT,
                                   "R7 GO gate receipt")
            if receipt_path.is_symlink() or _has_symlink_component(receipt_path):
                errors.append("R7 GO gate receipt may not traverse a symlink")
            if stat.S_IMODE(receipt_path.stat().st_mode) & WRITE_BITS:
                errors.append("R7 GO gate receipt must be read-only")
        except (MechanismFreezeError, OSError) as exc:
            errors.append(str(exc))
    generator = value.get("generator")
    expected_generator = RUNTIME_BINDING_PATHS["mechanism_release_tool"].resolve()
    if not isinstance(generator, Mapping) or set(generator) != {"path", "sha256"}:
        errors.append("R7 GO gate generator descriptor is malformed")
    else:
        generator_path = Path(str(generator.get("path", "")))
        if (not generator_path.is_absolute() or
                generator_path.resolve() != expected_generator or
                not generator_path.is_file()):
            errors.append("R7 GO gate generator path mismatch")
        elif generator.get("sha256") != sha256_file(generator_path):
            errors.append("R7 GO gate generator hash mismatch")
    checks = value.get("checks")
    if not isinstance(checks, Mapping) or set(checks) != set(GO_CHECK_TEST_COUNTS):
        errors.append("R7 GO gate checks are incomplete or contain unknown checks")
    else:
        for name, expected_count in GO_CHECK_TEST_COUNTS.items():
            check = checks.get(name)
            if not isinstance(check, Mapping):
                errors.append(f"R7 GO gate {name} check is malformed")
                continue
            expected_check_fields = {
                "status", "command", "returncode", "test_count",
                "failure_count", "error_count", "evidence",
            }
            if name == "build":
                expected_check_fields.add("packages")
            if set(check) != expected_check_fields:
                errors.append(f"R7 GO gate {name} check fields are not exact")
            if check.get("status") != "PASS" or check.get("returncode") != 0:
                errors.append(f"R7 GO gate {name} did not PASS")
            command = check.get("command")
            if (not isinstance(command, list) or not command or
                    not all(isinstance(token, str) and token for token in command)):
                errors.append(f"R7 GO gate {name} command is missing")
            elif command != GO_CHECK_COMMANDS[name]:
                errors.append(f"R7 GO gate {name} command mismatch")
            if check.get("test_count") != expected_count:
                errors.append(f"R7 GO gate {name} test count mismatch")
            if check.get("failure_count") != 0 or check.get("error_count") != 0:
                errors.append(f"R7 GO gate {name} contains failures/errors")
            evidence = check.get("evidence")
            if not isinstance(evidence, Mapping) or set(evidence) != {"path", "sha256"}:
                errors.append(f"R7 GO gate {name} evidence descriptor is malformed")
                continue
            evidence_path = Path(str(evidence.get("path", "")))
            if (not evidence_path.is_absolute() or not evidence_path.is_file() or
                    evidence_path.is_symlink() or _has_symlink_component(evidence_path)):
                errors.append(f"R7 GO gate {name} evidence path is invalid")
                continue
            if stat.S_IMODE(evidence_path.stat().st_mode) & WRITE_BITS:
                errors.append(f"R7 GO gate {name} evidence must be read-only")
            if evidence.get("sha256") != sha256_file(evidence_path):
                errors.append(f"R7 GO gate {name} evidence hash mismatch")
            if require_canonical_path:
                evidence_root = CANONICAL_GO_GATE_RECEIPT.parent / "evidence"
                try:
                    evidence_path.resolve().relative_to(evidence_root.resolve())
                except ValueError:
                    errors.append(f"R7 GO gate {name} evidence is outside canonical root")
            try:
                transcript = evidence_path.read_text(
                    encoding="utf-8", errors="replace")
                if "returncode=0" not in transcript:
                    errors.append(f"R7 GO gate {name} transcript return code mismatch")
                expected_command_line = (
                    "command=" + json.dumps(
                        GO_CHECK_COMMANDS[name], ensure_ascii=False
                    )
                )
                if not transcript.startswith(expected_command_line + "\n"):
                    errors.append(f"R7 GO gate {name} transcript command mismatch")
                if name != "build":
                    counts = re.findall(r"Ran ([0-9]+) tests?", transcript)
                    if counts != [str(expected_count)] or "OK" not in transcript or "FAILED" in transcript or "skipped=" in transcript:
                        errors.append(f"R7 GO gate {name} transcript semantics mismatch")
                if name == "launch_runtime_rejection":
                    if ("RUNTIME_REJECTION_CASES=18\n" not in transcript or
                            "RUNTIME_POSITIVE_FIXTURE_CASES=1\n" not in transcript):
                        errors.append(
                            "R7 GO gate runtime case-count transcript mismatch"
                        )
            except OSError as exc:
                errors.append(f"cannot read R7 GO gate {name} evidence: {exc}")
            if (name == "build" and
                    check.get("packages") != list(GO_BUILD_PACKAGES)):
                errors.append("R7 GO gate build package set mismatch")
    if value.get("runtime_rejection_case_count") != 18:
        errors.append("R7 GO gate lacks the exact 18-case runtime rejection proof")
    if value.get("positive_fixture_case_count") != 1:
        errors.append("R7 GO gate lacks the one positive FixedProfile fixture proof")
    if value.get("cmd_vel_publisher_observed_in_rejection_cases") is not False:
        errors.append(
            "R7 GO gate does not prove /cmd_vel publisher absence in rejection cases"
        )
    if value.get("positive_fixture_cmd_vel_publisher_observed") is not True:
        errors.append(
            "R7 GO gate does not prove /cmd_vel publication in the positive fixture"
        )
    core = dict(value)
    declared_hash = core.pop("go_receipt_hash", None)
    if not is_sha256(declared_hash) or declared_hash != canonical_hash(core):
        errors.append("R7 GO gate receipt hash mismatch")
    return errors


def write_json_new_readonly(path: Path, value: Mapping[str, Any]) -> None:
    require(not path.exists(), f"refusing to overwrite immutable asset: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")
    try:
        with path.open("xb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(path, 0o444)
    except OSError as exc:
        raise MechanismFreezeError(f"cannot write immutable asset {path}: {exc}") from exc


def _load_toolchain():
    path = Path(__file__).with_name("smpcc_sim_toolchain.py")
    spec = importlib.util.spec_from_file_location("smpcc_sim_toolchain_mechanism", path)
    if spec is None or spec.loader is None:
        raise MechanismFreezeError(f"cannot load shared randomisation helpers: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


toolchain = _load_toolchain()


