def timing_initial_yaw_offset(seed: int) -> float:
    """Condition-blind yaw realization shared with the R7 timing pilot."""

    require(isinstance(seed, int) and not isinstance(seed, bool) and
            seed == TIMING_CALIBRATION_SEED,
            "timing yaw offset requires the frozen R7 calibration seed")
    digest = hashlib.sha256(
        f"{PROTOCOL_ID}:{seed}:timing-initial-yaw".encode("utf-8")
    ).digest()
    unit = int.from_bytes(digest[:8], "big") / float(2 ** 64 - 1)
    return round((2.0 * unit - 1.0) * 0.02, 12)


def _points_from_candidate(path_id: str) -> list[Dict[str, float]]:
    filename = "high_p2_sim.json" if path_id == "H1" else "low_p2_sim.json"
    source = read_json(DEVELOPMENT_ASSETS / "paths" / filename, f"{path_id} candidate path")
    points = source.get("points")
    require(isinstance(points, list) and len(points) >= 3, f"{path_id} candidate has no usable points")
    output: list[Dict[str, float]] = []
    for index, point in enumerate(points):
        require(isinstance(point, Mapping), f"{path_id} point {index} is invalid")
        values = {key: point.get(key) for key in ("x", "y", "yaw")}
        require(all(isinstance(value, (int, float)) and math.isfinite(float(value)) for value in values.values()), f"{path_id} point {index} is not finite")
        output.append({key: float(value) for key, value in values.items()})
    require(output[0] == {"x": -4.0, "y": 0.0, "yaw": 0.0}, f"{path_id} start differs from authorised open-field start")
    require(output[-1] == {"x": 5.0, "y": 0.0, "yaw": 0.0}, f"{path_id} goal differs from authorised open-field goal")
    return output


def _path_document(path_id: str, points: Sequence[Mapping[str, float]], source: bool) -> Dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "document_type": "SMPCC_SIM_MECHANISM_FROZEN_SOURCE_PATH" if source else "SMPCC_SIM_MECHANISM_FROZEN_SIM_PATH",
        "protocol_id": PROTOCOL_ID,
        "formal": True,
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "development_only": False,
        "physical_alignment": False,
        "physical_primary_eligible": False,
        "path_id": path_id,
        "source_mode": "frozen_json_replay",
        "runtime_generation_forbidden": True,
        # ``points`` is consumed by the reviewed frozen-path validator;
        # ``poses`` is the identical read-only representation consumed by the
        # offline Hamaguchi generator.  Neither permits runtime generation.
        "points": list(points),
        "poses": list(points),
        "zones": {
            "Z1": {"motion_intent": "accelerate_from_rest", "point_indices": [0, 29]},
            "Z2": {"motion_intent": "sustained_first_curvature", "point_indices": [29, 81]},
            "Z3": {"motion_intent": "curvature_reversal", "point_indices": [81, 115]},
            "Z4": {"motion_intent": "exit_curve_reaccelerate", "point_indices": [115, 151]},
            "Z5": {"motion_intent": "terminal_brake_to_goal", "point_indices": [151, 180]},
        },
    }


def _geometry_document(world_hash: str) -> Dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "document_type": "SMPCC_SIM_WORLD_CLEARANCE_GEOMETRY",
        "protocol_id": PROTOCOL_ID,
        "formal": True,
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "status": "FROZEN",
        "physical_alignment": False,
        "physical_primary_eligible": False,
        "launched_world_hash": world_hash,
        "world_runtime_format": "gazebo_sdf",
        "bounds": [-5.94, 5.94, -3.94, 3.94],
        "obstacles": [],
        "robot_footprint_radius_m": 0.45,
        "container_footprint_radius_m": 0.0475,
    }


def _controller_config(condition_id: str, smoothmatch_vref: float) -> Dict[str, Any]:
    require(condition_id in {"B0", "Bsmooth", "SmoothMatch", "Bslosh"}, f"online config is unsupported for {condition_id}")
    if condition_id == "B0":
        weights = {"w_control": 0.1, "w_smooth": 0.1, "w_alpha": 0.1, "w_du_a": 0.1, "w_du_vs": 0.1, "w_slosh": 0.0}
        slosh, smooth, v_ref = False, False, 0.20
    elif condition_id == "Bslosh":
        weights = {"w_control": 0.3, "w_smooth": 1.0, "w_alpha": 1.0, "w_du_a": 1.0, "w_du_vs": 1.0, "w_slosh": 5.0}
        slosh, smooth, v_ref = True, False, 0.20
    else:
        weights = {"w_control": 0.3, "w_smooth": 1.0, "w_alpha": 1.0, "w_du_a": 1.0, "w_du_vs": 1.0, "w_slosh": 0.0}
        slosh, smooth, v_ref = False, True, 0.20 if condition_id == "Bsmooth" else smoothmatch_vref
    core: Dict[str, Any] = {
        "schema_version": SCHEMA_VERSION,
        "document_type": "SMPCC_SIM_MECHANISM_EFFECTIVE_CONFIG",
        "protocol_id": PROTOCOL_ID,
        "formal": True,
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "development_only": False,
        "physical_alignment": False,
        "physical_primary_eligible": False,
        "physical_primary": None,
        "condition_id": condition_id,
        "planner_variant": CONDITION_VARIANTS[condition_id],
        "method_backend": BACKENDS[condition_id],
        "solver_backend": "continuous_mpcc_acados",
        "controller": {
            "slosh_enable": slosh, "smooth_priority_enable": smooth,
            "slosh_constraint_enable": False, "primitive_mode": "linear",
            "w_contour": 1.0, "w_lag": 0.2, "w_progress": 0.2,
            "w_v": 1.0, "w_vs": 0.3, "w_accel": 0.0,
            "v_ref": v_ref, **weights,
        },
        "observer": {"source": "odom", "imu_shadow_enable": False, "fallback_policy": "odom"},
        # ``off`` disables use of delay prediction; it does not erase the
        # underlying timing parameters loaded by the controller.  Freeze the
        # effective values actually read back from the R1 simulation gate so
        # an old ``-1`` CLI-sentinel can never masquerade as a full config.
        "delay": {
            "mode": "off", "linear_sec": 0.15, "angular_sec": 0.22,
            "cmd_timeout_sec": 0.5, "odom_timeout_sec": 0.5,
            "history_window_sec": 2.0, "require_complete_history": False,
        },
        "measurements": {
            "H_proxy": {"topic": "/slosh/height", "semantic": "model_proxy_mechanism_only", "physical_primary_eligible": False},
            "H_modal": {"topic": "/sim_spmpc/slosh_height", "semantic": "controller_internal_modal_only", "physical_primary_eligible": False},
            "physical_primary": None,
        },
    }
    return dict(core, effective_config_hash=canonical_hash(core))


def _load_container(path: Path, container_id: str) -> Dict[str, Any]:
    try:
        import yaml  # type: ignore
    except ImportError as exc:
        raise MechanismFreezeError("PyYAML is required for simulation container capture") from exc
    require_file(path, f"{container_id} controller container YAML")
    raw = yaml.safe_load(path.read_text(encoding="utf-8"))
    require(isinstance(raw, Mapping) and isinstance(raw.get("slosh"), Mapping), f"{container_id} container YAML is invalid")
    slosh = raw["slosh"]
    required = ("container_radius", "liquid_height", "liquid_density", "damping_ratio", "mode_index", "slosh_height_ref", "slosh_height_max", "slosh_eta_dot_ratio", "use_linear_model", "use_parabola_term")
    require(set(required).issubset(slosh), f"{container_id} controller container YAML lacks fields")
    core = {
        "schema_version": SCHEMA_VERSION, "document_type": "SMPCC_SIM_MECHANISM_CONTAINER_PARAMETERS",
        "protocol_id": PROTOCOL_ID, "formal": True, "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "development_only": False, "physical_alignment": False, "physical_primary_eligible": False,
        "container_id": container_id, "source_yaml": descriptor(path, f"{container_id} YAML"),
        "parameters": {key: slosh[key] for key in required},
        "description": "simulation assumption only; not a physical container manifest",
    }
    return dict(core, parameter_hash=canonical_hash(core))


def _write_profile(profile_path: Path, report_path: Path, path_json: Path,
                   container: Mapping[str, Any]) -> Dict[str, Any]:
    # Container parameters affect only this offline profile-shaping step.  The
    # dedicated runtime tracker replays the resulting immutable CSV and has no
    # online liquid feedback, keeping FixedProfile isolated from Bslosh while
    # still making the C1/C2 generation assumptions explicit and hash-bound.
    require(container.get("container_id") in {"C1", "C2"},
            "FixedProfile container identity is invalid")
    container_parameters = container.get("parameters")
    require(isinstance(container_parameters, Mapping),
            "FixedProfile container parameters are missing")
    radius = float(container_parameters["container_radius"])
    height = float(container_parameters["liquid_height"])
    damping = float(container_parameters["damping_ratio"])
    require(radius > 0.0 and height > 0.0 and damping >= 0.0 and
            all(math.isfinite(value) for value in (radius, height, damping)),
            "FixedProfile liquid-derived inputs are invalid")
    omega_n = math.sqrt(
        PROFILE_GRAVITY_M_S2 * PROFILE_MODE_ROOT_XI / radius *
        math.tanh(PROFILE_MODE_ROOT_XI * height / radius)
    )
    parameters = PROFILE_GENERATION_PARAMETERS
    command = [
        sys.executable,
        str(require_file(PROFILE_GENERATOR, "FixedProfile generator")),
        "--path-file", str(path_json),
        "--out-csv", str(profile_path),
        "--v-max", str(parameters["v_max"]),
        "--base-speed", str(parameters["base_speed"]),
        "--omega-max", str(parameters["omega_max"]),
        "--alpha-max", str(parameters["alpha_max"]),
        "--a-max", str(parameters["a_max"]),
        "--decel-max", str(parameters["decel_max"]),
        "--omega-n", str(omega_n),
        "--damping-ratio", str(damping),
        "--dt", str(parameters["dt"]),
        "--lateral-accel-max", str(parameters["lateral_accel_max"]),
        "--num-samples", str(parameters["num_samples"]),
        "--method-name", str(parameters["method_name"]),
        "--report-json", str(report_path),
    ]
    completed = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False, timeout=30)
    require(completed.returncode == 0, "FixedProfile generator failed: " + completed.stderr[-1000:])
    require(profile_path.is_file() and report_path.is_file(), "FixedProfile generator did not produce profile/report")
    report = read_json(report_path, "FixedProfile generation report")
    duration = report.get("duration_sec")
    require(report.get("status") == "PASS" and
            report.get("profile_sha256") == sha256_file(profile_path) and
            isinstance(duration, (int, float)) and math.isfinite(float(duration)) and
            0.0 < float(duration) <= PROFILE_MAX_DURATION_SEC,
            "FixedProfile constraint/duration audit did not PASS")
    os.chmod(profile_path, 0o444)
    os.chmod(report_path, 0o444)
    derived_core = {
        "container_id": container["container_id"],
        "container_parameter_hash": container["parameter_hash"],
        "container_radius_m": radius,
        "liquid_height_m": height,
        "damping_ratio": damping,
        "gravity_m_s2": PROFILE_GRAVITY_M_S2,
        "mode_root_xi": PROFILE_MODE_ROOT_XI,
        "omega_n_rad_s": omega_n,
        "derivation": "sqrt(g*xi/R*tanh(xi*h/R))",
    }
    return dict(derived_core, derived_input_hash=canonical_hash(derived_core))


def _randomization(seed: str, stage: str) -> Dict[str, Any]:
    # Reuse the reviewed complete-block algorithm, then rebind it to this
    # protocol before it enters a mechanism-only freeze.
    table = dict(toolchain.make_randomization(stage, 8, seed))
    table["protocol_id"] = PROTOCOL_ID
    core = {key: table[key] for key in ("schema_version", "table_id", "stage", "algorithm", "seed_commitment", "rows")}
    table["randomization_hash"] = canonical_hash(core)
    return table


def _crn_trace_asset(bundle: Mapping[str, Any], stage: str,
                     block_id: str) -> Dict[str, Any]:
    """Materialise one immutable, condition-blind block trace payload.

    ``make_seed_bundle`` historically embedded deterministic sample arrays in a
    large freeze document.  That proved how the values were generated, but not
    that a runtime ever received or consumed them.  R7 gives every block one
    independently hashable asset.  Every method in that block must receive this
    exact descriptor; no condition name appears in the asset.
    """

    seed_report = toolchain.validate_seed_bundle(bundle)
    traces = bundle["traces"]
    require(
        all(
            isinstance(trace, Mapping)
            and trace.get("samples")
            and trace["samples"][0].get("time_index_ms") == 0
            and trace["samples"][-1].get("time_index_ms") == CRN_TRACE_END_MS
            for trace in traces.values()
        ),
        "CRN trace streams must cover first motion through the 60 second motion window",
    )
    initial_pose_samples = traces["initial_robot_pose"]["samples"]
    initial_yaw_offset_rad = round(
        (2.0 * float(initial_pose_samples[0]["unit_uniform"]) - 1.0) *
        CRN_INITIAL_YAW_MAX_ABS_RAD,
        12,
    )
    require(abs(initial_yaw_offset_rad) <= CRN_INITIAL_YAW_MAX_ABS_RAD,
            "CRN initial yaw offset exceeds its frozen bound")
    core: Dict[str, Any] = {
        "schema_version": CRN_TRACE_SCHEMA_VERSION,
        "document_type": CRN_TRACE_DOCUMENT_TYPE,
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "formal": True,
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "physical_primary_eligible": False,
        "stage": stage,
        "block_id": block_id,
        "seed_bundle_id": bundle["seed_bundle_id"],
        "seed_bundle_hash": bundle["seed_bundle_hash"],
        "condition_id": None,
        "method_independent": True,
        "same_asset_for_every_condition_in_block": True,
        "callback_count_rng_forbidden": True,
        "runtime_consumption_required": True,
        "runtime_consumer_ack_required": True,
        "time_domain": CRN_TIME_DOMAIN,
        "time_origin_event": CRN_TIME_ORIGIN_EVENT,
        "time_index_field": "time_index_ms",
        "interpolation": CRN_INTERPOLATION,
        "trace_end_ms": CRN_TRACE_END_MS,
        "stream_consumption_phases": dict(CRN_CONSUMPTION_PHASES),
        "initial_yaw_realization": {
            "source_stream": "initial_robot_pose",
            "source_time_index_ms": 0,
            "source_field": "unit_uniform",
            "mapping": "(2*unit_uniform-1)*max_abs_rad",
            "max_abs_rad": CRN_INITIAL_YAW_MAX_ABS_RAD,
            "initial_yaw_offset_rad": initial_yaw_offset_rad,
            "runtime_target":
                "SPAWN_YAW=frozen_path_initial_yaw+initial_yaw_offset_rad",
            "consumption_phase": "PRE_MOTION_RESET",
            "runtime_ack_required": True,
        },
        "sub_seeds": dict(bundle["sub_seeds"]),
        "traces": dict(traces),
        "stream_trace_hashes": dict(seed_report["trace_hashes"]),
    }
    return dict(core, trace_asset_hash=canonical_hash(core))


def _seed_bundle(seed: str, stage: str, block: int,
                 trace_root: Path) -> Dict[str, Any]:
    bundle = dict(toolchain.make_seed_bundle(seed, stage, block))
    bundle["protocol_id"] = PROTOCOL_ID
    core = {key: bundle[key] for key in (
        "stage", "block_id", "sub_seeds", "traces",
        "independent_sub_seeds", "time_indexed_traces")}
    bundle["seed_bundle_hash"] = canonical_hash(core)
    asset = _crn_trace_asset(bundle, stage, f"b{block:02d}")
    asset_path = trace_root / f"{stage}_b{block:02d}.json"
    write_json_new_readonly(asset_path, asset)
    bundle.update({
        "trace_asset": descriptor(asset_path, f"{stage} b{block:02d} CRN trace"),
        "trace_asset_hash": asset["trace_asset_hash"],
        "runtime_consumption_required": True,
        "runtime_consumer_ack_required": True,
        "initial_yaw_offset_rad":
            asset["initial_yaw_realization"]["initial_yaw_offset_rad"],
    })
    return bundle


def validate_crn_trace_asset(bundle: Any, stage: str,
                             block_id: str) -> Dict[str, Any]:
    """Validate the immutable trace asset and its embedded seed bundle."""

    require(isinstance(bundle, Mapping), f"{stage}:{block_id} seed bundle is malformed")
    require(bundle.get("stage") == stage and bundle.get("block_id") == block_id,
            f"{stage}:{block_id} seed bundle identity mismatch")
    require(bundle.get("runtime_consumption_required") is True and
            bundle.get("runtime_consumer_ack_required") is True,
            f"{stage}:{block_id} does not require runtime trace consumption/ack")
    seed_report = toolchain.validate_seed_bundle(bundle)
    asset_path = _readonly_file_descriptor(
        bundle.get("trace_asset"), f"{stage}:{block_id} CRN trace asset")
    asset = read_json(asset_path, f"{stage}:{block_id} CRN trace asset")
    expected_fields = {
        "schema_version", "document_type", "protocol_id", "release_id",
        "formal", "formal_scope", "physical_primary_eligible", "stage",
        "block_id", "seed_bundle_id", "seed_bundle_hash", "condition_id",
        "method_independent", "same_asset_for_every_condition_in_block",
        "callback_count_rng_forbidden", "runtime_consumption_required",
        "runtime_consumer_ack_required", "time_domain", "time_origin_event",
        "time_index_field", "interpolation", "trace_end_ms",
        "stream_consumption_phases", "initial_yaw_realization",
        "sub_seeds", "traces",
        "stream_trace_hashes", "trace_asset_hash",
    }
    require(set(asset) == expected_fields,
            f"{stage}:{block_id} CRN trace asset fields are not exact")
    expected_identity = {
        "schema_version": CRN_TRACE_SCHEMA_VERSION,
        "document_type": CRN_TRACE_DOCUMENT_TYPE,
        "protocol_id": PROTOCOL_ID,
        "release_id": RELEASE_ID,
        "formal": True,
        "formal_scope": "SIMULATION_MECHANISM_ONLY",
        "physical_primary_eligible": False,
        "stage": stage,
        "block_id": block_id,
        "seed_bundle_id": bundle.get("seed_bundle_id"),
        "seed_bundle_hash": bundle.get("seed_bundle_hash"),
        "condition_id": None,
        "method_independent": True,
        "same_asset_for_every_condition_in_block": True,
        "callback_count_rng_forbidden": True,
        "runtime_consumption_required": True,
        "runtime_consumer_ack_required": True,
        "time_domain": CRN_TIME_DOMAIN,
        "time_origin_event": CRN_TIME_ORIGIN_EVENT,
        "time_index_field": "time_index_ms",
        "interpolation": CRN_INTERPOLATION,
        "trace_end_ms": CRN_TRACE_END_MS,
        "stream_consumption_phases": CRN_CONSUMPTION_PHASES,
        "initial_yaw_realization": {
            "source_stream": "initial_robot_pose",
            "source_time_index_ms": 0,
            "source_field": "unit_uniform",
            "mapping": "(2*unit_uniform-1)*max_abs_rad",
            "max_abs_rad": CRN_INITIAL_YAW_MAX_ABS_RAD,
            "initial_yaw_offset_rad": bundle.get("initial_yaw_offset_rad"),
            "runtime_target":
                "SPAWN_YAW=frozen_path_initial_yaw+initial_yaw_offset_rad",
            "consumption_phase": "PRE_MOTION_RESET",
            "runtime_ack_required": True,
        },
        "sub_seeds": bundle.get("sub_seeds"),
        "traces": bundle.get("traces"),
        "stream_trace_hashes": seed_report["trace_hashes"],
    }
    for key, expected in expected_identity.items():
        require(asset.get(key) == expected,
                f"{stage}:{block_id} CRN trace asset {key} mismatch")
    core = dict(asset)
    declared_hash = core.pop("trace_asset_hash", None)
    require(is_sha256(declared_hash) and declared_hash == canonical_hash(core),
            f"{stage}:{block_id} CRN trace asset semantic hash mismatch")
    require(bundle.get("trace_asset_hash") == declared_hash,
            f"{stage}:{block_id} seed bundle/trace asset hash mismatch")
    initial_yaw = bundle.get("initial_yaw_offset_rad")
    require(isinstance(initial_yaw, (int, float)) and
            math.isfinite(float(initial_yaw)) and
            abs(float(initial_yaw)) <= CRN_INITIAL_YAW_MAX_ABS_RAD,
            f"{stage}:{block_id} initial yaw offset is invalid")
    return {
        "status": "PASS",
        "trace_asset_path": str(asset_path),
        "trace_asset_file_hash": sha256_file(asset_path),
        "trace_asset_hash": declared_hash,
        "seed_bundle_hash": seed_report["seed_bundle_hash"],
        "stream_trace_hashes": seed_report["trace_hashes"],
    }


