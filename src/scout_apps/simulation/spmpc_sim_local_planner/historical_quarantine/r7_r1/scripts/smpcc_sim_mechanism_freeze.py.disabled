#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.
"""Freeze the independent simulation-mechanism 40 -> 64 -> 88 matrix.

This is intentionally a *different* protocol from
``SMPCC-SIM-40-64-88-v0.1``.  The latter remains an aligned-to-physical
protocol and continues to reject these inputs.  This protocol uses the
user-authorised open-field paths, 0705 controller vectors and a 95 mm C2
container solely as simulation assumptions.  Its outcomes are mechanism
evidence; no output can claim physical alignment or a physical primary.

The builder is offline.  It writes new, read-only small assets below the
dedicated simulation root and never starts ROS/Gazebo.  A final gate also
requires a separately recorded (simulation-only) SmoothMatch timing pilot so
that ``v_ref`` is not guessed, plus an immutable runtime-consumer contract
proving that the frozen common-random-number assets are actually consumed.
"""

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


