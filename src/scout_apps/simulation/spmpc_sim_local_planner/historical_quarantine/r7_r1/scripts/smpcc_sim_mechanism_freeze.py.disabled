def _bind_source_tree(prefix: str, root: Path) -> None:
    if not root.is_dir():
        return
    for path in sorted(root.rglob("*")):
        if (not path.is_file() or "__pycache__" in path.parts or
                path.suffix in {".pyc", ".bag", ".active"}):
            continue
        relative = path.relative_to(root).as_posix().replace("/", "__")
        RUNTIME_BINDING_PATHS[f"{prefix}__{relative}"] = path


for _prefix, _root in (
