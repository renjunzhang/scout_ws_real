def build_audit(
    physical_document: Path = DEFAULT_PHYSICAL_COMMAND_DOC,
    h0_adapter: Path = DEFAULT_H0_ADAPTER,
    *,
    expected_physical_document_sha256: str | None = None,
    expected_h0_adapter_sha256: str | None = None,
) -> Dict[str, Any]:
    physical_document = physical_document.resolve()
    h0_adapter = h0_adapter.resolve()
    require(physical_document.is_file(), f"physical command document is missing: {physical_document}")
    require(h0_adapter.is_file(), f"H0 adapter is missing: {h0_adapter}")
    document_hash = sha256_file(physical_document)
    adapter_hash = sha256_file(h0_adapter)
    require_expected_sha256(
        document_hash,
        expected_physical_document_sha256,
        "physical command document",
    )
    require_expected_sha256(adapter_hash, expected_h0_adapter_sha256, "H0 adapter")
    lines = read_numbered_lines(physical_document)
    inventory = inventory_physical_commands(lines)
    h0 = compare_h0_to_physical(inventory, h0_adapter)
    statuses = [item["status"] for item in h0["comparisons"]]
    return {
        "audit_schema_version": AUDIT_SCHEMA_VERSION,
        "auditor_id": AUDITOR_ID,
        "status": "DEVELOPMENT_ONLY_ALIGNMENT_AUDIT_COMPLETE",
        "formal": False,
        "development_only": True,
        "authorization": "NO_FORMAL_AUTHORIZATION_NO_FORMAL_FREEZE_CREATED",
        "side_effects": {"writes_files": False, "launches_ros": False, "launches_gazebo": False, "touches_data_root": False},
        "source_bindings": {
            "physical_command_document_path": str(physical_document),
            "physical_command_document_sha256": document_hash,
            "physical_command_document_line_count": len(lines),
            "h0_adapter_path": str(h0_adapter),
            "h0_adapter_sha256": adapter_hash,
            "external_physical_document_trust_anchor": expected_physical_document_sha256,
            "external_h0_adapter_trust_anchor": expected_h0_adapter_sha256,
        },
        "physical_inventory": inventory,
        "h0_comparison": h0,
        "comparison_counts": {
            "aligned_development_only": sum(status == "ALIGNED_DEVELOPMENT_ONLY" for status in statuses),
            "mismatch_development_only": sum(status == "MISMATCH_DEVELOPMENT_ONLY" for status in statuses),
            "sim_specific_or_unavailable": sum(status not in {"ALIGNED_DEVELOPMENT_ONLY", "MISMATCH_DEVELOPMENT_ONLY"} for status in statuses),
        },
        "formal_inputs_unavailable": formal_unavailable_items(),
        "nonnegotiable_boundary": "This report may guide development alignment only. It cannot be used as a formal freeze, formal Bslosh selection, formal C1/C2 release, randomization table, or formal result.",
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--physical-command-document", type=Path, default=DEFAULT_PHYSICAL_COMMAND_DOC)
    parser.add_argument("--h0-adapter", type=Path, default=DEFAULT_H0_ADAPTER)
    parser.add_argument(
        "--expected-physical-command-sha256",
        help="optional external trust anchor; mismatch fails closed",
    )
    parser.add_argument(
        "--expected-h0-adapter-sha256",
        help="optional external trust anchor; mismatch fails closed",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        report = build_audit(
            args.physical_command_document,
            args.h0_adapter,
            expected_physical_document_sha256=args.expected_physical_command_sha256,
            expected_h0_adapter_sha256=args.expected_h0_adapter_sha256,
        )
    except AuditError as exc:
        print(json.dumps({"status": "FAIL", "formal": False, "error": str(exc)}, ensure_ascii=False, sort_keys=True))
        return 2
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
