# Long-form paired outputs use the outcome metrics that are meaningful for a
# condition comparison.  Sample counts and QC diagnostics are not contrasts.
PAIRED_METRICS = METRIC_FIELDS

METRIC_UNITS = {
    **{name: "s" for name in (
        "trajectory_sim_time_sec", "completion_time_wall_sec")},
    **{name: "m" for name in (
        "endpoint_goal_distance_m", "tracking_mean_m", "tracking_rmse_m",
        "tracking_p95_m", "tracking_max_m", "odom_path_length_m",
