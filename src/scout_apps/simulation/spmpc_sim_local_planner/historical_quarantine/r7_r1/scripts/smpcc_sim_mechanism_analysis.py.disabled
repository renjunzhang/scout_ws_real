        "cmd_angular_total_variation_radps",
        "tail_cmd_angular_max_abs_radps")},
    **{name: "mm" for name in METRIC_FIELDS
       if name.startswith("H_proxy_") or name.startswith("H_modal_")},
}
if set(METRIC_UNITS) != set(METRIC_FIELDS):
    raise RuntimeError("metric unit registry does not match metric fields")

LOWER_IS_BETTER = frozenset({
    "trajectory_sim_time_sec", "completion_time_wall_sec",
    "endpoint_goal_distance_m", "tracking_mean_m", "tracking_rmse_m",
    "tracking_p95_m", "tracking_max_m",
    "cmd_linear_total_variation_mps", "cmd_angular_total_variation_radps",
