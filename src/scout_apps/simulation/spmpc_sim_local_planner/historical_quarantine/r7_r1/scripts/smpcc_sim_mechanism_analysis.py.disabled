#!/usr/bin/env python3
# QUARANTINED_R7_R1_ARCHIVE: historical source only; never execute or import.
"""Fail-closed, read-only analysis for the frozen R7 mechanism matrix.

This program is deliberately release-specific.  It first delegates admission
and ledger validation to the immutable canonical R7 runner, then derives only
descriptive, post-hoc mechanism metrics.  It never upgrades ``H_proxy`` or
``H_modal`` to a physical primary and it has no scientific threshold or
hypothesis-test path.

The only accepted measurement windows come from each immutable
``closed_bag_qc.json`` receipt:

* motion: ``motion_start.ros_time_sec`` through ``terminal.ros_time_sec``;
* tail: ``tail_anchor_ros_time_sec`` through anchor + required tail seconds.

Odometry is windowed by ``msg.header.stamp``.  Headerless topics are windowed
by their rosbag record time.  ``/slosh/height`` is H_proxy in metres and is
converted to millimetres.  ``/sim_spmpc/slosh_height`` is H_modal and is already
in millimetres.  FixedProfile must have no H_modal samples at all.
"""

from __future__ import annotations
raise SystemExit("QUARANTINED_R7_R1_ARCHIVE: this historical source is not executable")


import argparse
import csv
import hashlib
import html
import importlib.util
import json
import math
import os
import shutil
import stat
import statistics
import sys
import tempfile
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Mapping, Optional, Sequence, Tuple


SCRIPT_DIR = Path(__file__).resolve().parent
RUNNER_PATH = SCRIPT_DIR / "smpcc_sim_mechanism_runner.py"
SCHEMA_VERSION = "smpcc-sim-mechanism-analysis-v1"
ANALYSIS_CLASS = "DESCRIPTIVE_POST_HOC_MECHANISM_ONLY"
FORMAL_SCOPE = "SIMULATION_MECHANISM_ONLY"
RELEASE_ID = "SIM-MECHANISM-40-64-88-R7"
STAGE_ORDER = (
    "SIM-S1_CORE",
    "SIM-S2A_SELECTIVITY",
    "SIM-S2B_TRANSFER",
)
STAGE_ALIASES = {
    "SIM-S1_CORE": "SIM-S1",
    "SIM-S2A_SELECTIVITY": "SIM-S2A",
    "SIM-S2B_TRANSFER": "SIM-S2B",
}
PREFIXES = ((40, (STAGE_ORDER[0],)),
            (64, STAGE_ORDER[:2]),
            (88, STAGE_ORDER))
H_PROXY_TOPIC = "/slosh/height"
H_MODAL_TOPIC = "/sim_spmpc/slosh_height"
ODOM_TOPIC = "/odom"
CMD_TOPIC = "/cmd_vel"
ANALYSIS_TOPICS = (ODOM_TOPIC, CMD_TOPIC, H_PROXY_TOPIC, H_MODAL_TOPIC)
ONLINE_CONDITIONS = frozenset(("B0", "Bsmooth", "SmoothMatch", "Bslosh"))
FIXED_PROFILE = "FixedProfile"

# These are descriptive outcomes only.  No field is a registered scientific
# primary and H_proxy/H_modal are kept in disjoint, explicitly named columns.
METRIC_FIELDS = (
    "trajectory_sim_time_sec",
    "completion_time_wall_sec",
    "endpoint_goal_distance_m",
    "tracking_mean_m",
    "tracking_rmse_m",
