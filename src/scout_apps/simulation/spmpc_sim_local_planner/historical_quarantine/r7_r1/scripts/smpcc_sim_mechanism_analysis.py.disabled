    "odom_path_length_m",
    "cmd_linear_rms_mps",
    "cmd_linear_p95_abs_mps",
    "cmd_angular_rms_radps",
    "cmd_angular_p95_abs_radps",
    "cmd_linear_total_variation_mps",
    "cmd_angular_total_variation_radps",
    "H_proxy_motion_rms_mm",
    "H_proxy_motion_p95_abs_mm",
    "H_proxy_motion_peak_abs_mm",
    "H_proxy_motion_plus_tail_rms_mm",
    "H_proxy_motion_plus_tail_p95_abs_mm",
    "H_proxy_motion_plus_tail_peak_abs_mm",
    "H_proxy_tail_rms_mm",
    "H_proxy_tail_peak_abs_mm",
