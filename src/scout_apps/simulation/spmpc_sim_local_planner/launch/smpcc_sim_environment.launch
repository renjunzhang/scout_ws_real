<launch>
  <!--
    Fresh simulation environment boundary.

    This launch intentionally owns only Gazebo, the isolated proxy robot,
    command limiting, and read-only localization.  It neither includes the
    legacy proxy navigation adapter nor starts any path or controller node.
    Motion is an explicit later step through a simulation-owned launch.

    Keep this launch self-contained instead of including a vendor proxy-world
    launch: that makes the exact runtime graph reviewable from this simulation
    package and prevents an unrelated legacy launch change from becoming part
    of a simulation case.
  -->
  <arg name="world_file"/>
  <arg name="map_file"/>
  <arg name="gui" default="false"/>
  <arg name="headless" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="physics" default="ode"/>
  <arg name="verbose" default="false"/>
  <arg name="gzserver_extra_args" default=""/>

  <arg name="x" default="-4.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="cmd_vel_in" default="/cmd_vel"/>
  <arg name="cmd_vel_drive" default="/cmd_vel_drive"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="publish_odom_tf" default="false"/>
  <arg name="scan_topic" default="/scan_front"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="cmd_timeout" default="0.3"/>
  <arg name="max_linear_x" default="0.8"/>
  <arg name="max_angular_z" default="1.2"/>
  <arg name="max_linear_accel" default="0.6"/>
  <arg name="max_angular_accel" default="1.2"/>
  <arg name="localization_odom_topic" default="/odom_carto"/>
  <arg name="localization_rviz" default="false"/>
  <arg name="robot_xacro_file"
       default="$(find scout_mini_proxy_description)/urdf/scout_mini_proxy_stable.xacro"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <param name="smpcc_sim_environment/role" value="ENVIRONMENT_ONLY_NO_CONTROLLER_OR_PATH"/>
  <param name="smpcc_sim_environment/owner_package" value="spmpc_sim_local_planner"/>

  <arg unless="$(arg paused)" name="paused_arg" value=""/>
  <arg if="$(arg paused)" name="paused_arg" value="-u"/>
  <arg unless="$(arg verbose)" name="verbose_arg" value=""/>
  <arg if="$(arg verbose)" name="verbose_arg" value="--verbose"/>

  <!-- Gazebo's ROS API uses its node namespace for /spawn_urdf_model and the
       world services.  Keep the canonical isolated-master namespace /gazebo
       so the stock spawn_model client binds the same fresh instance. -->
  <node name="gazebo"
        pkg="gazebo_ros"
        type="gzserver"
        respawn="false"
        output="screen"
        args="$(arg paused_arg) $(arg verbose_arg) $(arg gzserver_extra_args) -e $(arg physics) $(arg world_file)"/>

  <node if="$(arg gui)"
        name="sim_environment_gzclient"
        pkg="gazebo_ros"
        type="gzclient"
        respawn="false"
        output="screen"
        args="$(arg verbose_arg)"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(arg robot_xacro_file)'
                  robot_namespace:=/
                  cmd_vel_drive_topic:=$(arg cmd_vel_drive)
                  odom_topic:=$(arg odom_topic)
                  publish_odom_tf:=$(arg publish_odom_tf)
                  scan_topic:=$(arg scan_topic)
                  imu_topic:=$(arg imu_topic)"/>

  <node name="sim_environment_robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        output="screen">
    <param name="publish_frequency" value="50.0"/>
  </node>

  <!-- This is only an actuator-side clamp.  It subscribes to cmd_vel and
       cannot synthesize a path or command on its own. -->
  <node name="sim_environment_cmd_vel_guard"
        pkg="scout_mini_proxy_bringup"
        type="cmd_vel_guard.py"
        output="screen">
    <param name="input_topic" value="$(arg cmd_vel_in)"/>
    <param name="output_topic" value="$(arg cmd_vel_drive)"/>
    <param name="timeout" value="$(arg cmd_timeout)"/>
    <param name="max_linear_x" value="$(arg max_linear_x)"/>
    <param name="max_angular_z" value="$(arg max_angular_z)"/>
    <param name="max_linear_accel" value="$(arg max_linear_accel)"/>
    <param name="max_angular_accel" value="$(arg max_angular_accel)"/>
  </node>

  <node name="sim_environment_spawn_proxy"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-urdf -param robot_description -model scout_mini_proxy_stable -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw) -unpause"/>

  <include file="$(find spmpc_sim_local_planner)/launch/smpcc_sim_localization.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="input_odom_topic" value="$(arg odom_topic)"/>
    <arg name="odom_topic" value="$(arg localization_odom_topic)"/>
    <arg name="use_rviz" value="$(arg localization_rviz)"/>
  </include>
</launch>
