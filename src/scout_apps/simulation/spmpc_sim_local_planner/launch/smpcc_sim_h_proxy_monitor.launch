<launch>
  <!-- Source-separated, record-only H_proxy monitor.  It has exactly one ROS
       input (/odom) and exposes no controller or command input. -->
  <arg name="odom_topic" default="/odom"/>
  <arg name="output_namespace" default="/slosh"/>
  <arg name="subscribe_cmd_vel_debug" default="false"/>
  <arg name="container_radius" default="0.0185"/>
  <arg name="liquid_height" default="0.058"/>
  <arg name="liquid_density" default="1000.0"/>
  <arg name="mode_index" default="1"/>
  <arg name="damping_ratio" default="0.05"/>
  <arg name="offset_x" default="0.0"/>
  <arg name="offset_y" default="0.0"/>
  <arg name="use_linear_model" default="true"/>
  <arg name="use_parabola_term" default="false"/>
  <arg name="model_dt" default="0.02"/>
  <arg name="accel_filter_alpha" default="0.3"/>
  <arg name="min_dt" default="0.001"/>
  <arg name="max_dt" default="0.1"/>

  <node pkg="spmpc_sim_local_planner" type="smpcc_sim_h_proxy_monitor.py"
        name="sim_h_proxy_monitor" ns="$(arg output_namespace)" output="screen"
        required="true">
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="subscribe_cmd_vel_debug" value="$(arg subscribe_cmd_vel_debug)"/>
    <param name="container_radius" value="$(arg container_radius)"/>
    <param name="liquid_height" value="$(arg liquid_height)"/>
    <param name="liquid_density" value="$(arg liquid_density)"/>
    <param name="mode_index" value="$(arg mode_index)"/>
    <param name="damping_ratio" value="$(arg damping_ratio)"/>
    <param name="offset_x" value="$(arg offset_x)"/>
    <param name="offset_y" value="$(arg offset_y)"/>
    <param name="use_linear_model" value="$(arg use_linear_model)"/>
    <param name="use_parabola_term" value="$(arg use_parabola_term)"/>
    <param name="model_dt" value="$(arg model_dt)"/>
    <param name="accel_filter_alpha" value="$(arg accel_filter_alpha)"/>
    <param name="min_dt" value="$(arg min_dt)"/>
    <param name="max_dt" value="$(arg max_dt)"/>
  </node>
</launch>
