<launch>
  <!-- 仿真雷达输入/输出 -->
  <arg name="sim_scan_topic" default="/scan" />
  <arg name="scan_topic_out" default="/scan_front" />
  <arg name="enable_filter" default="false" />

  <!-- 坐标系与外参（按仿真模型修改） -->
  <arg name="frame_id"   default="nano_nanoscan3_sensor_link" />
  <arg name="base_frame" default="base_link" />
  <arg name="x" default="0.125" />
  <arg name="y" default="-0.0425" />
  <arg name="z" default="0.155" />
  <arg name="roll"  default="0.0" />
  <arg name="pitch" default="0.0" />
  <arg name="yaw"   default="0.0" />

  <!-- 将仿真 /scan 转成统一输出话题 -->
  <node pkg="topic_tools"
        type="relay"
        name="scan_front_relay"
        args="$(arg sim_scan_topic) $(arg scan_topic_out)"
        output="screen" />

  <!-- 可选滤波 -->
  <node pkg="laser_filters"
        type="scan_to_scan_filter_chain"
        name="scan_front_filter"
        output="screen"
        if="$(arg enable_filter)">
    <rosparam command="load" file="$(find nanoscan3_bringup)/config/scan_front_filter.yaml" />
    <remap from="scan" to="$(arg scan_topic_out)" />
    <remap from="scan_filtered" to="/scan_front_filtered" />
  </node>

  <!-- base_frame -> frame_id 静态 TF（默认关闭，避免与 URDF 中的雷达 TF 冲突） -->
  <arg name="publish_static_tf" default="false" />
  <node if="$(arg publish_static_tf)"
        pkg="tf" type="static_transform_publisher" name="tf_base_to_front_laser"
        args="$(arg x) $(arg y) $(arg z) $(arg roll) $(arg pitch) $(arg yaw) $(arg base_frame) $(arg frame_id) 100" />

  <!-- RViz -->
  <arg name="use_rviz" default="false" />
  <arg name="rviz_config" default="$(find nanoscan3_bringup)/rviz/nanoscan3_front_sim.rviz" />
  <node if="$(arg use_rviz)"
        pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
