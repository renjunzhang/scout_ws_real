<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Cartographer 实物建图 -->
  <arg name="scan_topic" default="/scan_front" />
  <arg name="odom_topic" default="/odom" />
  <arg name="use_rviz" default="true" />
  <arg name="use_slam_toolbox" default="false" />

  <!-- 坐标变换发布 -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 1 /map /odom" />

  <!-- Cartographer 节点 -->
  <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node" 
        args="-configuration_directory $(find nanoscan3_mapping)/config
              -configuration_basename scout_2d.lua"
        output="screen"
        respawn="true" respawn_delay="5">
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <!-- Cartographer 栅格地图发布 -->
  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros" 
        type="cartographer_occupancy_grid_node" args="-resolution 0.05"
        output="screen" />

  <!-- RViz 可视化 -->
  <node if="$(arg use_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find nanoscan3_mapping)/rviz/cartographer.rviz" 
        output="screen" />

  <!-- 调试：发布扫描话题 (可选) -->
  <!-- <node name="topic_monitor" pkg="rostopic" type="rostopic"
        args="echo $(arg scan_topic)" output="screen" /> -->

</launch>
