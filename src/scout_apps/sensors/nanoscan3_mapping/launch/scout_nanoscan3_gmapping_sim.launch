<launch>
  <!-- 仿真建图：默认订阅 /scan_front -->
  <arg name="scan_topic" default="/scan_front" />
  <arg name="laser_frame" default="nano_nanoscan3_sensor_link" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="odom" />
  <arg name="map_frame" default="map" />

  <!-- 可选：发布假 odom->base_frame（仿真一般已有，默认关闭） -->
  <arg name="fake_odom_tf" default="false" />
  <node if="$(arg fake_odom_tf)" pkg="tf" type="static_transform_publisher" name="tf_fake_odom_to_base"
        args="0 0 0 0 0 0 odom $(arg base_frame) 30" />

  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>

  <!-- RViz -->
  <arg name="use_rviz" default="true" />
  <arg name="rviz_config" default="$(find nanoscan3_mapping)/rviz/gmapping_front_sim.rviz" />
  <node if="$(arg use_rviz)"
        pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
