<launch>
  <!-- 仿真建图：默认订阅 /scan_front -->
  <arg name="scan_topic" default="/scan_front" />
  <arg name="laser_frame" default="nano_nanoscan3_sensor_link" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="odom" />
  <arg name="map_frame" default="map" />

  <!-- 可选：发布假 odom->base_frame（仿真一般已有，默认关闭） -->
  <arg name="fake_odom_tf" default="false" />
  <node if="$(arg fake_odom_tf)" pkg="tf" type="static_transform_publisher" name="tf_fake_odom_to_base"
        args="0 0 0 0 0 0 odom $(arg base_frame) 30" />

  <!-- gmapping (仿真优化参数) -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <!-- 坐标系 -->
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <remap from="scan" to="$(arg scan_topic)" />

    <!-- 地图分辨率 -->
    <param name="delta" value="0.05" />          <!-- 5cm 栅格 -->
    <param name="maxUrange" value="8.0" />       <!-- 激光最大可用距离 -->
    <param name="maxRange" value="10.0" />       <!-- 激光最大测量距离 -->

    <!-- 里程计误差模型（关键！增大容忍度） -->
    <param name="srr" value="0.05" />             <!-- 平移引起的平移误差 (默认0.1) -->
    <param name="srt" value="0.05" />             <!-- 平移引起的旋转误差 (默认0.2) -->
    <param name="str" value="0.05" />             <!-- 旋转引起的平移误差 (默认0.1) -->
    <param name="stt" value="0.05" />             <!-- 旋转引起的旋转误差 (默认0.2) ⬆️ 滑移转向重点 -->

    <!-- 粒子滤波 -->
    <param name="particles" value="100" />        <!-- 粒子数（越多越稳但越慢） -->
    <param name="minimumScore" value="100" />    <!-- 匹配最低分（防止错误匹配） -->

    <!-- 更新阈值（降低以更频繁更新） -->
    <param name="linearUpdate" value="0.2" />    <!-- 移动0.2m更新一次 -->
    <param name="angularUpdate" value="0.25" />  <!-- 旋转0.25rad≈14°更新一次 -->
    <param name="temporalUpdate" value="2.0" />  <!-- 静止2秒也更新 -->

    <!-- 扫描匹配 -->
    <param name="iterations" value="5" />        <!-- 匹配迭代次数 -->
    <param name="lsigma" value="0.075" />        <!-- 似然sigma -->
    <param name="ogain" value="3.0" />           <!-- 似然增益 -->
    <param name="lstep" value="0.05" />          <!-- 线性搜索步长 -->
    <param name="astep" value="0.05" />          <!-- 角度搜索步长 -->
  </node>

  <!-- RViz -->
  <arg name="use_rviz" default="true" />
  <arg name="rviz_config" default="$(find nanoscan3_mapping)/rviz/gmapping_front_sim.rviz" />
  <node if="$(arg use_rviz)"
        pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
